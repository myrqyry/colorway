@OBSThemeMeta {
    name: 'Catppuccin Frappé — Blue';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Blue';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #292c3c;
    --bg_base: #303446;
    --bg_preview: #232634;
    --bg_dock: #292c3c;
    --bg_hover: #414559;
    --text: #c6d0f5;
    --text_light: #f5f5f5;
    --text_muted: #838ba7;
    --text_disabled: #a5adce;
    --text_inactive: #a5adce;
    --text_inverse: #FFFFFF;
    --primary: #8caaee;
    --primary_light: #babbf1;
    --primary_lighter: #99d1db;
    --primary_dark: #85c1dc;
    --primary_darker: #626880;
    --input_bg: #414559;
    --input_bg_hover: #51576d;
    --input_bg_focus: #464d5e;
    --input_border: #5B607B;
    --input_border_hover: #626880;
    --button_bg: #292c3c;
    --button_bg_hover: #414559;
    --button_bg_disabled: #303446;
    --list_item_bg_hover: #484f5f;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #414559;
    --accent_bg_start: rgba(140, 170, 238, 0.3);
    --accent_bg_end: rgba(140, 170, 238, 0.1);
    --warning: #ef9f76;
    --danger: #e78284;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #c6d0f5;
    --ico_selected: #303446;
}
