@OBSThemeMeta {
    name: 'Colorway Brutalist Acid';
    id: 'com.myrqyry.ColorwayBrutalist.Acid';
    extends: 'com.myrqyry.ColorwayBrutalist';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #09090b;
    --bg_base: #0b0b0f;
    --bg_preview: #050505;

    --primary: #00e5ff;
    --primary_light: #67f8ff;
    --primary_lighter: #e0fbff;
    --primary_dark: #0891b2;
    --primary_darker: #164e63;

    --warning: #f7ff00;
    --danger: #ff4fd8;

    --text: #f8fafc;
    --text_light: #ffffff;
    --text_muted: #a1a1aa;
    --text_disabled: #71717a;
    --text_inactive: #71717a;

    --border_color: #050505;
    --highlight_color: #f7ff00;
    --border_highlight: var(--grey3);

    --input_bg: var(--text);
    --input_bg_hover: var(--primary_lighter);
    --input_bg_focus: var(--text_light);

    --list_item_bg_selected: var(--danger);
    --list_item_bg_hover: var(--primary_darker);

    --input_border: var(--border_color);
    --input_border_hover: var(--border_color);
    --input_border_focus: var(--warning);

    --button_bg: var(--primary);
    --button_bg_hover: #0e7490;
    --button_bg_down: var(--danger);
    --button_bg_disabled: #27272a;

    --button_border: var(--border_color);
    --button_border_hover: var(--border_color);
    --button_border_focus: var(--warning);

    --tab_bg: var(--bg_window);
    --tab_bg_hover: var(--primary_darker);
    --tab_bg_down: var(--danger);
    --tab_bg_disabled: #18181b;

    --tab_border: var(--border_color);
    --tab_border_hover: var(--border_color);
    --tab_border_focus: var(--warning);
    --tab_border_selected: var(--border_color);

    --bg_dock: var(--primary_darker);
    --bg_hover: var(--primary_dark);
    --text_inverse: var(--border_color);

    --live: #00e5ff;
    --recording: #ff4fd8;

    --scrollbar_bg: #050505;
    --scrollbar_border: #050505;

    --meter_bg_nom: var(--bg_window);
    --meter_bg_war: var(--warning);
    --meter_bg_err: var(--danger);
    --meter_fg_nom: var(--primary_light);
    --meter_fg_war: var(--warning);
    --meter_fg_err: var(--danger);
}
