@OBSThemeMeta {
    name: 'Catppuccin Mocha';
    id: 'com.myrqyry.Colorway.CatppuccinMocha';
    extends: 'com.myrqyry.Colorway';
    author: 'Mat + AI';
    dark: 'true';
}

@OBSThemeVars {
    /* Base Theme Colors */
    --bg_window: #181825;
    --bg_base: #1e1e2e;
    --bg_preview: #11111b;

    --primary: #cba6f7;
    --primary_light: #b4befe;
    --primary_lighter: #f5c2e7;
    --primary_dark: #89b4fa;
    --primary_darker: #585b70;

    --warning: #fab387;
    --danger: #f38ba8;

    --text: #cdd6f4;
    --text_light: #f5f5f5;
    --text_muted: #7f849c;

    --text_disabled: #a6adc8;
    --text_inactive: #a6adc8;

    --border_color: #313244;

    /* Inputs and Buttons */
    --input_bg: #313244;
    --input_bg_hover: #45475a;
    --input_bg_focus: #313244;

    --list_item_bg_hover: #313244;

    --input_border: #313244;
    --input_border_hover: #585b70;

    --button_bg: #181825;
    --button_bg_hover: #313244;
    --button_bg_disabled: #1e1e2e;

    /* Theme Aliases */
    --bg_dock: #181825;
    --bg_hover: #313244;
}
