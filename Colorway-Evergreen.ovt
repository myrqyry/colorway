@OBSThemeMeta {
    name: 'Evergreen';
    id: 'com.myrqyry.Colorway.Evergreen';
    extends: 'com.myrqyry.Colorway';
    author: 'Mat + AI';
    dark: 'true';
}

@OBSThemeVars {
    /* Adapta Evergreen colors */
    --bg_base: #2b3339;
    --bg_window: #2b3339;
    --bg_dock: #323c41;
    --primary: #a7c080;
    --primary_light: #d3c6aa;
    --text: #d3c6aa;
    --text_muted: #9da9a0;
    --danger: #e67e80;
    --warning: #dbbc7f;
    --border_color: #434f55;
    --input_bg: #323c41;
    --input_border: #434f55;
    --button_bg: #323c41;
    --button_bg_hover: #3a454a;
    --text_light: #ffffff;
    --accent: #fffd79;
}
