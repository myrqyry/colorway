@OBSThemeMeta {
    name: 'Catppuccin Macchiato';
    id: 'com.myrqyry.Colorway.CatppuccinMacchiato';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Base Theme Colors */
    --bg_window: #1e2030;
    --bg_base: #24273a;
    --bg_preview: #181926;

    --primary: #c6a0f6;
    --primary_light: #b7bdf8;
    --primary_lighter: #f5bde6;
    --primary_dark: #8aadf4;
    --primary_darker: #5b6078;

    --warning: #f5a97f;
    --danger: #ed8796;

    --text: #cad3f5;
    --text_light: #f5f5f5;
    --text_muted: #8087a2;

    --text_disabled: #a5adcb;
    --text_inactive: #a5adcb;

    --border_color: #363a4f;

    /* Inputs and Buttons */
    --input_bg: #363a4f;
    --input_bg_hover: #494d64;
    --input_bg_focus: #363a4f;

    --list_item_bg_hover: #363a4f;

    --input_border: #363a4f;
    --input_border_hover: #5b6078;

    --button_bg: #1e2030;
    --button_bg_hover: #363a4f;
    --button_bg_disabled: #24273a;

    /* Theme Aliases */
    --bg_dock: #1e2030;
    --bg_hover: #363a4f;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #24273a;
}
