@OBSThemeMeta {
    name: 'Adapta Evergreen';
    id: 'com.myrqyry.Colorway.AdaptaEvergreen';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #222d32;
    --bg_base: #222d32;
    --bg_preview: #29353b;
    --bg_dock: #263238;
    --bg_hover: #222d32;
    --text: #d4d4d4;
    --text_light: #d4d4d4;
    --text_muted: #7c8d96;
    --text_disabled: #858585;
    --text_inactive: #858585;
    --text_inverse: #000000;
    --primary: #afff45;
    --primary_light: #85c036;
    --primary_lighter: #d4d4d4;
    --primary_dark: #6ba22e;
    --primary_darker: #4a7a24;
    --input_bg: #29353b;
    --input_bg_hover: #29353b;
    --input_bg_focus: #38444a;
    --input_border: #85c036;
    --input_border_hover: #85c036;
    --button_bg: #7AB230;
    --button_bg_hover: #85c036;
    --button_bg_disabled: #222d32;
    --list_item_bg_hover: #222d32;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #85c036;
    --accent_bg_start: rgba(175, 255, 69, 0.3);
    --accent_bg_end: rgba(175, 255, 69, 0.1);
    --warning: #cca700;
    --danger: #f48771;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #d4d4d4;
    --ico_selected: #222d32;
}
