@OBSThemeMeta {
    name: 'Everforest Light Soft';
    id: 'com.myrqyry.Colorway.Everforest.Light.Soft';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference: Everforest Light Soft
       Hex colors:
       --bg_window: #F3EAD3;
       --bg_base: #F3EAD3;
       --bg_preview: #EAE4CA;
       --bg_dock: #EAE4CA;
       --bg_hover: #E5DFC5;
       --text: #5C6A72;
       --text_light: #2D353B;
       --text_muted: #829181;
       --text_inactive: #A6B0A0;
       --text_inverse: #000000;
       --text_disabled: #A6B0A0;
       --primary: #8DA101;
       --primary_light: #5C6A72;
       --primary_lighter: #4A555B;
       --primary_dark: #6E7F26;
       --primary_darker: #4A5B2E;
       --input_bg: #EAE4CA;
       --input_bg_hover: #E5DFC5;
       --input_bg_focus: #E5DFC5;
       --input_border: #B9C0AB;
       --input_border_hover: #859289;
       --button_bg: #EAE4CA;
       --button_bg_hover: #E5DFC5;
       --button_bg_disabled: #F3EAD3;
       --list_item_bg_hover: #E5DFC5;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #D8D3BA;
       --ico: #5C6A72;
       --ico_selected: #F3EAD3;
       --warning: #DFA000;
       --danger: #F85552;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(141, 161, 1, 0.3);
       --accent_bg_end: rgba(141, 161, 1, 0.1);
    */
    --accent_bg_start: rgba(141, 161, 1, 0.3);
    --accent_bg_end: rgba(141, 161, 1, 0.1);

    --bg_window: #F3EAD3;
    --bg_base: #F3EAD3;
    --bg_preview: #EAE4CA;

    --primary: #8DA101;
    --primary_light: #5C6A72;
    --primary_lighter: #4A555B;
    --primary_dark: #6E7F26;
    --primary_darker: #4A5B2E;

    --warning: #DFA000;
    --danger: #F85552;

    --text: #5C6A72;
    --text_light: #2D353B;
    --text_muted: #829181;

    --text_disabled: #A6B0A0;
    --text_inactive: #A6B0A0;

    --border_color: #D8D3BA;

    --input_bg: #EAE4CA;
    --input_bg_hover: #E5DFC5;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #E5DFC5;

    --input_border: #B9C0AB;
    --input_border_hover: #859289;

    --button_bg: #EAE4CA;
    --button_bg_hover: #E5DFC5;
    --button_bg_disabled: #F3EAD3;

    /* Light theme: selected-item text stays dark */
    --text_inverse: #000000;

    --bg_dock: #EAE4CA;
    --bg_hover: #E5DFC5;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #F3EAD3;
}
