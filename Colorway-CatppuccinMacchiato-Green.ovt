@OBSThemeMeta {
    name: 'Catppuccin Macchiato — Green';
    id: 'com.myrqyry.Colorway.CatppuccinMacchiato.Green';
    extends: 'com.myrqyry.Colorway.CatppuccinMacchiato';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #a6da95;
    --primary_light: #8bd5ca;
    --primary_lighter: #a6da95;
    --primary_dark: #7dc4e4;
    --primary_darker: #5b6078;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #24273a;
}
