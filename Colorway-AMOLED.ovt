@OBSThemeMeta {
    name: 'AMOLED';
    id: 'com.myrqyry.Colorway.Amoled';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #000000;
    --bg_base: #000000;
    --bg_preview: #1a1a1a;
    --bg_dock: #000000;
    --bg_hover: #252525;
    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #555555;
    --text_disabled: #484848;
    --text_inactive: #484848;
    --text_inverse: #FFFFFF;
    --primary: #b388ff;
    --primary_light: #18ffff;
    --primary_lighter: #ff4081;
    --primary_dark: #00ff88;
    --primary_darker: #555555;
    --input_bg: #1a1a1a;
    --input_bg_hover: #252525;
    --input_bg_focus: #252525;
    --input_border: #141414;
    --input_border_hover: #b388ff;
    --button_bg: #000000;
    --button_bg_hover: #252525;
    --button_bg_disabled: #000000;
    --list_item_bg_hover: #252525;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #141414;
    --accent_bg_start: rgba(179, 136, 255, 0.3);
    --accent_bg_end: rgba(179, 136, 255, 0.1);
    --warning: #ffea00;
    --danger: #ff1744;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #ffffff;
    --ico_selected: #000000;
}
