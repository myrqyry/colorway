@OBSThemeMeta {
    name: 'Catppuccin Latte';
    id: 'com.myrqyry.Colorway.CatppuccinLatte';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(136, 57, 239, 0.3);
    --accent_bg_end: rgba(136, 57, 239, 0.1);

    /* Base Theme Colors */
    --bg_window: #e6e9ef;
    --bg_base: #eff1f5;
    --bg_preview: #dce0e8;

    --primary: #8839ef;
    --primary_light: #7287fd;
    --primary_lighter: #ea76cb;
    --primary_dark: #1e66f5;
    --primary_darker: #acb0be;

    --warning: #fe640b;
    --danger: #d20f39;

    --text: #4c4f69;
    --text_light: #1e1e2e;
    --text_muted: #8c8fa1;

    --text_disabled: #6c6f85;
    --text_inactive: #6c6f85;

    --border_color: #ccd0da;

    /* Inputs and Buttons */
    --input_bg: #ccd0da;
    --input_bg_hover: #bcc0cc;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #f0e4d4;

    --input_border: #ccd0da;
    --input_border_hover: #acb0be;

    --button_bg: #e6e9ef;
    --button_bg_hover: #ccd0da;
    --button_bg_disabled: #eff1f5;

    /* Light theme: selected-item text stays dark */
    --text_inverse: #191724;

    /* Theme Aliases */
    --bg_dock: #e6e9ef;
    --bg_hover: #ccd0da;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #eff1f5;
}
