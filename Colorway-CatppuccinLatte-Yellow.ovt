@OBSThemeMeta {
    name: 'Catppuccin Latte — Yellow';
    id: 'com.myrqyry.Colorway.CatppuccinLatte.Yellow';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    --bg_window: #eff1f5;
    --bg_base: #e6e9ef;
    --bg_preview: #dce0e8;

    --primary: #df8e1d;
    --primary_light: #fe640b;
    --primary_lighter: #dc8a78;
    --primary_dark: #e64553;
    --primary_darker: #acb0be;

    --warning: #df8e1d;
    --danger: #d20f39;

    --text: #4c4f69;
    --text_light: #eff1f5;
    --text_muted: #9ca0b0;
    --text_disabled: #bcc0cc;
    --text_inactive: #bcc0cc;
    --text_inverse: #000000;

    --border_color: #ccd0da;

    --input_bg: #ccd0da;
    --input_bg_hover: #bcc0cc;
    --input_bg_focus: #e6e9ef;

    --list_item_bg_hover: #ccd0da;

    --input_border: #EDEEF1;
    --input_border_hover: #acb0be;

    --button_bg: #eff1f5;
    --button_bg_hover: #ccd0da;
    --button_bg_disabled: #e6e9ef;

    --bg_dock: #eff1f5;
    --bg_hover: #ccd0da;

    --ico: var(--text);
    --ico_selected: #eff1f5;

    --accent_bg_start: rgba(223, 142, 29, 0.3);
    --accent_bg_end: rgba(223, 142, 29, 0.1);
}