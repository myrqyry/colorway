@OBSThemeMeta {
    name: 'Solarized Light+';
    id: 'com.myrqyry.Colorway.SolarizedLight';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(38, 139, 210, 0.3);
    --accent_bg_end: rgba(38, 139, 210, 0.1);

    --bg_window: #fdf6e3;
    --bg_base: #fdf6e3;
    --bg_preview: #eee8d5;

    --primary: #268bd2;
    --primary_light: #2aa198;
    --primary_lighter: #5cb8b3;
    --primary_dark: #1a6d9e;
    --primary_darker: #586e75;

    --warning: #b58900;
    --danger: #dc322f;

    --text: #000000;
    --text_light: #002b36;
    --text_muted: #93a1a1;

    --text_disabled: #c6c6b4;
    --text_inactive: #c6c6b4;

    --border_color: #d6cfc1;

    --input_bg: #eee8d5;
    --input_bg_hover: #e0d9c6;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #e0d9c6;

    --input_border: #d6cfc1;
    --input_border_hover: #839496;

    --button_bg: #eee8d5;
    --button_bg_hover: #e0d9c6;
    --button_bg_disabled: #fdf6e3;

    /* Light theme: selected-item text stays dark */
    --text_inverse: #000000;

    --bg_dock: #eee8d5;
    --bg_hover: #e0d9c6;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #fdf6e3;
}
