@OBSThemeMeta {
    name: 'Rosé Pine — Iris';
    id: 'com.myrqyry.Colorway.RosePine.Iris';
    extends: 'com.myrqyry.Colorway.RosePine';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #c4a7e7;
    --primary_light: #ebbcba;
    --primary_lighter: #e0def4;
    --primary_dark: #9ccfd8;
    --primary_darker: #524f67;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #191724;
}
