@OBSThemeMeta {
    name: 'Mercury';
    id: 'com.myrqyry.Colorway.Mercury';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(141, 164, 245, 0.3);
    --accent_bg_end: rgba(141, 164, 245, 0.1);

    /* Base Theme Colors */
    --bg_window: #171721;
    --bg_base: #171721;
    --bg_preview: #2e2e37;

    --primary: #8da4f5;
    --primary_light: #77becf;
    --primary_lighter: #8da4f5;
    --primary_dark: #77c599;
    --primary_darker: #9d9da8;

    --warning: #fc9b6f;
    --danger: #fc92b4;

    --text: #dddde5;
    --text_light: #ffffff;
    --text_muted: #9d9da8;

    --text_disabled: #85858f;
    --text_inactive: #85858f;

    --border_color: #2a2a33;

    /* Inputs and Buttons */
    --input_bg: #2e2e37;
    --input_bg_hover: #383841;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #383841;

    --input_border: #2a2a33;
    --input_border_hover: #8da4f5;

    --button_bg: #16161f;
    --button_bg_hover: #383841;
    --button_bg_disabled: #171721;

    /* Theme Aliases */
    --bg_dock: #16161f;
    --bg_hover: #383841;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #171721;
}
