@OBSThemeMeta {
    name: 'Catppuccin Macchiato — Pink';
    id: 'com.myrqyry.Colorway.CatppuccinMacchiato.Pink';
    extends: 'com.myrqyry.Colorway.CatppuccinMacchiato';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #f5bde6;
    --primary_light: #f4dbd6;
    --primary_lighter: #f0c6c6;
    --primary_dark: #c6a0f6;
    --primary_darker: #5b6078;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #24273a;
}
