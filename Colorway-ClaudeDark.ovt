@OBSThemeMeta {
    name: 'Claude Dark';
    id: 'com.myrqyry.Colorway.ClaudeDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --text_inverse: #101010;
    /* Base Theme Colors (Warm Charcoal) */
    --bg_window: #1B1B1A;
    --bg_base: #1B1B1A;
    --bg_preview: #151514; /* Slightly darker for canvas */

    /* Claude Orange Accents */
    --primary: #C15F3C;        /* Signature Claude Orange */
    --primary_light: #d67a58;
    --primary_lighter: #e89576;
    --primary_dark: #9e4b2d;
    --primary_darker: #7a3820;

    --warning: #dbbc7f; /* Warm Yellow */
    --danger: #b75e7e;  /* Muted Red/Purple */

    /* Typography */
    --text: #F4F3EE;        /* Pampas Off-white */
    --text_light: #FFFFFF;
    --text_muted: #B1ADA1;  /* Cloudy Gray */

    --text_disabled: #696661;
    --text_inactive: #696661;

    --border_color: #3d3c3a;

    /* Inputs and Buttons */
    --input_bg: #242423;
    --input_bg_hover: #3d3c3a;
    --input_bg_focus: #242423;

    --list_item_bg_hover: #3d3c3a;

    --input_border: #3d3c3a;
    --input_border_hover: #B1ADA1;

    --button_bg: #242423;
    --button_bg_hover: #3d3c3a;
    --button_bg_disabled: #1B1B1A;

    /* Theme Aliases */
    --bg_dock: #242423;
    --bg_hover: #3d3c3a;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #1B1B1A;
}