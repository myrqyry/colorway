@OBSThemeMeta {
    name: 'Earthbound Darker';
    id: 'com.myrqyry.Colorway.EarthBound.Darker';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #080808;
    --bg_base: #080808;
    --bg_preview: #050505;
    --bg_dock: #0a0a0a;
    --bg_hover: #1a1a1a;
    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #ffff79;
    --text_disabled: #333333;
    --text_inactive: #333333;
    --text_inverse: #000000;
    --primary: #25ff81;
    --primary_light: #70caff;
    --primary_lighter: #a0ddff;
    --primary_dark: #fafd51;
    --primary_darker: #c4b800;
    --input_bg: #111111;
    --input_bg_hover: #1a1a1a;
    --input_bg_focus: #1a1a1a;
    --input_border: #1a1a1a;
    --input_border_hover: #25ff81;
    --button_bg: #19B25A;
    --button_bg_hover: #4fff99;
    --button_bg_disabled: #080808;
    --list_item_bg_hover: #1a1a1a;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #1a1a1a;
    --accent_bg_start: rgba(37, 255, 129, 0.3);
    --accent_bg_end: rgba(37, 255, 129, 0.1);
    --warning: #fafd51;
    --danger: #fb967f;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #ffffff;
    --ico_selected: #080808;
}
