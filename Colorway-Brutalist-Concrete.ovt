@OBSThemeMeta {
    name: 'Colorway Brutalist Concrete';
    id: 'com.myrqyry.ColorwayBrutalist.Concrete';
    extends: 'com.myrqyry.ColorwayBrutalist';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #1c1917;
    --bg_base: #292524;
    --bg_preview: #0c0a09;

    --primary: #57534e;
    --primary_light: #a8a29e;
    --primary_lighter: #f5f5f4;
    --primary_dark: #44403c;
    --primary_darker: #1c1917;

    --warning: #facc15;
    --danger: #ff6b4a;

    --text: #fafaf9;
    --text_light: #ffffff;
    --text_muted: #a8a29e;
    --text_disabled: #78716c;
    --text_inactive: #78716c;

    --border_color: #0c0a09;
    --highlight_color: #facc15;
    --border_highlight: #0c0a09;

    --input_bg: #fafaf9;
    --input_bg_hover: #e7e5e4;
    --input_bg_focus: #ffffff;

    --list_item_bg_selected: #ff6b4a;
    --list_item_bg_hover: #44403c;

    --input_border: #0c0a09;
    --input_border_hover: #0c0a09;
    --input_border_focus: #facc15;

    --button_bg: #57534e;
    --button_bg_hover: #78716c;
    --button_bg_down: #ff6b4a;
    --button_bg_disabled: #292524;

    --button_border: #0c0a09;
    --button_border_hover: #0c0a09;
    --button_border_focus: #facc15;

    --tab_bg: #1c1917;
    --tab_bg_hover: #44403c;
    --tab_bg_down: #ff6b4a;
    --tab_bg_disabled: #292524;

    --tab_border: #0c0a09;
    --tab_border_hover: #0c0a09;
    --tab_border_focus: #facc15;
    --tab_border_selected: #0c0a09;

    --bg_dock: #44403c;
    --bg_hover: #57534e;
    --text_inverse: #0c0a09;

    --meter_bg_nom: #1c1917;
    --meter_bg_war: var(--warning);
    --meter_bg_err: var(--danger);
    --meter_fg_nom: var(--primary_light);
    --meter_fg_war: var(--warning);
    --meter_fg_err: var(--danger);
}

/* Neo-brutalist drop shadow simulation */
QPushButton {
    border: 5px solid var(--border_color);
    border-top-color: var(--border_highlight);
    border-left-color: var(--border_highlight);
    border-bottom-color: var(--border_color);
    border-right-color: var(--border_color);
    background: var(--button_bg);
    margin: 2px;
}
QPushButton:pressed {
    border: 5px solid var(--border_color);
    border-top-color: var(--border_color);
    border-left-color: var(--border_color);
    border-bottom-color: var(--border_highlight);
    border-right-color: var(--border_highlight);
    background: var(--button_bg_down);
}
QPushButton:hover {
    border: 6px solid var(--border_highlight);
    background: var(--button_bg_hover);
}
