@OBSThemeMeta {
    name: 'Colorway Brutalist Concrete';
    id: 'com.myrqyry.ColorwayBrutalist.Concrete';
    extends: 'com.myrqyry.ColorwayBrutalist';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #1c1917;
    --bg_base: #292524;
    --bg_preview: #0c0a09;

    --primary: #57534e;
    --primary_light: #a8a29e;
    --primary_lighter: #f5f5f4;
    --primary_dark: #44403c;
    --primary_darker: #1c1917;

    --warning: #facc15;
    --danger: #ff6b4a;

    --text: #fafaf9;
    --text_light: #ffffff;
    --text_muted: #a8a29e;
    --text_disabled: #78716c;
    --text_inactive: #78716c;

    --border_color: #0c0a09;
    --highlight_color: #facc15;
    --border_highlight: var(--grey3);

    --input_bg: var(--text);
    --input_bg_hover: #e7e5e4;
    --input_bg_focus: var(--text_light);

    --list_item_bg_selected: var(--danger);
    --list_item_bg_hover: var(--primary_dark);

    --input_border: var(--border_color);
    --input_border_hover: var(--border_color);
    --input_border_focus: var(--warning);

    --button_bg: var(--primary);
    --button_bg_hover: #78716c;
    --button_bg_down: var(--danger);
    --button_bg_disabled: #292524;

    --button_border: var(--border_color);
    --button_border_hover: var(--border_color);
    --button_border_focus: var(--warning);

    --tab_bg: var(--bg_window);
    --tab_bg_hover: var(--primary_dark);
    --tab_bg_down: var(--danger);
    --tab_bg_disabled: #292524;

    --tab_border: var(--border_color);
    --tab_border_hover: var(--border_color);
    --tab_border_focus: var(--warning);
    --tab_border_selected: var(--border_color);

    --bg_dock: var(--primary_dark);
    --bg_hover: var(--primary);
    --text_inverse: var(--border_color);

    --live: #a8a29e;
    --recording: #ff6b4a;

    --scrollbar_bg: #0c0a09;
    --scrollbar_border: #0c0a09;

    --meter_bg_nom: var(--bg_window);
    --meter_bg_war: var(--warning);
    --meter_bg_err: var(--danger);
    --meter_fg_nom: var(--primary_light);
    --meter_fg_war: var(--warning);
    --meter_fg_err: var(--danger);
}
