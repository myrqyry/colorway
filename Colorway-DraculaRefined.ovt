@OBSThemeMeta {
    name: 'Dracula Refined';
    id: 'com.myrqyry.Colorway.DraculaRefined';
    extends: 'com.myrqyry.Colorway.Dracula';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(189, 147, 249, 0.3);
    --accent_bg_end: rgba(189, 147, 249, 0.1);

    --bg_window: #282a36;
    --bg_base: #282a36;
    --bg_preview: #1d1d24;

    --primary: #bd93f9;
    --primary_light: #f8f8f2;
    --primary_lighter: #ffffff;
    --primary_dark: #9a86fd;
    --primary_darker: #6272a4;

    --warning: #f1fa8c;
    --danger: #ff5555;

    --text: #f8f8f2;
    --text_light: #ffffff;
    --text_muted: #6272a4;

    --text_disabled: #44475a;
    --text_inactive: #44475a;

    --border_color: #44475a;

    --input_bg: #44475a;
    --input_bg_hover: #525266;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #525266;

    --input_border: #44475a;
    --input_border_hover: #6272a4;

    --button_bg: #44475a;
    --button_bg_hover: #525266;
    --button_bg_disabled: #282a36;

    --bg_dock: #1e1f2b;
    --bg_hover: #525266;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #282a36;
}
