@OBSThemeMeta {
    name: 'Vercel';
    id: 'com.myrqyry.Colorway.Vercel';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(0, 112, 243, 0.3);
    --accent_bg_end: rgba(0, 112, 243, 0.1);

    /* Base Theme Colors */
    --bg_window: #000000;
    --bg_base: #000000;
    --bg_preview: #1a1a1a;

    --primary: #0070F3;
    --primary_light: #52A8FF;
    --primary_lighter: #8E4EC6;
    --primary_dark: #46A758;
    --primary_darker: #878787;

    --warning: #FFB224;
    --danger: #E5484D;

    --text: #EDEDED;
    --text_light: #ffffff;
    --text_muted: #878787;

    --text_disabled: #737373;
    --text_inactive: #737373;
    --text_inverse: #FFFFFF;

    --border_color: #141414;

    /* Inputs and Buttons */
    --input_bg: #1a1a1a;
    --input_bg_hover: #252525;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #252525;

    --input_border: #141414;
    --input_border_hover: #0070F3;

    --button_bg: #000000;
    --button_bg_hover: #252525;
    --button_bg_disabled: #000000;

    /* Theme Aliases */
    --bg_dock: #000000;
    --bg_hover: #252525;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #000000;
}
