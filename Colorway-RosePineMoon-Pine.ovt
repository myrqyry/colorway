@OBSThemeMeta {
    name: 'Rose Pine Moon — Pine';
    id: 'com.myrqyry.Colorway.RosePineMoon.Pine';
    extends: 'com.myrqyry.Colorway.RosePineMoon';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --text_inverse: #1F1D30;
    --primary: #3e8fb0;
    --primary_light: #9ccfd8;
    --primary_lighter: #e0def4;
    --primary_dark: #ea9a97;
    --primary_darker: #56526e;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #232136;
}
