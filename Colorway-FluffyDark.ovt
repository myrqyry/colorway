@OBSThemeMeta {
    name: 'Fluffy Dark';
    id: 'com.myrqyry.Colorway.FluffyDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Fluffy Dark
       Hex colors:
       --bg_window: #212121;
       --bg_base: #212121;
       --bg_preview: #1a1a1a;
       --bg_dock: #252525;
       --bg_hover: #3A3D41;
       --text: #D4D4D4;
       --text_light: #FFFFFF;
       --text_muted: #8c8c8c;
       --text_inactive: #6B6B6B;
       --text_inverse: #FFFFFF;
       --text_disabled: #6B6B6B;
       --primary: #F48FB1;
       --primary_light: #F8BBD0;
       --primary_lighter: #FCE4EC;
       --primary_dark: #C2185B;
       --primary_darker: #880E4F;
       --input_bg: #252525;
       --input_bg_hover: #3A3D41;
       --input_bg_focus: #353535;
       --input_border: #3A3D41;
       --input_border_hover: #F48FB1;
       --button_bg: #252525;
       --button_bg_hover: #3A3D41;
       --button_bg_disabled: #212121;
       --list_item_bg_hover: #3A3D41;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #3A3D41;
       --ico: #D4D4D4;
       --ico_selected: #212121;
       --warning: #DCDCAA;
       --danger: #CE9178;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(244, 143, 177, 0.3);
       --accent_bg_end: rgba(244, 143, 177, 0.1);
    */

    --bg_window: #212121;
    --bg_base: #212121;
    --bg_preview: #1a1a1a; 

    
    --primary: #F48FB1;        
    --primary_light: #F8BBD0;  
    --primary_lighter: #FCE4EC;
    --primary_dark: #C2185B;
    --primary_darker: #880E4F;

    --warning: #DCDCAA; 
    --danger: #CE9178;  

    
    --text: #D4D4D4;        
    --text_light: #FFFFFF;
    --text_muted: #8c8c8c;  

    --text_disabled: #6B6B6B; 
    --text_inactive: #6B6B6B;
    --text_inverse: #FFFFFF;

    --border_color: #3A3D41;

    
    --input_bg: #252525;
    --input_bg_hover: #3A3D41;
    --input_bg_focus: #353535;

    --list_item_bg_hover: #3A3D41;

    --input_border: #3A3D41;
    --input_border_hover: #F48FB1;

    --button_bg: #252525;
    --button_bg_hover: #3A3D41;
    --button_bg_disabled: #212121;

    
    
    --accent_bg_start: rgba(244, 143, 177, 0.3);
    --accent_bg_end: rgba(244, 143, 177, 0.1);

    --bg_dock: #252525;
    --bg_hover: #3A3D41;

    
    --ico: var(--text);
    --ico_selected: #212121;

}