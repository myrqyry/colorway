@OBSThemeMeta {
    name: 'Cobalt2';
    id: 'com.myrqyry.Colorway.Cobalt2';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #193549;
    --bg_base: #193549;
    --bg_preview: #30495b;
    --bg_dock: #183245;
    --bg_hover: #3a5263;
    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #0088ff;
    --text_disabled: #0074d9;
    --text_inactive: #0074d9;
    --text_inverse: #FFFFFF;
    --primary: #0088ff;
    --primary_light: #ff9d00;
    --primary_lighter: #2affdf;
    --primary_dark: #9eff80;
    --primary_darker: #0088ff;
    --input_bg: #30495b;
    --input_bg_hover: #3a5263;
    --input_bg_focus: #3a5263;
    --input_border: #2b4558;
    --input_border_hover: #0088ff;
    --button_bg: #183245;
    --button_bg_hover: #3a5263;
    --button_bg_disabled: #193549;
    --list_item_bg_hover: #3a5263;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #2b4558;
    --accent_bg_start: rgba(0, 136, 255, 0.3);
    --accent_bg_end: rgba(0, 136, 255, 0.1);
    --warning: #ffc600;
    --danger: #ff0088;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #ffffff;
    --ico_selected: #193549;
}
