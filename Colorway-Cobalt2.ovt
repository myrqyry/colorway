@OBSThemeMeta {
    name: 'Cobalt2';
    id: 'com.myrqyry.Colorway.Cobalt2';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(0, 136, 255, 0.3);
    --accent_bg_end: rgba(0, 136, 255, 0.1);

    /* Base Theme Colors */
    --bg_window: #193549;
    --bg_base: #193549;
    --bg_preview: #30495b;

    --primary: #0088ff;
    --primary_light: #ff9d00;
    --primary_lighter: #2affdf;
    --primary_dark: #9eff80;
    --primary_darker: #0088ff;

    --warning: #ffc600;
    --danger: #ff0088;

    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #0088ff;

    --text_disabled: #0074d9;
    --text_inactive: #0074d9;
    --text_inverse: #FFFFFF;

    --border_color: #2b4558;

    /* Inputs and Buttons */
    --input_bg: #30495b;
    --input_bg_hover: #3a5263;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3a5263;

    --input_border: #2b4558;
    --input_border_hover: #0088ff;

    --button_bg: #183245;
    --button_bg_hover: #3a5263;
    --button_bg_disabled: #193549;

    /* Theme Aliases */
    --bg_dock: #183245;
    --bg_hover: #3a5263;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #193549;
}
