@OBSThemeMeta {
    name: 'Aura';
    id: 'com.myrqyry.Colorway.Aura';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(162, 119, 255, 0.3);
    --accent_bg_end: rgba(162, 119, 255, 0.1);

    /* Base Theme Colors */
    --bg_window: #15141b;
    --bg_base: #15141b;
    --bg_preview: #2c2c32;

    --primary: #a277ff;
    --primary_light: #82e2ff;
    --primary_lighter: #ff6767;
    --primary_dark: #61ffca;
    --primary_darker: #6d6a7e;

    --warning: #ffca85;
    --danger: #ff6767;

    --text: #edecee;
    --text_light: #ffffff;
    --text_muted: #6d6a7e;

    --text_disabled: #5d5a6b;
    --text_inactive: #5d5a6b;
    --text_inverse: #FFFFFF;

    --border_color: #28272d;

    /* Inputs and Buttons */
    --input_bg: #2c2c32;
    --input_bg_hover: #37373c;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #37373c;

    --input_border: #28272d;
    --input_border_hover: #a277ff;

    --button_bg: #14131a;
    --button_bg_hover: #37373c;
    --button_bg_disabled: #15141b;

    /* Theme Aliases */
    --bg_dock: #14131a;
    --bg_hover: #37373c;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #15141b;
}
