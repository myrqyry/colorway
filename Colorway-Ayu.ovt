@OBSThemeMeta {
    name: 'Ayu';
    id: 'com.myrqyry.Colorway.Ayu';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #0f1419;
    --bg_base: #0f1419;
    --bg_preview: #272c30;
    --bg_dock: #0e1318;
    --bg_hover: #32373a;
    --text: #d6dae0;
    --text_light: #ffffff;
    --text_muted: #5a6673;
    --text_disabled: #4d5762;
    --text_inactive: #4d5762;
    --text_inverse: #FFFFFF;
    --primary: #3fb7e3;
    --primary_light: #66c6f1;
    --primary_lighter: #f2856f;
    --primary_dark: #78d05c;
    --primary_darker: #5a6673;
    --input_bg: #272c30;
    --input_bg_hover: #32373a;
    --input_bg_focus: #32373a;
    --input_border: #22272b;
    --input_border_hover: #3fb7e3;
    --button_bg: #0e1318;
    --button_bg_hover: #32373a;
    --button_bg_disabled: #0f1419;
    --list_item_bg_hover: #32373a;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #22272b;
    --accent_bg_start: rgba(63, 183, 227, 0.3);
    --accent_bg_end: rgba(63, 183, 227, 0.1);
    --warning: #e4a75c;
    --danger: #f58572;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #d6dae0;
    --ico_selected: #0f1419;
}
