@OBSThemeMeta {
    name: 'Catppuccin Mocha — Pink';
    id: 'com.myrqyry.Colorway.CatppuccinMocha.Pink';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #181825;
    --bg_base: #1e1e2e;
    --bg_preview: #11111b;
    --primary: #f5c2e7;
    --primary_light: #f5e0dc;
    --primary_lighter: #f2cdcd;
    --primary_dark: #cba6f7;
    --primary_darker: #585b70;
    --warning: #fab387;
    --danger: #f38ba8;
    --text: #cdd6f4;
    --text_light: #f5f5f5;
    --text_muted: #7f849c;
    --text_disabled: #a6adc8;
    --text_inactive: #a6adc8;
    --border_color: #313244;
    --input_bg: #313244;
    --input_bg_hover: #45475a;
    --input_bg_focus: #383652;
    --list_item_bg_hover: #3a3955;
    --input_border: #484A64;
    --input_border_hover: #585b70;
    --button_bg: #181825;
    --button_bg_hover: #313244;
    --button_bg_disabled: #1e1e2e;
    --bg_dock: #181825;
    --bg_hover: #313244;
    --ico: var(--text);
    --ico_selected: #1e1e2e;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(245, 194, 231, 0.3);
    --accent_bg_end: rgba(245, 194, 231, 0.1);
}
