@OBSThemeMeta {
    name: 'matchalk';
    id: 'com.myrqyry.Colorway.matchalk';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(210, 180, 140, 0.3);
    --accent_bg_end: rgba(210, 180, 140, 0.1);

    --bg_window: #273136;
    --bg_base: #273136;
    --bg_preview: #1c2427;

    --primary: #d2b48c;
    --primary_light: #7eb08a;
    --primary_lighter: #D1DED3;
    --primary_dark: #7ea4b0;
    --primary_darker: #304e37;

    --warning: #ba8eaf;
    --danger: #ff819f;

    --text: #D1DED3;
    --text_light: #FFFFFF;
    --text_muted: #7ea4b0;

    --text_disabled: #304e37;
    --text_inactive: #304e37;

    --border_color: #323e45;

    --input_bg: #323e45;
    --input_bg_hover: #323e45;
    --input_bg_focus: #3c4951;

    --list_item_bg_hover: #3c4951;

    --input_border: #323e45;
    --input_border_hover: #d2b48c;

    --button_bg: #d2b48c;
    --button_bg_hover: #d2b48c;
    --button_bg_disabled: #273136;

    --bg_dock: #1c2427;
    --bg_hover: #323e45;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #273136;
}
