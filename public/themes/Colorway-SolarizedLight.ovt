@OBSThemeMeta {
    name: 'Solarized Light+';
    id: 'com.myrqyry.Colorway.SolarizedLight';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference (source values; live accessibility overrides below may differ): Solarized Light+
       Hex colors:
       --bg_window: #fdf6e3;
       --bg_base: #fdf6e3;
       --bg_preview: #eee8d5;
       --bg_dock: #eee8d5;
       --bg_hover: #e0d9c6;
       --text: #000000;
       --text_light: #002b36;
       --text_muted: #93a1a1;
       --text_inactive: #c6c6b4;
       --text_inverse: #000000;
       --text_disabled: #c6c6b4;
       --primary: #268bd2;
       --primary_light: #2aa198;
       --primary_lighter: #5cb8b3;
       --primary_dark: #1a6d9e;
       --primary_darker: #586e75;
       --input_bg: #eee8d5;
       --input_bg_hover: #e0d9c6;
       --input_bg_focus: #e0d9c6;
       --input_border: #d6cfc1;
       --input_border_hover: #839496;
       --button_bg: #eee8d5;
       --button_bg_hover: #e0d9c6;
       --button_bg_disabled: #fdf6e3;
       --list_item_bg_hover: #e0d9c6;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #d6cfc1;
       --ico: #000000;
       --ico_selected: #fdf6e3;
       --warning: #b58900;
       --danger: #dc322f;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(38, 139, 210, 0.3);
       --accent_bg_end: rgba(38, 139, 210, 0.1);
    */

    --accent_bg_start: 'rgba(38, 139, 210, 0.3)';
    --accent_bg_end: 'rgba(38, 139, 210, 0.1)';

    --bg_window: #fdf6e3;
    --bg_base: #fdf6e3;
    --bg_preview: #eee8d5;

    --primary: #268bd2;
    --primary_light: #2aa198;
    --primary_lighter: #5cb8b3;
    --primary_dark: #1a6d9e;
    --primary_darker: #586e75;

    --warning: #745800;
    --danger: #dc322f;
    --success: #4b5f00;
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/selected/check.svg)';

    --text: #000000;
    --text_light: #002b36;
    --text_muted: #93a1a1;

    --text_disabled: #c6c6b4;
    --text_inactive: #c6c6b4;

    --border_color: #d6cfc1;

    --input_bg: #eee8d5;
    --input_bg_hover: #e0d9c6;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #e0d9c6;

    --input_border: #d6cfc1;
    --input_border_hover: #839496;

    --button_bg: #eee8d5;
    --button_bg_hover: #e0d9c6;
    --button_bg_disabled: #fdf6e3;

    
    --text_inverse: #000000;

    --bg_dock: #eee8d5;
    --bg_hover: #e0d9c6;

    
    --ico: var(--text);
    --ico_selected: #fdf6e3;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_primary_dark: var(--bg_base);
    --cw_icon_arrow_down_base: 'url(theme:icons/colorway/mingcute/selected/arrow-down.svg)';
    --cw_icon_arrow_up_base: 'url(theme:icons/colorway/mingcute/selected/arrow-up.svg)';
    --cw_icon_audio_base: 'url(theme:icons/colorway/mingcute/selected/audio.svg)';
    --cw_icon_brush_base: 'url(theme:icons/colorway/mingcute/selected/brush.svg)';
    --cw_icon_check_base: 'url(theme:icons/colorway/mingcute/selected/check.svg)';
    --cw_icon_checkbox_fill_base: 'url(theme:icons/colorway/mingcute/selected/checkbox_fill.svg)';
    --cw_icon_checkbox_line_base: 'url(theme:icons/colorway/mingcute/selected/checkbox_line.svg)';
    --cw_icon_chevron_down_base: 'url(theme:icons/colorway/mingcute/selected/chevron-down.svg)';
    --cw_icon_chevron_right_base: 'url(theme:icons/colorway/mingcute/selected/chevron-right.svg)';
    --cw_icon_chevron_up_base: 'url(theme:icons/colorway/mingcute/selected/chevron-up.svg)';
    --cw_icon_close_base: 'url(theme:icons/colorway/mingcute/selected/close.svg)';
    --cw_icon_cogs_base: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_default_base: 'url(theme:icons/colorway/mingcute/selected/default.svg)';
    --cw_icon_display_base: 'url(theme:icons/colorway/mingcute/selected/display.svg)';
    --cw_icon_dots_vert_base: 'url(theme:icons/colorway/mingcute/selected/dots-vert.svg)';
    --cw_icon_eye_off_base: 'url(theme:icons/colorway/mingcute/selected/eye-off.svg)';
    --cw_icon_eye_base: 'url(theme:icons/colorway/mingcute/selected/eye.svg)';
    --cw_icon_filter_base: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_icon_gamepad_base: 'url(theme:icons/colorway/mingcute/selected/gamepad.svg)';
    --cw_icon_globe_base: 'url(theme:icons/colorway/mingcute/selected/globe.svg)';
    --cw_icon_group_base: 'url(theme:icons/colorway/mingcute/selected/group.svg)';
    --cw_icon_image_base: 'url(theme:icons/colorway/mingcute/selected/image.svg)';
    --cw_icon_interact_base: 'url(theme:icons/colorway/mingcute/selected/interact.svg)';
    --cw_icon_layout_horizontal_base: 'url(theme:icons/colorway/mingcute/selected/layout-horizontal.svg)';
    --cw_icon_layout_vertical_base: 'url(theme:icons/colorway/mingcute/selected/layout-vertical.svg)';
    --cw_icon_lock_base: 'url(theme:icons/colorway/mingcute/selected/lock.svg)';
    --cw_icon_media_play_base: 'url(theme:icons/colorway/mingcute/selected/media-play.svg)';
    --cw_icon_media_stop_base: 'url(theme:icons/colorway/mingcute/selected/media-stop.svg)';
    --cw_icon_microphone_base: 'url(theme:icons/colorway/mingcute/selected/microphone.svg)';
    --cw_icon_minus_base: 'url(theme:icons/colorway/mingcute/selected/minus.svg)';
    --cw_icon_output_base: 'url(theme:icons/colorway/mingcute/selected/output.svg)';
    --cw_icon_pause_base: 'url(theme:icons/colorway/mingcute/selected/pause.svg)';
    --cw_icon_pin_base: 'url(theme:icons/colorway/mingcute/selected/pin.svg)';
    --cw_icon_plus_base: 'url(theme:icons/colorway/mingcute/selected/plus.svg)';
    --cw_icon_popout_base: 'url(theme:icons/colorway/mingcute/selected/popout.svg)';
    --cw_icon_refresh_base: 'url(theme:icons/colorway/mingcute/selected/refresh.svg)';
    --cw_icon_revert_base: 'url(theme:icons/colorway/mingcute/selected/revert.svg)';
    --cw_icon_save_base: 'url(theme:icons/colorway/mingcute/selected/save.svg)';
    --cw_icon_scene_base: 'url(theme:icons/colorway/mingcute/selected/scene.svg)';
    --cw_icon_settings_base: 'url(theme:icons/colorway/mingcute/selected/settings.svg)';
    --cw_icon_slideshow_base: 'url(theme:icons/colorway/mingcute/selected/slideshow.svg)';
    --cw_icon_skip_forward_base: 'url(theme:icons/colorway/mingcute/selected/skip_forward.svg)';
    --cw_icon_skip_previous_base: 'url(theme:icons/colorway/mingcute/selected/skip_previous.svg)';
    --cw_icon_text_base: 'url(theme:icons/colorway/mingcute/selected/text.svg)';
    --cw_icon_trash_base: 'url(theme:icons/colorway/mingcute/selected/trash.svg)';
    --cw_icon_unlock_base: 'url(theme:icons/colorway/mingcute/selected/unlock.svg)';
    --cw_icon_video_base: 'url(theme:icons/colorway/mingcute/selected/video.svg)';
    --cw_icon_volume_high_base: 'url(theme:icons/colorway/mingcute/selected/volume-high.svg)';
    --cw_icon_volume_mute_base: 'url(theme:icons/colorway/mingcute/selected/volume-mute.svg)';
    --cw_icon_window_base: 'url(theme:icons/colorway/mingcute/selected/window.svg)';
    --cw_icon_download_base: 'url(theme:icons/colorway/mingcute/selected/download.svg)';
    /* colorway:state-tokens:end */

}
