@OBSThemeMeta {
    name: 'Kick Dark';
    id: 'com.myrqyry.Colorway.KickDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Kick Dark
       Hex colors:
       --bg_window: #0e1113;
       --bg_base: #0e1113;
       --bg_preview: #191b1f;
       --bg_dock: #14171a;
       --bg_hover: #26233a;
       --text: #e1e7e9;
       --text_light: #ffffff;
       --text_muted: #78868c;
       --text_inactive: #4e5558;
       --text_inverse: #000000;
       --text_disabled: #4e5558;
       --primary: #53fc18;
       --primary_light: #80ff52;
       --primary_lighter: #dcfcd4;
       --primary_dark: #3cbd0a;
       --primary_darker: #237703;
       --input_bg: #191b1f;
       --input_bg_hover: #191b1f;
       --input_bg_focus: #262c33;
       --input_border: #191b1f;
       --input_border_hover: #53fc18;
       --button_bg: #191b1f;
       --button_bg_hover: #53fc18;
       --button_bg_disabled: #0e1113;
       --list_item_bg_hover: #0e1113;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #191b1f;
       --warning: #ffb000;
       --danger: #fb4d5d;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(83, 252, 24, 0.3);
       --accent_bg_end: rgba(83, 252, 24, 0.1);
    */
    --bg_window: #0e1113;
    --bg_base: #0e1113;
    --bg_preview: #191b1f;
    --bg_dock: #14171a;

    /* Primary Accent (Vibrant Kick Lime-Green) */
    --primary: #53fc18;
    --primary_light: #80ff52;
    --primary_lighter: #dcfcd4;
    --primary_dark: #3cbd0a;
    --primary_darker: #237703;

    --warning: #ffb000;
    --danger: #fb4d5d;

    /* Text Colors */
    --text: #e1e7e9;
    --text_light: #ffffff;
    --text_muted: #78868c;
    --text_disabled: #4e5558;
    --text_inactive: #4e5558;

    /* Borders & Spacing */
    --border_color: #191b1f;

    /* Input & Button Layouts */
    --input_bg: #191b1f;
    --input_bg_hover: #191b1f;
    --input_bg_focus: #262c33;
    --list_item_bg_hover: #0e1113;
    --input_border: #191b1f;
    --input_border_hover: #53fc18;

    --button_bg: #191b1f;
    --button_bg_hover: #53fc18;
    --button_bg_disabled: #0e1113;

    /* Replay/VirtualCam active state overlays */
    --accent_bg_start: rgba(83, 252, 24, 0.3);
    --accent_bg_end: rgba(83, 252, 24, 0.1);

    /* Dark text contrast for bright green elements */
    --text_inverse: #000000;
}