@OBSThemeMeta {
    name: 'Miku Better';
    id: 'com.myrqyry.Colorway.MikuBetter';
    extends: 'com.myrqyry.Colorway.HatsuneMiku';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Miku Better
       Hex colors:
       --bg_window: #1A1F24;
       --bg_base: #1A1F24;
       --bg_preview: #23282D;
       --bg_dock: #23282D;
       --bg_hover: #2A3035;
       --text: #DEE8F2;
       --text_light: #DEE8F2;
       --text_muted: #89A0A1;
       --text_inactive: #6A7D84;
       --text_inverse: #000000;
       --text_disabled: #6A7D84;
       --primary: #39C5BB;
       --primary_light: #95DFDB;
       --primary_lighter: #DEE8F2;
       --primary_dark: #2EA69B;
       --primary_darker: #1A6B64;
       --input_bg: #23282D;
       --input_bg_hover: #2A3035;
       --input_bg_focus: #2A3035;
       --input_border: #39C5BB60;
       --input_border_hover: #39C5BB;
       --button_bg: #278982;
       --button_bg_hover: #2EA69B;
       --button_bg_disabled: #1A1F24;
       --list_item_bg_hover: #39C5BB40;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #39C5BB40;
       --ico: #DEE8F2;
       --ico_selected: #1A1F24;
       --warning: #F0CD7B;
       --danger: #FF8FEF;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(57, 197, 187, 0.3);
       --accent_bg_end: rgba(57, 197, 187, 0.1);
    */

    --accent_bg_start: 'rgba(57, 197, 187, 0.3)';
    --accent_bg_end: 'rgba(57, 197, 187, 0.1)';

    --bg_window: #1A1F24;
    --bg_base: #1A1F24;
    --bg_preview: #23282D;

    --primary: #39C5BB;
    --primary_light: #95DFDB;
    --primary_lighter: #DEE8F2;
    --primary_dark: #2EA69B;
    --primary_darker: #1A6B64;

    --warning: #F0CD7B;
    --danger: #FF8FEF;

    --text: #DEE8F2;
    --text_light: #DEE8F2;
    --text_muted: #89A0A1;

    --text_disabled: #6A7D84;
    --text_inactive: #6A7D84;
    --text_inverse: #000000;

    --border_color: #39C5BB40;

    --input_bg: #23282D;
    --input_bg_hover: #2A3035;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #39C5BB40;

    --input_border: #39C5BB60;
    --input_border_hover: #39C5BB;

    --button_bg: #278982;
    --button_bg_hover: #2EA69B;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #1A1F24;

    --bg_dock: #23282D;
    --bg_hover: #2A3035;

    
    --ico: var(--text);
    --ico_selected: #1A1F24;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #DEE8F2;
    --on_panel_muted: #89A0A1;
    --on_base_muted: #89A0A1;
    --on_preview_muted: #89A0A1;
    --on_preview: #DEE8F2;
    --on_list_hover: #DEE8F2;
    --on_hover: #DEE8F2;
    --on_panel_disabled: #6A7D84;
    --on_base_disabled: #6A7D84;
    --on_panel_outline: #587677;
    --on_section_heading: #39C5BB;
    --on_panel_accent: #39C5BB;
    --on_button: #101011;
    --on_button_disabled: #6A7D84;
    --on_input: #DEE8F2;
    --on_input_hover: #DEE8F2;
    --on_input_focus: #DEE8F2;
    --on_nav_hover: #DEE8F2;
    /* colorway:state-tokens:end */

}
