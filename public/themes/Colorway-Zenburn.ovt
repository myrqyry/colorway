@OBSThemeMeta {
    name: 'Zenburn';
    id: 'com.myrqyry.Colorway.Zenburn';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(140, 208, 211, 0.3);
    --accent_bg_end: rgba(140, 208, 211, 0.1);

    /* Base Theme Colors */
    --bg_window: #3f3f3f;
    --bg_base: #3f3f3f;
    --bg_preview: #525252;

    --primary: #8cd0d3;
    --primary_light: #dfaf8f;
    --primary_lighter: #93e0e3;
    --primary_dark: #7f9f7f;
    --primary_darker: #7f9f7f;

    --warning: #f0dfaf;
    --danger: #cc9393;

    --text: #dcdccc;
    --text_light: #ffffff;
    --text_muted: #7f9f7f;

    --text_disabled: #6c876c;
    --text_inactive: #6c876c;

    --border_color: #4e4e4e;

    /* Inputs and Buttons */
    --input_bg: #525252;
    --input_bg_hover: #5b5b5b;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #5b5b5b;

    --input_border: #4e4e4e;
    --input_border_hover: #8cd0d3;

    --button_bg: #3c3c3c;
    --button_bg_hover: #5b5b5b;
    --button_bg_disabled: #3f3f3f;

    /* Theme Aliases */
    --bg_dock: #3c3c3c;
    --bg_hover: #5b5b5b;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #3f3f3f;
}
