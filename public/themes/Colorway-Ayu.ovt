@OBSThemeMeta {
    name: 'Ayu';
    id: 'com.myrqyry.Colorway.Ayu';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(63, 183, 227, 0.3);
    --accent_bg_end: rgba(63, 183, 227, 0.1);

    /* Base Theme Colors */
    --bg_window: #0f1419;
    --bg_base: #0f1419;
    --bg_preview: #272c30;

    --primary: #3fb7e3;
    --primary_light: #66c6f1;
    --primary_lighter: #f2856f;
    --primary_dark: #78d05c;
    --primary_darker: #5a6673;

    --warning: #e4a75c;
    --danger: #f58572;

    --text: #d6dae0;
    --text_light: #ffffff;
    --text_muted: #5a6673;

    --text_disabled: #4d5762;
    --text_inactive: #4d5762;

    --border_color: #22272b;

    /* Inputs and Buttons */
    --input_bg: #272c30;
    --input_bg_hover: #32373a;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #32373a;

    --input_border: #22272b;
    --input_border_hover: #3fb7e3;

    --button_bg: #0e1318;
    --button_bg_hover: #32373a;
    --button_bg_disabled: #0f1419;

    /* Theme Aliases */
    --bg_dock: #0e1318;
    --bg_hover: #32373a;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #0f1419;
}
