@OBSThemeMeta {
    name: 'Night Owl';
    id: 'com.myrqyry.Colorway.Nightowl';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(130, 170, 255, 0.3);
    --accent_bg_end: rgba(130, 170, 255, 0.1);

    /* Base Theme Colors */
    --bg_window: #011627;
    --bg_base: #011627;
    --bg_preview: #1a2d3d;

    --primary: #82aaff;
    --primary_light: #82aaff;
    --primary_lighter: #f78c6c;
    --primary_dark: #c5e478;
    --primary_darker: #637777;

    --warning: #ecc48d;
    --danger: #ef5350;

    --text: #d6deeb;
    --text_light: #ffffff;
    --text_muted: #637777;

    --text_disabled: #546565;
    --text_inactive: #546565;

    --border_color: #152938;

    /* Inputs and Buttons */
    --input_bg: #1a2d3d;
    --input_bg_hover: #253847;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #253847;

    --input_border: #152938;
    --input_border_hover: #82aaff;

    --button_bg: #011525;
    --button_bg_hover: #253847;
    --button_bg_disabled: #011627;

    /* Theme Aliases */
    --bg_dock: #011525;
    --bg_hover: #253847;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #011627;
}
