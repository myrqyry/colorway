@OBSThemeMeta {
    name: 'Everforest Dark Hard';
    id: 'com.myrqyry.Colorway.Everforest.Hard';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Everforest Dark Hard
       Hex colors:
       --bg_window: #272E33;
       --bg_base: #272E33;
       --bg_preview: #1E2326;
       --bg_dock: #2E383C;
       --bg_hover: #374145;
       --text: #D3C6AA;
       --text_light: #FFFFFF;
       --text_muted: #9DA9A0;
       --text_inactive: #7A8478;
       --text_inverse: #FFFFFF;
       --text_disabled: #7A8478;
       --primary: #A7C080;
       --primary_light: #D3C6AA;
       --primary_lighter: #E6E2CC;
       --primary_dark: #8DA468;
       --primary_darker: #4A5B48;
       --input_bg: #2E383C;
       --input_bg_hover: #374145;
       --input_bg_focus: #374145;
       --input_border: #374145;
       --input_border_hover: #859289;
       --button_bg: #2E383C;
       --button_bg_hover: #374145;
       --button_bg_disabled: #272E33;
       --list_item_bg_hover: #374145;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #374145;
       --ico: #D3C6AA;
       --ico_selected: #272E33;
       --warning: #DBBC7F;
       --danger: #E67E80;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(167, 192, 128, 0.3);
       --accent_bg_end: rgba(167, 192, 128, 0.1);
    */
    --accent_bg_start: rgba(167, 192, 128, 0.3);
    --accent_bg_end: rgba(167, 192, 128, 0.1);

    --bg_window: #272E33;
    --bg_base: #272E33;
    --bg_preview: #1E2326;

    --primary: #A7C080;
    --primary_light: #D3C6AA;
    --primary_lighter: #E6E2CC;
    --primary_dark: #8DA468;
    --primary_darker: #4A5B48;

    --warning: #DBBC7F;
    --danger: #E67E80;

    --text: #D3C6AA;
    --text_light: #FFFFFF;
    --text_muted: #9DA9A0;

    --text_disabled: #7A8478;
    --text_inactive: #7A8478;
    --text_inverse: #FFFFFF;

    --border_color: #374145;

    --input_bg: #2E383C;
    --input_bg_hover: #374145;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #374145;

    --input_border: #374145;
    --input_border_hover: #859289;

    --button_bg: #2E383C;
    --button_bg_hover: #374145;
    --button_bg_disabled: #272E33;

    --bg_dock: #2E383C;
    --bg_hover: #374145;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #272E33;
}
