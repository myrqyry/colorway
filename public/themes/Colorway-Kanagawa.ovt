@OBSThemeMeta {
    name: 'Kanagawa';
    id: 'com.myrqyry.Colorway.Kanagawa';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Kanagawa
       Hex colors:
       --bg_window: #1F1F28;
       --bg_base: #1F1F28;
       --bg_preview: #35353e;
       --bg_dock: #1d1d26;
       --bg_hover: #3f3f48;
       --text: #DCD7BA;
       --text_light: #ffffff;
       --text_muted: #727169;
       --text_inactive: #616059;
       --text_inverse: #FFFFFF;
       --text_disabled: #616059;
       --primary: #7E9CD8;
       --primary_light: #76946A;
       --primary_lighter: #D27E99;
       --primary_dark: #98BB6C;
       --primary_darker: #727169;
       --input_bg: #35353e;
       --input_bg_hover: #3f3f48;
       --input_bg_focus: #3f3f48;
       --input_border: #313139;
       --input_border_hover: #7E9CD8;
       --button_bg: #1d1d26;
       --button_bg_hover: #3f3f48;
       --button_bg_disabled: #1F1F28;
       --list_item_bg_hover: #3f3f48;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #313139;
       --ico: #DCD7BA;
       --ico_selected: #1F1F28;
       --warning: #D7A657;
       --danger: #E82424;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(126, 156, 216, 0.3);
       --accent_bg_end: rgba(126, 156, 216, 0.1);
    */

    --accent_bg_start: 'rgba(126, 156, 216, 0.3)';
    --accent_bg_end: 'rgba(126, 156, 216, 0.1)';

    
    --bg_window: #1F1F28;
    --bg_base: #1F1F28;
    --bg_preview: #35353e;

    --primary: #7E9CD8;
    --primary_light: #76946A;
    --primary_lighter: #D27E99;
    --primary_dark: #98BB6C;
    --primary_darker: #727169;

    --warning: #D7A657;
    --danger: #E82424;

    --text: #DCD7BA;
    --text_light: #ffffff;
    --text_muted: #727169;

    --text_disabled: #616059;
    --text_inactive: #616059;
    --text_inverse: #FFFFFF;

    --border_color: #313139;

    
    --input_bg: #35353e;
    --input_bg_hover: #3f3f48;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3f3f48;

    --input_border: #313139;
    --input_border_hover: #7E9CD8;

    --button_bg: #1d1d26;
    --button_bg_hover: #3f3f48;
    --button_bg_disabled: #1F1F28;

    
    --bg_dock: #1d1d26;
    --bg_hover: #3f3f48;

    
    --ico: var(--text);
    --ico_selected: #1F1F28;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #DCD7BA;
    --on_panel_muted: #85857e;
    --on_base_muted: #878780;
    --on_preview_muted: #9e9e98;
    --on_panel_disabled: #696962;
    --on_base_disabled: #6b6a63;
    --on_panel_outline: #68686d;
    --on_section_heading: #7E9CD8;
    --on_panel_accent: #7E9CD8;
    --on_button: #DCD7BA;
    --on_button_disabled: #6b6a63;
    --on_input: #DCD7BA;
    --on_input_hover: #DCD7BA;
    --on_input_focus: #DCD7BA;
    --on_mixer_muted: #E82424;
    --on_mixer_warning: #D7A657;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-e82424.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-d7a657.svg)';
    /* colorway:state-tokens:end */

}
