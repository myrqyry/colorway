@OBSThemeMeta {
    name: 'Kanagawa';
    id: 'com.myrqyry.Colorway.Kanagawa';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(126, 156, 216, 0.3);
    --accent_bg_end: rgba(126, 156, 216, 0.1);

    /* Base Theme Colors */
    --bg_window: #1F1F28;
    --bg_base: #1F1F28;
    --bg_preview: #35353e;

    --primary: #7E9CD8;
    --primary_light: #76946A;
    --primary_lighter: #D27E99;
    --primary_dark: #98BB6C;
    --primary_darker: #727169;

    --warning: #D7A657;
    --danger: #E82424;

    --text: #DCD7BA;
    --text_light: #ffffff;
    --text_muted: #727169;

    --text_disabled: #616059;
    --text_inactive: #616059;

    --border_color: #313139;

    /* Inputs and Buttons */
    --input_bg: #35353e;
    --input_bg_hover: #3f3f48;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3f3f48;

    --input_border: #313139;
    --input_border_hover: #7E9CD8;

    --button_bg: #1d1d26;
    --button_bg_hover: #3f3f48;
    --button_bg_disabled: #1F1F28;

    /* Theme Aliases */
    --bg_dock: #1d1d26;
    --bg_hover: #3f3f48;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #1F1F28;
}
