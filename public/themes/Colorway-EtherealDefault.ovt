@OBSThemeMeta {
    name: 'Ethereal Default';
    id: 'com.myrqyry.Colorway.EtherealDefault';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Ethereal Default
       Hex colors:
       --bg_window: #07080c;
       --bg_base: #07080c;
       --bg_preview: #030406;
       --bg_dock: #0d1017;
       --bg_hover: #141922;
       --text: #e2f1ff;
       --text_light: #ffffff;
       --text_muted: #8aa2b8;
       --text_inactive: #3a4a5a;
       --text_inverse: #FFFFFF;
       --text_disabled: #3a4a5a;
       --primary: #9cd2ff;
       --primary_light: #e2f1ff;
       --primary_lighter: #f8fbff;
       --primary_dark: #6baadd;
       --primary_darker: #4a8ab8;
       --input_bg: #0d1017;
       --input_bg_hover: #141922;
       --input_bg_focus: #141922;
       --input_border: #1a1f2a;
       --input_border_hover: #8aa2b8;
       --button_bg: #0d1017;
       --button_bg_hover: #141922;
       --button_bg_disabled: #07080c;
       --list_item_bg_hover: #141922;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1a1f2a;
       --ico: #e2f1ff;
       --ico_selected: #07080c;
       --warning: #ffd166;
       --danger: #ff6b6b;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(156, 210, 255, 0.3);
       --accent_bg_end: rgba(156, 210, 255, 0.1);
    */

    --accent_bg_start: 'rgba(156, 210, 255, 0.3)';
    --accent_bg_end: 'rgba(156, 210, 255, 0.1)';

    --bg_window: #07080c;
    --bg_base: #07080c;
    --bg_preview: #030406;

    --primary: #9cd2ff;
    --primary_light: #e2f1ff;
    --primary_lighter: #f8fbff;
    --primary_dark: #6baadd;
    --primary_darker: #4a8ab8;

    --warning: #ffd166;
    --danger: #ff6b6b;

    --text: #e2f1ff;
    --text_light: #ffffff;
    --text_muted: #8aa2b8;

    --text_disabled: #3a4a5a;
    --text_inactive: #3a4a5a;
    --text_inverse: #FFFFFF;

    --border_color: #1a1f2a;

    --input_bg: #0d1017;
    --input_bg_hover: #141922;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #141922;

    --input_border: #1a1f2a;
    --input_border_hover: #8aa2b8;

    --button_bg: #0d1017;
    --button_bg_hover: #141922;
    --button_bg_disabled: #07080c;

    --bg_dock: #0d1017;
    --bg_hover: #141922;

    
    --ico: var(--text);
    --ico_selected: #07080c;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #e2f1ff;
    --on_panel_muted: #8aa2b8;
    --on_base_muted: #8aa2b8;
    --on_preview_muted: #8aa2b8;
    --on_panel_disabled: #54616f;
    --on_base_disabled: #4f5e6c;
    --on_panel_outline: #5c6067;
    --on_section_heading: #9cd2ff;
    --on_panel_accent: #9cd2ff;
    --on_button: #e2f1ff;
    --on_button_disabled: #4f5e6c;
    --on_input: #e2f1ff;
    --on_input_hover: #e2f1ff;
    --on_input_focus: #e2f1ff;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    /* colorway:state-tokens:end */

}
