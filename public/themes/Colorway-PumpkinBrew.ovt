@OBSThemeMeta {
    name: 'Pumpkin Brew';
    id: 'com.myrqyry.Colorway.PumpkinBrew';
    extends: 'com.myrqyry.Colorway';
    author: 'g0nebatty / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Pumpkin Brew
       Hex colors:
       --bg_window: #2a1838;
       --bg_base: #2a1838;
       --bg_preview: #7a5aa8;
       --bg_dock: #6e2c1c;
       --bg_hover: #7a5aa8;
       --text: #f4ecff;
       --text_light: #f4ecff;
       --text_muted: #f8bc74;
       --text_inactive: #a884d0;
       --text_inverse: #2a1838;
       --text_disabled: #7a5aa8;
       --primary: #ee9048;
       --primary_light: #f8bc74;
       --primary_lighter: #f4ecff;
       --primary_dark: #c8622e;
       --primary_darker: #6e2c1c;
       --input_bg: #6e2c1c;
       --input_bg_hover: #6e2c1c;
       --input_bg_focus: #7a5aa8;
       --input_border: #7a5aa8;
       --input_border_hover: #ee9048;
       --button_bg: #6e2c1c;
       --button_bg_hover: #ee9048;
       --button_bg_disabled: #6e2c1c;
       --list_item_bg_hover: #6e2c1c;
       --list_item_bg_selected: #7a5aa8;
       --border_color: #7a5aa8;
       --ico: #f4ecff;
       --ico_selected: #2a1838;
       --warning: #f8bc74;
       --danger: #ee9048;
       --success: #b1dbaa;
       --meter_bg_nom: #6e2c1c;
       --meter_bg_war: #c8622e;
       --meter_bg_err: #6e2c1c;
       --meter_fg_nom: #b1dbaa;
       --meter_fg_war: #f8bc74;
       --meter_fg_err: #ee9048;
       Derived colors:
       --accent_bg_start: rgba(238, 144, 72, 0.3);
       --accent_bg_end: rgba(238, 144, 72, 0.1);
    */

    /* Lospec palette: Pumpkin Brew — g0nebatty
       Source: https://lospec.com/palette-list/pumpkin-brew
       Colors mapped to OBS roles; derived alert colors are explicitly
       distinct from the original limited source palette. */

    --bg_window: #2a1838;
    --bg_base: #2a1838;
    --bg_preview: #7a5aa8;
    --bg_dock: #6e2c1c;
    --bg_hover: #7a5aa8;
    --text: #f4ecff;
    --text_light: #f4ecff;
    --text_muted: #f8bc74;
    --text_inactive: #a884d0;
    --text_disabled: #7a5aa8;
    --text_inverse: #2a1838;
    --primary: #ee9048;
    --primary_light: #f8bc74;
    --primary_lighter: #f4ecff;
    --primary_dark: #c8622e;
    --primary_darker: #6e2c1c;
    --input_bg: #6e2c1c;
    --input_bg_hover: #6e2c1c;
    --input_bg_focus: #7a5aa8;
    --input_border: #7a5aa8;
    --input_border_hover: #ee9048;
    --button_bg: #6e2c1c;
    --button_bg_hover: #ee9048;
    --button_hover_text: #2a1838;
    --button_bg_disabled: #6e2c1c;
    --list_item_bg_hover: #6e2c1c;
    --list_item_bg_selected: #7a5aa8;
    --border_color: #7a5aa8;
    --warning: #f8bc74;
    --danger: #ee9048;
    --success: #b1dbaa;
    --meter_bg_nom: #6e2c1c;
    --meter_bg_war: #c8622e;
    --meter_bg_err: #6e2c1c;
    --meter_fg_nom: #b1dbaa;
    --meter_fg_war: #f8bc74;
    --meter_fg_err: #ee9048;
    --accent_bg_start: 'rgba(238, 144, 72, 0.3)';
    --accent_bg_end: 'rgba(238, 144, 72, 0.1)';
    --ico: var(--text);
    --ico_selected: var(--text_inverse);
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/normal/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #f4ecff;
    --on_panel_muted: #f8bc74;
    --on_base_muted: #f8bc74;
    --on_preview_muted: #fce7cc;
    --on_preview: #f4ecff;
    --on_list_hover: #f4ecff;
    --on_hover: #f4ecff;
    --on_panel_disabled: #9880bc;
    --on_base_disabled: #7a5ba8;
    --on_panel_outline: #9880bc;
    --on_section_heading: #ee9048;
    --on_panel_accent: #ef9753;
    --on_button: #f4ecff;
    --on_button_disabled: #9880bc;
    --on_input: #f4ecff;
    --on_input_hover: #f4ecff;
    --on_input_focus: #f4ecff;
    --on_nav_hover: #f4ecff;
    --on_mixer_muted: #ee9048;
    --on_mixer_monitor: #b1dbaa;
    --on_mixer_warning: #f8bc74;
    --on_primary_dark: #000000;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ee9048.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-b1dbaa.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-f8bc74.svg)';
    /* colorway:state-tokens:end */

}
