@OBSThemeMeta {
    name: 'Ethereal Frutiger';
    id: 'com.myrqyry.Colorway.EtherealFrutiger';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(0, 255, 170, 0.3);
    --accent_bg_end: rgba(0, 255, 170, 0.1);

    --bg_window: #08131a;
    --bg_base: #08131a;
    --bg_preview: #040a10;

    --primary: #00ffaa;
    --primary_light: #00d2ff;
    --primary_lighter: #b3fff0;
    --primary_dark: #00cc88;
    --primary_darker: #008866;

    --warning: #ffd166;
    --danger: #ff6b6b;

    --text: #d6f5ff;
    --text_light: #d6f5ff;
    --text_muted: #5aa0aa;

    --text_disabled: #1a333d;
    --text_inactive: #1a333d;

    --border_color: #0f2330;

    --input_bg: #0c1920;
    --input_bg_hover: #132430;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #132430;

    --input_border: #0f2330;
    --input_border_hover: #5aa0aa;

    --button_bg: #0c1920;
    --button_bg_hover: #132430;
    --button_bg_disabled: #08131a;

    --bg_dock: #0c1920;
    --bg_hover: #132430;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #08131a;
}
