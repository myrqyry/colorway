@OBSThemeMeta {
    name: 'NOPAL-12';
    id: 'com.myrqyry.Colorway.NOPAL12';
    extends: 'com.myrqyry.Colorway';
    author: 'BurakoIRL / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: NOPAL-12
       Hex colors:
       --bg_window: #92929c;
       --bg_base: #92929c;
       --bg_preview: #c5cfc4;
       --bg_dock: #a8b5ae;
       --bg_hover: #26233a;
       --text: #000000;
       --text_light: #ffffff;
       --text_muted: #a8b5ae;
       --text_inactive: #92929c;
       --text_inverse: #000000;
       --text_disabled: #92929c;
       --primary: #cca3a3;
       --primary_light: #f1b4b4;
       --primary_lighter: #fbd4d2;
       --primary_dark: #aba47b;
       --primary_darker: #e4dba0;
       --input_bg: #c5cfc4;
       --input_bg_hover: #c5cfc4;
       --input_bg_focus: #a8b5ae;
       --input_border: #c5cfc4;
       --input_border_hover: #cca3a3;
       --button_bg: #a8b5ae;
       --button_bg_hover: #cca3a3;
       --button_bg_disabled: #92929c;
       --list_item_bg_hover: #92929c;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #c5cfc4;
       --warning: #f1eab6;
       --danger: #cca3a3;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(204, 163, 163, 0.3);
       --accent_bg_end: rgba(204, 163, 163, 0.1);
    */

    --bg_window: #92929c;
    --bg_base: #92929c;
    --bg_preview: #c5cfc4;
    --bg_dock: #a8b5ae;

    
    --primary: #cca3a3;
    --primary_light: #f1b4b4;
    --primary_lighter: #fbd4d2;
    --primary_dark: #aba47b;
    --primary_darker: #e4dba0;

    --warning: #f1eab6;
    --danger: #cca3a3;

    
    --text: #000000;
    --text_light: #ffffff;
    --text_muted: #a8b5ae;
    --text_disabled: #92929c;
    --text_inactive: #92929c;

    
    --border_color: #c5cfc4;

    
    --input_bg: #c5cfc4;
    --input_bg_hover: #c5cfc4;
    --input_bg_focus: #a8b5ae;
    --list_item_bg_hover: #92929c;
    --input_border: #c5cfc4;
    --input_border_hover: #cca3a3;

    --button_bg: #a8b5ae;
    --button_bg_hover: #cca3a3;
    --button_bg_disabled: #92929c;

    
    --accent_bg_start: 'rgba(204, 163, 163, 0.3)';
    --accent_bg_end: 'rgba(204, 163, 163, 0.1)';

    
    --text_inverse: #000000;
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/selected/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #000000;
    --on_panel_muted: #414644;
    --on_base_muted: #2a2d2c;
    --on_preview_muted: #525855;
    --on_preview: #575757;
    --on_list_hover: #2c2c2c;
    --on_panel_disabled: #5e5e65;
    --on_base_disabled: #47474b;
    --on_panel_outline: #5c605b;
    --on_section_heading: #342a2a;
    --on_panel_accent: #524141;
    --on_button: #000000;
    --on_button_disabled: #47474b;
    --on_input: #000000;
    --on_input_hover: #000000;
    --on_input_focus: #000000;
    --on_nav_hover: #575757;
