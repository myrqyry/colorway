@OBSThemeMeta {
    name: 'Catppuccin Sibling — Lichen';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Lichen';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: olive-laced stone / muted yellow-green.
 */
@OBSThemeVars {
    /* Official palette reference: Catppuccin Sibling — Lichen
       Hex colors:
       --bg_window: #1a1a12;
       --bg_base: #212116;
       --bg_preview: #13130c;
       --bg_dock: #1a1a12;
       --bg_hover: #34352c;
       --text: #d8d8ca;
       --text_light: #f1e2dc;
       --text_muted: #86867b;
       --text_inactive: #afafa3;
       --text_inverse: #13130c;
       --text_disabled: #afafa3;
       --primary: #c5acea;
       --primary_light: #b8bff0;
       --primary_lighter: #f0c6df;
       --primary_dark: #7fbbe3;
       --primary_darker: #5d5e54;
       --input_bg: #34352c;
       --input_bg_hover: #494941;
       --input_bg_focus: #494941;
       --input_border: #494941;
       --input_border_hover: #c5acea;
       --button_bg: #1a1a12;
       --button_bg_hover: #34352c;
       --button_bg_disabled: #212116;
       --list_item_bg_hover: #34352c;
       --list_item_bg_selected: #c5acea;
       --border_color: #34352c;
       --ico: #d8d8ca;
       --ico_selected: #13130c;
       --warning: #f3e3bd;
       --danger: #e7959f;
       --success: #c6da9d;
       --meter_bg_nom: #34352c;
       --meter_bg_war: #34352c;
       --meter_bg_err: #34352c;
       --meter_fg_nom: #c6da9d;
       --meter_fg_war: #f3e3bd;
       --meter_fg_err: #e7959f;
       Derived colors:
       --accent_bg_start: rgba(197, 172, 234, 0.3);
       --accent_bg_end: rgba(197, 172, 234, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling_text: #d8d8ca;
    --sibling_subtext1: #c4c4b7;
    --sibling_subtext0: #afafa3;
    --sibling_overlay2: #9b9b90;
    --sibling_overlay1: #86867b;
    --sibling_overlay0: #727268;
    --sibling_surface2: #5d5e54;
    --sibling_surface1: #494941;
    --sibling_surface0: #34352c;
    --sibling_base: #212116;
    --sibling_mantle: #1a1a12;
    --sibling_crust: #13130c;

    --sibling_rosewater: #f1e2dc;
    --sibling_flamingo: #ecd0ce;
    --sibling_pink: #f0c6df;
    --sibling_mauve: #c5acea;
    --sibling_red: #e7959f;
    --sibling_maroon: #e1a8a1;
    --sibling_peach: #edb995;
    --sibling_yellow: #f3e3bd;
    --sibling_green: #c6da9d;
    --sibling_teal: #aeddc4;
    --sibling_sky: #9ddbd4;
    --sibling_sapphire: #82c7d8;
    --sibling_blue: #7fbbe3;
    --sibling_lavender: #b8bff0;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling_mantle);
    --bg_base: var(--sibling_base);
    --bg_preview: var(--sibling_crust);
    --bg_dock: var(--sibling_mantle);
    --bg_hover: var(--sibling_surface0);
    --text: var(--sibling_text);
    --text_light: var(--sibling_rosewater);
    --text_muted: var(--sibling_overlay1);
    --text_inactive: var(--sibling_subtext0);
    --text_inverse: var(--sibling_crust);
    --text_disabled: var(--sibling_subtext0);
    --primary: var(--sibling_mauve);
    --primary_light: var(--sibling_lavender);
    --primary_lighter: var(--sibling_pink);
    --primary_dark: var(--sibling_blue);
    --primary_darker: var(--sibling_surface2);
    --input_bg: var(--sibling_surface0);
    --input_bg_hover: var(--sibling_surface1);
    --input_bg_focus: var(--sibling_surface1);
    --input_border: var(--sibling_surface1);
    --input_border_hover: var(--sibling_mauve);
    --button_bg: var(--sibling_mantle);
    --button_bg_hover: var(--sibling_surface0);
    --button_hover_text: var(--sibling_text);
    --button_bg_disabled: var(--sibling_base);
    --list_item_bg_hover: var(--sibling_surface0);
    --list_item_bg_selected: var(--sibling_mauve);
    --border_color: var(--sibling_surface0);
    --warning: var(--sibling_yellow);
    --danger: var(--sibling_red);
    --success: var(--sibling_green);
    --meter_bg_nom: var(--sibling_surface0);
    --meter_bg_war: var(--sibling_surface0);
    --meter_bg_err: var(--sibling_surface0);
    --meter_fg_nom: var(--sibling_green);
    --meter_fg_war: var(--sibling_yellow);
    --meter_fg_err: var(--sibling_red);
    --ico: var(--text);
    --ico_selected: var(--sibling_crust);
    --accent_bg_start: rgba(197, 172, 234, 0.3);
    --accent_bg_end: rgba(197, 172, 234, 0.1);

}
