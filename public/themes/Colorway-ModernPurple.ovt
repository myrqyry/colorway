@OBSThemeMeta {
    name: 'Modern Purple';
    id: 'com.myrqyry.Colorway.ModernPurple';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Modern Purple
       Hex colors:
       --bg_window: #1b1133;
       --bg_base: #1b1133;
       --bg_preview: #0d0225;
       --bg_dock: #0d0225;
       --bg_hover: #3e3a52;
       --text: #e2e2e2;
       --text_light: #e2e2e2;
       --text_muted: #767C7E;
       --text_inactive: #4a4a6a;
       --text_inverse: #000000;
       --text_disabled: #4a4a6a;
       --primary: #6471e4;
       --primary_light: #e85c71;
       --primary_lighter: #ff8fa3;
       --primary_dark: #375dda;
       --primary_darker: #0d0225;
       --input_bg: #342f42;
       --input_bg_hover: #3e3a52;
       --input_bg_focus: #3e3a52;
       --input_border: #4F4864;
       --input_border_hover: #6471e4;
       --button_bg: #375dda;
       --button_bg_hover: #4a70f0;
       --button_bg_disabled: #1b1133;
       --list_item_bg_hover: #3e3a52;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #342f42;
       --ico: #e2e2e2;
       --ico_selected: #1b1133;
       --warning: #F78C6C;
       --danger: #ce838e;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(100, 113, 228, 0.3);
       --accent_bg_end: rgba(100, 113, 228, 0.1);
    */

    --accent_bg_start: 'rgba(100, 113, 228, 0.3)';
    --accent_bg_end: 'rgba(100, 113, 228, 0.1)';

    --bg_window: #1b1133;
    --bg_base: #1b1133;
    --bg_preview: #0d0225;

    --primary: #6471e4;
    --primary_light: #e85c71;
    --primary_lighter: #ff8fa3;
    --primary_dark: #375dda;
    --primary_darker: #0d0225;

    --warning: #F78C6C;
    --danger: #ce838e;

    --text: #e2e2e2;
    --text_light: #e2e2e2;
    --text_muted: #767C7E;

    --text_disabled: #4a4a6a;
    --text_inactive: #4a4a6a;
    --text_inverse: #000000;

    --border_color: #342f42;

    --input_bg: #342f42;
    --input_bg_hover: #3e3a52;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3e3a52;

    --input_border: #4F4864;
    --input_border_hover: #6471e4;

    --button_bg: #375dda;
    --button_bg_hover: #4a70f0;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #1b1133;

    --bg_dock: #0d0225;
    --bg_hover: #3e3a52;

    
    --ico: var(--text);
    --ico_selected: #1b1133;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #e2e2e2;
    --on_panel_muted: #767C7E;
    --on_base_muted: #7b8182;
    --on_preview_muted: #767C7E;
    --on_preview: #e2e2e2;
    --on_list_hover: #e2e2e2;
    --on_hover: #e2e2e2;
    --on_panel_disabled: #5a5a77;
    --on_base_disabled: #62627d;
    --on_panel_outline: #5e5b6a;
    --on_section_heading: #6976e5;
    --on_panel_accent: #6471e4;
    --on_button: #e7e7e7;
    --on_button_disabled: #62627d;
    --on_input: #e2e2e2;
    --on_input_hover: #e2e2e2;
    --on_input_focus: #e2e2e2;
    --on_nav_hover: #e2e2e2;
    --on_mixer_muted: #ce838e;
    --on_mixer_warning: #F78C6C;
    --on_primary_dark: #ffffff;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ce838e.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-f78c6c.svg)';
    /* colorway:state-tokens:end */

}
