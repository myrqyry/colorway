@OBSThemeMeta {
    name: 'Rosé Pine — Rose';
    id: 'com.myrqyry.Colorway.RosePine.Rose';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Rosé Pine — Rose
       Hex colors:
       --bg_window: #191724;
       --bg_base: #191724;
       --bg_preview: #26233a;
       --bg_dock: #1f1d2e;
       --bg_hover: #26233a;
       --text: #e0def4;
       --text_light: #ffffff;
       --text_muted: #908caa;
       --text_inactive: #6e6a86;
       --text_inverse: #FFFFFF;
       --text_disabled: #6e6a86;
       --primary: #ebbcba;
       --primary_light: #f6c177;
       --primary_lighter: #e0def4;
       --primary_dark: #eb6f92;
       --primary_darker: #524f67;
       --input_bg: #26233a;
       --input_bg_hover: #403d52;
       --input_bg_focus: #332f4a;
       --input_border: #403d52;
       --input_border_hover: #524f67;
       --button_bg: #1f1d2e;
       --button_bg_hover: #26233a;
       --button_bg_disabled: #191724;
       --list_item_bg_hover: #332f4a;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #403d52;
       --ico: #e0def4;
       --ico_selected: #191724;
       --warning: #f6c177;
       --danger: #eb6f92;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(235, 188, 186, 0.3);
       --accent_bg_end: rgba(235, 188, 186, 0.1);
    */
    --bg_window: #191724;
    --bg_base: #191724;
    --bg_preview: #26233a;
    --primary: #ebbcba;
    --primary_light: #f6c177;
    --primary_lighter: #e0def4;
    --primary_dark: #eb6f92;
    --primary_darker: #524f67;
    --warning: #f6c177;
    --danger: #eb6f92;
    --text: #e0def4;
    --text_light: #ffffff;
    --text_muted: #908caa;
    --text_disabled: #6e6a86;
    --text_inactive: #6e6a86;
    --text_inverse: #FFFFFF;
    --border_color: #403d52;
    --input_bg: #26233a;
    --input_bg_hover: #403d52;
    --input_bg_focus: #332f4a;
    --list_item_bg_hover: #332f4a;
    --input_border: #403d52;
    --input_border_hover: #524f67;
    --button_bg: #1f1d2e;
    --button_bg_hover: #26233a;
    --button_bg_disabled: #191724;
    --bg_dock: #1f1d2e;
    --bg_hover: #26233a;
    --ico: var(--text);
    --ico_selected: #191724;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(235, 188, 186, 0.3);
    --accent_bg_end: rgba(235, 188, 186, 0.1);
}
