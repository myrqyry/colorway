@OBSThemeMeta {
    name: 'Fogfire';
    id: 'com.myrqyry.Colorway.Fogfire';
    extends: 'com.myrqyry.Colorway';
    author: 'Quemis guy / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Fogfire
       Hex colors:
       --bg_window: #1c1820;
       --bg_base: #1c1820;
       --bg_preview: #644740;
       --bg_dock: #433e4e;
       --bg_hover: #663e2f;
       --text: #deddec;
       --text_light: #deddec;
       --text_muted: #d8ba92;
       --text_inactive: #79747f;
       --text_inverse: #1c1820;
       --text_disabled: #79747f;
       --primary: #e75c13;
       --primary_light: #efb34f;
       --primary_lighter: #d8ba92;
       --primary_dark: #c8783d;
       --primary_darker: #a2330f;
       --input_bg: #433e4e;
       --input_bg_hover: #644740;
       --input_bg_focus: #433e4e;
       --input_border: #79747f;
       --input_border_hover: #e75c13;
       --button_bg: #433e4e;
       --button_bg_hover: #c8783d;
       --button_bg_disabled: #433e4e;
       --list_item_bg_hover: #433e4e;
       --list_item_bg_selected: #644740;
       --border_color: #79747f;
       --ico: #deddec;
       --ico_selected: #1c1820;
       --warning: #efb34f;
       --danger: #e75c13;
       --success: #98c5a2;
       --meter_bg_nom: #433e4e;
       --meter_bg_war: #663e2f;
       --meter_bg_err: #a2330f;
       --meter_fg_nom: #98c5a2;
       --meter_fg_war: #efb34f;
       --meter_fg_err: #e75c13;
       Derived colors:
       --accent_bg_start: rgba(231, 92, 19, 0.3);
       --accent_bg_end: rgba(231, 92, 19, 0.1);
    */

    /* Lospec palette: Fogfire — Quemis guy
       Source: https://lospec.com/palette-list/fogfire
       Colors mapped to OBS roles; derived alert colors are explicitly
       distinct from the original limited source palette. */

    --bg_window: #1c1820;
    --bg_base: #1c1820;
    --bg_preview: #644740;
    --bg_dock: #433e4e;
    --bg_hover: #663e2f;
    --text: #deddec;
    --text_light: #deddec;
    --text_muted: #d8ba92;
    --text_inactive: #79747f;
    --text_disabled: #79747f;
    --text_inverse: #1c1820;
    --primary: #e75c13;
    --primary_light: #efb34f;
    --primary_lighter: #d8ba92;
    --primary_dark: #c8783d;
    --primary_darker: #a2330f;
    --input_bg: #433e4e;
    --input_bg_hover: #644740;
    --input_bg_focus: #433e4e;
    --input_border: #79747f;
    --input_border_hover: #e75c13;
    --button_bg: #433e4e;
    --button_bg_hover: #c8783d;
    --button_hover_text: #1c1820;
    --button_bg_disabled: #433e4e;
    --list_item_bg_hover: #433e4e;
    --list_item_bg_selected: #644740;
    --border_color: #79747f;
    --warning: #efb34f;
    --danger: #e75c13;
    --success: #98c5a2;
    --meter_bg_nom: #433e4e;
    --meter_bg_war: #663e2f;
    --meter_bg_err: #a2330f;
    --meter_fg_nom: #98c5a2;
    --meter_fg_war: #efb34f;
    --meter_fg_err: #e75c13;
    --accent_bg_start: 'rgba(231, 92, 19, 0.3)';
    --accent_bg_end: 'rgba(231, 92, 19, 0.1)';
    --ico: var(--text);
    --ico_selected: var(--text_inverse);
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/normal/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #deddec;
    --on_panel_muted: #d8ba92;
    --on_base_muted: #d8ba92;
    --on_preview_muted: #d8ba92;
    --on_preview: #deddec;
    --on_list_hover: #deddec;
    --on_hover: #deddec;
    --on_panel_disabled: #8d8992;
    --on_base_disabled: #79747f;
    --on_panel_outline: #8d8992;
    --on_section_heading: #e75c13;
    --on_panel_accent: #ef9666;
    --on_button: #deddec;
    --on_button_disabled: #8d8992;
    --on_input: #deddec;
    --on_input_hover: #deddec;
    --on_input_focus: #deddec;
    --on_nav_hover: #deddec;
    --on_mixer_muted: #e75c13;
    --on_mixer_monitor: #98c5a2;
    --on_mixer_warning: #efb34f;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-e75c13.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-98c5a2.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-efb34f.svg)';
    /* colorway:state-tokens:end */

}
