    --cw_icon_plus_primary: 'url(theme:icons/colorway/mingcute/normal/plus.svg)';
    --cw_icon_popout_primary: 'url(theme:icons/colorway/mingcute/normal/popout.svg)';
    --cw_icon_refresh_primary: 'url(theme:icons/colorway/mingcute/normal/refresh.svg)';
    --cw_icon_revert_primary: 'url(theme:icons/colorway/mingcute/normal/revert.svg)';
    --cw_icon_save_primary: 'url(theme:icons/colorway/mingcute/normal/save.svg)';
