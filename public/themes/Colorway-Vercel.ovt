@OBSThemeMeta {
    name: 'Vercel';
    id: 'com.myrqyry.Colorway.Vercel';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Vercel
       Hex colors:
       --bg_window: #000000;
       --bg_base: #000000;
       --bg_preview: #1a1a1a;
       --bg_dock: #000000;
       --bg_hover: #252525;
       --text: #EDEDED;
       --text_light: #ffffff;
       --text_muted: #878787;
       --text_inactive: #737373;
       --text_inverse: #FFFFFF;
       --text_disabled: #737373;
       --primary: #0070F3;
       --primary_light: #52A8FF;
       --primary_lighter: #8E4EC6;
       --primary_dark: #46A758;
       --primary_darker: #878787;
       --input_bg: #1a1a1a;
       --input_bg_hover: #252525;
       --input_bg_focus: #252525;
       --input_border: #141414;
       --input_border_hover: #0070F3;
       --button_bg: #000000;
       --button_bg_hover: #252525;
       --button_bg_disabled: #000000;
       --list_item_bg_hover: #252525;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #141414;
       --ico: #EDEDED;
       --ico_selected: #000000;
       --warning: #FFB224;
       --danger: #E5484D;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(0, 112, 243, 0.3);
       --accent_bg_end: rgba(0, 112, 243, 0.1);
    */

    --accent_bg_start: 'rgba(0, 112, 243, 0.3)';
    --accent_bg_end: 'rgba(0, 112, 243, 0.1)';

    
    --bg_window: #000000;
    --bg_base: #000000;
    --bg_preview: #1a1a1a;

    --primary: #0070F3;
    --primary_light: #52A8FF;
    --primary_lighter: #8E4EC6;
    --primary_dark: #46A758;
    --primary_darker: #878787;

    --warning: #FFB224;
    --danger: #E5484D;

    --text: #EDEDED;
    --text_light: #ffffff;
    --text_muted: #878787;

    --text_disabled: #737373;
    --text_inactive: #737373;
    --text_inverse: #FFFFFF;

    --border_color: #141414;

    
    --input_bg: #1a1a1a;
    --input_bg_hover: #252525;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #252525;

    --input_border: #141414;
    --input_border_hover: #0070F3;

    --button_bg: #000000;
    --button_bg_hover: #252525;
    --button_bg_disabled: #000000;

    
    --bg_dock: #000000;
    --bg_hover: #252525;

    
    --ico: var(--text);
    --ico_selected: #000000;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #EDEDED;
    --on_panel_muted: #878787;
    --on_base_muted: #878787;
    --on_preview_muted: #878787;
    --on_panel_disabled: #737373;
    --on_base_disabled: #737373;
    --on_panel_outline: #5a5a5a;
    --on_section_heading: #0070F3;
    --on_panel_accent: #0070F3;
    --on_button: #EDEDED;
    --on_button_disabled: #737373;
    --on_input: #EDEDED;
    --on_input_hover: #EDEDED;
    --on_input_focus: #EDEDED;
    --on_mixer_muted: #E5484D;
    --on_mixer_warning: #FFB224;
    --cw_icon_arrow_down_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-down.svg)';
    --cw_icon_arrow_up_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-up.svg)';
    --cw_icon_audio_primary: 'url(theme:icons/colorway/mingcute/normal/audio.svg)';
    --cw_icon_brush_primary: 'url(theme:icons/colorway/mingcute/normal/brush.svg)';
