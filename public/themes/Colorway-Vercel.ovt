    --cw_icon_eye_off_primary: 'url(theme:icons/colorway/mingcute/normal/eye-off.svg)';
    --cw_icon_eye_primary: 'url(theme:icons/colorway/mingcute/normal/eye.svg)';
    --cw_icon_filter_primary: 'url(theme:icons/colorway/mingcute/normal/filter.svg)';
    --cw_icon_gamepad_primary: 'url(theme:icons/colorway/mingcute/normal/gamepad.svg)';
    --cw_icon_globe_primary: 'url(theme:icons/colorway/mingcute/normal/globe.svg)';
    --cw_icon_group_primary: 'url(theme:icons/colorway/mingcute/normal/group.svg)';
    --cw_icon_headphone_primary: 'url(theme:icons/colorway/mingcute/normal/headphone.svg)';
    --cw_icon_headphone_off_primary: 'url(theme:icons/colorway/mingcute/normal/headphone-off.svg)';
