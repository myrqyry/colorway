@OBSThemeMeta {
    name: 'SLSO8 Pixels';
    id: 'com.myrqyry.Colorway.SLSO8Pixels';
    extends: 'com.myrqyry.Colorway';
    author: 'solosalsero / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: SLSO8 Pixels
       Hex colors:
       --bg_window: #0d2b45;
       --bg_base: #0d2b45;
       --bg_preview: #203c56;
       --bg_dock: #544e68;
       --bg_hover: #26233a;
       --text: #ffecd6;
       --text_light: #ffffff;
       --text_muted: #8d697a;
       --text_inactive: #544e68;
       --text_inverse: #000000;
       --text_disabled: #544e68;
       --primary: #d08159;
       --primary_light: #ffaa5e;
       --primary_lighter: #ffd4a3;
       --primary_dark: #8d697a;
       --primary_darker: #1d1b21;
       --input_bg: #203c56;
       --input_bg_hover: #203c56;
       --input_bg_focus: #544e68;
       --input_border: #203c56;
       --input_border_hover: #d08159;
       --button_bg: #544e68;
       --button_bg_hover: #d08159;
       --button_bg_disabled: #0d2b45;
       --list_item_bg_hover: #0d2b45;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #203c56;
       --warning: #ffecd6;
       --danger: #ffaa5e;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(208, 129, 89, 0.3);
       --accent_bg_end: rgba(208, 129, 89, 0.1);
    */
    --bg_window: #0d2b45;
    --bg_base: #0d2b45;
    --bg_preview: #203c56;
    --bg_dock: #544e68;

    /* Primary Accent (Terracotta → Peach Gradient) */
    --primary: #d08159;
    --primary_light: #ffaa5e;
    --primary_lighter: #ffd4a3;
    --primary_dark: #8d697a;
    --primary_darker: #1d1b21;

    --warning: #ffecd6;
    --danger: #ffaa5e;

    /* Text Colors (Peach → Cool Gray) */
    --text: #ffecd6;
    --text_light: #ffffff;
    --text_muted: #8d697a;
    --text_disabled: #544e68;
    --text_inactive: #544e68;

    /* Borders (Subtle dock dividers) */
    --border_color: #203c56;

    /* Input & Button Layouts */
    --input_bg: #203c56;
    --input_bg_hover: #203c56;
    --input_bg_focus: #544e68;
    --list_item_bg_hover: #0d2b45;
    --input_border: #203c56;
    --input_border_hover: #d08159;

    --button_bg: #544e68;
    --button_bg_hover: #d08159;
    --button_bg_disabled: #0d2b45;

    /* Replay/VirtualCam active state overlays */
    --accent_bg_start: rgba(208, 129, 89, 0.3);
    --accent_bg_end: rgba(208, 129, 89, 0.1);

    /* Text contrast for warm earth tones */
    --text_inverse: #000000;
}