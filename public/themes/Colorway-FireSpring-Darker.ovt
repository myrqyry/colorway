@OBSThemeMeta {
    name: 'EarthBound — Fire Spring Darker';
    id: 'com.myrqyry.Colorway.FireSpring.Darker';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: EarthBound — Fire Spring Darker
       Hex colors:
       --bg_window: #080808;
       --bg_base: #080808;
       --bg_preview: #040404;
       --bg_dock: #0c0c0c;
       --bg_hover: #1a1a1a;
       --text: #ffffca;
       --text_light: #ffffff;
       --text_muted: #ffff00;
       --text_inactive: #333333;
       --text_inverse: #000000;
       --text_disabled: #333333;
       --primary: #d992ff;
       --primary_light: #a99ade;
       --primary_lighter: #c4b0f0;
       --primary_dark: #9b4de0;
       --primary_darker: #6a20a8;
       --input_bg: #111111;
       --input_bg_hover: #1a1a1a;
       --input_bg_focus: #1a1a1a;
       --input_border: #1a1a1a;
       --input_border_hover: #d992ff;
       --button_bg: #9766B2;
       --button_bg_hover: #e4aaff;
       --button_bg_disabled: #080808;
       --list_item_bg_hover: #1a1a1a;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1a1a1a;
       --ico: #ffffca;
       --ico_selected: #080808;
       --warning: #f0e500;
       --danger: #ff6b6b;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(217, 146, 255, 0.3);
       --accent_bg_end: rgba(217, 146, 255, 0.1);
    */

    --accent_bg_start: 'rgba(217, 146, 255, 0.3)';
    --accent_bg_end: 'rgba(217, 146, 255, 0.1)';

    --bg_window: #080808;
    --bg_base: #080808;
    --bg_preview: #040404;

    --primary: #d992ff;
    --primary_light: #a99ade;
    --primary_lighter: #c4b0f0;
    --primary_dark: #9b4de0;
    --primary_darker: #6a20a8;

    --warning: #f0e500;
    --danger: #ff6b6b;

    --text: #ffffca;
    --text_light: #ffffff;
    --text_muted: #ffff00;

    --text_disabled: #333333;
    --text_inactive: #333333;
    --text_inverse: #000000;

    --border_color: #1a1a1a;

    --input_bg: #111111;
    --input_bg_hover: #1a1a1a;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #1a1a1a;

    --input_border: #1a1a1a;
    --input_border_hover: #d992ff;

    --button_bg: #9766B2;
    --button_bg_hover: #e4aaff;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #080808;

    --bg_dock: #0c0c0c;
    --bg_hover: #1a1a1a;

    
    --ico: var(--text);
    --ico_selected: #080808;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #ffffca;
    --on_panel_muted: #ffff00;
    --on_base_muted: #ffff00;
    --on_preview_muted: #ffff00;
    --on_panel_disabled: #5e5e5e;
    --on_base_disabled: #5d5d5d;
    --on_panel_outline: #5e5e5e;
    --on_section_heading: #d992ff;
    --on_panel_accent: #d992ff;
    --on_button: #0d0d0b;
    --on_button_disabled: #5d5d5d;
    --on_input: #ffffca;
    --on_input_hover: #ffffca;
    --on_input_focus: #ffffca;
    --on_mixer_muted: #ff6b6b;
    --on_mixer_warning: #f0e500;
    --cw_icon_cogs_button: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_filter_button: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ff6b6b.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-f0e500.svg)';
    /* colorway:state-tokens:end */

}
