@OBSThemeMeta {
    name: 'Catppuccin Sibling — Sesame';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Sesame';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: warm charcoal / near-neutral.
 */
@OBSThemeVars {
    /* Official palette reference (Colorway-generated sibling; not an official Catppuccin flavor): Catppuccin Sibling — Sesame
       Hex colors:
       --bg_window: #1c1916;
       --bg_base: #231f1b;
       --bg_preview: #14120f;
       --bg_dock: #1c1916;
       --bg_hover: #363330;
       --text: #dbd6d0;
       --text_light: #f0e2de;
       --text_muted: #898580;
       --text_inactive: #b2ada8;
       --text_inverse: #14120f;
       --text_disabled: #b2ada8;
       --primary: #c6ace5;
       --primary_light: #c0bdeb;
       --primary_lighter: #ecc8e0;
       --primary_dark: #8fb7e4;
       --primary_darker: #5f5c58;
       --input_bg: #363330;
       --input_bg_hover: #4b4845;
       --input_bg_focus: #4b4845;
       --input_border: #4b4845;
       --input_border_hover: #c6ace5;
       --button_bg: #1c1916;
       --button_bg_hover: #363330;
       --button_hover_text: #dbd6d0;
       --button_bg_disabled: #231f1b;
       --list_item_bg_hover: #363330;
       --list_item_bg_selected: #c6ace5;
       --border_color: #363330;
       --warning: #f3e2c0;
       --danger: #e398a3;
       --success: #bbdcaa;
       --meter_bg_nom: #363330;
       --meter_bg_war: #363330;
       --meter_bg_err: #363330;
       --meter_fg_nom: #bbdcaa;
       --meter_fg_war: #f3e2c0;
       --meter_fg_err: #e398a3;
       --ico: #dbd6d0;
       --ico_selected: #14120f;
       Derived colors:
       --accent_bg_start: rgba(198, 172, 229, 0.3);
       --accent_bg_end: rgba(198, 172, 229, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling-text: #dbd6d0;
    --sibling-subtext1: #c7c2bd;
    --sibling-subtext0: #b2ada8;
    --sibling-overlay2: #9e9a95;
    --sibling-overlay1: #898580;
    --sibling-overlay0: #74716d;
    --sibling-surface2: #5f5c58;
    --sibling-surface1: #4b4845;
    --sibling-surface0: #363330;
    --sibling-base: #231f1b;
    --sibling-mantle: #1c1916;
    --sibling-crust: #14120f;

    --sibling-rosewater: #f0e2de;
    --sibling-flamingo: #ead0d0;
    --sibling-pink: #ecc8e0;
    --sibling-mauve: #c6ace5;
    --sibling-red: #e398a3;
    --sibling-maroon: #dea8a7;
    --sibling-peach: #ebb99c;
    --sibling-yellow: #f3e2c0;
    --sibling-green: #bbdcaa;
    --sibling-teal: #abddcd;
    --sibling-sky: #a0d9dd;
    --sibling-sapphire: #8cc4dc;
    --sibling-blue: #8fb7e4;
    --sibling-lavender: #c0bdeb;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling-mantle);
    --bg_base: var(--sibling-base);
    --bg_preview: var(--sibling-crust);
    --bg_dock: var(--sibling-mantle);
    --bg_hover: var(--sibling-surface0);
    --text: var(--sibling-text);
    --text_light: var(--sibling-rosewater);
    --text_muted: var(--sibling-overlay1);
    --text_inactive: var(--sibling-subtext0);
    --text_inverse: var(--sibling-crust);
    --text_disabled: var(--sibling-subtext0);
    --primary: var(--sibling-mauve);
    --primary_light: var(--sibling-lavender);
    --primary_lighter: var(--sibling-pink);
    --primary_dark: var(--sibling-blue);
    --primary_darker: var(--sibling-surface2);
    --input_bg: var(--sibling-surface0);
    --input_bg_hover: var(--sibling-surface1);
    --input_bg_focus: var(--sibling-surface1);
    --input_border: var(--sibling-surface1);
    --input_border_hover: var(--sibling-mauve);
    --button_bg: var(--sibling-mantle);
    --button_bg_hover: var(--sibling-surface0);
    --button_hover_text: var(--sibling-text);
    --button_bg_disabled: var(--sibling-base);
    --list_item_bg_hover: var(--sibling-surface0);
    --list_item_bg_selected: var(--sibling-mauve);
    --border_color: var(--sibling-surface0);
    --warning: var(--sibling-yellow);
    --danger: var(--sibling-red);
    --success: var(--sibling-green);
    --meter_bg_nom: var(--sibling-surface0);
    --meter_bg_war: var(--sibling-surface0);
    --meter_bg_err: var(--sibling-surface0);
    --meter_fg_nom: var(--sibling-green);
    --meter_fg_war: var(--sibling-yellow);
    --meter_fg_err: var(--sibling-red);
    --ico: var(--text);
    --ico_selected: var(--sibling-crust);
    --accent_bg_start: rgba(198, 172, 229, 0.3);
    --accent_bg_end: rgba(198, 172, 229, 0.1);
}
