@OBSThemeMeta {
    name: 'Ethereal Fallen Angel';
    id: 'com.myrqyry.Colorway.EtherealFallenAngel';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Ethereal Fallen Angel
       Hex colors:
       --bg_window: #080808;
       --bg_base: #080808;
       --bg_preview: #030303;
       --bg_dock: #111111;
       --bg_hover: #1c1c1c;
       --text: #f0f0f0;
       --text_light: #ffffff;
       --text_muted: #888888;
       --text_inactive: #333333;
       --text_inverse: #FFFFFF;
       --text_disabled: #333333;
       --primary: #ffffff;
       --primary_light: #ffb3b3;
       --primary_lighter: #ffe0e0;
       --primary_dark: #cccccc;
       --primary_darker: #999999;
       --input_bg: #111111;
       --input_bg_hover: #1c1c1c;
       --input_bg_focus: #1c1c1c;
       --input_border: #1a1a1a;
       --input_border_hover: #888888;
       --button_bg: #111111;
       --button_bg_hover: #1c1c1c;
       --button_bg_disabled: #080808;
       --list_item_bg_hover: #1c1c1c;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1a1a1a;
       --ico: #f0f0f0;
       --ico_selected: #080808;
       --warning: #ffd166;
       --danger: #ff6b6b;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(255, 255, 255, 0.3);
       --accent_bg_end: rgba(255, 255, 255, 0.1);
    */

    --accent_bg_start: 'rgba(255, 255, 255, 0.3)';
    --accent_bg_end: 'rgba(255, 255, 255, 0.1)';

    --bg_window: #080808;
    --bg_base: #080808;
    --bg_preview: #030303;

    --primary: #ffffff;
    --primary_light: #ffb3b3;
    --primary_lighter: #ffe0e0;
    --primary_dark: #cccccc;
    --primary_darker: #999999;

    --warning: #ffd166;
    --danger: #ff6b6b;

    --text: #f0f0f0;
    --text_light: #ffffff;
    --text_muted: #888888;

    --text_disabled: #333333;
    --text_inactive: #333333;
    --text_inverse: #FFFFFF;

    --border_color: #1a1a1a;

    --input_bg: #111111;
    --input_bg_hover: #1c1c1c;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #1c1c1c;

    --input_border: #1a1a1a;
    --input_border_hover: #888888;

    --button_bg: #111111;
    --button_bg_hover: #1c1c1c;
    --button_bg_disabled: #080808;

    --bg_dock: #111111;
    --bg_hover: #1c1c1c;

    
    --ico: var(--text);
    --ico_selected: #080808;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #f0f0f0;
    --on_panel_muted: #888888;
    --on_base_muted: #888888;
    --on_preview_muted: #888888;
    --on_panel_disabled: #606060;
    --on_base_disabled: #5d5d5d;
    --on_panel_outline: #606060;
    --on_section_heading: #ffffff;
    --on_panel_accent: #ffffff;
    --on_button: #f0f0f0;
    --on_button_disabled: #5d5d5d;
    --on_input: #f0f0f0;
    --on_input_hover: #f0f0f0;
    --on_input_focus: #f0f0f0;
    --on_mixer_muted: #ff6b6b;
    --on_mixer_warning: #ffd166;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ff6b6b.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ffd166.svg)';
    /* colorway:state-tokens:end */

}
