@OBSThemeMeta {
    name: 'EarthBound — Cave of the Past';
    id: 'com.myrqyry.Colorway.CaveOfThePast';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference (source values; live accessibility overrides below may differ): Cave of the Past
       Hex colors:
       --bg_window: #b0d0b8;
       --bg_base: #b0d0b8;
       --bg_preview: #8ab098;
       --bg_dock: #c0dcc8;
       --bg_hover: #d8ecd8;
       --text: #394537;
       --text_light: #0e1e0e;
       --text_muted: #546658;
       --text_inactive: #7a9a80;
       --text_inverse: #FFFFFF;
       --text_disabled: #7a9a80;
       --primary: #293d29;
       --primary_light: #445046;
       --primary_lighter: #556a58;
       --primary_dark: #1a2b1a;
       --primary_darker: #0e1e0e;
       --input_bg: #c8e0d0;
       --input_bg_hover: #d8ecd8;
       --input_bg_focus: #d8ecd8;
       --input_border: #8ab098;
       --input_border_hover: #293d29;
       --button_bg: #1C2A1C;
       --button_bg_hover: #3a553a;
       --button_bg_disabled: #b0d0b8;
       --list_item_bg_hover: #d8ecd8;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #8ab098;
       --ico: #394537;
       --ico_selected: #b0d0b8;
       --warning: #546658;
       --danger: #8b3a3a;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(41, 61, 41, 0.3);
       --accent_bg_end: rgba(41, 61, 41, 0.1);
    */

    --accent_bg_start: rgba(41, 61, 41, 0.3);
    --accent_bg_end: rgba(41, 61, 41, 0.1);

    --bg_window: #b0d0b8;
    --bg_base: #b0d0b8;
    --bg_preview: #8ab098;

    --primary: #293d29;
    --primary_light: #445046;
    --primary_lighter: #556a58;
    --primary_dark: #1a2b1a;
    --primary_darker: #0e1e0e;

    --warning: #546658;
    --danger: #8b3a3a;
    --success: #315b31;
    --checkbox_check_icon: url(theme:icons/colorway/mingcute/selected/check.svg);

    --text: #394537;
    --text_light: #0e1e0e;
    --text_muted: #546658;

    --text_disabled: #7a9a80;
    --text_inactive: #7a9a80;

    --border_color: #8ab098;

    --input_bg: #c8e0d0;
    --input_bg_hover: #d8ecd8;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #d8ecd8;

    --input_border: #8ab098;
    --input_border_hover: #293d29;

    --button_bg: #1C2A1C;
    --button_bg_hover: #3a553a;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #b0d0b8;

    
    --text_inverse: #FFFFFF;

    --bg_dock: #c0dcc8;
    --bg_hover: #d8ecd8;

    
    --ico: var(--text);
    --ico_selected: #b0d0b8;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --cw_icon_arrow_down_primary: url(theme:icons/colorway/mingcute/normal/arrow-down.svg);
