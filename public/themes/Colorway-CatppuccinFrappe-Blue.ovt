@OBSThemeMeta {
    name: 'Catppuccin Frappé — Blue';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Blue';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Catppuccin Frappé — Blue
       Hex colors:
       --bg_window: #292c3c;
       --bg_base: #303446;
       --bg_preview: #232634;
       --bg_dock: #292c3c;
       --bg_hover: #414559;
       --text: #c6d0f5;
       --text_light: #f5f5f5;
       --text_muted: #838ba7;
       --text_inactive: #a5adce;
       --text_inverse: #FFFFFF;
       --text_disabled: #a5adce;
       --primary: #8caaee;
       --primary_light: #babbf1;
       --primary_lighter: #99d1db;
       --primary_dark: #85c1dc;
       --primary_darker: #626880;
       --input_bg: #414559;
       --input_bg_hover: #51576d;
       --input_bg_focus: #464d5e;
       --input_border: #5B607B;
       --input_border_hover: #626880;
       --button_bg: #292c3c;
       --button_bg_hover: #414559;
       --button_bg_disabled: #303446;
       --list_item_bg_hover: #484f5f;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #414559;
       --ico: #c6d0f5;
       --ico_selected: #303446;
       --warning: #ef9f76;
       --danger: #e78284;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(140, 170, 238, 0.3);
       --accent_bg_end: rgba(140, 170, 238, 0.1);
    */

    --bg_window: #292c3c;
    --bg_base: #303446;
    --bg_preview: #232634;
    --primary: #8caaee;
    --primary_light: #babbf1;
    --primary_lighter: #99d1db;
    --primary_dark: #85c1dc;
    --primary_darker: #626880;
    --warning: #ef9f76;
    --danger: #e78284;
    --text: #c6d0f5;
    --text_light: #f5f5f5;
    --text_muted: #838ba7;
    --text_disabled: #a5adce;
    --text_inactive: #a5adce;
    --text_inverse: #FFFFFF;
    --border_color: #414559;
    --input_bg: #414559;
    --input_bg_hover: #51576d;
    --input_bg_focus: #464d5e;
    --list_item_bg_hover: #484f5f;
    --input_border: #5B607B;
    --input_border_hover: #626880;
    --button_bg: #292c3c;
    --button_bg_hover: #414559;
    --button_bg_disabled: #303446;
    --bg_dock: #292c3c;
    --bg_hover: #414559;
    --ico: var(--text);
    --ico_selected: #303446;

    
    --accent_bg_start: 'rgba(140, 170, 238, 0.3)';
    --accent_bg_end: 'rgba(140, 170, 238, 0.1)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #c6d0f5;
    --on_panel_muted: #8b93ad;
    --on_base_muted: #959cb4;
    --on_preview_muted: #848ca8;
    --on_preview: #f5f5f5;
    --on_list_hover: #f5f5f5;
    --on_hover: #f5f5f5;
    --on_panel_disabled: #a5adce;
    --on_base_disabled: #a5adce;
    --on_panel_outline: #727583;
    --on_section_heading: #8caaee;
    --on_panel_accent: #8caaee;
    --on_button: #c6d0f5;
    --on_button_disabled: #a5adce;
    --on_input: #c6d0f5;
    --on_input_hover: #c6d0f5;
    --on_input_focus: #c6d0f5;
    --on_nav_hover: #f5f5f5;
    --on_mixer_muted: #e78284;
    --on_mixer_warning: #ef9f76;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-e78284.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ef9f76.svg)';
    /* colorway:state-tokens:end */

}
