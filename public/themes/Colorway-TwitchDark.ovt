    --cw_icon_unlock_primary: 'url(theme:icons/colorway/mingcute/normal/unlock.svg)';
    --cw_icon_video_primary: 'url(theme:icons/colorway/mingcute/normal/video.svg)';
    --cw_icon_volume_high_primary: 'url(theme:icons/colorway/mingcute/normal/volume-high.svg)';
    --cw_icon_volume_mute_primary: 'url(theme:icons/colorway/mingcute/normal/volume-mute.svg)';
