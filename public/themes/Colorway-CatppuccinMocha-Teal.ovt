@OBSThemeMeta {
    name: 'Catppuccin Mocha — Teal';
    id: 'com.myrqyry.Colorway.CatppuccinMocha.Teal';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Catppuccin Mocha — Teal
       Hex colors:
       --bg_window: #181825;
       --bg_base: #1e1e2e;
       --bg_preview: #11111b;
       --bg_dock: #181825;
       --bg_hover: #313244;
       --text: #cdd6f4;
       --text_light: #f5f5f5;
       --text_muted: #7f849c;
       --text_inactive: #a6adc8;
       --text_inverse: #FFFFFF;
       --text_disabled: #a6adc8;
       --primary: #94e2d5;
       --primary_light: #a6e3a1;
       --primary_lighter: #89dceb;
       --primary_dark: #74c7ec;
       --primary_darker: #585b70;
       --input_bg: #313244;
       --input_bg_hover: #45475a;
       --input_bg_focus: #383652;
       --input_border: #484A64;
       --input_border_hover: #585b70;
       --button_bg: #181825;
       --button_bg_hover: #313244;
       --button_bg_disabled: #1e1e2e;
       --list_item_bg_hover: #3a3955;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #313244;
       --ico: #cdd6f4;
       --ico_selected: #1e1e2e;
       --warning: #fab387;
       --danger: #f38ba8;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(148, 226, 213, 0.3);
       --accent_bg_end: rgba(148, 226, 213, 0.1);
    */
    --bg_window: #181825;
    --bg_base: #1e1e2e;
    --bg_preview: #11111b;
    --primary: #94e2d5;
    --primary_light: #a6e3a1;
    --primary_lighter: #89dceb;
    --primary_dark: #74c7ec;
    --primary_darker: #585b70;
    --warning: #fab387;
    --danger: #f38ba8;
    --text: #cdd6f4;
    --text_light: #f5f5f5;
    --text_muted: #7f849c;
    --text_disabled: #a6adc8;
    --text_inactive: #a6adc8;
    --text_inverse: #FFFFFF;
    --border_color: #313244;
    --input_bg: #313244;
    --input_bg_hover: #45475a;
    --input_bg_focus: #383652;
    --list_item_bg_hover: #3a3955;
    --input_border: #484A64;
    --input_border_hover: #585b70;
    --button_bg: #181825;
    --button_bg_hover: #313244;
    --button_bg_disabled: #1e1e2e;
    --bg_dock: #181825;
    --bg_hover: #313244;
    --ico: var(--text);
    --ico_selected: #1e1e2e;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(148, 226, 213, 0.3);
    --accent_bg_end: rgba(148, 226, 213, 0.1);
}
