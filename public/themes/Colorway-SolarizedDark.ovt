@OBSThemeMeta {
    name: 'Solarized Dark+';
    id: 'com.myrqyry.Colorway.SolarizedDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Solarized Dark+
       Hex colors:
       --bg_window: #002b36;
       --bg_base: #002b36;
       --bg_preview: #001f26;
       --bg_dock: #001f26;
       --bg_hover: #09414d;
       --text: #839496;
       --text_light: #eee8d5;
       --text_muted: #5F747B;
       --text_inactive: #4C7685;
       --text_inverse: #FFFFFF;
       --text_disabled: #4C7685;
       --primary: #268bd2;
       --primary_light: #2aa198;
       --primary_lighter: #94e0db;
       --primary_dark: #1a6d9e;
       --primary_darker: #073642;
       --input_bg: #073642;
       --input_bg_hover: #09414d;
       --input_bg_focus: #0e4d5c;
       --input_border: #0D6277;
       --input_border_hover: #586e75;
       --button_bg: #073642;
       --button_bg_hover: #09414d;
       --button_bg_disabled: #002b36;
       --list_item_bg_hover: #09414d;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #073642;
       --ico: #839496;
       --ico_selected: #002b36;
       --warning: #b58900;
       --danger: #dc322f;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(38, 139, 210, 0.3);
       --accent_bg_end: rgba(38, 139, 210, 0.1);
    */

    --text_inverse: #FFFFFF;
    --bg_window: #002b36;
    --bg_base: #002b36;
    --bg_preview: #001f26;

    --primary: #268bd2;
    --primary_light: #2aa198;
    --primary_lighter: #94e0db;
    --primary_dark: #1a6d9e;
    --primary_darker: #073642;

    --warning: #b58900;
    --danger: #dc322f;

    --text: #839496;
    --text_light: #eee8d5;
    --text_muted: #5F747B;

    --text_disabled: #4C7685;
    --text_inactive: #4C7685;

    --border_color: #073642;

    --input_bg: #073642;
    --input_bg_hover: #09414d;
    --input_bg_focus: #0e4d5c;

    --list_item_bg_hover: #09414d;

    --input_border: #0D6277;
    --input_border_hover: #586e75;

    --button_bg: #073642;
    --button_bg_hover: #09414d;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #002b36;

    --bg_dock: #001f26;
    --bg_hover: #09414d;

    
    --accent_bg_start: 'rgba(38, 139, 210, 0.3)';
    --accent_bg_end: 'rgba(38, 139, 210, 0.1)';

    
    --ico: var(--text);
    --ico_selected: #002b36;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #839496;
    --on_panel_muted: #73868c;
    --on_base_muted: #7f9095;
    --on_preview_muted: #73868c;
    --on_preview: #eee8d5;
    --on_list_hover: #eee8d5;
    --on_hover: #eee8d5;
    --on_panel_disabled: #4C7685;
    --on_base_disabled: #4C7685;
    --on_panel_outline: #496c74;
    --on_section_heading: #3694d5;
    --on_panel_accent: #268bd2;
    --on_button: #8b9b9d;
    --on_button_disabled: #4C7685;
    --on_input: #8b9b9d;
    --on_input_hover: #99a7a8;
    --on_input_focus: #aab6b7;
    --on_nav_hover: #eee8d5;
    --on_mixer_muted: #dc322f;
    --on_mixer_warning: #b58900;
    --on_primary: #000000;
    --on_primary_hover: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-dc322f.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-b58900.svg)';
    /* colorway:state-tokens:end */

}
