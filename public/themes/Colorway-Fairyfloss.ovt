@OBSThemeMeta {
    name: 'Fairyfloss';
    id: 'com.myrqyry.Colorway.Fairyfloss';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Fairyfloss
       Hex colors:
       --bg_window: #464258;
       --bg_base: #5A5475;
       --bg_preview: #322D42;
       --bg_dock: #514C66;
       --bg_hover: #716799;
       --text: #F8F8F2;
       --text_light: #FFFFFF;
       --text_muted: #A0A0A0;
       --text_inactive: #707070;
       --text_inverse: #000000;
       --text_disabled: #505050;
       --primary: #AD5877;
       --primary_light: #C990A5;
       --primary_lighter: #FFB8D1;
       --primary_dark: #9673D3;
       --primary_darker: #6B6683;
       --input_bg: #464258;
       --input_bg_hover: #5A5475;
       --input_bg_focus: #5A5475;
       --input_border: #524D66;
       --input_border_hover: #AD5877;
       --button_bg: #793D53;
       --button_bg_hover: #C76B8A;
       --button_bg_disabled: #464258;
       --list_item_bg_hover: #716799;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #524D66;
       --ico: #F8F8F2;
       --ico_selected: #F8F8F2;
       --warning: #FFC799;
       --danger: #FF857F;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(173, 88, 119, 0.3);
       --accent_bg_end: rgba(173, 88, 119, 0.1);
    */

    --accent_bg_start: 'rgba(173, 88, 119, 0.3)';
    --accent_bg_end: 'rgba(173, 88, 119, 0.1)';

    --bg_window: #464258;
    --bg_base: #5A5475;
    --bg_preview: #322D42;

    --primary: #AD5877;
    --primary_light: #C990A5;
    --primary_lighter: #FFB8D1;
    --primary_dark: #9673D3;
    --primary_darker: #6B6683;

    --warning: #FFC799;
    --danger: #FF857F;

    --text: #F8F8F2;
    --text_light: #FFFFFF;
    --text_muted: #A0A0A0;

    --text_disabled: #505050;
    --text_inactive: #707070;
    --text_inverse: #000000;

    --border_color: #524D66;

    --input_bg: #464258;
    --input_bg_hover: #5A5475;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #716799;

    --input_border: #524D66;
    --input_border_hover: #AD5877;

    --button_bg: #793D53;
    --button_bg_hover: #C76B8A;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #464258;

    --bg_dock: #514C66;
    --bg_hover: #716799;

    
    --ico: var(--text);
    --ico_selected: #F8F8F2;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #F8F8F2;
    --on_panel_muted: #c1c1c1;
    --on_base_muted: #cecece;
    --on_preview_muted: #A0A0A0;
    --on_preview: #FFFFFF;
    --on_list_hover: #FFFFFF;
    --on_hover: #FFFFFF;
    --on_panel_disabled: #9d9d9d;
    --on_base_disabled: #a9a9a9;
    --on_panel_outline: #9e9ca9;
    --on_section_heading: #d3a5b5;
    --on_panel_accent: #dcb7c4;
    --on_button: #F8F8F2;
    --on_button_disabled: #909090;
    --on_input: #F8F8F2;
    --on_input_hover: #F8F8F2;
    --on_input_focus: #F8F8F2;
    --on_nav_hover: #FFFFFF;
    --on_mixer_muted: #FF857F;
    --on_mixer_warning: #FFC799;
    --on_primary: #ffffff;
    --cw_icon_arrow_down_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-down.svg)';
    --cw_icon_arrow_up_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-up.svg)';
    --cw_icon_audio_primary: 'url(theme:icons/colorway/mingcute/normal/audio.svg)';
