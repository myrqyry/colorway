@OBSThemeMeta {
    name: 'One Dark Pro';
    id: 'com.myrqyry.Colorway.Onedarkpro';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: One Dark Pro
       Hex colors:
       --bg_window: #1e222a;
       --bg_base: #1e222a;
       --bg_preview: #35383f;
       --bg_dock: #1d2028;
       --bg_hover: #3f4249;
       --text: #abb2bf;
       --text_light: #ffffff;
       --text_muted: #5c6370;
       --text_inactive: #4e545f;
       --text_inverse: #FFFFFF;
       --text_disabled: #4e545f;
       --primary: #61afef;
       --primary_light: #56b6c2;
       --primary_lighter: #e06c75;
       --primary_dark: #98c379;
       --primary_darker: #5c6370;
       --input_bg: #35383f;
       --input_bg_hover: #3f4249;
       --input_bg_focus: #3f4249;
       --input_border: #30343b;
       --input_border_hover: #61afef;
       --button_bg: #1d2028;
       --button_bg_hover: #3f4249;
       --button_bg_disabled: #1e222a;
       --list_item_bg_hover: #3f4249;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #30343b;
       --ico: #abb2bf;
       --ico_selected: #1e222a;
       --warning: #e5c07b;
       --danger: #e06c75;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(97, 175, 239, 0.3);
       --accent_bg_end: rgba(97, 175, 239, 0.1);
    */

    --accent_bg_start: 'rgba(97, 175, 239, 0.3)';
    --accent_bg_end: 'rgba(97, 175, 239, 0.1)';

    
    --bg_window: #1e222a;
    --bg_base: #1e222a;
    --bg_preview: #35383f;

    --primary: #61afef;
    --primary_light: #56b6c2;
    --primary_lighter: #e06c75;
    --primary_dark: #98c379;
    --primary_darker: #5c6370;

    --warning: #e5c07b;
    --danger: #e06c75;

    --text: #abb2bf;
    --text_light: #ffffff;
    --text_muted: #5c6370;

    --text_disabled: #4e545f;
    --text_inactive: #4e545f;
    --text_inverse: #FFFFFF;

    --border_color: #30343b;

    
    --input_bg: #35383f;
    --input_bg_hover: #3f4249;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3f4249;

    --input_border: #30343b;
    --input_border_hover: #61afef;

    --button_bg: #1d2028;
    --button_bg_hover: #3f4249;
    --button_bg_disabled: #1e222a;

    
    --bg_dock: #1d2028;
    --bg_hover: #3f4249;

    
    --ico: var(--text);
    --ico_selected: #1e222a;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #abb2bf;
    --on_panel_muted: #818791;
    --on_base_muted: #838992;
    --on_preview_muted: #9ca1a8;
    --on_panel_disabled: #656b74;
    --on_base_disabled: #666c75;
    --on_panel_outline: #676a70;
    --on_section_heading: #61afef;
    --on_panel_accent: #61afef;
    --on_button: #abb2bf;
    --on_button_disabled: #666c75;
    --on_input: #abb2bf;
    --on_input_hover: #abb2bf;
    --on_input_focus: #abb2bf;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    /* colorway:state-tokens:end */

}
