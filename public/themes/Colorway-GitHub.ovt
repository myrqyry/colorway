@OBSThemeMeta {
    name: 'GitHub';
    id: 'com.myrqyry.Colorway.Github';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: GitHub
       Hex colors:
       --bg_window: #0d1117;
       --bg_base: #0d1117;
       --bg_preview: #25292e;
       --bg_dock: #0c1016;
       --bg_hover: #303438;
       --text: #c9d1d9;
       --text_light: #ffffff;
       --text_muted: #8b949e;
       --text_inactive: #767e86;
       --text_inverse: #FFFFFF;
       --text_disabled: #767e86;
       --primary: #58a6ff;
       --primary_light: #d29922;
       --primary_lighter: #39c5cf;
       --primary_dark: #3fb950;
       --primary_darker: #8b949e;
       --input_bg: #25292e;
       --input_bg_hover: #303438;
       --input_bg_focus: #303438;
       --input_border: #20242a;
       --input_border_hover: #58a6ff;
       --button_bg: #0c1016;
       --button_bg_hover: #303438;
       --button_bg_disabled: #0d1117;
       --list_item_bg_hover: #303438;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #20242a;
       --ico: #c9d1d9;
       --ico_selected: #0d1117;
       --warning: #e3b341;
       --danger: #f85149;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(88, 166, 255, 0.3);
       --accent_bg_end: rgba(88, 166, 255, 0.1);
    */

    --accent_bg_start: rgba(88, 166, 255, 0.3);
    --accent_bg_end: rgba(88, 166, 255, 0.1);

    
    --bg_window: #0d1117;
    --bg_base: #0d1117;
    --bg_preview: #25292e;

    --primary: #58a6ff;
    --primary_light: #d29922;
    --primary_lighter: #39c5cf;
    --primary_dark: #3fb950;
    --primary_darker: #8b949e;

    --warning: #e3b341;
    --danger: #f85149;

    --text: #c9d1d9;
    --text_light: #ffffff;
    --text_muted: #8b949e;

    --text_disabled: #767e86;
    --text_inactive: #767e86;
    --text_inverse: #FFFFFF;

    --border_color: #20242a;

    
    --input_bg: #25292e;
    --input_bg_hover: #303438;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #303438;

    --input_border: #20242a;
    --input_border_hover: #58a6ff;

    --button_bg: #0c1016;
    --button_bg_hover: #303438;
    --button_bg_disabled: #0d1117;

    
    --bg_dock: #0c1016;
    --bg_hover: #303438;

    
    --ico: var(--text);
    --ico_selected: #0d1117;

}
