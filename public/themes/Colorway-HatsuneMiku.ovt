@OBSThemeMeta {
    name: 'Hatsune Miku';
    id: 'com.myrqyry.Colorway.HatsuneMiku';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Hatsune Miku
       Hex colors:
       --bg_window: #1a1a1a;
       --bg_base: #1a1a1a;
       --bg_preview: #101010;
       --bg_dock: #2d2d2d;
       --bg_hover: #4d4d4d;
       --text: #e6e6e6;
       --text_light: #e6e6e6;
       --text_muted: #808080;
       --text_inactive: #666666;
       --text_inverse: #FFFFFF;
       --text_disabled: #666666;
       --primary: #39c5bb;
       --primary_light: #7be1d9;
       --primary_lighter: #bcf2ee;
       --primary_dark: #2a9b92;
       --primary_darker: #1c6d66;
       --input_bg: #2d2d2d;
       --input_bg_hover: #4d4d4d;
       --input_bg_focus: #404040;
       --input_border: #4d4d4d;
       --input_border_hover: #808080;
       --button_bg: #2d2d2d;
       --button_bg_hover: #4d4d4d;
       --button_bg_disabled: #1a1a1a;
       --list_item_bg_hover: #404040;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #4d4d4d;
       --ico: #e6e6e6;
       --ico_selected: #1a1a1a;
       --warning: #f6c177;
       --danger: #ff0055;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(57, 197, 187, 0.3);
       --accent_bg_end: rgba(57, 197, 187, 0.1);
    */

    --bg_window: #1a1a1a;
    --bg_base: #1a1a1a;
    --bg_preview: #101010; 

    
    --primary: #39c5bb;
    --primary_light: #7be1d9;
    --primary_lighter: #bcf2ee;
    --primary_dark: #2a9b92;
    --primary_darker: #1c6d66;

    --warning: #f6c177; 
    --danger: #ff0055;  

    --text: #e6e6e6;
    --text_light: #e6e6e6;
    --text_muted: #808080;

    --text_disabled: #666666;
    --text_inactive: #666666;
    --text_inverse: #FFFFFF;

    --border_color: #4d4d4d;

    
    --input_bg: #2d2d2d;
    --input_bg_hover: #4d4d4d;
    --input_bg_focus: #404040;

    --list_item_bg_hover: #404040;

    --input_border: #4d4d4d;
    --input_border_hover: #808080;

    --button_bg: #2d2d2d;
    --button_bg_hover: #4d4d4d;
    --button_bg_disabled: #1a1a1a;

    
    
    --accent_bg_start: rgba(57, 197, 187, 0.3);
    --accent_bg_end: rgba(57, 197, 187, 0.1);

    --bg_dock: #2d2d2d;
    --bg_hover: #4d4d4d;

    
    --ico: var(--text);
    --ico_selected: #1a1a1a;

}