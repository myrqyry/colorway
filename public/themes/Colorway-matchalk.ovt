@OBSThemeMeta {
    name: 'matchalk';
    id: 'com.myrqyry.Colorway.matchalk';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: matchalk
       Hex colors:
       --bg_window: #273136;
       --bg_base: #273136;
       --bg_preview: #1c2427;
       --bg_dock: #1c2427;
       --bg_hover: #323e45;
       --text: #D1DED3;
       --text_light: #D1DED3;
       --text_muted: #7ea4b0;
       --text_inactive: #304e37;
       --text_inverse: #000000;
       --text_disabled: #304e37;
       --primary: #d2b48c;
       --primary_light: #7eb08a;
       --primary_lighter: #D1DED3;
       --primary_dark: #7ea4b0;
       --primary_darker: #304e37;
       --input_bg: #323e45;
       --input_bg_hover: #323e45;
       --input_bg_focus: #3c4951;
       --input_border: #4B5C66;
       --input_border_hover: #d2b48c;
       --button_bg: #937D62;
       --button_bg_hover: #d2b48c;
       --button_bg_disabled: #273136;
       --list_item_bg_hover: #3c4951;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #323e45;
       --ico: #D1DED3;
       --ico_selected: #273136;
       --warning: #ba8eaf;
       --danger: #ff819f;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(210, 180, 140, 0.3);
       --accent_bg_end: rgba(210, 180, 140, 0.1);
    */

    --accent_bg_start: 'rgba(210, 180, 140, 0.3)';
    --accent_bg_end: 'rgba(210, 180, 140, 0.1)';

    --bg_window: #273136;
    --bg_base: #273136;
    --bg_preview: #1c2427;

    --primary: #d2b48c;
    --primary_light: #7eb08a;
    --primary_lighter: #D1DED3;
    --primary_dark: #7ea4b0;
    --primary_darker: #304e37;

    --warning: #ba8eaf;
    --danger: #ff819f;

    --text: #D1DED3;
    --text_light: #D1DED3;
    --text_muted: #7ea4b0;

    --text_disabled: #304e37;
    --text_inactive: #304e37;
    --text_inverse: #000000;

    --border_color: #323e45;

    --input_bg: #323e45;
    --input_bg_hover: #323e45;
    --input_bg_focus: #3c4951;

    --list_item_bg_hover: #3c4951;

    --input_border: #4B5C66;
    --input_border_hover: #d2b48c;

    --button_bg: #937D62;
    --button_bg_hover: #d2b48c;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #273136;

    --bg_dock: #1c2427;
    --bg_hover: #323e45;

    
    --ico: var(--text);
    --ico_selected: #273136;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #D1DED3;
    --on_panel_muted: #7ea4b0;
    --on_base_muted: #7ea4b0;
    --on_preview_muted: #7ea4b0;
    --on_preview: #D1DED3;
    --on_list_hover: #D1DED3;
    --on_hover: #D1DED3;
    --on_panel_disabled: #5a725f;
    --on_base_disabled: #687d6d;
    --on_panel_outline: #646e73;
    --on_section_heading: #d2b48c;
    --on_panel_accent: #d2b48c;
    --on_button: #171918;
    --on_button_disabled: #687d6d;
    --on_input: #D1DED3;
    --on_input_hover: #D1DED3;
    --on_input_focus: #D1DED3;
    --on_nav_hover: #D1DED3;
    --on_mixer_muted: #ff819f;
    --on_mixer_warning: #ba8eaf;
    --cw_icon_cogs_button: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_filter_button: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ff819f.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ba8eaf.svg)';
    /* colorway:state-tokens:end */

}
