@OBSThemeMeta {
    name: 'Sailor Moon Background';
    id: 'com.myrqyry.Colorway.SailorMoonBackground';
    extends: 'com.myrqyry.Colorway';
    author: 'OldNinjaCat / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Sailor Moon Background
       Hex colors:
       --bg_window: #00245c;
       --bg_base: #00245c;
       --bg_preview: #144d70;
       --bg_dock: #3c7596;
       --bg_hover: #144d70;
       --text: #e8f8d7;
       --text_light: #ffffff;
       --text_muted: #8797c5;
       --text_inactive: #3c377b;
       --text_inverse: #000000;
       --text_disabled: #3c377b;
       --primary: #bdffff;
       --primary_light: #a0e1d9;
       --primary_lighter: #e8f8d7;
       --primary_dark: #5db8ca;
       --primary_darker: #378dae;
       --input_bg: #144d70;
       --input_bg_hover: #144d70;
       --input_bg_focus: #1e6da0;
       --input_border: #144d70;
       --input_border_hover: #bdffff;
       --button_bg: #675390;
       --button_bg_hover: #8797c5;
       --button_bg_disabled: #00245c;
       --list_item_bg_hover: #00245c;
       --list_item_bg_selected: #a0e1d9;
       --border_color: #3c7596;
       --warning: #fdd3b0;
       --danger: #e055b8;
       --success: #a0e1d9;
       --meter_bg_nom: #144d70;
       --meter_bg_war: #fdd3b0;
       --meter_bg_err: #e055b8;
       --meter_fg_nom: #bdffff;
       --meter_fg_war: #fdd3b0;
       --meter_fg_err: #e055b8;
       Derived colors:
       --accent_bg_start: rgba(189, 255, 255, 0.3);
       --accent_bg_end: rgba(189, 255, 255, 0.1);
    */
    --bg_window: #00245c;
    --bg_base: #00245c;
    --bg_preview: #144d70;
    --bg_dock: #3c7596;
    --bg_hover: #144d70;

    --primary: #bdffff;
    --primary_light: #a0e1d9;
    --primary_lighter: #e8f8d7;
    --primary_dark: #5db8ca;
    --primary_darker: #378dae;

    --warning: #fdd3b0;
    --danger: #e055b8;

    --text: #e8f8d7;
    --text_light: #ffffff;
    --text_muted: #8797c5;
    --text_disabled: #3c377b;
    --text_inactive: #3c377b;

    --border_color: #3c7596;

    --input_bg: #144d70;
    --input_bg_hover: #144d70;
    --input_bg_focus: #1e6da0;
    --list_item_bg_hover: #00245c;
    --list_item_bg_selected: #a0e1d9;
    --input_border: #144d70;
    --input_border_hover: #bdffff;

    --button_bg: #675390;
    --button_bg_hover: #8797c5;
    --button_bg_disabled: #00245c;

    --success: #a0e1d9;
    --meter_bg_nom: #144d70;
    --meter_bg_war: #fdd3b0;
    --meter_bg_err: #e055b8;
    --meter_fg_nom: #bdffff;
    --meter_fg_war: #fdd3b0;
    --meter_fg_err: #e055b8;

    --accent_bg_start: rgba(189, 255, 255, 0.3);
    --accent_bg_end: rgba(189, 255, 255, 0.1);

    --text_inverse: #000000;
}
