@OBSThemeMeta {
    name: 'Screen Burn Monitor';
    id: 'com.myrqyry.Colorway.ScreenBurnMonitor';
    extends: 'com.myrqyry.Colorway';
    author: 'SteelSoldier / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Screen Burn Monitor
       Hex colors:
       --bg_window: #05090f;
       --bg_base: #05090f;
       --bg_preview: #19252e;
       --bg_dock: #19252e;
       --bg_hover: #324d4b;
       --text: #cccbc2;
       --text_light: #ededed;
       --text_muted: #aba89a;
       --text_inactive: #7f8a75;
       --text_inverse: #05090f;
       --text_disabled: #5f6b4b;
       --primary: #208763;
       --primary_light: #5d8756;
       --primary_lighter: #7f8a75;
       --primary_dark: #324d4b;
       --primary_darker: #19252e;
       --input_bg: #19252e;
       --input_bg_hover: #324d4b;
       --input_bg_focus: #324d4b;
       --input_border: #324d4b;
       --input_border_hover: #208763;
       --button_bg: #324d4b;
       --button_bg_hover: #7f8a75;
       --button_bg_disabled: #19252e;
       --list_item_bg_hover: #19252e;
       --list_item_bg_selected: #324d4b;
       --border_color: #324d4b;
       --ico: #cccbc2;
       --ico_selected: #05090f;
       --warning: #877920;
       --danger: #cf6f82;
       --success: #5d8756;
       --meter_bg_nom: #19252e;
       --meter_bg_war: #87423e;
       --meter_bg_err: #87203f;
       --meter_fg_nom: #5d8756;
       --meter_fg_war: #877920;
       --meter_fg_err: #cf6f82;
       Derived colors:
       --accent_bg_start: rgba(32, 135, 99, 0.3);
       --accent_bg_end: rgba(32, 135, 99, 0.1);
    */

    /* Lospec palette: Screen Burn Monitor — SteelSoldier
       Source: https://lospec.com/palette-list/screen-burn-monitor
       Curated OBS semantic mapping; alert legibility may use derived colors.
       All other solid swatches preserve the source palette. */

    --bg_window: #05090f;
    --bg_base: #05090f;
    --bg_preview: #19252e;
    --bg_dock: #19252e;
    --bg_hover: #324d4b;
    --text: #cccbc2;
    --text_light: #ededed;
    --text_muted: #aba89a;
    --text_inactive: #7f8a75;
    --text_disabled: #5f6b4b;
    --text_inverse: #05090f;
    --primary: #208763;
    --primary_light: #5d8756;
    --primary_lighter: #7f8a75;
    --primary_dark: #324d4b;
    --primary_darker: #19252e;
    --input_bg: #19252e;
    --input_bg_hover: #324d4b;
    --input_bg_focus: #324d4b;
    --input_border: #324d4b;
    --input_border_hover: #208763;
    --button_bg: #324d4b;
    --button_bg_hover: #7f8a75;
    --button_hover_text: #05090f;
    --button_bg_disabled: #19252e;
    --list_item_bg_hover: #19252e;
    --list_item_bg_selected: #324d4b;
    --border_color: #324d4b;
    --warning: #877920;
    --danger: #cf6f82;
    --success: #5d8756;
    --meter_bg_nom: #19252e;
    --meter_bg_war: #87423e;
    --meter_bg_err: #87203f;
    --meter_fg_nom: #5d8756;
    --meter_fg_war: #877920;
    --meter_fg_err: #cf6f82;
    --accent_bg_start: 'rgba(32, 135, 99, 0.3)';
    --accent_bg_end: 'rgba(32, 135, 99, 0.1)';
    --ico: var(--text);
    --ico_selected: var(--text_inverse);
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/normal/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #cccbc2;
    --on_panel_muted: #aba89a;
    --on_base_muted: #aba89a;
    --on_preview_muted: #aba89a;
    --on_preview: #ededed;
    --on_list_hover: #ededed;
    --on_hover: #ededed;
    --on_panel_disabled: #657152;
    --on_base_disabled: #5f6b4b;
    --on_panel_outline: #5b716f;
    --on_section_heading: #218864;
    --on_panel_accent: #41997a;
    --on_button: #cccbc2;
    --on_button_disabled: #657152;
    --on_input: #cccbc2;
    --on_input_hover: #cccbc2;
    --on_input_focus: #cccbc2;
    --on_nav_hover: #ededed;
    --on_mixer_muted: #cf6f82;
    --on_mixer_monitor: #5d8756;
    --on_mixer_warning: #877920;
    --on_primary: #000000;
    --on_primary_dark: var(--text);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-cf6f82.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-5d8756.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-877920.svg)';
    /* colorway:state-tokens:end */

}
