@OBSThemeMeta {
    name: 'AMOLED';
    id: 'com.myrqyry.Colorway.Amoled';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(179, 136, 255, 0.3);
    --accent_bg_end: rgba(179, 136, 255, 0.1);

    /* Base Theme Colors */
    --bg_window: #000000;
    --bg_base: #000000;
    --bg_preview: #1a1a1a;

    --primary: #b388ff;
    --primary_light: #18ffff;
    --primary_lighter: #ff4081;
    --primary_dark: #00ff88;
    --primary_darker: #555555;

    --warning: #ffea00;
    --danger: #ff1744;

    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #555555;

    --text_disabled: #484848;
    --text_inactive: #484848;

    --border_color: #141414;

    /* Inputs and Buttons */
    --input_bg: #1a1a1a;
    --input_bg_hover: #252525;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #252525;

    --input_border: #141414;
    --input_border_hover: #b388ff;

    --button_bg: #000000;
    --button_bg_hover: #252525;
    --button_bg_disabled: #000000;

    /* Theme Aliases */
    --bg_dock: #000000;
    --bg_hover: #252525;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #000000;
}
