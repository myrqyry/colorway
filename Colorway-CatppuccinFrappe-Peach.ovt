@OBSThemeMeta {
    name: 'Catppuccin Frappé — Peach';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Peach';
    extends: 'com.myrqyry.Colorway.CatppuccinFrappe';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #ef9f76;
    --primary_light: #e5c890;
    --primary_lighter: #f2d5cf;
    --primary_dark: #ea999c;
    --primary_darker: #626880;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #303446;
}
