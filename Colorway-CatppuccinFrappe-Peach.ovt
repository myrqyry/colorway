@OBSThemeMeta {
    name: 'Catppuccin Frappé — Peach';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Peach';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Catppuccin Frappé — Peach
       Hex colors:
       --bg_window: #292c3c;
       --bg_base: #303446;
       --bg_preview: #232634;
       --bg_dock: #292c3c;
       --bg_hover: #414559;
       --text: #c6d0f5;
       --text_light: #f5f5f5;
       --text_muted: #838ba7;
       --text_inactive: #a5adce;
       --text_inverse: #FFFFFF;
       --text_disabled: #a5adce;
       --primary: #ef9f76;
       --primary_light: #e5c890;
       --primary_lighter: #f2d5cf;
       --primary_dark: #ea999c;
       --primary_darker: #626880;
       --input_bg: #414559;
       --input_bg_hover: #51576d;
       --input_bg_focus: #464d5e;
       --input_border: #5B607B;
       --input_border_hover: #626880;
       --button_bg: #292c3c;
       --button_bg_hover: #414559;
       --button_bg_disabled: #303446;
       --list_item_bg_hover: #484f5f;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #414559;
       --ico: #c6d0f5;
       --ico_selected: #303446;
       --warning: #ef9f76;
       --danger: #e78284;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(239, 159, 118, 0.3);
       --accent_bg_end: rgba(239, 159, 118, 0.1);
    */
    --bg_window: #292c3c;
    --bg_base: #303446;
    --bg_preview: #232634;
    --primary: #ef9f76;
    --primary_light: #e5c890;
    --primary_lighter: #f2d5cf;
    --primary_dark: #ea999c;
    --primary_darker: #626880;
    --warning: #ef9f76;
    --danger: #e78284;
    --text: #c6d0f5;
    --text_light: #f5f5f5;
    --text_muted: #838ba7;
    --text_disabled: #a5adce;
    --text_inactive: #a5adce;
    --text_inverse: #FFFFFF;
    --border_color: #414559;
    --input_bg: #414559;
    --input_bg_hover: #51576d;
    --input_bg_focus: #464d5e;
    --list_item_bg_hover: #484f5f;
    --input_border: #5B607B;
    --input_border_hover: #626880;
    --button_bg: #292c3c;
    --button_bg_hover: #414559;
    --button_bg_disabled: #303446;
    --bg_dock: #292c3c;
    --bg_hover: #414559;
    --ico: var(--text);
    --ico_selected: #303446;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(239, 159, 118, 0.3);
    --accent_bg_end: rgba(239, 159, 118, 0.1);
}
