@OBSThemeMeta {
    name: 'Catppuccin Frappé — Rosewater';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Rosewater';
    extends: 'com.myrqyry.Colorway.CatppuccinFrappe';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #f2d5cf;
    --primary_light: #eebebe;
    --primary_lighter: #f4b8e4;
    --primary_dark: #ef9f76;
    --primary_darker: #626880;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #303446;
}
