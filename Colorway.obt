@OBSThemeMeta {
    name: 'Colorway';
    id: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* OBS Color Palette */
    --blue1: #718CDC;
    --blue2: #476BD7;
    --blue3: #284CB8;
    --blue4: #213E97;
    --blue5: #1A3278;
    --blue6: #162A64;

    --red1: #E85E75;
    --red2: #E33B57;
    --red3: #C01C37;
    --red4: #A1172E;
    --red5: #7D1224;
    --red6: #590D1A;

    --pink1: #E5619A;
    --pink2: #E03E84;
    --pink3: #C11F65;
    --pink4: #9E1A53;
    --pink5: #7B1441;
    --pink6: #580E2E;

    --teal1: #3DBEF5;
    --teal2: #16B1F3;
    --teal3: #0981B4;
    --teal4: #086F9B;
    --teal5: #065374;
    --teal6: #04374E;

    --purple1: #997FDC;
    --purple2: #805FD3;
    --purple3: #5B34BF;
    --purple4: #4D2CA0;
    --purple5: #3D2380;
    --purple6: #2E1A60;

    --green1: #59D966;
    --green2: #37D247;
    --green3: #25A231;
    --green4: #1E8528;
    --green5: #17641E;
    --green6: #0F4313;

    --yellow1: #EABC48;
    --yellow2: #E5AF24;
    --yellow3: #B88A16;
    --yellow4: #926E11;
    --yellow5: #6E520D;
    --yellow6: #493709;

    --grey1: #5B6273;
    --grey2: #4E5566;
    --grey3: #464B59;
    --grey4: #3C404D;
    --grey5: #323540;
    --grey6: #272A33;
    --grey7: #1D1F26;
    --grey8: #13141A;

    --white1: #FFFFFF;
    --white2: #E1E1E1;
    --white3: #D2D2D2;
    --white4: #B4B4B4;
    --white5: #969696;

    --black1: #0A0A0A;
    --black2: #1F1F1F;
    --black3: #414141;
    --black4: #646464;
    --black5: #828282;

    /* Base Theme Colors */
    --bg_window: #191724;
    --bg_base: #191724;
    --bg_preview: #26233a;

    --primary: #c4a7e7;
    --primary_light: #e0def4;
    --primary_lighter: #f0ebff;
    --primary_dark: #907aa9;
    --primary_darker: #524f67;

    --warning: #f6c177;
    --danger: #eb6f92;

    --text: #e0def4;
    --text_light: #ffffff;
    --text_muted: #908caa;

    --text_disabled: #6e6a86;
    --text_inactive: #6e6a86;

    --border_color: #403d52;

    /* Layout & Accessibility Scaling */
    --font_base_value: var(--obsFontScale);
    --padding_base_value: var(--obsPadding);
    --spacing_base_value: calc(2 + calc(var(--obsPadding) / 2));

    --highlight_width: 1px;
    --highlight_color: var(--primary_lighter);

    --border_highlight: transparent;

    /* OS Fixes */
    --os_mac_font_base_value: calc(1.2 * var(--obsFontScale));

    --font_base: calc(1pt * var(--font_base_value));
    --font_small: max(7pt, calc(0.8pt * var(--font_base_value)));
    --font_xsmall: max(6.75pt, calc(0.65pt * var(--font_base_value)));
    --font_large: calc(1.1pt * var(--font_base_value));
    --font_xlarge: calc(1.5pt * var(--font_base_value));

    --font_heading: calc(2.5pt * var(--font_base_value));

    --icon_base: calc(calc(max(2, var(--obsPadding)) * 1px) + 12px);
    --icon_small: calc(4px + var(--font_base_value));

    --spacing_base: min(max(1px, calc(0.4 * var(--spacing_base_value))), 2px);
    --spacing_large: min(max(2px, calc(1px * var(--spacing_base_value))), 4px);
    --spacing_small: max(1px, calc(0.25px * var(--spacing_base_value)));
    --spacing_title: 4px;

    --padding_base: calc(0.5px * var(--padding_base_value));
    --padding_large: min(max(1px, calc(1px * var(--padding_base_value))), 5px);
    --padding_xlarge: min(max(2px, calc(1.75px * var(--padding_base_value))), 10px);
    --padding_small: max(0px, calc(0.25px * var(--padding_base_value)));

    --padding_container: max(4px, var(--padding_base));
    --padding_wide: min(calc(12px + max(var(--padding_base_value), 4)), 24px);
    --padding_menu: calc(4px + calc(2 * var(--padding_base_value)));
    --padding_menubar: max(6px, calc(2px + calc(1.25 * var(--padding_base_value))));

    --padding_base_border: calc(var(--padding_base) + 1px);

    --spinbox_button_height: calc(var(--input_height_half) - 1px);

    --volume_slider: calc(calc(4px + var(--font_base_value)) / 4);
    --volume_slider_box: calc(var(--volume_slider) * 4);
    --volume_slider_label: calc(var(--volume_slider_box) * 2);

    --scrollbar_size: 10px;
    --settings_scrollbar_size: calc(var(--scrollbar_size) + 9px);
    --scrollbar_handle: var(--border_color);

    --scrollbar_bg: #181818;
    --scrollbar_hover: var(--primary);
    --scrollbar_down: var(--primary_dark);

    --scrollbar_border: #333333;

    /* Semantic Feedback Active States */
    --live: #38bdf8;
    --recording: #fb4d5d;
    --lavender_accent: var(--primary);

    /* Semantic Feedback Backgrounds */
    --live_bg_start: rgba(56, 189, 248, 0.3);
    --live_bg_end: rgba(56, 189, 248, 0.1);
    --recording_bg_start: rgba(251, 77, 93, 0.3);
    --recording_bg_end: rgba(251, 77, 93, 0.1);
    --accent_bg_start: rgba(196, 167, 231, 0.3);
    --accent_bg_end: rgba(196, 167, 231, 0.1);

    /* Indicator Tint Overlays */
    --tint_amber: rgba(251, 191, 36, 0.1);
    --tint_green: rgba(74, 222, 128, 0.1);
    --tint_red: rgba(244, 63, 94, 0.1);

    /* Material Rounded Corners */
    --border_radius: 9px;
    --border_radius_small: 5px;
    --border_radius_large: 12px;

    /* Accessibility Sizing for Sliders (Enlarged and aligned to track height) */
    --slider_groove_thickness: 14px;
    --slider_groove_radius: 7px;
    --slider_handle_size: 14px;       /* Set equal to track thickness to stop vertical clipping */
    --slider_handle_radius: 7px;     /* Half of 14px for a perfect circle */
    --slider_handle_margin: 0px;      /* Set to 0px since no vertical centering offset is needed */

    /* Inputs & Layout Controls */
    --input_font_scale: calc(var(--font_base_value) * 2.2);
    --input_font_padding: calc(var(--padding_base_value) * 2);

    --input_height_base: max(calc(var(--input_font_scale) + var(--input_font_padding)), 24);
    --input_padding: calc(2px + var(--padding_base));
    --input_text_padding: max(calc(6px + var(--padding_base)), 8px);
    --input_height: calc(var(--input_height_base) - calc(var(--input_padding) * 2));
    --input_height_half: calc(var(--input_height_base) / 2);

    --input_bg: #26233a;
    --input_bg_hover: #403d52;
    --input_bg_focus: #2d2a42;

    --list_item_bg_selected: var(--primary);
    --list_item_bg_hover: #332f4a;

    --input_border: #403d52;
    --input_border_width: 1px;
    --input_border_hover: #524f67;
    --input_border_focus: var(--primary);

    --spacing_input: var(--spacing_base);

    --button_bg: #1f1d2e;
    --button_bg_hover: #26233a;
    --button_bg_down: var(--primary);
    --button_bg_disabled: #21202e;

    --button_border_width: var(--input_border_width);
    --button_border: var(--button_bg);
    --button_border_hover: var(--border_color);
    --button_border_focus: var(--primary);

    --tab_bg: var(--button_bg_disabled);
    --tab_bg_hover: var(--button_bg_hover);
    --tab_bg_down: var(--primary);
    --tab_bg_disabled: var(--button_bg_disabled);

    --tab_border: var(--border_color);
    --tab_border_hover: var(--button_border_hover);
    --tab_border_focus: var(--primary_lighter);
    --tab_border_selected: var(--primary);

    --tab_padding_base: calc(5px + var(--padding_base));
    --tab_padding_large: calc(9px + var(--padding_base));

    --preview_scale_width: calc(calc(var(--input_text_padding) * 3.5) * calc(var(--font_base_value) / 10));

    --separator_hover: var(--text_light);

    --action_row_base: calc(var(--input_height_base) * 0.75);
    --action_row_height: calc(var(--action_row_base) + calc(var(--action_row_padding) * 2px));
    --action_row_border: 3px;
    --action_row_input_width: calc(var(--action_row_base) * 4);
    --action_row_collapse: calc(var(--action_row_base) + var(--padding_large));
    --action_row_collapse_radius: calc(var(--action_row_collapse) / 2);
    --action_row_padding: calc(var(--padding_large) * 1.5);
    --action_row_padding_x: calc(var(--action_row_padding) * 2);
    --action_row_padding_nested: calc(var(--action_row_padding_x) * 1.5);

    --toggle_border: 1;
    --toggle_margin: 3;
    --toggle_width: calc(var(--action_row_base) * 1.8);
    --toggle_height: calc(var(--action_row_base) * 0.9);
    --toggle_handle: calc(calc(calc(var(--toggle_height) * 0.9) - calc(var(--toggle_border) * 2)) - var(--toggle_margin));
    --toggle_radius: calc(var(--toggle_height) / 2);

    /* Qt Palette variables can be set with the "palette_" prefix */
    --palette_window: var(--bg_window);
    --palette_windowText: var(--text);
    --palette_base: var(--bg_base);

    --palette_light: var(--input_bg_hover);
    --palette_mid: var(--bg_preview);
    --palette_dark: #1f1d2e;

    --palette_highlight: var(--primary);
    --palette_highlightedText: var(--text_inverse);

    --palette_text: var(--text);
    --palette_link: var(--primary_light);
    --palette_linkVisited: var(--primary);

    --palette_button: var(--button_bg);
    --palette_buttonText: var(--text);

    --palette_text_active: var(--text);
    --palette_text_disabled: var(--text_disabled);
    --palette_text_inactive: var(--text_inactive);

    /* Theme Aliases */
    --bg_dock: #1f1d2e;
    --bg_hover: #26233a;
    --bg_input: var(--input_bg);
    --border_base: var(--border_color);
    --border_focus: var(--primary);
    --text_base: var(--text);
    --text_bright: var(--text_light);
    --text_inverse: var(--bg_base);
    --primary_hover: var(--primary_light);
    --primary_dark_alias: var(--primary_dark);

    --meter_bg_nom: var(--bg_hover);
    --meter_bg_war: var(--warning);
    --meter_bg_err: var(--danger);
    --meter_fg_nom: var(--primary);
    --meter_fg_war: var(--warning);
    --meter_fg_err: var(--danger);

    --icon_add: url(theme:icons/colorway/iconamoon/normal/plus.svg);
    --icon_remove: url(theme:icons/colorway/iconamoon/normal/minus.svg);
    --icon_settings: url(theme:icons/colorway/iconamoon/normal/settings.svg);
    --icon_refresh: url(theme:icons/colorway/iconamoon/normal/refresh.svg);
    --icon_up: url(theme:icons/colorway/iconamoon/normal/arrow-up.svg);
    --icon_down: url(theme:icons/colorway/iconamoon/normal/arrow-down.svg);
    --icon_eye: url(theme:icons/colorway/iconamoon/normal/eye.svg);
    --icon_eye_off: url(theme:icons/colorway/iconamoon/normal/eye-off.svg);
    --icon_lock: url(theme:icons/colorway/iconamoon/normal/lock.svg);
    --icon_unlock: url(theme:icons/colorway/iconamoon/normal/unlock.svg);
    --icon_vol_high: url(theme:icons/colorway/iconamoon/normal/volume-high.svg);
    --icon_vol_mute: url(theme:icons/colorway/iconamoon/normal/volume-mute.svg);
    --icon_tree_closed: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
    --icon_tree_open: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    --icon_dock_close: url(theme:icons/colorway/iconamoon/normal/close.svg);
    --icon_dock_popout: url(theme:icons/colorway/iconamoon/normal/popout.svg);
    --icon_check: url(theme:icons/colorway/iconamoon/normal/check.svg);
    --pattern_eyes: url(theme:patterns/pattern.svg);

    /* Elevation & Depth Simulation */
    --elevation_1: rgba(0, 0, 0, 0.15);
    --elevation_2: rgba(0, 0, 0, 0.25);

    /* Focus Glow */
    --focus_glow: rgba(196, 167, 231, 0.15);

    /* M3 Expressive - Surface Tone Hierarchy (auto-adapts to variants) */
    --surface0: var(--bg_base);
    --surface1: var(--bg_dock);
    --surface2: var(--bg_preview);
    --surface3: var(--input_bg_focus);
    --surface4: var(--input_bg_hover);
    --surface_dim: var(--grey8);

    /* M3 Expressive - Container Colors */
    --primary_container: var(--surface3);
    --on_primary_container: var(--text);
    --secondary_container: var(--surface2);
    --on_secondary_container: var(--text);

    /* M3 Expressive - Expanded Shape Scale */
    --shape_xs: 3px;
    --shape_sm: 5px;
    --shape_md: 9px;
    --shape_lg: 16px;
    --shape_xl: 24px;
    --shape_full: 999px;

    /* M3 Expressive - Typography Role Aliases */
    --font_label_size: var(--font_small);
    --font_label_weight: 500;
    --font_body_size: var(--font_base);
    --font_body_weight: 400;
    --font_title_size: var(--font_xlarge);
    --font_title_weight: 600;
    --font_headline_size: var(--font_heading);
    --font_headline_weight: 700;

}

/* --------------------- */
/* General Styling Hints */

.bg_window {
    background-color: var(--bg_window);
}

.bg-base {
    background-color: var(--bg_base);
}

.text-title {
    font-size: var(--font_large);
    font-weight: bold;
}

.text-small {
    font-size: var(--font_small);
}

.text-tiny {
    font-size: var(--font_xsmall);
}

.text-heading {
    font-size: var(--font_heading);
    font-weight: bold;
}

.text-large {
    font-size: var(--font_large);
}

.text-bold {
    font-weight: bold;
}

.text-italic {
    font-style: italic;
}

.text-bright {
    color: var(--primary_light);
}

.text-muted {
    color: var(--text_muted);
}

.text-warning {
    color: var(--warning);
}

.text-danger {
    color: var(--danger);
}

.text-success {
    color: var(--green3);
}

.frame-notice {
    background: var(--grey8);
    border: 1px solid var(--grey6);
    border-radius: var(--border_radius);
    padding: var(--padding_xlarge) var(--padding_large);
}

.frame-notice QLabel {
    padding: var(--padding_large) 0px;
}

.dialog-container {
    padding: var(--padding_large) var(--padding_xlarge);
}

.dialog-frame {
    background-color: var(--surface1);
    border-radius: var(--shape_md);
    border: 1px solid var(--border_color);
    margin: var(--spacing_base);
}

.dialog-frame > QWidget {
    margin: var(--spacing_base) 0;
}

.subtitle {
    font-size: var(--font_small);
    font-weight: bold;
    color: var(--text_muted);
}

.button-primary {
    background-color: var(--primary_dark);
    border-color: var(--primary);
    outline: none;
}

.button-primary:hover,
.button-primary:focus {
    background-color: var(--primary);
    border-color: var(--white3);
}

.button-primary:hover {
    border-color: var(--primary_light);
}

.toolbar-button {
    background: transparent;
    font-weight: bold;
    padding: 0 var(--padding_xlarge);
    margin: var(--spacing_small) var(--spacing_small) 0px;
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

.margin {
    margin: var(--spacing_base);
}

.margin-x {
    margin-left: var(--spacing_base);
    margin-right: var(--spacing_base);
}

.margin-left {
    margin-left: var(--spacing_base);
}

.margin-right {
    margin-right: var(--spacing_base);
}

.margin-y {
    margin-top: var(--spacing_base);
    margin-bottom: var(--spacing_base);
}

.margin-top {
    margin-top: var(--spacing_base);
}

.margin-bottom {
    margin-bottom: var(--spacing_base);
}

/* Icon Overrides */

.icon-plus { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/plus.svg); }

.icon-minus { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/minus.svg); }

.icon-trash { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/trash.svg); }

.icon-clear { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/close.svg); }

.icon-gear { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/settings.svg); }

.icon-dots-vert { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/dots-vert.svg); }

.icon-refresh { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/refresh.svg); }

.icon-cogs { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/cogs.svg); }

.icon-touch { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/interact.svg); }

.icon-up { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/chevron-up.svg); }

.icon-down { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg); }

.icon-pause { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/pause.svg); }

.icon-filter { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/filter.svg); }

.icon-revert { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/revert.svg); }

.icon-save { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/save.svg); }

.icon-close { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/close.svg); }

.icon-pin { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/pin.svg); }

.icon-layout-vertical { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/layout-vertical.svg); }

.icon-layout-horizontal { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/layout-horizontal.svg); }

/* Media icons */

.icon-media-play { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/media-play.svg); }

.icon-media-pause { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/pause.svg); }

.icon-media-restart { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/refresh.svg); }

.icon-media-stop { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/media-stop.svg); }

.icon-media-next { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/skip_forward.svg); }

.icon-media-previous { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/skip_previous.svg); }

/* Dark icon swaps for icon classes on light backgrounds */
QListView::item:selected:hover .icon-plus,
QListWidget::item:selected:hover .icon-plus,
QTreeView::item:selected:hover .icon-plus {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/plus.svg);
}

QListView::item:selected:hover .icon-minus,
QListWidget::item:selected:hover .icon-minus,
QTreeView::item:selected:hover .icon-minus {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/minus.svg);
}

QListView::item:selected:hover .icon-trash,
QListWidget::item:selected:hover .icon-trash,
QTreeView::item:selected:hover .icon-trash {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/trash.svg);
}

QListView::item:selected:hover .icon-clear,
QListWidget::item:selected:hover .icon-clear,
QTreeView::item:selected:hover .icon-clear {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/close.svg);
}

QListView::item:selected:hover .icon-gear,
QListWidget::item:selected:hover .icon-gear,
QTreeView::item:selected:hover .icon-gear {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/settings.svg);
}

QListView::item:selected:hover .icon-dots-vert,
QListWidget::item:selected:hover .icon-dots-vert,
QTreeView::item:selected:hover .icon-dots-vert {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/dots-vert.svg);
}

QListView::item:selected:hover .icon-refresh,
QListWidget::item:selected:hover .icon-refresh,
QTreeView::item:selected:hover .icon-refresh {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/refresh.svg);
}

QListView::item:selected:hover .icon-cogs,
QListWidget::item:selected:hover .icon-cogs,
QTreeView::item:selected:hover .icon-cogs {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/cogs.svg);
}

QListView::item:selected:hover .icon-touch,
QListWidget::item:selected:hover .icon-touch,
QTreeView::item:selected:hover .icon-touch {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/interact.svg);
}

QListView::item:selected:hover .icon-up,
QListWidget::item:selected:hover .icon-up,
QTreeView::item:selected:hover .icon-up {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/chevron-up.svg);
}

QListView::item:selected:hover .icon-down,
QListWidget::item:selected:hover .icon-down,
QTreeView::item:selected:hover .icon-down {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/chevron-down.svg);
}

QListView::item:selected:hover .icon-pause,
QListWidget::item:selected:hover .icon-pause,
QTreeView::item:selected:hover .icon-pause {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/pause.svg);
}

QListView::item:selected:hover .icon-filter,
QListWidget::item:selected:hover .icon-filter,
QTreeView::item:selected:hover .icon-filter {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/filter.svg);
}

QListView::item:selected:hover .icon-revert,
QListWidget::item:selected:hover .icon-revert,
QTreeView::item:selected:hover .icon-revert {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/revert.svg);
}

QListView::item:selected:hover .icon-save,
QListWidget::item:selected:hover .icon-save,
QTreeView::item:selected:hover .icon-save {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/save.svg);
}

QListView::item:selected:hover .icon-close,
QListWidget::item:selected:hover .icon-close,
QTreeView::item:selected:hover .icon-close {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/close.svg);
}

QListView::item:selected:hover .icon-pin,
QListWidget::item:selected:hover .icon-pin,
QTreeView::item:selected:hover .icon-pin {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/pin.svg);
}

QListView::item:selected:hover .icon-layout-vertical,
QListWidget::item:selected:hover .icon-layout-vertical,
QTreeView::item:selected:hover .icon-layout-vertical {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/layout-vertical.svg);
}

QListView::item:selected:hover .icon-layout-horizontal,
QListWidget::item:selected:hover .icon-layout-horizontal,
QTreeView::item:selected:hover .icon-layout-horizontal {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/layout-horizontal.svg);
}

QListView::item:selected:hover .icon-media-play,
QListWidget::item:selected:hover .icon-media-play,
QTreeView::item:selected:hover .icon-media-play {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/media-play.svg);
}

QListView::item:selected:hover .icon-media-pause,
QListWidget::item:selected:hover .icon-media-pause,
QTreeView::item:selected:hover .icon-media-pause {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/pause.svg);
}

QListView::item:selected:hover .icon-media-restart,
QListWidget::item:selected:hover .icon-media-restart,
QTreeView::item:selected:hover .icon-media-restart {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/refresh.svg);
}

QListView::item:selected:hover .icon-media-stop,
QListWidget::item:selected:hover .icon-media-stop,
QTreeView::item:selected:hover .icon-media-stop {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/media-stop.svg);
}

QListView::item:selected:hover .icon-media-next,
QListWidget::item:selected:hover .icon-media-next,
QTreeView::item:selected:hover .icon-media-next {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/skip_forward.svg);
}

QListView::item:selected:hover .icon-media-previous,
QListWidget::item:selected:hover .icon-media-previous,
QTreeView::item:selected:hover .icon-media-previous {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/skip_previous.svg);
}

/* Bricolage Grotesque variable font via @font-face.
   Fallback to system fonts if Qt fails to load it. */

@font-face {
    font-family: "Bricolage Grotesque";
    src: url("theme:BricolageGrotesqueVariable.ttf");
}

QWidget {
    alternate-background-color: var(--bg_base);
    color: var(--text);
    selection-background-color: var(--primary);
    selection-color: var(--text_inverse);
    font-size: var(--font_base);
    font-weight: normal;
    font-family: "Bricolage Grotesque", system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, 'Helvetica Neue', Arial, sans-serif;
}

QWidget:disabled {
    color: var(--text_disabled);
}

/* Container windows */

QDialog,
QMainWindow,
QMessageBox,
QStatusBar,
QMenuBar,
QMenu {
    background-color: var(--bg_window);
    color: var(--text_base);
}

OBSBasic,
QDialog {
    background-color: var(--bg_window);
    background-image: var(--pattern_eyes);
}

/* Central widget of the main window */
OBSBasic > QWidget {
    background: transparent;
    background-image: var(--pattern_eyes);
}

/* General Widgets */

QLabel,
QGroupBox,
QCheckBox {
    background: transparent;
}

QListView QWidget,
QListWidget QWidget {
    margin-top: 0;
    margin-bottom: 0;
}

* [frameShape="1"],
* [frameShape="2"],
* [frameShape="3"],
* [frameShape="4"],
* [frameShape="5"],
* [frameShape="6"] {
    border: 1px solid var(--bg_base);
}

QCheckBox,
QGroupBox,
QMenuBar,
QRadioButton {
    spacing: var(--spacing_small);
}

/* Misc */

QAbstractItemView {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
}

QListWidget,
SceneTree,
SourceTree {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
}

/* Context Menu */

QMenu::indicator {
    left: var(--padding_large);
}

QMenu::right-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
}

QMenu::item:selected:hover QMenu::right-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
}

/* Top Menu Bar Items */
QMenuBar::item {
    background-color: transparent;
    padding: var(--padding_large) var(--padding_menubar);
}

QMenuBar::item:selected {
    background: var(--primary);
    color: var(--text_inverse);
}

/* Toolbars */

QToolBar::separator {
    background: var(--border_color);
    width: 1px;
    margin: 0px var(--spacing_base) 0px;
}

QListWidget::item,
SourceTreeItem {
    padding: var(--padding_large) var(--padding_large);
}

SourceTreeItem {
    border-radius: var(--border_radius);
    color: var(--text);
}

/* Temporary fix for plugins affected by fix in #11555 */
QListView::item,
QListWidget::item,
SourceTreeItem {
    min-height: var(--padding_menu);
}

SourceTreeItem .checkbox-icon {
    margin-right: 0;
    margin-left: var(--spacing_large);
}

SourceTree .indicator-expand {
    margin-right: var(--spacing_large);
    margin-left: 0;
}

QMenu::item:selected,
QMenu > QWidget:selected,
QListView::item:selected,
QListWidget::item:selected,
SourceTreeItem:selected {
    background-color: var(--primary);
    border-color: var(--primary_light);
    color: var(--text_inverse);
}

QMenu::item:hover,
QListView::item:hover,
QListWidget::item:hover,
SourceTreeItem:hover {
    background: var(--list_item_bg_hover);
    border: 1px solid var(--border_base);
}

QMenu::item:focus,
QListView::item:focus,
QListWidget::item:focus,
SourceTreeItem:focus,
QMenu::item:selected:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid var(--white3);
}

QMenu::item:selected:hover,
QListView::item:selected:hover,
QListWidget::item:selected:hover,
QTreeView::item:selected:hover,
SourceTreeItem:selected:hover {
    background: var(--primary_light);
    border: 1px solid var(--primary_lighter);
    color: var(--text_inverse);
}

QMenu::item:selected:hover {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
}

QListView::item:disabled,
QListView::item:disabled:hover,
QListWidget::item:disabled,
QListWidget::item:disabled:hover {
    background: transparent;
    color: var(--text_disabled);
}

QListView QLineEdit,
QListWidget QLineEdit {
    padding: 0;
    padding-bottom: 1px;
    margin: 0;
    border: var(--input_border_width) solid var(--white1);
    border-radius: var(--border_radius);
}

QListView QLineEdit:focus,
QListWidget QLineEdit:focus {
    border: 1px solid var(--grey1);
}

/* Settings QList */

OBSBasicSettings QScrollBar:vertical {
    width: var(--settings_scrollbar_size);
    margin-left: 9px;
}

OBSBasicSettings QScrollBar:horizontal {
    height: var(--settings_scrollbar_size);
}

/* Settings properties view */
OBSBasicSettings #PropertiesContainer {
    background-color: var(--bg_base);
}

/* Dock Widget */
OBSDock > QWidget {
    background: var(--surface1);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
    border-bottom-left-radius: var(--shape_lg);
    border-bottom-right-radius: var(--shape_lg);
    border: 1px solid var(--border_color);
    border-top: none;
}

OBSDock QToolBar {
    padding: 1px;
    margin: 0px;
    height: 32px;
    max-height: 32px;
    border-top: 1px solid var(--border_color);
    spacing: 0;
}

OBSDock QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--border_radius_small);
    margin: 1px;
    margin-top: 2px;
    padding: var(--padding_large);
    max-width: var(--icon_small);
    max-height: var(--icon_small);
}

OBSDock QToolBar QToolButton:hover {
    border-color: var(--grey1);
}

OBSDock QToolBar QToolButton:disabled {
    background: var(--grey7);
}

#transitionsFrame {
    padding: var(--padding_container);
}

OBSDock QLabel {
    background: transparent;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background: var(--button_bg_down);
    padding: 1px -1px -1px 1px;
}

QAbstractScrollArea {
    border-radius: var(--border_radius);
}

/* Status Bar Widget Formatting */
OBSBasicStatusBar {
    margin-top: var(--spacing_large);
    border-top: 1px solid var(--border_color);
    background: var(--bg_base);
}

StatusBarWidget > QFrame {
    border: 0px solid var(--border_color);
    border-left-width: 1px;
    padding: 0px var(--padding_xlarge) var(--padding_small);
}

/* ScrollBars */

::corner {
    background-color: var(--bg_window);
    border: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    border: none;
    background: none;
    color: none;
}

QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    border: none;
    background: none;
    color: none;
}

QScrollBar::handle:pressed {
    background-color: var(--scrollbar_down);
    border-color: var(--scrollbar_down);
}

QScrollBar::handle:disabled {
    background: transparent;
    border-color: transparent;
}

OBSDock QScrollBar {
    border-radius: var(--border_radius_small);
}

OBSDock QListWidget::corner {
    background: transparent;
    border-top: 1px solid var(--border_color);
    border-left: 1px solid var(--border_color);
}

OBSDock QScrollBar:horizontal {
    border-top: 1px solid var(--border_color);
}

OBSDock QScrollBar:vertical {
    border-left: 1px solid var(--border_color);
}

/* Source Context Bar */

#contextContainer {
    background-color: var(--surface1);
    margin-top: 4px;
    border-radius: var(--shape_md);
}

#contextContainer QPushButton {
    padding-left: 12px;
    padding-right: 12px;
}

QPushButton#sourcePropertiesButton {
    icon-size: var(--icon_base);
}

QPushButton#sourcePropertiesButton:pressed {
}

QPushButton#sourceFiltersButton {
    icon-size: var(--icon_base);
}

QPushButton#sourceFiltersButton:pressed {
}

QToolBarExtension {
    background: var(--button_bg);
    min-width: 12px;
    max-width: 12px;
    padding: 4px 0px;
    margin-left: 0px;

}


/* Tab Widget */

QTabBar {
    outline: none;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab:top {
    border-bottom: 0px solid transparent;
    margin-bottom: 0px;
}

QTabBar::tab:bottom {
    border-top: 0px solid transparent;
    margin-top: 0px;
}

/* ComboBox */

QComboBox QAbstractItemView {
    padding: var(--spacing_base) var(--spacing_large);
    border: 1px solid var(--border_color);
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: var(--padding_large) var(--padding_xlarge);
    border-radius: var(--shape_sm);
}

QComboBox QAbstractItemView::item:selected {
    background-color: var(--primary);
    color: var(--text_inverse);
}

QComboBox QAbstractItemView::item:hover {
    background-color: var(--primary_light);
    color: var(--text_inverse);
}

QComboBox:hover,
QComboBox:focus,
QDateTimeEdit:hover,
QDateTimeEdit:selected {
    background-color: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

QComboBox:on {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    border-left: 1px solid var(--grey6);
    width: var(--input_height);
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow {
    qproperty-alignment: AlignTop;
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    width: 100%;
}

QListView::item:selected:hover QComboBox::down-arrow,
QListWidget::item:selected:hover QComboBox::down-arrow,
QTreeView::item:selected:hover QComboBox::down-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
}

QComboBox:editable:hover {
    background-color: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

QComboBox:on,
QDateTimeEdit:on,
QComboBox:editable:focus {
    background-color: var(--input_bg_focus);
    border-color: var(--input_border_focus);
}

QComboBox::drop-down:editable,
QDateTimeEdit::drop-down:editable {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow:editable,
QDateTimeEdit::down-arrow:editable {
    qproperty-alignment: AlignTop;
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    width: 100%;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background-color: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

QLineEdit:read-only,
QLineEdit:read-only:hover,
QLineEdit:read-only:focus {
    background-color: var(--button_bg_disabled);
    border-color: var(--input_border);
    color: var(--text_muted);
}

QTextEdit:!editable,
QTextEdit:!editable:hover,
QTextEdit:!editable:focus {
    background-color: var(--input_bg);
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: var(--button_bg_hover);
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: var(--button_bg_down);
}

QSpinBox::up-button:disabled,
QSpinBox::up-button:off,
QSpinBox::down-button:disabled,
QSpinBox::down-button:off {
    background-color: var(--button_bg_disabled);
}

QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:off,
QDoubleSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:off {
    background-color: var(--button_bg_disabled);
}

QListView::item:selected:hover QSpinBox::up-arrow,
QListWidget::item:selected:hover QSpinBox::up-arrow,
QTreeView::item:selected:hover QSpinBox::up-arrow,
QListView::item:selected:hover QDoubleSpinBox::up-arrow,
QListWidget::item:selected:hover QDoubleSpinBox::up-arrow,
QTreeView::item:selected:hover QDoubleSpinBox::up-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/arrow-up.svg);
}

QListView::item:selected:hover QSpinBox::down-arrow,
QListWidget::item:selected:hover QSpinBox::down-arrow,
QTreeView::item:selected:hover QSpinBox::down-arrow,
QListView::item:selected:hover QDoubleSpinBox::down-arrow,
QListWidget::item:selected:hover QDoubleSpinBox::down-arrow,
QTreeView::item:selected:hover QDoubleSpinBox::down-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/arrow-down.svg);
}

/* Controls Dock */
#controlsFrame {
    padding: var(--padding_container);
}

#controlsFrame QPushButton {
    margin: var(--spacing_base) var(--spacing_small);
}

#streamButton,
#recordButton,
#replayBufferButton,
#broadcastButton {
    padding: var(--padding_large);
}

#pauseRecordButton,
#saveReplayButton,
#virtualCamConfigButton {
    padding: var(--padding_large) var(--padding_large);
    width: var(--input_height);
    max-width: var(--input_height);
}

/* Primary Control Button Active States */
#streamButton.state-active, #broadcastButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--live_bg_start), stop:1 var(--live_bg_end));
    border-color: var(--live);
    color: var(--live);
    font-weight: bold;
}

#recordButton.state-active, #pauseRecordButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--recording_bg_start), stop:1 var(--recording_bg_end));
    border-color: var(--recording);
    color: var(--recording);
    font-weight: bold;
}

#replayBufferButton.state-active, #virtualCamButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--accent_bg_start), stop:1 var(--accent_bg_end));
    border-color: var(--lavender_accent);
    color: var(--lavender_accent);
}

/* Primary Control Button Checked Coloring */
#streamButton:!hover:!pressed.state-active,
#recordButton:!hover:!pressed.state-active,
#pauseRecordButton:!hover:!pressed.state-active,
#replayBufferButton:!hover:!pressed.state-active,
#virtualCamButton:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed.state-active,
#broadcastButton:!hover:!pressed.state-active {
    background: var(--primary);
}

/* Primary Control Button Hover Coloring */
#streamButton:hover:!pressed.state-active,
#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active,
#replayBufferButton:!pressed.state-active,
#virtualCamButton:!pressed.state-active,
#modeSwitch:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--primary_light);
    color: var(--text);
}


QPushButton:focus {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius: 0.9, fx:0.5, fy:0.5,
        stop:0    var(--button_bg),
        stop:0.5  var(--button_bg),
        stop:1    var(--primary)
    );
}

QPushButton::flat {
    background-color: var(--button_bg);
}

QPushButton:checked {
    background-color: var(--primary);
    border-color: var(--primary_light);
}

QPushButton:checked:hover,
QPushButton:checked:focus {
    border-color: var(--primary_lighter);
}

QPushButton::menu-indicator {
    image: none;
    width: 0px;
    height: 0px;
    subcontrol-position: right;
    subcontrol-origin: content;
    margin-left: 0px;
    right: -2px;
}

QToolButton {
    border: 1px solid var(--button_border);
}

QToolButton,
.btn-tool {
    background-color: var(--button_bg);
    padding: var(--padding_base) var(--padding_base);
    margin: 0px 0px;
    border: 1px solid var(--button_border);
    border-radius: var(--border_radius);
    icon-size: var(--icon_base);
}

QToolButton:last-child,
.btn-tool:last-child {
    margin-right: 0px;
}

QToolButton:hover,
QToolButton:focus,
.btn-tool:hover,
.btn-tool:focus {
    border-color: var(--primary);
    border-width: 2px;
    background-color: var(--button_bg_hover);
}

QToolButton:pressed,
QToolButton:pressed:hover,
.btn-tool:pressed,
.btn-tool:pressed:hover {
    background-color: var(--button_bg_down);
    border-color: var(--button_border);
}

QToolButton:disabled,
.btn-tool:disabled {
    background-color: var(--button_bg_disabled);
    border-color: transparent;
}

/* Sliders */

QSlider::sub-page:horizontal:disabled {
    background-color: var(--grey4);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:horizontal:disabled {
    background-color: var(--grey7);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:vertical:disabled {
    background-color: var(--grey4);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:vertical:disabled {
    background-color: var(--grey7);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:disabled {
    background-color: var(--white5);
}

#stackedMixerArea {
    border: none;
    padding: 0px;
}

.mixer-category {
    color: var(--text_muted);
    margin: 0;
    padding: 0;
    text-align: center;
}

/* Volume Control Buttons */

.btn-mute,
.btn-monitor {
    width: var(--icon_small);
    height: var(--icon_small);
    background-color: transparent;
    padding: var(--padding_base_border) var(--padding_base_border);
    margin: 0px var(--spacing_small);
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
    icon-size: var(--icon_small);
}

.btn-mute:checked,
.btn-monitor:checked {
    background-color: transparent;
    border-color: transparent;
}

.btn-mute:hover,
.btn-monitor:hover {
    background-color: var(--button_bg_hover);
    border-color: transparent;
}

.btn-mute:pressed,
.btn-monitor:pressed {
    background-color: var(--button_bg_down);
}

/* Mute Button */

.btn-mute {
    color: var(--text);
}

.btn-mute.checked {
    color: var(--red3);
    background: transparent;
}

.btn-mute.checked.hover {
    color: var(--red2);
    background: var(--grey8);
    border-color: var(--red1);
}

.btn-mute.checked:focus {
    border-color: var(--red1);
}

.btn-mute.mute-unassigned {
    color: var(--yellow1);
    background: var(--yellow6);
}

.btn-mute.mute-unassigned.hover,
.btn-mute.mute-unassigned:focus {
    border-color: var(--yellow1);
}

/* Monitor Button */

.btn-monitor {
    background: transparent;
}

.btn-monitor:focus {
    border-color: var(--red1);
}

.btn-monitor.checked {
    background: var(--green4);
    color: var(--text_light);
}

.btn-monitor.checked:focus,
.btn-monitor:checked:focus {
    color: var(--text_light);
    border-color: var(--green1);
}

.btn-monitor.checked:hover {
    background: var(--green3);
    border-color: var(--green1);
    color: var(--text_light);
}

/* Toggle hidden button */

.toggle-hidden:checked {
    background: var(--purple5);
    border-color: var(--purple3);
}

.toggle-hidden:disabled {
    background: transparent;
    border-color: transparent;
}

VolumeControl,
VolumeMeter {
    background: var(--bg_base);
}

VolumeName {
    background: transparent;
    padding: var(--padding_base) 0;
    border: 1px solid transparent;
}

VolumeName QLabel {
    font-size: var(--font_small);
}

VolumeName:focus {
    border: 1px solid var(--button_border_hover);
}

VolumeName:hover {
    background: var(--button_bg_hover);
    border: 1px solid var(--button_border_hover);
}

VolumeControl #volLabel {
    min-width: 48px;
    padding: var(--padding_base) 0px var(--padding_base);
    text-align: center;
    font-size: var(--font_small);
    color: var(--text_muted);
}

/* Horizontal Mixer */
#hVolumeWidgets VolumeControl {
    padding: 0px 0px;
    border-bottom: 1px solid var(--border_color);
    margin-bottom: 0px;
}

#hVolumeWidgets .mixer-category {
    margin: var(--spacing_base);
    padding: 0px var(--padding_xlarge);
    border-radius: var(--border_radius);
}

#hVolumeWidgets VolumeName {
    padding-right: var(--padding_large);
}

#hVolumeWidgets VolumeName QLabel {
    margin: 0 var(--padding_large);
}

#hVolumeWidgets #volLabel {
    margin: 0 var(--spacing_base);
    border-radius: var(--border_radius);
}

#hVolumeWidgets #volMeterFrame {
    margin-bottom: var(--padding_large);
}

#hVolumeWidgets VolumeControl QSlider {
    margin: var(--padding_large) 0px;
    min-height: var(--slider_handle_size);
}

#hVolumeWidgets VolumeControl QSlider::groove:horizontal {
    background: var(--bg_window);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

#hVolumeWidgets VolumeControl QPushButton {
    margin-left: var(--padding_large);
}

#hVolumeWidgets VolumeControl #volMeterFrame {
    padding: 0 var(--padding_xlarge);
}

/* Vertical Mixer */
#vVolumeWidgets VolumeControl {
    padding: 0px 0px var(--padding_container);
    border-right: 1px solid var(--border_color);
}

#vVolumeWidgets .mixer-category {
    border-bottom: 1px solid var(--border_color);
}

#vMixerScrollArea VolumeControl QSlider {
    width: var(--slider_handle_size);
    margin: 0px var(--padding_xlarge);
}

#vVolumeWidgets VolumeControl #volLabel {
    padding: var(--padding_base) 0px var(--padding_base);
    min-width: var(--volume_slider_label);
    margin-left: var(--padding_xlarge);
    text-align: center;
}

#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    background: var(--bg_window);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

#vVolumeWidgets VolumeControl #volMeterFrame {
    padding: var(--padding_large) var(--padding_xlarge) var(--padding_large) 0px;
}

#vVolumeWidgets VolumeControl QLabel {
    padding: 0px var(--padding_large);
}

VolumeControl.volume-inactive,
VolumeControl.volume-inactive VolumeMeter {
    background: var(--grey7);
}

VolumeControl.volume-hidden .mixer-name,
VolumeControl.volume-inactive .mixer-name {
    color: var(--text_muted);
}

VolumeControl .mixer-category {
    font-weight: bold;
    background: var(--blue6);
    color: var(--blue1);
}

VolumeControl.volume-pinned .mixer-category {
    background: var(--blue5);
    color: var(--text_light);
}

VolumeControl.volume-hidden .mixer-category {
    background: var(--purple6);
    color: var(--purple1);
}

VolumeControl.volume-unassigned .mixer-category {
    background: var(--yellow6);
    color: var(--yellow1);
}

VolumeControl.volume-inactive .mixer-category {
    background: var(--grey8);
    color: var(--text_muted);
}

VolumeControl.volume-preview .mixer-category {
    background: var(--green6);
    color: var(--green1);
}

#stackedMixerArea VolumeControl.volume-hidden QSlider::groove,
#stackedMixerArea VolumeControl.volume-inactive QSlider::groove {
    background: var(--grey8);
}

/* Table View */

QTableView::item {
    margin: 0px;
    padding: 0px;
}

QTableView QLineEdit {
    background: var(--input_bg_focus);
    padding: 0;
    margin: 0;
}

QTableView QPushButton,
QTableView QToolButton {
    padding: 0px;
    margin: -1px;
    border-radius: 0px;
}

/* Canvas / Preview background color */

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--bg_preview);
}

/* Filters Window */

OBSBasicFilters #widget,
OBSBasicFilters #widget_2 {
    margin: 0px;
    padding: 0px;
    padding-bottom: var(--padding_base);
}

OBSBasicFilters #widget QPushButton,
OBSBasicFilters #widget_2 QPushButton {
    min-width: 16px;
    padding: var(--padding_base) var(--padding_large);
    margin-top: 0px;
}

/* Preview/Program labels */

.label-preview-title {
    font-size: var(--font_xlarge);
    font-weight: bold;
    color: var(--text_light);
    margin-bottom: 4px;
}

/* Checkboxes */

QCheckBox::indicator,
QGroupBox::indicator,
QTableView::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
    margin-right: var(--spacing_large);
}

QGroupBox::indicator {
    margin-left: 2px;
}

/* Icon Checkboxes */
.checkbox-icon {
    outline: none;
    background: transparent;
    max-width: var(--icon_base);
    max-height: var(--icon_base);
    padding: var(--padding_base);
    margin-right: var(--spacing_large);
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

.checkbox-icon::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
}

.checkbox-icon:hover,
.checkbox-icon:focus {
    border-color: var(--primary_lighter);
}

/* Locked CheckBox */

.indicator-lock::indicator:checked,
.indicator-lock::indicator:checked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/lock.svg);
    background: var(--tint_amber);
    border-radius: var(--border_radius_small);
}

SourceTreeItem:selected:hover .indicator-lock::indicator:checked {
    image: url(theme:icons/colorway/iconamoon/normal/lock.svg);
}

.indicator-lock::indicator:unchecked,
.indicator-lock::indicator:unchecked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/unlock.svg);
}

SourceTreeItem:selected:hover .indicator-lock::indicator:unchecked {
    image: url(theme:icons/colorway/iconamoon/normal/unlock.svg);
}

/* Visibility CheckBox */

.indicator-visibility::indicator:checked,
.indicator-visibility::indicator:checked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/eye.svg);
    background: var(--tint_green);
    border-radius: var(--border_radius_small);
}

SourceTreeItem:selected:hover .indicator-visibility::indicator:checked {
    image: url(theme:icons/colorway/iconamoon/normal/eye.svg);
}

.indicator-visibility::indicator:unchecked,
.indicator-visibility::indicator:unchecked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/eye-off.svg);
    background: var(--tint_red);
    border-radius: var(--border_radius_small);
}

SourceTreeItem:selected:hover .indicator-visibility::indicator:unchecked {
    image: url(theme:icons/colorway/iconamoon/normal/eye-off.svg);
}

#hotkeyFilterReset {
    margin-top: 0px;
}

OBSHotkeyWidget {
    padding: 8px 0px;
    margin: 2px 0px;
}

OBSHotkeyLabel {
    padding: 4px 0px;
}

OBSHotkeyWidget QPushButton {
    min-width: 16px;
    padding: var(--padding_base);
    margin-top: 0px;
    margin-left: var(--spacing_base);
}


/* Sources List Group Collapse Checkbox */

.indicator-expand::indicator:checked,
.indicator-expand::indicator:checked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
}

SourceTreeItem:selected:hover .indicator-expand::indicator:checked {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-right.svg);
}

.indicator-expand::indicator:unchecked,
.indicator-expand::indicator:unchecked:hover {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
}

SourceTreeItem:selected:hover .indicator-expand::indicator:unchecked {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
}

/* Source Icons */

.source-icon {
    margin-right: var(--spacing_large);
}

OBSBasic {
    qproperty-imageIcon: url(theme:icons/colorway/iconamoon/normal/image.svg);
    qproperty-colorIcon: url(theme:icons/colorway/iconamoon/normal/brush.svg);
    qproperty-slideshowIcon: url(theme:icons/colorway/iconamoon/normal/output.svg);
    qproperty-audioInputIcon: url(theme:icons/colorway/iconamoon/normal/microphone.svg);
    qproperty-audioOutputIcon: url(theme:icons/colorway/iconamoon/normal/audio.svg);
    qproperty-desktopCapIcon: url(theme:icons/colorway/iconamoon/normal/display.svg);
    qproperty-windowCapIcon: url(theme:icons/colorway/iconamoon/normal/window.svg);
    qproperty-gameCapIcon: url(theme:icons/colorway/iconamoon/normal/gamepad.svg);
    qproperty-cameraIcon: url(theme:icons/colorway/iconamoon/normal/video.svg);
    qproperty-textIcon: url(theme:icons/colorway/iconamoon/normal/text.svg);
    qproperty-mediaIcon: url(theme:icons/colorway/iconamoon/normal/output.svg);
    qproperty-browserIcon: url(theme:icons/colorway/iconamoon/normal/globe.svg);
    qproperty-groupIcon: url(theme:icons/colorway/iconamoon/normal/group.svg);
    qproperty-sceneIcon: url(theme:icons/colorway/iconamoon/normal/scene.svg);
    qproperty-defaultIcon: url(theme:icons/colorway/iconamoon/normal/default.svg);
    qproperty-audioProcessOutputIcon: url(theme:icons/colorway/iconamoon/normal/audio.svg);
}

/* Scene Tree Grid Mode */

SceneTree,
SourceTree {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
}

SceneTree {
    qproperty-gridItemWidth: 154;
    qproperty-gridItemHeight: var(--input_height_base);
}

.list-grid SceneTree::item {
    color: var(--text);
    background-color: var(--button_bg);
    border-radius: var(--border_radius);
    margin: var(--spacing_base);
}

.list-grid SceneTree::item:selected {
    background-color: var(--list_item_bg_selected);
}

.list-grid SceneTree::item:checked {
    background-color: var(--primary);
}

.list-grid SceneTree::item:hover {
    background-color: var(--list_item_bg_hover);
}

.list-grid SceneTree::item:selected:hover {
    background-color: var(--primary_light);
    color: var(--text_inverse);
}

/* Studio Mode T-Bar */

.slider-tbar {
    height: var(--slider_handle_size);
}

.slider-tbar::groove:horizontal {
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

.slider-tbar::sub-page:horizontal {
    background: var(--primary);
    border-radius: var(--slider_groove_radius);
}

.slider-tbar::handle:horizontal {
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    border-radius: var(--slider_handle_radius);
    margin: var(--slider_handle_margin) 0px;
}

/* YouTube Integration */
OBSYoutubeActions {
    qproperty-thumbPlaceholder: url(theme:icons/colorway/iconamoon/normal/image.svg);
}

#ytEventList QLabel {
    color: var(--text);
    background-color: var(--button_bg);
    border: none;
    border-radius: var(--border_radius);
    padding: 4px 20px;
}

#ytEventList QLabel:hover {
    background-color: var(--button_bg_hover);
}

#ytEventList .row-selected {
    background-color: var(--primary);
    border: none;
}

#ytEventList .row-selected:hover {
    background-color: var(--primary_light);
    color: var(--text);
}

/* Calendar Widget */
QDateTimeEdit::down-arrow {
    qproperty-alignment: AlignTop;
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    width: 100%;
}

QDateTimeEdit:on {
    background-color: var(--grey7);
}

/* Calendar Top Bar */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: var(--bg_base);
    padding: var(--padding_base) var(--padding_large);
}

/* Calendar Top Bar Buttons */
QCalendarWidget QToolButton {
    background-color: var(--button_bg);
    padding: 2px 16px;
    border-radius: var(--border_radius);
    margin: var(--spacing_base);
}

#qt_calendar_monthbutton::menu-indicator {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    subcontrol-position: right;
    padding-top: var(--padding_small);
    padding-right: var(--padding_base);
    height: 10px;
    width: 10px;
}

QCalendarWidget #qt_calendar_prevmonth {
    padding: var(--padding_small);
    icon-size: var(--icon_base);
}

QCalendarWidget #qt_calendar_nextmonth {
    padding: var(--padding_small);
    icon-size: var(--icon_base);
}

QCalendarWidget QToolButton:hover {
    background-color: var(--button_bg_hover);
    border-radius: var(--border_radius);
}

QCalendarWidget QToolButton:pressed {
    background-color: var(--button_bg_down);
}

/* Month Dropdown Menu */
QCalendarWidget QMenu {}

/* Year spinbox */
QCalendarWidget QSpinBox {
    background-color: var(--input_bg);
    border: none;
    border-radius: var(--border_radius);
    margin: 0px var(--spacing_base) 0px 0px;
    padding: var(--padding_base) 16px;
}

QCalendarWidget QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
}

QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
}

QCalendarWidget QSpinBox::up-arrow {
    width: 10px;
    height: 10px;
}

QCalendarWidget QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* Days of the Week Bar */
QCalendarWidget QWidget {
    alternate-background-color: var(--grey7);
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: var(--bg_base);
    color: var(--text);
}

QCalendarWidget QAbstractItemView:disabled {
    color: var(--text_disabled);
}

/* VirtualCam Plugin Fixes */

#VirtualProperties QWidget {
    margin-top: 0;
    margin-bottom: 0;
}

/* Disable icons on QDialogButtonBox */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Advanced audio dialog */
OBSBasicAdvAudio #scrollAreaWidgetContents {
    background: var(--bg_base);
}

#previewScalePercent,
#previewScalingMode {
    background: transparent;
    color: var(--text_muted);
    font-size: var(--font_xsmall);
    height: 14px;
    max-height: 14px;
    padding: 0px;
    margin: 0;
}

#previewXContainer {
    border: 1px solid var(--grey6);
}

#previewScalePercent {
    padding: 0px var(--input_text_padding);
    min-width: var(--preview_scale_width);
}

#previewScalingMode {
    padding: 0px var(--input_text_padding);
    border: 1px solid var(--grey6);
}

#previewScalingMode:hover,
#previewScalingMode:focus {
    border-color: var(--input_border_hover);
}

#previewScalingMode:on {
    background-color: var(--input_bg_focus);
    border-color: var(--input_border_focus);
}

#previewXScrollBar,
#previewYScrollBar {
    background: transparent;
    border: 1px solid var(--grey6);
    border-radius: 0;
}

#previewXScrollBar {
    border-left: none;
    height: 16px;
}

#previewXScrollBar::handle,
#previewYScrollBar::handle {
    margin: 3px;
}

#previewYScrollBar {
    width: 16px;
}

#previewZoomInButton {
    border: none;
    border-radius: 0px;
    outline: none;
}

#previewZoomOutButton {
    border: none;
    border-radius: 0px;
    outline: none;
}

#previewZoomInButton:!hover,
#previewZoomOutButton:!hover {
    background-color: transparent;
}

#previewZoomInButton:pressed,
#previewZoomOutButton:pressed {
    background-color: var(--button_bg);
}

#previewZoomInButton:focus,
#previewZoomOutButton:focus {
    border: 1px solid var(--input_border_hover);
}

/* Add Source Dialog */
SourceSelectButton {
    background: var(--button_bg);
    padding: var(--padding_base) var(--padding_large);
    margin: var(--spacing_base);
    border-radius: var(--shape_lg);
    border: 1px solid var(--border_color);
    outline: none;
}

SourceSelectButton QLabel {
    padding: var(--padding_large) 0;
    text-align: center;
}

SourceSelectButton #thumbnail {
    background: var(--bg_preview);
    border-radius: var(--border_radius);
    padding: 0;
    margin-top: var(--spacing_base);
}

SourceSelectButton:hover {
    background-color: var(--button_bg_hover);
}

SourceSelectButton:checked {
    background-color: var(--primary);
    border-color: var(--primary_light);
}

SourceSelectButton:focus,
SourceSelectButton:checked:focus {
    border-color: var(--text_light);
}

SourceSelectButton:pressed,
SourceSelectButton:pressed:hover {
    background-color: var(--button_bg_down);
    border-color: var(--button_border);
}

/* Idian Widgets */
idian--Group {
    background: var(--surface1);
    border-radius: var(--shape_md);
    padding: var(--padding_base);
    font-weight: bold;
    margin: 0 0 var(--spacing_base);
    min-width: 300px;
    max-width: 600px;
}

idian--Group .header .title {
    font-weight: bold;
    padding: var(--padding_large);
    color: var(--on_primary_container);
}

idian--Group .header .description {
    color: var(--text_muted);
    padding: var(--spacing_small) var(--padding_small);
}

idian--PropertiesList {
    border-width: 0;
    padding: 0;
    margin: var(--spacing_base) 0;
}

idian--Row {
    background: var(--grey5);
    margin: 0;
    padding: var(--action_row_padding) var(--action_row_padding_x);
}

idian--Row.keyFocus {
    background: var(--grey4);
    border: var(--highlight_width) solid var(--grey4);
}

idian--Row.cursor-pointer.hover {
    background: var(--grey4);
    border: var(--highlight_width) solid var(--grey1);
}

idian--Row.first {
    border-top-left-radius: var(--border_radius);
    border-top-right-radius: var(--border_radius);
}

idian--Row.last {
    border-bottom-left-radius: var(--border_radius);
    border-bottom-right-radius: var(--border_radius);
}

idian--Row > QLabel.description {
    font-size: var(--font_small);
    color: var(--text_muted);
}

idian--ToggleSwitch {
    qproperty-background: var(--grey6);
    qproperty-background_hover: var(--grey7);
    qproperty-background_checked: var(--primary);
    qproperty-background_checked_hover: var(--primary_light);

    min-width: var(--toggle_width);
    min-height: var(--toggle_height);

    border-radius: var(--toggle_radius);

    qproperty-handleColor: var(--white1);
    qproperty-handleSize: var(--toggle_handle);

    border: var(--highlight_width) solid transparent;
}

idian--ToggleSwitch.hover {
    border-color: var(--grey4);
}

idian--ToggleSwitch.checked.hover {
    border-color: var(--white1);
}

idian--ToggleSwitch.keyFocus {
    border-color: var(--highlight_color);
}

idian--Row idian--ToggleSwitch.hover,
idian--Row.hover > idian--ToggleSwitch.row-buddy {
    border-color: var(--grey1);
}

idian--Row idian--ToggleSwitch.hover.checked,
idian--Row.hover > idian--ToggleSwitch.checked.row-buddy {
    border-color: var(--white1);
}

idian--Row QComboBox {
    background-color: transparent;
    min-height: var(--action_row_base);
    max-height: var(--action_row_base);
    min-width: var(--action_row_input_width);
    border: var(--highlight_width) solid transparent;
    padding: 0;
    padding-left: var(--padding_xlarge);
    margin: 0;
}

idian--Row QComboBox:focus {
    border-color: transparent;
}

idian--Row QComboBox.hover {
    border-color: var(--grey1);
}

idian--Row QComboBox.keyFocus {
    border-color: var(--highlight_color);
}

idian--Row QComboBox::drop-down {
    border: none;
}

idian--Row QComboBox::down-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
}

idian--Row QComboBox QAbstractItemView {
    outline: none;
}

idian--Row QComboBox QAbstractItemView::item {
    background-color: var(--bg_base);
    padding: var(--padding_base) var(--padding_large);
}

idian--Row QComboBox QAbstractItemView.hover::item,
idian--Row QComboBox QAbstractItemView::item:selected {
    background-color: var(--list_item_bg_selected);
    padding: var(--padding_base) var(--padding_large);
}

idian--Row QPushButton,
idian--Row QSpinBox,
idian--Row QDoubleSpinBox {
    margin: 0;
    padding: var(--padding_base) var(--action_row_padding_x);
}

idian--PropertiesListSpacer {
    max-height: var(--spacing_small);
    min-height: var(--spacing_small);
    background-color: var(--bg_window);
}

idian--Row idian--CheckBox {
    outline: none;
}

idian--CheckBox::indicator {
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

idian--CheckBox.keyFocus::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator {
    image: url(theme:icons/colorway/iconamoon/normal/checkbox_line.svg);
}

idian--CheckBox.keyFocus.checked::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    image: url(theme:icons/colorway/iconamoon/normal/checkbox_fill.svg);
}

idian--CheckBox.hover::indicator,
idian--CheckBox.checked.hover::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    border-color: var(--grey1);
}

idian--CheckBox.keyFocus::indicator,
idian--CheckBox.keyFocus.checked::indicator {
    border-color: var(--highlight_color);
}

idian--CollapsibleRow {
    margin: 0;
    padding: 0;
    border: none;
}

idian--CollapsibleRow.keyFocus {
    border: var(--highlight_width) solid var(--highlight_color);
}

idian--CollapsibleRow idian--PropertiesList {
    border-radius: 0;
    border-left: 1px solid var(--grey5);
    border-right: 1px solid var(--grey5);
    border-bottom: 1px solid var(--grey5);
    margin: var(--spacing_small) 0px 0px;
}

idian--CollapsibleRow idian--PropertiesList idian--Row {
    background-color: var(--grey6);
    padding-left: var(--action_row_padding_nested);
}

idian--CollapsibleRow idian--Row.first,
idian--CollapsibleRow idian--Row.last {
    border-radius: 0;
}

idian--CollapsibleRow idian--PropertiesList idian--ToggleSwitch {
    qproperty-background: var(--grey7);
    qproperty-background_hover: var(--grey6);
}

idian--ExpandButton {
    background: transparent;
    min-width: var(--action_row_collapse);
    max-width: var(--action_row_collapse);
    min-height: var(--action_row_collapse);
    max-height: var(--action_row_collapse);
    border: none;
}

idian--ExpandButton::indicator {
    background: var(--grey5);
    border-radius: var(--action_row_collapse_radius);
    padding: var(--padding_large);
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    border: var(--highlight_width) solid var(--grey5);
}

idian--ExpandButton::indicator:checked {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-up.svg);
}

idian--ExpandButton.keyFocus,
idian--ExpandButton.keyFocus::indicator {
    border-color: var(--highlight_color);
}

idian--RowFrame .btn-frame {
    background: var(--grey5);
    padding: var(--action_row_padding) var(--action_row_padding_x);
}

idian--RowFrame.hover .btn-frame {
    background: var(--grey4);
}

idian--RowFrame.hover idian--Row {
    background: var(--grey4);
    border: var(--highlight_width) solid var(--grey1);
    border-right: none;
}

idian--RowFrame.hover .row-buddy {
    background: var(--grey4);
    border: var(--highlight_width) solid var(--grey1);
    border-left: none;
}

idian--RowFrame.hover idian--ExpandButton::indicator {
    border-color: var(--grey1);
}

AlignmentSelector {
    border: 1px solid var(--input_border);
    margin: 0px;
    border-radius: 2px;
}

AlignmentSelector:focus,
AlignmentSelector:hover {
    border: 1px solid var(--white3);
}

AlignmentSelector:checked:hover {
    border: 1px solid var(--primary_lighter);
}

AlignmentSelector::indicator {
    margin: 0px;
    background: transparent;    
}

AlignmentSelector::indicator:checked {
    background: var(--primary);
}

AlignmentSelector::indicator:checked:focus {
    background: var(--primary_light);
}

AlignmentSelector:disabled {
    border: 1px solid var(--grey3);
}

AlignmentSelector::indicator:disabled {
    background: var(--grey5);
}

AlignmentSelector::indicator:checked:disabled {
    background: var(--grey3);
}

/* ==================================================================================
   MAT COMPACT MATERIAL OPINIONATED BASE LAYER
   This layer extends the base rules using Yami's variables to preserve scaling.
   ================================================================================== */

/* ==================================================================================
   GLOBAL FONTS (font-family set globally on QWidget above; nothing to override here)
   ================================================================================== */

/* ==================================================================================
   BUTTONS - Rounded Material Design with Smooth Transitions
   ================================================================================== */

QPushButton {
    background-color: var(--button_bg);
    color: var(--text);
    border: 2px solid var(--button_bg);
    border-radius: var(--border_radius); /* Propagates 9px rounding globally */
    min-height: calc(1.8pt * var(--font_base_value));
    padding: var(--padding_small) var(--padding_wide);
    margin: var(--spacing_small);
    font-weight: 500;
}

QPushButton:hover {
    color: var(--text_bright);
    border-color: var(--primary);
    background: qradialgradient(
        cx:0.5, cy:0.5, radius: 0.9, fx:0.5, fy:0.5,
        stop:0    var(--button_bg),
        stop:0.5  var(--button_bg),
        stop:1    var(--primary)
    );
}

QPushButton:pressed {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--text_inverse);
}

QPushButton:disabled {
    background-color: var(--button_bg_disabled);
    border-color: var(--button_bg_disabled);
    color: var(--text_disabled);
}

/* Small Property Icon Buttons override */
QPushButton[themeID="settingsIconSmall"],
QPushButton[themeID="menuIconSmall"],
QPushButton[themeID="replayIconSmall"] {
    min-height: calc(1.6pt * var(--font_base_value));
    padding: var(--padding_small) var(--padding_large);
    font-size: var(--font_small);
}

/* ==================================================================================
   INPUTS - Dropdowns, Spinners, Line Edits
   ================================================================================== */

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit, QPlainTextEdit, QTextEdit {
    min-height: calc(2.0pt * var(--font_base_value));
    padding: var(--padding_small) var(--padding_large);
    border: 1px solid var(--border_base);
    background: var(--bg_input);
    border-radius: var(--border_radius_small);
    margin: var(--spacing_small);
    color: var(--text_base);
    selection-background-color: var(--primary);
    selection-color: var(--text_inverse);
}

QSpinBox, QDoubleSpinBox {
    min-height: calc(2.6pt * var(--font_base_value));
}

QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border: 2px solid var(--border_focus);
    background-color: var(--input_bg_focus);
}

QPlainTextEdit:focus, QTextEdit:focus,
QTreeView:focus, QListWidget:focus, QTableView:focus {
    border: 2px solid var(--border_focus);
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
    background: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

/* Dropdown Arrow Area */
QComboBox::drop-down {
    border: none;
    width: var(--input_height);
    background: transparent;
}

QComboBox::down-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/chevron-down.svg);
    width: var(--icon_small);
    height: var(--icon_small);
}

/* Spinbox Buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: var(--icon_small);
    height: var(--spinbox_button_height);
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: var(--icon_small);
    height: var(--spinbox_button_height);
    border: none;
    background: transparent;
}
QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/arrow-up.svg);
    width: 100%;
    margin: 2px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(theme:icons/colorway/iconamoon/normal/arrow-down.svg);
    width: 100%;
    padding: 2px;
}
/* ==================================================================================
   SLIDERS - Dynamic Volume Sliders (Tactile Circle Markers for Easy Targeting)
   ================================================================================== */
QSlider {
    background: transparent;
    /* Allocates room at the edges so the handle does not get clipped at 0% or 100% */
    padding-left: var(--slider_handle_radius);
    padding-right: var(--slider_handle_radius);
}

QSlider:vertical {
    padding-top: var(--slider_handle_radius);
    padding-bottom: var(--slider_handle_radius);
}

QSlider::groove:horizontal {
    background: var(--button_bg);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:horizontal {
    background: var(--primary);
    border-radius: 8px;
}

QSlider::add-page:horizontal {
    background: var(--button_bg);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:horizontal {
    background: var(--text_bright);
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    margin: var(--slider_handle_margin) 0px;
    border-radius: var(--slider_handle_radius);
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background: var(--primary_hover);
}

QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: var(--primary);
}

/* Vertical sliders */
QSlider::groove:vertical {
    background: var(--button_bg);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:vertical {
    background: var(--primary);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:vertical {
    background: var(--primary);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:vertical {
    background: var(--text_bright);
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    margin: 0px var(--slider_handle_margin);
    border-radius: var(--slider_handle_radius);
}

/* ==================================================================================
   CHECKBOXES & RADIO BUTTONS
   ================================================================================== */
QCheckBox, QRadioButton {
    spacing: var(--spacing_large);
    padding: var(--padding_small);
    color: var(--text_base);
}

QCheckBox::indicator, QRadioButton::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
    border: 1px solid var(--border_base);
    border-radius: var(--shape_sm);
    background: var(--bg_base);
}

QRadioButton::indicator {
    border-radius: var(--shape_full);
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: var(--primary);
    background: var(--bg_hover);
}

QCheckBox::indicator:checked {
    background: var(--primary);
    border-color: var(--primary);
    image: var(--icon_check);
}

QRadioButton::indicator:checked {
    background: var(--primary);
    border: 3px solid var(--bg_base);
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border-color: var(--button_bg_disabled);
    background: var(--button_bg_disabled);
}

/* Icon-based checkboxes mapping */
QCheckBox[themeID="visibilityCheckBox"]::indicator:unchecked { 
    image: var(--icon_eye);
    border: none;
    background: transparent;
}
QCheckBox[themeID="visibilityCheckBox"]::indicator:checked { 
    image: var(--icon_eye_off);
    border: none;
    background: transparent;
}
QCheckBox[themeID="lockCheckBox"]::indicator:unchecked { 
    image: var(--icon_unlock);
    border: none;
    background: transparent;
}
QCheckBox[themeID="lockCheckBox"]::indicator:checked { 
    image: var(--icon_lock);
    border: none;
    background: transparent;
}
QCheckBox[themeID="muteCheckBox"]::indicator:unchecked { 
    image: var(--icon_vol_high);
    border: none;
    background: transparent;
}
QCheckBox[themeID="muteCheckBox"]::indicator:checked { 
    image: var(--icon_vol_mute);
    border: none;
    background: transparent;
}

OBSBasicStats, OBSBasicFilters, OBSBasicSettings {
    background-color: var(--bg_base);
    color: var(--text_base);
}

OBSBasicStats QLabel { 
    background: transparent;
    color: var(--text_bright);
    font-weight: 600;
}

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget { 
    background: transparent;
}

/* ==================================================================================
   MENUS & CONTEXT MENUS
   ================================================================================== */
QMenu {
    background-color: var(--bg_dock);
    border: 1px solid var(--border_base);
    border-bottom: 2px solid var(--elevation_2);
    padding: var(--spacing_base);
}

QMenu::item {
    padding: var(--padding_large) var(--padding_menu);
    margin: var(--spacing_small);
    border-radius: var(--shape_sm);
    color: var(--text_base);
}

QMenu::item:selected {
    background-color: var(--primary);
    color: var(--text_inverse);
}

QMenu::item:disabled {
    color: var(--text_muted);
}

QMenu::separator {
    height: 1px;
    background: var(--border_base);
    margin: var(--spacing_base) var(--spacing_large);
}

QMenu::icon {
    padding-left: var(--padding_large);
}

/* ==================================================================================
   DOCK WIDGETS
   ================================================================================== */
QDockWidget {
    titlebar-close-icon: var(--icon_dock_close);
    titlebar-normal-icon: var(--icon_dock_popout);
}

QDockWidget::title {
    padding: var(--padding_base) var(--padding_large);
    font-size: var(--font_small);
    font-weight: bold;
    background: var(--surface1);
    color: var(--primary);
    border-bottom: 2px solid var(--border_base);
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    border-radius: var(--border_radius_small);
    background: transparent;
    padding: var(--padding_small);
    icon-size: var(--icon_small);
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: var(--primary);
}

/* ==================================================================================
   LIST & TREE WIDGETS - Ultra Compact
   ================================================================================== */
QListWidget, QTreeView, QTableView {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
    border: 1px solid var(--border_base);
    color: var(--text_base);
    border-radius: var(--border_radius_small);
    outline: none;
    selection-background-color: var(--primary);
    selection-color: var(--text_inverse);
    show-decoration-selected: 1;
}

QListWidget::item, QTreeView::item {
    padding: var(--padding_base) var(--padding_large);
    min-height: calc(1.6pt * var(--font_base_value));
    margin: 0px;
    border-radius: var(--border_radius_small);
    background-color: transparent;
}

QListWidget::item:alternate, QTreeView::item:alternate {
    background-color: var(--bg_hover);
}

QListWidget::item:selected, QTreeView::item:selected {
    background: var(--primary);
    color: var(--text_inverse);
}

QListWidget::item:hover:!selected, QTreeView::item:hover:!selected {
    background: var(--list_item_bg_hover);
    color: var(--text_bright);
}

/* Tree View Branches */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: var(--icon_tree_closed);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: var(--icon_tree_open);
}

/* Table Headers */
QHeaderView::section {
    background-color: var(--bg_dock);
    color: var(--text_muted);
    border: none;
    border-bottom: 1px solid var(--border_base);
    border-right: 1px solid var(--border_base);
    padding: var(--padding_base) var(--padding_large);
    font-weight: bold;
    font-size: var(--font_small);
}

QHeaderView::section:hover {
    background: var(--bg_hover);
    color: var(--text_bright);
}

/* ==================================================================================
   SCROLLBARS - Slim & Rounded
   ================================================================================== */
QScrollBar:vertical {
    background: var(--bg_base);
    width: var(--scrollbar_size);
    margin: 0px;
    border-radius: var(--border_radius);
}

QScrollBar::handle:vertical {
    background: var(--scrollbar_handle);
    min-height: 20px;
    border-radius: calc(var(--scrollbar_size) / 2);
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: var(--primary);
}

QScrollBar::handle:vertical:pressed {
    background: var(--primary_dark);
}

QScrollBar::handle:vertical:disabled {
    background: transparent;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: var(--bg_base);
    height: var(--scrollbar_size);
    margin: 0px;
    border-radius: var(--border_radius);
}

QScrollBar::handle:horizontal {
    background: var(--scrollbar_handle);
    min-width: 20px;
    border-radius: calc(var(--scrollbar_size) / 2);
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: var(--primary);
}

QScrollBar::handle:horizontal:pressed {
    background: var(--primary_dark);
}

QScrollBar::handle:horizontal:disabled {
    background: transparent;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ==================================================================================
   TABS (Settings & Filters)
   ================================================================================== */
QTabWidget::pane {
    border: 1px solid var(--border_base);
    background: var(--surface1);
    top: -1px;
}

QTabBar::tab {
    background: var(--bg_base);
    color: var(--text_muted);
    padding: var(--padding_base) var(--padding_large);
    min-width: 50px;
    border-top-left-radius: var(--shape_sm);
    border-top-right-radius: var(--shape_sm);
    margin-right: 2px;
    font-size: var(--font_small);
}

QTabBar::tab:selected {
    background: var(--surface1);
    color: var(--primary);
    border-bottom: 2px solid var(--primary);
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background: var(--surface2);
    color: var(--text_bright);
    border-bottom: 2px solid var(--border_base);
}

QTabBar::tab:pressed {
    background: var(--tab_bg_down);
}

QTabBar::tab:focus {
    border-color: var(--tab_border_focus);
}

QTabBar QToolButton {
    background: var(--button_bg);
    border: none;
    border-radius: var(--border_radius_small);
    min-width: 16px;
    padding: 0px;
}

/* ==================================================================================
   GROUP BOXES
   ================================================================================== */
QGroupBox {
    background: var(--surface1);
    border: 1px solid var(--border_base);
    border-radius: var(--shape_md);
    margin-top: 16px;
    padding: var(--padding_large);
    font-size: var(--font_base);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: var(--spacing_title);
    padding: 0 var(--padding_large);
    color: var(--primary);
    font-weight: bold;
    font-size: var(--font_small);
}

/* ==================================================================================
   TOOLTIPS
   ================================================================================== */
QToolTip {
    background-color: var(--surface2);
    color: var(--text_bright);
    border: 1px solid var(--primary);
    border-radius: var(--shape_sm);
    padding: var(--padding_base) var(--padding_large);
    font-size: var(--font_small);
}

/* ==================================================================================
   STATUS BAR
   ================================================================================== */
QStatusBar {
    background: var(--bg_dock);
    border-top: 1px solid var(--border_base);
    color: var(--text_muted);
    font-size: var(--font_small);
}

QStatusBar::item {
    border: none;
}

/* ==================================================================================
   SPLITTERS
   ================================================================================== */
QMainWindow::separator {
    background: var(--border_base);
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background: var(--primary);
}

QSplitter::handle {
    background: var(--border_base);
}

QSplitter::handle:hover {
    background: var(--primary);
}

/* ==================================================================================
   TOOLBAR
   ================================================================================== */
QToolBar {
    border: none;
    spacing: var(--spacing_small);
    padding: var(--padding_base);
    background: var(--bg_dock);
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    padding: var(--padding_small);
    margin: 1px;
    border-radius: var(--border_radius_small);
}

QToolBar QToolButton:hover {
    background: var(--bg_hover);
}

QToolBar QToolButton:pressed {
    background: var(--primary);
}

/* ==================================================================================
   PROPERTIES VIEW - Compact Layout Scaling
   ================================================================================== */
OBSPropertiesView {
    min-height: calc(2.0pt * var(--font_base_value));
}

OBSPropertiesView QLabel {
    margin-bottom: 0px;
    padding: 1px 0px;
    font-size: var(--font_base);
}

OBSPropertiesView QWidget {
    margin-bottom: var(--spacing_small);
}

OBSPropertiesView QPushButton,
OBSPropertiesView QComboBox,
OBSPropertiesView QSpinBox,
OBSPropertiesView QLineEdit {
    margin: var(--spacing_base) 0px;
}

OBSPropertiesView IconLabel {
    margin-left: var(--spacing_large);
}

OBSPropertiesView QSlider:horizontal {
    min-height: calc(var(--slider_handle_size) + calc(var(--slider_handle_radius) * 2));
    padding-left: var(--slider_handle_radius);
    padding-right: var(--slider_handle_radius);
    padding-top: var(--slider_handle_radius);
    padding-bottom: var(--slider_handle_radius);
}

/* ==================================================================================
   SETTINGS DIALOG - SIDEBAR
   ================================================================================== */
OBSBasicSettings QListWidget {
    background-color: var(--bg_dock);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
    border: none;
    border-right: 1px solid var(--border_base);
    outline: none;
    padding: var(--padding_container) 0px;
    font-weight: bold;
    min-width: 140px;
}

OBSBasicSettings QListWidget::item {
    padding: var(--padding_large) var(--padding_xlarge);
    margin: 0px var(--spacing_small) var(--spacing_small) var(--spacing_small);
    color: var(--text_muted);
    border-radius: var(--shape_md);
}

OBSBasicSettings QListWidget::item:hover {
    background-color: var(--surface2);
    color: var(--text_bright);
}

OBSBasicSettings QListWidget::item:selected {
    background-color: var(--primary);
    color: var(--text_inverse);
}

OBSBasicSettings QLabel {
    color: var(--text_base);
}

OBSBasicSettings QGroupBox::title {
    color: var(--primary);
}

/* Link Colors */
QLabel[openExternalLinks="true"] {
    color: var(--palette_link);
}

/* ==================================================================================
   FILTERS WINDOW
   ================================================================================== */
OBSBasicFilters QListWidget {
    background-color: var(--bg_dock);
    background-image: var(--pattern_eyes);
    background-repeat: repeat;
    border: 1px solid var(--border_base);
    color: var(--text_base);
    border-radius: var(--border_radius_small);
}

OBSBasicFilters QListWidget::item {
    padding: var(--padding_base) var(--padding_large);
    margin: 1px;
}

OBSBasicFilters QListWidget::item:selected {
    background: var(--primary);
    color: var(--text_inverse);
}

/* ==================================================================================
   LOG VIEWER
   ================================================================================== */
OBSLogViewer {
    background: var(--bg_base);
}

OBSLogViewer QTextEdit, OBSLogViewer QPlainTextEdit {
    background-color: var(--bg_preview);
    color: var(--text);
    border: 1px solid var(--border_base);
    border-radius: var(--border_radius_small);
    font-family: 'Consolas', 'Courier New', 'Monaco', monospace;
    font-size: var(--font_small);
    padding: var(--padding_large);
    margin: var(--padding_xlarge);
}

/* ==================================================================================
   AUDIO METER
   ================================================================================== */
VolumeMeter {
    qproperty-backgroundNominalColor: var(--meter_bg_nom);
    qproperty-backgroundWarningColor: var(--meter_bg_war);
    qproperty-backgroundErrorColor: var(--meter_bg_err);
    qproperty-foregroundNominalColor: var(--meter_fg_nom);
    qproperty-foregroundWarningColor: var(--meter_fg_war);
    qproperty-foregroundErrorColor: var(--meter_fg_err);
    qproperty-magnitudeColor: var(--text_bright);
    qproperty-majorTickColor: var(--text_bright);
    qproperty-minorTickColor: var(--text_disabled);
}

/* ==================================================================================
   PROGRESS BARS
   ================================================================================== */
QProgressBar {
    border: 1px solid var(--border_base);
    border-radius: var(--shape_full);
    text-align: center;
    background: var(--bg_base);
    color: var(--text_base);
    height: 18px;
}

QProgressBar::chunk {
    background: var(--primary);
    border-radius: var(--shape_full);
}

/* ==================================================================================
   ICON BUTTONS (Small Action Buttons)
   ================================================================================== */
*[themeID="propertiesIconSmall"], *[themeID="configIconSmall"] { qproperty-icon: url(theme:icons/colorway/iconamoon/normal/cogs.svg); }

/* Dark icon swaps for icon buttons on light backgrounds */
QListView::item:selected:hover *[themeID="addIconSmall"],
QListWidget::item:selected:hover *[themeID="addIconSmall"],
QTreeView::item:selected:hover *[themeID="addIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/plus.svg);
}

QListView::item:selected:hover *[themeID="removeIconSmall"],
QListWidget::item:selected:hover *[themeID="removeIconSmall"],
QTreeView::item:selected:hover *[themeID="removeIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/minus.svg);
}

QListView::item:selected:hover *[themeID="propertiesIconSmall"],
QListView::item:selected:hover *[themeID="configIconSmall"],
QListWidget::item:selected:hover *[themeID="propertiesIconSmall"],
QListWidget::item:selected:hover *[themeID="configIconSmall"],
QTreeView::item:selected:hover *[themeID="propertiesIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/cogs.svg);
}

QListView::item:selected:hover *[themeID="upArrowIconSmall"],
QListWidget::item:selected:hover *[themeID="upArrowIconSmall"],
QTreeView::item:selected:hover *[themeID="upArrowIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/chevron-up.svg);
}

QListView::item:selected:hover *[themeID="downArrowIconSmall"],
QListWidget::item:selected:hover *[themeID="downArrowIconSmall"],
QTreeView::item:selected:hover *[themeID="downArrowIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/chevron-down.svg);
}

QListView::item:selected:hover *[themeID="refreshIconSmall"],
QListWidget::item:selected:hover *[themeID="refreshIconSmall"],
QTreeView::item:selected:hover *[themeID="refreshIconSmall"] {
    qproperty-icon: url(theme:icons/colorway/iconamoon/selected/refresh.svg);
}

/* ==================================================================================
   TEXT BROWSER (About Dialog)
   ================================================================================== */
QTextBrowser {
    background-color: var(--bg_dock);
    color: var(--text_base);
    border: 1px solid var(--border_base);
    border-radius: var(--border_radius_small);
    padding: var(--padding_large);
}

QTextBrowser a {
    color: var(--palette_link);
}
