@OBSThemeMeta {
    name: 'Evondev Night Contrast';
    id: 'com.myrqyry.Colorway.EvondevDracula.Night';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(154, 134, 253, 0.3);
    --accent_bg_end: rgba(154, 134, 253, 0.1);

    --bg_window: #011627;
    --bg_base: #011627;
    --bg_preview: #00080f;

    --primary: #9a86fd;
    --primary_light: #ffb86c;
    --primary_lighter: #ffe4b3;
    --primary_dark: #7c6ce0;
    --primary_darker: #4a3b8a;

    --warning: #f1fa8c;
    --danger: #ff5555;

    --text: #f8f8f2;
    --text_light: #ffffff;
    --text_muted: #6272a4;

    --text_disabled: #44475a;
    --text_inactive: #44475a;
    --text_inverse: #FFFFFF;

    --border_color: #0a2137;

    --input_bg: #00111d;
    --input_bg_hover: #0a1e33;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #0a1e33;

    --input_border: #0a2137;
    --input_border_hover: #6272a4;

    --button_bg: #00111d;
    --button_bg_hover: #0a1e33;
    --button_bg_disabled: #011627;

    --bg_dock: #00111d;
    --bg_hover: #0a1e33;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #011627;
}
