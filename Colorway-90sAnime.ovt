@OBSThemeMeta {
    name: '90s Anime';
    id: 'com.myrqyry.Colorway.90sAnime';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: 90s Anime
       Hex colors:
       --bg_window: #13062b;
       --bg_base: #13062b;
       --bg_preview: #0b021b;
       --bg_dock: #13062b;
       --bg_hover: #3b2369;
       --text: #E0E1DD;
       --text_light: #E0E1DD;
       --text_muted: #7DCFB6;
       --text_inactive: #65737E;
       --text_inverse: #FFFFFF;
       --text_disabled: #65737E;
       --primary: #FF3864;
       --primary_light: #9C95DC;
       --primary_lighter: #C19AB7;
       --primary_dark: #ff0095;
       --primary_darker: #261447;
       --input_bg: #191331;
       --input_bg_hover: #271f47;
       --input_bg_focus: #261447;
       --input_border: #261447;
       --input_border_hover: #3b2369;
       --button_bg: #261447;
       --button_bg_hover: #3b2369;
       --button_bg_disabled: #13062b;
       --list_item_bg_hover: #3b2369;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #261447;
       --ico: #E0E1DD;
       --ico_selected: #13062b;
       --warning: #FFE97F;
       --danger: #FF3864;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(255, 56, 100, 0.3);
       --accent_bg_end: rgba(255, 56, 100, 0.1);
    */
    --accent_bg_start: rgba(255, 56, 100, 0.3);
    --accent_bg_end: rgba(255, 56, 100, 0.1);

    --bg_window: #13062b;
    --bg_base: #13062b;
    --bg_preview: #0b021b;

    --primary: #FF3864;
    --primary_light: #9C95DC;
    --primary_lighter: #C19AB7;
    --primary_dark: #ff0095;
    --primary_darker: #261447;

    --warning: #FFE97F;
    --danger: #FF3864;

    --text: #E0E1DD;
    --text_light: #E0E1DD;
    --text_muted: #7DCFB6;

    --text_disabled: #65737E;
    --text_inactive: #65737E;
    --text_inverse: #FFFFFF;

    --border_color: #261447;

    --input_bg: #191331;
    --input_bg_hover: #271f47;
    --input_bg_focus: #261447;

    --list_item_bg_hover: #3b2369;

    --input_border: #261447;
    --input_border_hover: #3b2369;

    --button_bg: #261447;
    --button_bg_hover: #3b2369;
    --button_bg_disabled: #13062b;

    --bg_dock: #13062b;
    --bg_hover: #3b2369;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #13062b;
}
