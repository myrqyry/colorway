@OBSThemeMeta {
    name: 'Modern Purple';
    id: 'com.myrqyry.Colorway.ModernPurple';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(100, 113, 228, 0.3);
    --accent_bg_end: rgba(100, 113, 228, 0.1);

    --bg_window: #1b1133;
    --bg_base: #1b1133;
    --bg_preview: #0d0225;

    --primary: #6471e4;
    --primary_light: #e85c71;
    --primary_lighter: #ff8fa3;
    --primary_dark: #375dda;
    --primary_darker: #0d0225;

    --warning: #F78C6C;
    --danger: #ce838e;

    --text: #e2e2e2;
    --text_light: #e2e2e2;
    --text_muted: #767C7E;

    --text_disabled: #4a4a6a;
    --text_inactive: #4a4a6a;
    --text_inverse: #000000;

    --border_color: #342f42;

    --input_bg: #342f42;
    --input_bg_hover: #3e3a52;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #3e3a52;

    --input_border: #4F4864;
    --input_border_hover: #6471e4;

    --button_bg: #375dda;
    --button_bg_hover: #4a70f0;
    --button_bg_disabled: #1b1133;

    --bg_dock: #0d0225;
    --bg_hover: #3e3a52;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #1b1133;
}
