@OBSThemeMeta {
    name: 'YouTube Dark';
    id: 'com.myrqyry.Colorway.YouTubeDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #0f0f0f;
    --bg_base: #0f0f0f;
    --bg_preview: #1c1c1c;
    --bg_dock: #0f0f0f;
    --bg_hover: #26233a;
    --text: #f1f1f1;
    --text_light: #ffffff;
    --text_muted: #aaaaaa;
    --text_disabled: #717171;
    --text_inactive: #717171;
    --text_inverse: #FFFFFF;
    --primary: #ff0000;
    --primary_light: #ff4e45;
    --primary_lighter: #ffb3b0;
    --primary_dark: #cc0000;
    --primary_darker: #990000;
    --input_bg: #212121;
    --input_bg_hover: #212121;
    --input_bg_focus: #2d2d2d;
    --input_border: #272727;
    --input_border_hover: #ff0000;
    --button_bg: #272727;
    --button_bg_hover: #3f3f3f;
    --button_bg_disabled: #0f0f0f;
    --list_item_bg_hover: #0f0f0f;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #272727;
    --accent_bg_start: rgba(255, 0, 0, 0.3);
    --accent_bg_end: rgba(255, 0, 0, 0.1);
    --warning: #f6c177;
    --danger: #ff0000;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: undefined;
    --ico_selected: undefined;
}
