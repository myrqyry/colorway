@OBSThemeMeta {
    name: 'Claude Code Warm';
    id: 'com.myrqyry.Colorway.ClaudeCodeWarm';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(218, 119, 86, 0.3);
    --accent_bg_end: rgba(218, 119, 86, 0.1);

    --bg_window: #171614;
    --bg_base: #171614;
    --bg_preview: #0f0e0d;

    --primary: #da7756;
    --primary_light: #f3d5a3;
    --primary_lighter: #ffdec8;
    --primary_dark: #9e4b2d;
    --primary_darker: #7a3820;

    --warning: #e1a035;
    --danger: #e33737;

    --text: #f6dece;
    --text_light: #fbf0df;
    --text_muted: #8a7a6b;

    --text_disabled: #2B2926;
    --text_inactive: #2B2926;

    --border_color: #1F1E1B;

    --input_bg: #1F1E1B;
    --input_bg_hover: #262421;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #262421;

    --input_border: #3d3126;
    --input_border_hover: #6b5e50;

    --button_bg: #1F1E1B;
    --button_bg_hover: #262421;
    --button_bg_disabled: #171614;

    --bg_dock: #1F1E1B;
    --bg_hover: #262421;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #171614;
}
