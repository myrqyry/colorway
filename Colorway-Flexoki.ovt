@OBSThemeMeta {
    name: 'Flexoki';
    id: 'com.myrqyry.Colorway.Flexoki';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(218, 112, 44, 0.3);
    --accent_bg_end: rgba(218, 112, 44, 0.1);

    /* Base Theme Colors */
    --bg_window: #100F0F;
    --bg_base: #100F0F;
    --bg_preview: #282727;

    --primary: #DA702C;
    --primary_light: #3AA99F;
    --primary_lighter: #8B7EC8;
    --primary_dark: #879A39;
    --primary_darker: #6F6E69;

    --warning: #DA702C;
    --danger: #D14D41;

    --text: #CECDC3;
    --text_light: #ffffff;
    --text_muted: #6F6E69;

    --text_disabled: #5e5e59;
    --text_inactive: #5e5e59;
    --text_inverse: #FFFFFF;

    --border_color: #232222;

    /* Inputs and Buttons */
    --input_bg: #282727;
    --input_bg_hover: #333232;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #333232;

    --input_border: #232222;
    --input_border_hover: #DA702C;

    --button_bg: #0f0e0e;
    --button_bg_hover: #333232;
    --button_bg_disabled: #100F0F;

    /* Theme Aliases */
    --bg_dock: #0f0e0e;
    --bg_hover: #333232;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #100F0F;
}
