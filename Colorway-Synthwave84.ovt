@OBSThemeMeta {
    name: 'Synthwave 84';
    id: 'com.myrqyry.Colorway.Synthwave84';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Synthwave 84
       Hex colors:
       --bg_window: #262335;
       --bg_base: #262335;
       --bg_preview: #3c3949;
       --bg_dock: #242132;
       --bg_hover: #464352;
       --text: #ffffff;
       --text_light: #ffffff;
       --text_muted: #848bbd;
       --text_inactive: #7076a1;
       --text_inverse: #FFFFFF;
       --text_disabled: #7076a1;
       --primary: #36f9f6;
       --primary_light: #ff8b39;
       --primary_lighter: #b084eb;
       --primary_dark: #72f1b8;
       --primary_darker: #848bbd;
       --input_bg: #3c3949;
       --input_bg_hover: #464352;
       --input_bg_focus: #464352;
       --input_border: #373545;
       --input_border_hover: #36f9f6;
       --button_bg: #242132;
       --button_bg_hover: #464352;
       --button_bg_disabled: #262335;
       --list_item_bg_hover: #464352;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #373545;
       --ico: #ffffff;
       --ico_selected: #262335;
       --warning: #fede5d;
       --danger: #fe4450;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(54, 249, 246, 0.3);
       --accent_bg_end: rgba(54, 249, 246, 0.1);
    */

    --accent_bg_start: rgba(54, 249, 246, 0.3);
    --accent_bg_end: rgba(54, 249, 246, 0.1);

    
    --bg_window: #262335;
    --bg_base: #262335;
    --bg_preview: #3c3949;

    --primary: #36f9f6;
    --primary_light: #ff8b39;
    --primary_lighter: #b084eb;
    --primary_dark: #72f1b8;
    --primary_darker: #848bbd;

    --warning: #fede5d;
    --danger: #fe4450;

    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #848bbd;

    --text_disabled: #7076a1;
    --text_inactive: #7076a1;
    --text_inverse: #FFFFFF;

    --border_color: #373545;

    
    --input_bg: #3c3949;
    --input_bg_hover: #464352;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #464352;

    --input_border: #373545;
    --input_border_hover: #36f9f6;

    --button_bg: #242132;
    --button_bg_hover: #464352;
    --button_bg_disabled: #262335;

    
    --bg_dock: #242132;
    --bg_hover: #464352;

    
    --ico: var(--text);
    --ico_selected: #262335;

}
