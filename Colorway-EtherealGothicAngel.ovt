@OBSThemeMeta {
    name: 'Ethereal Gothic Angel';
    id: 'com.myrqyry.Colorway.EtherealGothicAngel';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #0f090b;
    --bg_base: #0f090b;
    --bg_preview: #060406;
    --bg_dock: #140a10;
    --bg_hover: #1e1018;
    --text: #f0d0d8;
    --text_light: #f0d0d8;
    --text_muted: #987880;
    --text_disabled: #361e26;
    --text_inactive: #361e26;
    --text_inverse: #FFFFFF;
    --primary: #ff3b70;
    --primary_light: #ff5c86;
    --primary_lighter: #ffb3c6;
    --primary_dark: #d42a5a;
    --primary_darker: #a82048;
    --input_bg: #140a10;
    --input_bg_hover: #1e1018;
    --input_bg_focus: #1e1018;
    --input_border: #261418;
    --input_border_hover: #987880;
    --button_bg: #140a10;
    --button_bg_hover: #1e1018;
    --button_bg_disabled: #0f090b;
    --list_item_bg_hover: #1e1018;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #261418;
    --accent_bg_start: rgba(255, 59, 112, 0.3);
    --accent_bg_end: rgba(255, 59, 112, 0.1);
    --warning: #ffd166;
    --danger: #ff5c5c;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #f0d0d8;
    --ico_selected: #0f090b;
}
