@OBSThemeMeta {
    name: 'Catppuccin Frappé — Pink';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe.Pink';
    extends: 'com.myrqyry.Colorway.CatppuccinFrappe';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #f4b8e4;
    --primary_light: #f2d5cf;
    --primary_lighter: #eebebe;
    --primary_dark: #ca9ee6;
    --primary_darker: #626880;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #303446;
}
