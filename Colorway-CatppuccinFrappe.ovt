@OBSThemeMeta {
    name: 'Catppuccin Frappé';
    id: 'com.myrqyry.Colorway.CatppuccinFrappe';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Base Theme Colors */
    --bg_window: #292c3c;
    --bg_base: #303446;
    --bg_preview: #232634;

    --primary: #ca9ee6;
    --primary_light: #babbf1;
    --primary_lighter: #f4b8e4;
    --primary_dark: #8caaee;
    --primary_darker: #626880;

    --warning: #ef9f76;
    --danger: #e78284;

    --text: #c6d0f5;
    --text_light: #f5f5f5;
    --text_muted: #838ba7;

    --text_disabled: #a5adce;
    --text_inactive: #a5adce;

    --border_color: #414559;

    /* Inputs and Buttons */
    --input_bg: #414559;
    --input_bg_hover: #51576d;
    --input_bg_focus: #464d5e;

    --list_item_bg_hover: #484f5f;

    --input_border: #414559;
    --input_border_hover: #626880;

    --button_bg: #292c3c;
    --button_bg_hover: #414559;
    --button_bg_disabled: #303446;

    /* Theme Aliases */
    /* Replay/VirtualCam active state — derived from --primary */
    --accent_bg_start: rgba(202, 158, 230, 0.3);
    --accent_bg_end: rgba(202, 158, 230, 0.1);

    --bg_dock: #292c3c;
    --bg_hover: #414559;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #303446;
}
