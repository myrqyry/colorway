@OBSThemeMeta {
    name: 'Catppuccin Macchiato — Blue';
    id: 'com.myrqyry.Colorway.CatppuccinMacchiato.Blue';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Catppuccin Macchiato — Blue
       Hex colors:
       --bg_window: #1e2030;
       --bg_base: #24273a;
       --bg_preview: #181926;
       --bg_dock: #1e2030;
       --bg_hover: #363a4f;
       --text: #cad3f5;
       --text_light: #f5f5f5;
       --text_muted: #8087a2;
       --text_inactive: #a5adcb;
       --text_inverse: #FFFFFF;
       --text_disabled: #a5adcb;
       --primary: #8aadf4;
       --primary_light: #b7bdf8;
       --primary_lighter: #91d7e3;
       --primary_dark: #7dc4e4;
       --primary_darker: #5b6078;
       --input_bg: #363a4f;
       --input_bg_hover: #494d64;
       --input_bg_focus: #3d4159;
       --input_border: #4F5572;
       --input_border_hover: #5b6078;
       --button_bg: #1e2030;
       --button_bg_hover: #363a4f;
       --button_bg_disabled: #24273a;
       --list_item_bg_hover: #3f4359;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #363a4f;
       --ico: #cad3f5;
       --ico_selected: #24273a;
       --warning: #f5a97f;
       --danger: #ed8796;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(138, 173, 244, 0.3);
       --accent_bg_end: rgba(138, 173, 244, 0.1);
    */
    --bg_window: #1e2030;
    --bg_base: #24273a;
    --bg_preview: #181926;
    --primary: #8aadf4;
    --primary_light: #b7bdf8;
    --primary_lighter: #91d7e3;
    --primary_dark: #7dc4e4;
    --primary_darker: #5b6078;
    --warning: #f5a97f;
    --danger: #ed8796;
    --text: #cad3f5;
    --text_light: #f5f5f5;
    --text_muted: #8087a2;
    --text_disabled: #a5adcb;
    --text_inactive: #a5adcb;
    --text_inverse: #FFFFFF;
    --border_color: #363a4f;
    --input_bg: #363a4f;
    --input_bg_hover: #494d64;
    --input_bg_focus: #3d4159;
    --list_item_bg_hover: #3f4359;
    --input_border: #4F5572;
    --input_border_hover: #5b6078;
    --button_bg: #1e2030;
    --button_bg_hover: #363a4f;
    --button_bg_disabled: #24273a;
    --bg_dock: #1e2030;
    --bg_hover: #363a4f;
    --ico: var(--text);
    --ico_selected: #24273a;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(138, 173, 244, 0.3);
    --accent_bg_end: rgba(138, 173, 244, 0.1);
}
