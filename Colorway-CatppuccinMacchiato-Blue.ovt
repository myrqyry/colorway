@OBSThemeMeta {
    name: 'Catppuccin Macchiato — Blue';
    id: 'com.myrqyry.Colorway.CatppuccinMacchiato.Blue';
    extends: 'com.myrqyry.Colorway.CatppuccinMacchiato';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #8aadf4;
    --primary_light: #b7bdf8;
    --primary_lighter: #91d7e3;
    --primary_dark: #7dc4e4;
    --primary_darker: #5b6078;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #24273a;
}
