@OBSThemeMeta {
    name: 'Ethereal Luminous Space';
    id: 'com.myrqyry.Colorway.EtherealLuminousSpace';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #0d0b1a;
    --bg_base: #0d0b1a;
    --bg_preview: #06050e;
    --bg_dock: #120e24;
    --bg_hover: #1a1430;
    --text: #e4d8ff;
    --text_light: #e4d8ff;
    --text_muted: #8878b0;
    --text_disabled: #2a2040;
    --text_inactive: #2a2040;
    --text_inverse: #FFFFFF;
    --primary: #00ffd2;
    --primary_light: #cf9dff;
    --primary_lighter: #e8c8ff;
    --primary_dark: #00b8a0;
    --primary_darker: #00807a;
    --input_bg: #120e24;
    --input_bg_hover: #1a1430;
    --input_bg_focus: #1a1430;
    --input_border: #1e1432;
    --input_border_hover: #8878b0;
    --button_bg: #120e24;
    --button_bg_hover: #1a1430;
    --button_bg_disabled: #0d0b1a;
    --list_item_bg_hover: #1a1430;
    --list_item_bg_selected: #c4a7e7;
    --border_color: #1e1432;
    --accent_bg_start: rgba(0, 255, 210, 0.3);
    --accent_bg_end: rgba(0, 255, 210, 0.1);
    --warning: #ffd166;
    --danger: #ff6b6b;
    --success: #37d247;
    --meter_bg_nom: #26233a;
    --meter_bg_war: #f6c177;
    --meter_bg_err: #eb6f92;
    --meter_fg_nom: #c4a7e7;
    --meter_fg_war: #f6c177;
    --meter_fg_err: #eb6f92;
    --ico: #e4d8ff;
    --ico_selected: #0d0b1a;
}
