@OBSThemeMeta {
    name: 'Fire Spring';
    id: 'com.myrqyry.Colorway.FireSpring';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(217, 146, 255, 0.3);
    --accent_bg_end: rgba(217, 146, 255, 0.1);

    --bg_window: #181020;
    --bg_base: #181020;
    --bg_preview: #100a16;

    --primary: #d992ff;
    --primary_light: #a99ade;
    --primary_lighter: #c4b0f0;
    --primary_dark: #9b4de0;
    --primary_darker: #6a20a8;

    --warning: #f0e500;
    --danger: #ff6b6b;

    --text: #ffffca;
    --text_light: #ffffff;
    --text_muted: #ffff00;

    --text_disabled: #5a4070;
    --text_inactive: #5a4070;

    --border_color: #2a1a3a;

    --input_bg: #22142e;
    --input_bg_hover: #2e1e40;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #2e1e40;

    --input_border: #2a1a3a;
    --input_border_hover: #d992ff;

    --button_bg: #9766B2;
    --button_bg_hover: #e4aaff;
    --button_bg_disabled: #181020;

    --bg_dock: #1e1228;
    --bg_hover: #2e1e40;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #181020;
}
