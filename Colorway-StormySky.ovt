@OBSThemeMeta {
    name: 'Stormy Sky';
    id: 'com.myrqyry.Colorway.StormySky';
    extends: 'com.myrqyry.Colorway';
    author: 'Mat + AI';
    dark: 'true';
}

@OBSThemeVars {
    /* Stormy Sky Palette */
    --bg_window: #1e222a;
    --bg_base: #1e222a;
    --bg_preview: #232933;

    /* Cyan / Storm Accent */
    --primary: #39c5bb;
    --primary_light: #7be1d9;
    --primary_lighter: #bcf2ee;
    --primary_dark: #2a9b92;
    --primary_darker: #1c6d66;

    /* Supporting Colors */
    --warning: #f6c177;
    --danger: #ff0055;

    /* Typography */
    --text: #e6e6e6;
    --text_light: #ffffff;
    --text_muted: #808080;

    --text_disabled: #4d4d4d;
    --text_inactive: #4d4d4d;

    --border_color: #4d4d4d;

    /* Inputs and Buttons */
    --input_bg: #2d2d2d;
    --input_bg_hover: #4d4d4d;
    --input_bg_focus: #2d2d2d;

    --list_item_bg_hover: #2d2d2d;

    --input_border: #4d4d4d;
    --input_border_hover: #808080;

    --button_bg: #2d2d2d;
    --button_bg_hover: #4d4d4d;
    --button_bg_disabled: #1e222a;

    /* Theme Aliases */
    --bg_dock: #2d2d2d;
    --bg_hover: #4d4d4d;
}
