@OBSThemeMeta {
    name: 'Cursor';
    id: 'com.myrqyry.Colorway.Cursor';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(136, 192, 208, 0.3);
    --accent_bg_end: rgba(136, 192, 208, 0.1);

    /* Base Theme Colors */
    --bg_window: #181818;
    --bg_base: #181818;
    --bg_preview: #2f2f2f;

    --primary: #88c0d0;
    --primary_light: #81a1c1;
    --primary_lighter: #88c0d0;
    --primary_dark: #3fa266;
    --primary_darker: #e4e4e45e;

    --warning: #f1b467;
    --danger: #e34671;

    --text: #e4e4e4;
    --text_light: #ffffff;
    --text_muted: #e4e4e45e;

    --text_disabled: #c2c2c2;
    --text_inactive: #c2c2c2;
    --text_inverse: #FFFFFF;

    --border_color: #2a2a2a;

    /* Inputs and Buttons */
    --input_bg: #2f2f2f;
    --input_bg_hover: #393939;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #393939;

    --input_border: #2a2a2a;
    --input_border_hover: #88c0d0;

    --button_bg: #171717;
    --button_bg_hover: #393939;
    --button_bg_disabled: #181818;

    /* Theme Aliases */
    --bg_dock: #171717;
    --bg_hover: #393939;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #181818;
}
