@OBSThemeMeta {
    name: 'Rosé Pine — Gold';
    id: 'com.myrqyry.Colorway.RosePine.Gold';
    extends: 'com.myrqyry.Colorway.RosePine';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #f6c177;
    --primary_light: #ebbcba;
    --primary_lighter: #e0def4;
    --primary_dark: #eb6f92;
    --primary_darker: #524f67;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #191724;
}
