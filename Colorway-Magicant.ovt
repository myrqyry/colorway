@OBSThemeMeta {
    name: 'Magicant';
    id: 'com.myrqyry.Colorway.Magicant';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(157, 2, 242, 0.3);
    --accent_bg_end: rgba(157, 2, 242, 0.1);

    --bg_window: #F9F8B9;
    --bg_base: #F9F8B9;
    --bg_preview: #f0f0a0;

    --primary: #9D02F2;
    --primary_light: #7100b1;
    --primary_lighter: #9b30d0;
    --primary_dark: #604633;
    --primary_darker: #3d2a20;

    --warning: #f6d56a;
    --danger: #87000d;

    --text: #220088;
    --text_light: #1a0060;
    --text_muted: #90694c;

    --text_disabled: #c0b890;
    --text_inactive: #c0b890;

    --border_color: #e0d890;

    --input_bg: #fffde0;
    --input_bg_hover: #fff8c0;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #fff8c0;

    --input_border: #e0d890;
    --input_border_hover: #9D02F2;

    --button_bg: #9D02F2;
    --button_bg_hover: #b040ff;
    --button_bg_disabled: #F9F8B9;

    /* Light theme: selected-item text stays dark */
    --text_inverse: #191724;

    --bg_dock: #fffde0;
    --bg_hover: #fff8c0;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #F9F8B9;
}
