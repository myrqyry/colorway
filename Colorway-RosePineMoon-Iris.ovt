@OBSThemeMeta {
    name: 'Rose Pine Moon — Iris';
    id: 'com.myrqyry.Colorway.RosePineMoon.Iris';
    extends: 'com.myrqyry.Colorway.RosePineMoon';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --primary: #c4a7e7;
    --primary_light: #ea9a97;
    --primary_lighter: #e0def4;
    --primary_dark: #9ccfd8;
    --primary_darker: #56526e;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #232136;
}
