@OBSThemeMeta {
    name: 'Rose Pine Moon — Gold';
    id: 'com.myrqyry.Colorway.RosePineMoon.Gold';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Rose Pine Moon — Gold
       Hex colors:
       --bg_window: #232136;
       --bg_base: #232136;
       --bg_preview: #2a273f;
       --bg_dock: #2a273f;
       --bg_hover: #393552;
       --text: #e0def4;
       --text_light: #e0def4;
       --text_muted: #908caa;
       --text_inactive: #6e6a86;
       --text_inverse: #FFFFFF;
       --text_disabled: #6e6a86;
       --primary: #f6c177;
       --primary_light: #ea9a97;
       --primary_lighter: #e0def4;
       --primary_dark: #eb6f92;
       --primary_darker: #56526e;
       --input_bg: #2a273f;
       --input_bg_hover: #393552;
       --input_bg_focus: #3a3751;
       --input_border: #393552;
       --input_border_hover: #56526e;
       --button_bg: #393552;
       --button_bg_hover: #44415a;
       --button_bg_disabled: #232136;
       --list_item_bg_hover: #3a3751;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #393552;
       --ico: #e0def4;
       --ico_selected: #232136;
       --warning: #f6c177;
       --danger: #eb6f92;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(246, 193, 119, 0.3);
       --accent_bg_end: rgba(246, 193, 119, 0.1);
    */
    --bg_window: #232136;
    --bg_base: #232136;
    --bg_preview: #2a273f;
    --primary: #f6c177;
    --primary_light: #ea9a97;
    --primary_lighter: #e0def4;
    --primary_dark: #eb6f92;
    --primary_darker: #56526e;
    --warning: #f6c177;
    --danger: #eb6f92;
    --text: #e0def4;
    --text_light: #e0def4;
    --text_muted: #908caa;
    --text_disabled: #6e6a86;
    --text_inactive: #6e6a86;
    --text_inverse: #FFFFFF;
    --border_color: #393552;
    --input_bg: #2a273f;
    --input_bg_hover: #393552;
    --input_bg_focus: #3a3751;
    --list_item_bg_hover: #3a3751;
    --input_border: #393552;
    --input_border_hover: #56526e;
    --button_bg: #393552;
    --button_bg_hover: #44415a;
    --button_bg_disabled: #232136;
    --bg_dock: #2a273f;
    --bg_hover: #393552;
    --ico: var(--text);
    --ico_selected: #232136;

    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(246, 193, 119, 0.3);
    --accent_bg_end: rgba(246, 193, 119, 0.1);
}
