@OBSThemeMeta {
    name: 'EarthBound — Dusty Dunes';
    id: 'com.myrqyry.Colorway.DustyDunes';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: EarthBound — Dusty Dunes
       Hex colors:
       --bg_window: #0e0900;
       --bg_base: #0e0900;
       --bg_preview: #080600;
       --bg_dock: #120a00;
       --bg_hover: #2a1e08;
       --text: #f9e4a1;
       --text_light: #f9e4a1;
       --text_muted: #ffff9f;
       --text_inactive: #5a4a20;
       --text_inverse: #000000;
       --text_disabled: #5a4a20;
       --primary: #f6d56a;
       --primary_light: #ffd03c;
       --primary_lighter: #ffe08a;
       --primary_dark: #d4a830;
       --primary_darker: #a08020;
       --input_bg: #1a1200;
       --input_bg_hover: #2a1e08;
       --input_bg_focus: #2a1e08;
       --input_border: #3a2a10;
       --input_border_hover: #f6d56a;
       --button_bg: #AC954A;
       --button_bg_hover: #ffdd80;
       --button_bg_disabled: #0e0900;
       --list_item_bg_hover: #2a1e08;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #3a2a10;
       --ico: #f9e4a1;
       --ico_selected: #0e0900;
       --warning: #ffd03c;
       --danger: #ff8080;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(246, 213, 106, 0.3);
       --accent_bg_end: rgba(246, 213, 106, 0.1);
    */

    --accent_bg_start: 'rgba(246, 213, 106, 0.3)';
    --accent_bg_end: 'rgba(246, 213, 106, 0.1)';

    --bg_window: #0e0900;
    --bg_base: #0e0900;
    --bg_preview: #080600;

    --primary: #f6d56a;
    --primary_light: #ffd03c;
    --primary_lighter: #ffe08a;
    --primary_dark: #d4a830;
    --primary_darker: #a08020;

    --warning: #ffd03c;
    --danger: #ff8080;

    --text: #f9e4a1;
    --text_light: #f9e4a1;
    --text_muted: #ffff9f;

    --text_disabled: #5a4a20;
    --text_inactive: #5a4a20;
    --text_inverse: #000000;

    --border_color: #3a2a10;

    --input_bg: #1a1200;
    --input_bg_hover: #2a1e08;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #2a1e08;

    --input_border: #3a2a10;
    --input_border_hover: #f6d56a;

    --button_bg: #AC954A;
    --button_bg_hover: #ffdd80;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #0e0900;

    --bg_dock: #120a00;
    --bg_hover: #2a1e08;

    
    --ico: var(--text);
    --ico_selected: #0e0900;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #f9e4a1;
    --on_panel_muted: #ffff9f;
    --on_base_muted: #ffff9f;
    --on_preview_muted: #ffff9f;
    --on_preview: #f9e4a1;
    --on_list_hover: #f9e4a1;
    --on_hover: #f9e4a1;
    --on_panel_disabled: #6b5c36;
    --on_base_disabled: #6a5c36;
    --on_panel_outline: #685c48;
    --on_section_heading: #f6d56a;
    --on_panel_accent: #f6d56a;
    --on_button: #342f22;
    --on_button_disabled: #6a5c36;
    --on_input: #f9e4a1;
    --on_input_hover: #f9e4a1;
    --on_input_focus: #f9e4a1;
    --on_nav_hover: #f9e4a1;
    --on_mixer_muted: #ff8080;
    --on_mixer_warning: #ffd03c;
    --cw_icon_cogs_button: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_filter_button: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ff8080.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ffd03c.svg)';
    /* colorway:state-tokens:end */

}
