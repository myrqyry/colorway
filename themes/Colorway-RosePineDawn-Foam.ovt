@OBSThemeMeta {
    name: 'Rose Pine Dawn — Foam';
    id: 'com.myrqyry.Colorway.RosePineDawn.Foam';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference: Rose Pine Dawn — Foam
       Hex colors:
       --bg_window: #faf4ed;
       --bg_base: #faf4ed;
       --bg_preview: #fffaf3;
       --bg_dock: #f2e9e1;
       --bg_hover: #f4ede8;
       --text: #575279;
       --text_light: #ffffff;
       --text_muted: #9893a5;
       --text_inactive: #9893a5;
       --text_inverse: #575279;
       --text_disabled: #9893a5;
       --primary: #56949f;
       --primary_light: #907aa9;
       --primary_lighter: #d7827e;
       --primary_dark: #286983;
       --primary_darker: #cecacd;
       --input_bg: #fffaf3;
       --input_bg_hover: #f4ede8;
       --input_bg_focus: #f2e9e1;
       --input_border: #cecacd;
       --input_border_hover: #dfdad9;
       --button_bg: #f2e9e1;
       --button_bg_hover: #f4ede8;
       --button_bg_disabled: #faf4ed;
       --list_item_bg_hover: #f4ede8;
       --list_item_bg_selected: #faf4ed;
       --border_color: #dfdad9;
       --ico: #575279;
       --ico_selected: #faf4ed;
       --warning: #ea9d34;
       --danger: #b4637a;
       --success: #37d247;
       --meter_bg_nom: #fffaf3;
       --meter_bg_war: #ea9d34;
       --meter_bg_err: #b4637a;
       --meter_fg_nom: #56949f;
       --meter_fg_war: #ea9d34;
       --meter_fg_err: #b4637a;
       Derived colors:
       --accent_bg_start: rgba(86, 148, 159, 0.3);
       --accent_bg_end: rgba(86, 148, 159, 0.1);
    */

    --bg_window: #faf4ed;
    --bg_base: #faf4ed;
    --bg_preview: #fffaf3;
    --bg_dock: #f2e9e1;
    --bg_hover: #f4ede8;

    --text: #575279;
    --text_light: #ffffff;
    --text_muted: #9893a5;
    --text_inactive: #9893a5;
    --text_inverse: #575279;
    --text_disabled: #9893a5;

    --border_color: #dfdad9;

    --input_bg: #fffaf3;
    --input_bg_hover: #f4ede8;
    --input_bg_focus: #f2e9e1;
    --input_border: #cecacd;
    --input_border_hover: #dfdad9;

    --button_bg: #f2e9e1;
    --button_bg_hover: #f4ede8;
    --button_bg_disabled: #faf4ed;

    --list_item_bg_hover: #f4ede8;
    --list_item_bg_selected: #faf4ed;

    --warning: #ea9d34;
    --danger: #b4637a;
    --success: #37d247;

    --meter_bg_nom: #fffaf3;
    --meter_bg_war: #ea9d34;
    --meter_bg_err: #b4637a;
    --meter_fg_nom: #56949f;
    --meter_fg_war: #ea9d34;
    --meter_fg_err: #b4637a;

    
    --accent_bg_start: rgba(86, 148, 159, 0.3);
    --accent_bg_end: rgba(86, 148, 159, 0.1);

    --primary: #56949f;
    --primary_light: #907aa9;
    --primary_lighter: #d7827e;
    --primary_dark: #286983;
    --primary_darker: #cecacd;

    
    --ico: #575279;
    --ico_selected: #faf4ed;

}
