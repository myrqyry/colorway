@OBSThemeMeta {
    name: 'Catppuccin Sibling — Ube';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Ube';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: mulberry / red-plum.
 */
@OBSThemeVars {
    /* Official palette reference: Catppuccin Sibling — Ube
       Hex colors:
       --bg_window: #20161f;
       --bg_base: #281b26;
       --bg_preview: #170f16;
       --bg_dock: #20161f;
       --bg_hover: #3b3039;
       --text: #e3d1e0;
       --text_light: #f3e1df;
       --text_muted: #8f808d;
       --text_inactive: #b8a8b6;
       --text_inverse: #170f16;
       --text_disabled: #b8a8b6;
       --primary: #c6aaf1;
       --primary_light: #bebcf4;
       --primary_lighter: #ecc6ea;
       --primary_dark: #86b7ee;
       --primary_darker: #655863;
       --input_bg: #3b3039;
       --input_bg_hover: #50454e;
       --input_bg_focus: #50454e;
       --input_border: #50454e;
       --input_border_hover: #c6aaf1;
       --button_bg: #20161f;
       --button_bg_hover: #3b3039;
       --button_bg_disabled: #281b26;
       --list_item_bg_hover: #3b3039;
       --list_item_bg_selected: #c6aaf1;
       --border_color: #3b3039;
       --ico: #e3d1e0;
       --ico_selected: #170f16;
       --warning: #fbe0b8;
       --danger: #ec91a2;
       --success: #bade9e;
       --meter_bg_nom: #3b3039;
       --meter_bg_war: #3b3039;
       --meter_bg_err: #3b3039;
       --meter_fg_nom: #bade9e;
       --meter_fg_war: #fbe0b8;
       --meter_fg_err: #ec91a2;
       Derived colors:
       --accent_bg_start: rgba(198, 170, 241, 0.3);
       --accent_bg_end: rgba(198, 170, 241, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling_text: #e3d1e0;
    --sibling_subtext1: #cebdcc;
    --sibling_subtext0: #b8a8b6;
    --sibling_overlay2: #a495a2;
    --sibling_overlay1: #8f808d;
    --sibling_overlay0: #7a6d78;
    --sibling_surface2: #655863;
    --sibling_surface1: #50454e;
    --sibling_surface0: #3b3039;
    --sibling_base: #281b26;
    --sibling_mantle: #20161f;
    --sibling_crust: #170f16;

    --sibling_rosewater: #f3e1df;
    --sibling_flamingo: #ecced9;
    --sibling_pink: #ecc6ea;
    --sibling_mauve: #c6aaf1;
    --sibling_red: #ec91a2;
    --sibling_maroon: #dfa4bf;
    --sibling_peach: #f5b496;
    --sibling_yellow: #fbe0b8;
    --sibling_green: #bade9e;
    --sibling_teal: #a3dfcb;
    --sibling_sky: #94dbe1;
    --sibling_sapphire: #7fc6e4;
    --sibling_blue: #86b7ee;
    --sibling_lavender: #bebcf4;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling_mantle);
    --bg_base: var(--sibling_base);
    --bg_preview: var(--sibling_crust);
    --bg_dock: var(--sibling_mantle);
    --bg_hover: var(--sibling_surface0);
    --text: var(--sibling_text);
    --text_light: var(--sibling_rosewater);
    --text_muted: var(--sibling_overlay1);
    --text_inactive: var(--sibling_subtext0);
    --text_inverse: var(--sibling_crust);
    --text_disabled: var(--sibling_subtext0);
    --primary: var(--sibling_mauve);
    --primary_light: var(--sibling_lavender);
    --primary_lighter: var(--sibling_pink);
    --primary_dark: var(--sibling_blue);
    --primary_darker: var(--sibling_surface2);
    --input_bg: var(--sibling_surface0);
    --input_bg_hover: var(--sibling_surface1);
    --input_bg_focus: var(--sibling_surface1);
    --input_border: var(--sibling_surface1);
    --input_border_hover: var(--sibling_mauve);
    --button_bg: var(--sibling_mantle);
    --button_bg_hover: var(--sibling_surface0);
    --button_hover_text: var(--sibling_text);
    --button_bg_disabled: var(--sibling_base);
    --list_item_bg_hover: var(--sibling_surface0);
    --list_item_bg_selected: var(--sibling_mauve);
    --border_color: var(--sibling_surface0);
    --warning: var(--sibling_yellow);
    --danger: var(--sibling_red);
    --success: var(--sibling_green);
    --meter_bg_nom: var(--sibling_surface0);
    --meter_bg_war: var(--sibling_surface0);
    --meter_bg_err: var(--sibling_surface0);
    --meter_fg_nom: var(--sibling_green);
    --meter_fg_war: var(--sibling_yellow);
    --meter_fg_err: var(--sibling_red);
    --ico: var(--text);
    --ico_selected: var(--sibling_crust);
    --accent_bg_start: rgba(198, 170, 241, 0.3);
    --accent_bg_end: rgba(198, 170, 241, 0.1);
}
