@OBSThemeMeta {
    name: 'Hydrangea 11';
    id: 'com.myrqyry.Colorway.Hydrangea11';
    extends: 'com.myrqyry.Colorway';
    author: 'Dinchenix / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Hydrangea 11
       Hex colors:
       --bg_window: #413652;
       --bg_base: #413652;
       --bg_preview: #575f7e;
       --bg_dock: #6f577e;
       --bg_hover: #6f577e;
       --text: #eae4dd;
       --text_light: #ffffff;
       --text_muted: #62778c;
       --text_inactive: #575f7e;
       --text_inverse: #000000;
       --text_disabled: #575f7e;
       --primary: #c090a7;
       --primary_light: #d4beb8;
       --primary_lighter: #eae4dd;
       --primary_dark: #986f9c;
       --primary_darker: #6f577e;
       --input_bg: #575f7e;
       --input_bg_hover: #575f7e;
       --input_bg_focus: #6f577e;
       --input_border: #575f7e;
       --input_border_hover: #c090a7;
       --button_bg: #6f577e;
       --button_bg_hover: #eae4dd;
       --button_bg_disabled: #413652;
       --list_item_bg_hover: #413652;
       --list_item_bg_selected: #d4beb8;
       --border_color: #575f7e;
       --warning: #f1eab6;
       --danger: #c090a7;
       --success: #90c0a0;
       --meter_bg_nom: #575f7e;
       --meter_bg_war: #c090a7;
       --meter_bg_err: #986f9c;
       --meter_fg_nom: #90c0a0;
       --meter_fg_war: #f1eab6;
       --meter_fg_err: #c090a7;
       Derived colors:
       --accent_bg_start: rgba(192, 144, 167, 0.3);
       --accent_bg_end: rgba(192, 144, 167, 0.1);
    */

    --bg_window: #413652;
    --bg_base: #413652;
    --bg_preview: #575f7e;
    --bg_dock: #6f577e;
    --bg_hover: #6f577e;

    --primary: #c090a7;
    --primary_light: #d4beb8;
    --primary_lighter: #eae4dd;
    --primary_dark: #986f9c;
    --primary_darker: #6f577e;

    --warning: #f1eab6;
    --danger: #c090a7;

    --text: #eae4dd;
    --text_light: #ffffff;
    --text_muted: #62778c;
    --text_disabled: #575f7e;
    --text_inactive: #575f7e;

    --border_color: #575f7e;

    --input_bg: #575f7e;
    --input_bg_hover: #575f7e;
    --input_bg_focus: #6f577e;
    --list_item_bg_hover: #413652;
    --list_item_bg_selected: #d4beb8;
    --input_border: #575f7e;
    --input_border_hover: #c090a7;

    --button_bg: #6f577e;
    --button_bg_hover: #eae4dd;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #413652;

    --success: #90c0a0;
    --meter_bg_nom: #575f7e;
    --meter_bg_war: #c090a7;
    --meter_bg_err: #986f9c;
    --meter_fg_nom: #90c0a0;
    --meter_fg_war: #f1eab6;
    --meter_fg_err: #c090a7;

    --accent_bg_start: 'rgba(192, 144, 167, 0.3)';
    --accent_bg_end: 'rgba(192, 144, 167, 0.1)';

    --text_inverse: #000000;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #eae4dd;
    --on_panel_muted: #d5dbe0;
    --on_base_muted: #98a6b3;
    --on_preview_muted: #d5dbe1;
    --on_panel_disabled: #afb3c1;
    --on_base_disabled: #7d849b;
    --on_panel_outline: #afb3c1;
    --on_section_heading: #c498ad;
    --on_panel_accent: #e7d6de;
    --on_button: #eae4dd;
    --on_button_disabled: #7d849b;
    --on_input: #eae4dd;
    --on_input_hover: #eae4dd;
    --on_input_focus: #eae4dd;
    --on_mixer_muted: #c090a7;
    --on_mixer_monitor: #90c0a0;
    --on_mixer_warning: #f1eab6;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-c090a7.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-90c0a0.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-f1eab6.svg)';
    /* colorway:state-tokens:end */

}
