@OBSThemeMeta {
    name: 'Catppuccin Sibling — Affogato';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Affogato';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: warm espresso / cocoa.
 */
@OBSThemeVars {
    /* Official palette reference (Colorway-generated sibling; not an official Catppuccin flavor): Catppuccin Sibling — Affogato
       Hex colors:
       --bg_window: #23170e;
       --bg_base: #2b1c12;
       --bg_preview: #19100a;
       --bg_dock: #23170e;
       --bg_hover: #3e3128;
       --text: #e8d3c5;
       --text_light: #f2e2da;
       --text_muted: #938277;
       --text_inactive: #bdaa9e;
       --text_inverse: #19100a;
       --text_disabled: #bdaa9e;
       --primary: #d9a3e2;
       --primary_light: #bebcf5;
       --primary_lighter: #f7c3da;
       --primary_dark: #7bbaed;
       --primary_darker: #685950;
       --input_bg: #3e3128;
       --input_bg_hover: #53463e;
       --input_bg_focus: #53463e;
       --input_border: #53463e;
       --input_border_hover: #d9a3e2;
       --button_bg: #23170e;
       --button_bg_hover: #3e3128;
       --button_hover_text: #e8d3c5;
       --button_bg_disabled: #2b1c12;
       --list_item_bg_hover: #3e3128;
       --list_item_bg_selected: #d9a3e2;
       --border_color: #3e3128;
       --warning: #f9e1b6;
       --danger: #ef9198;
       --success: #b9de9c;
       --meter_bg_nom: #3e3128;
       --meter_bg_war: #3e3128;
       --meter_bg_err: #3e3128;
       --meter_fg_nom: #b9de9c;
       --meter_fg_war: #f9e1b6;
       --meter_fg_err: #ef9198;
       --ico: #e8d3c5;
       --ico_selected: #19100a;
       Derived colors:
       --accent_bg_start: rgba(217, 163, 226, 0.3);
       --accent_bg_end: rgba(217, 163, 226, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling-text: #e8d3c5;
    --sibling-subtext1: #d3bfb2;
    --sibling-subtext0: #bdaa9e;
    --sibling-overlay2: #a8978c;
    --sibling-overlay1: #938277;
    --sibling-overlay0: #7d6e64;
    --sibling-surface2: #685950;
    --sibling-surface1: #53463e;
    --sibling-surface0: #3e3128;
    --sibling-base: #2b1c12;
    --sibling-mantle: #23170e;
    --sibling-crust: #19100a;

    --sibling-rosewater: #f2e2da;
    --sibling-flamingo: #efcfca;
    --sibling-pink: #f7c3da;
    --sibling-mauve: #d9a3e2;
    --sibling-red: #ef9198;
    --sibling-maroon: #e7a59f;
    --sibling-peach: #f3b68e;
    --sibling-yellow: #f9e1b6;
    --sibling-green: #b9de9c;
    --sibling-teal: #a3e0c9;
    --sibling-sky: #93dcdb;
    --sibling-sapphire: #7ac8e0;
    --sibling-blue: #7bbaed;
    --sibling-lavender: #bebcf5;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling-mantle);
    --bg_base: var(--sibling-base);
    --bg_preview: var(--sibling-crust);
    --bg_dock: var(--sibling-mantle);
    --bg_hover: var(--sibling-surface0);
    --text: var(--sibling-text);
    --text_light: var(--sibling-rosewater);
    --text_muted: var(--sibling-overlay1);
    --text_inactive: var(--sibling-subtext0);
    --text_inverse: var(--sibling-crust);
    --text_disabled: var(--sibling-subtext0);
    --primary: var(--sibling-mauve);
    --primary_light: var(--sibling-lavender);
    --primary_lighter: var(--sibling-pink);
    --primary_dark: var(--sibling-blue);
    --primary_darker: var(--sibling-surface2);
    --input_bg: var(--sibling-surface0);
    --input_bg_hover: var(--sibling-surface1);
    --input_bg_focus: var(--sibling-surface1);
    --input_border: var(--sibling-surface1);
    --input_border_hover: var(--sibling-mauve);
    --button_bg: var(--sibling-mantle);
    --button_bg_hover: var(--sibling-surface0);
    --button_hover_text: var(--sibling-text);
    --button_bg_disabled: var(--sibling-base);
    --list_item_bg_hover: var(--sibling-surface0);
    --list_item_bg_selected: var(--sibling-mauve);
    --border_color: var(--sibling-surface0);
    --warning: var(--sibling-yellow);
    --danger: var(--sibling-red);
    --success: var(--sibling-green);
    --meter_bg_nom: var(--sibling-surface0);
    --meter_bg_war: var(--sibling-surface0);
    --meter_bg_err: var(--sibling-surface0);
    --meter_fg_nom: var(--sibling-green);
    --meter_fg_war: var(--sibling-yellow);
    --meter_fg_err: var(--sibling-red);
    --ico: var(--text);
    --ico_selected: var(--sibling-crust);
    --accent_bg_start: rgba(217, 163, 226, 0.3);
    --accent_bg_end: rgba(217, 163, 226, 0.1);
}
