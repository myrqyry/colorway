@OBSThemeMeta {
    name: 'Vanitas';
    id: 'com.myrqyry.Colorway.Vanitas';
    extends: 'com.myrqyry.Colorway';
    author: 'Vsigos / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Vanitas
       Hex colors:
       --bg_window: #1d1e19;
       --bg_base: #1d1e19;
       --bg_preview: #273d3e;
       --bg_dock: #372614;
       --bg_hover: #474b3c;
       --text: #beb2ab;
       --text_light: #beb2ab;
       --text_muted: #a39c75;
       --text_inactive: #918c6c;
       --text_inverse: #1d1e19;
       --text_disabled: #6b6f54;
       --primary: #a39c75;
       --primary_light: #beb2ab;
       --primary_lighter: #beb2ab;
       --primary_dark: #a25d1b;
       --primary_darker: #735e25;
       --input_bg: #273d3e;
       --input_bg_hover: #335552;
       --input_bg_focus: #273d3e;
       --input_border: #516664;
       --input_border_hover: #a25d1b;
       --button_bg: #335552;
       --button_bg_hover: #a39c75;
       --button_bg_disabled: #273d3e;
       --list_item_bg_hover: #474b3c;
       --list_item_bg_selected: #335552;
       --border_color: #516664;
       --ico: #beb2ab;
       --ico_selected: #1d1e19;
       --warning: #a39c75;
       --danger: #cc897f;
       --success: #9fbba2;
       --meter_bg_nom: #273d3e;
       --meter_bg_war: #5a4507;
       --meter_bg_err: #7a461b;
       --meter_fg_nom: #9fbba2;
       --meter_fg_war: #a39c75;
       --meter_fg_err: #cc897f;
       Derived colors:
       --accent_bg_start: rgba(162, 93, 27, 0.3);
       --accent_bg_end: rgba(162, 93, 27, 0.1);
    */

    /* Lospec palette: vanitas — Vsigos
       Source: https://lospec.com/palette-list/vanitas
       Colors mapped to OBS roles; derived alert colors are explicitly
       distinct from the original limited source palette. */

    --bg_window: #1d1e19;
    --bg_base: #1d1e19;
    --bg_preview: #273d3e;
    --bg_dock: #372614;
    --bg_hover: #474b3c;
    --text: #beb2ab;
    --text_light: #beb2ab;
    --text_muted: #a39c75;
    --text_inactive: #918c6c;
    --text_disabled: #6b6f54;
    --text_inverse: #1d1e19;
    --primary: #a39c75;
    --primary_light: #beb2ab;
    --primary_lighter: #beb2ab;
    --primary_dark: #a25d1b;
    --primary_darker: #735e25;
    --input_bg: #273d3e;
    --input_bg_hover: #335552;
    --input_bg_focus: #273d3e;
    --input_border: #516664;
    --input_border_hover: #a25d1b;
    --button_bg: #335552;
    --button_bg_hover: #a39c75;
    --button_hover_text: #1d1e19;
    --button_bg_disabled: #273d3e;
    --list_item_bg_hover: #474b3c;
    --list_item_bg_selected: #335552;
    --border_color: #516664;
    --warning: #a39c75;
    --danger: #cc897f;
    --success: #9fbba2;
    --meter_bg_nom: #273d3e;
    --meter_bg_war: #5a4507;
    --meter_bg_err: #7a461b;
    --meter_fg_nom: #9fbba2;
    --meter_fg_war: #a39c75;
    --meter_fg_err: #cc897f;
    --accent_bg_start: 'rgba(162, 93, 27, 0.3)';
    --accent_bg_end: 'rgba(162, 93, 27, 0.1)';
    --ico: var(--text);
    --ico_selected: var(--text_inverse);
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/normal/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #beb2ab;
    --on_panel_muted: #a39c75;
    --on_base_muted: #a39c75;
    --on_preview_muted: #a9a37e;
    --on_preview: #beb2ab;
    --on_list_hover: #c1b6af;
    --on_hover: #c1b6af;
    --on_panel_disabled: #71745b;
    --on_base_disabled: #6b6f54;
    --on_panel_outline: #637674;
    --on_section_heading: #a39c75;
    --on_panel_accent: #a39c75;
    --on_button: #c9beb9;
    --on_button_disabled: #81856e;
    --on_input: #beb2ab;
    --on_input_hover: #c9beb9;
    --on_input_focus: #beb2ab;
    --on_nav_hover: #beb2ab;
    --on_mixer_muted: #cc897f;
    --on_mixer_monitor: #9fbba2;
    --on_mixer_warning: #a39c75;
    --on_primary_dark: #ffffff;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-cc897f.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-9fbba2.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-a39c75.svg)';
    /* colorway:state-tokens:end */

}
