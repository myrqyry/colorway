@OBSThemeMeta {
    name: 'Everforest Dark Soft';
    id: 'com.myrqyry.Colorway.Everforest.Soft';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Everforest Dark Soft
       Hex colors:
       --bg_window: #333C43;
       --bg_base: #333C43;
       --bg_preview: #293136;
       --bg_dock: #3A464C;
       --bg_hover: #434F55;
       --text: #D3C6AA;
       --text_light: #FFFFFF;
       --text_muted: #9DA9A0;
       --text_inactive: #7A8478;
       --text_inverse: #FFFFFF;
       --text_disabled: #7A8478;
       --primary: #A7C080;
       --primary_light: #D3C6AA;
       --primary_lighter: #E6E2CC;
       --primary_dark: #8DA468;
       --primary_darker: #4A5B48;
       --input_bg: #3A464C;
       --input_bg_hover: #434F55;
       --input_bg_focus: #434F55;
       --input_border: #434F55;
       --input_border_hover: #859289;
       --button_bg: #3A464C;
       --button_bg_hover: #434F55;
       --button_bg_disabled: #333C43;
       --list_item_bg_hover: #434F55;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #434F55;
       --ico: #D3C6AA;
       --ico_selected: #333C43;
       --warning: #DBBC7F;
       --danger: #E67E80;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(167, 192, 128, 0.3);
       --accent_bg_end: rgba(167, 192, 128, 0.1);
    */

    --accent_bg_start: rgba(167, 192, 128, 0.3);
    --accent_bg_end: rgba(167, 192, 128, 0.1);

    --bg_window: #333C43;
    --bg_base: #333C43;
    --bg_preview: #293136;

    --primary: #A7C080;
    --primary_light: #D3C6AA;
    --primary_lighter: #E6E2CC;
    --primary_dark: #8DA468;
    --primary_darker: #4A5B48;

    --warning: #DBBC7F;
    --danger: #E67E80;

    --text: #D3C6AA;
    --text_light: #FFFFFF;
    --text_muted: #9DA9A0;

    --text_disabled: #7A8478;
    --text_inactive: #7A8478;
    --text_inverse: #FFFFFF;

    --border_color: #434F55;

    --input_bg: #3A464C;
    --input_bg_hover: #434F55;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #434F55;

    --input_border: #434F55;
    --input_border_hover: #859289;

    --button_bg: #3A464C;
    --button_bg_hover: #434F55;
    --button_bg_disabled: #333C43;

    --bg_dock: #3A464C;
    --bg_hover: #434F55;

    
    --ico: var(--text);
    --ico_selected: #333C43;

}
