@OBSThemeMeta {
    name: 'Catppuccin Mocha — Red';
    id: 'com.myrqyry.Colorway.CatppuccinMocha.Red';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Catppuccin Mocha — Red
       Hex colors:
       --bg_window: #181825;
       --bg_base: #1e1e2e;
       --bg_preview: #11111b;
       --bg_dock: #181825;
       --bg_hover: #313244;
       --text: #cdd6f4;
       --text_light: #f5f5f5;
       --text_muted: #7f849c;
       --text_inactive: #a6adc8;
       --text_inverse: #FFFFFF;
       --text_disabled: #a6adc8;
       --primary: #f38ba8;
       --primary_light: #eba0ac;
       --primary_lighter: #fab387;
       --primary_dark: #eba0ac;
       --primary_darker: #585b70;
       --input_bg: #313244;
       --input_bg_hover: #45475a;
       --input_bg_focus: #383652;
       --input_border: #484A64;
       --input_border_hover: #585b70;
       --button_bg: #181825;
       --button_bg_hover: #313244;
       --button_bg_disabled: #1e1e2e;
       --list_item_bg_hover: #3a3955;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #313244;
       --ico: #cdd6f4;
       --ico_selected: #1e1e2e;
       --warning: #fab387;
       --danger: #f38ba8;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(243, 139, 168, 0.3);
       --accent_bg_end: rgba(243, 139, 168, 0.1);
    */

    --bg_window: #181825;
    --bg_base: #1e1e2e;
    --bg_preview: #11111b;
    --primary: #f38ba8;
    --primary_light: #eba0ac;
    --primary_lighter: #fab387;
    --primary_dark: #eba0ac;
    --primary_darker: #585b70;
    --warning: #fab387;
    --danger: #f38ba8;
    --text: #cdd6f4;
    --text_light: #f5f5f5;
    --text_muted: #7f849c;
    --text_disabled: #a6adc8;
    --text_inactive: #a6adc8;
    --text_inverse: #FFFFFF;
    --border_color: #313244;
    --input_bg: #313244;
    --input_bg_hover: #45475a;
    --input_bg_focus: #383652;
    --list_item_bg_hover: #3a3955;
    --input_border: #484A64;
    --input_border_hover: #585b70;
    --button_bg: #181825;
    --button_bg_hover: #313244;
    --button_bg_disabled: #1e1e2e;
    --bg_dock: #181825;
    --bg_hover: #313244;
    --ico: var(--text);
    --ico_selected: #1e1e2e;

    
    --accent_bg_start: 'rgba(243, 139, 168, 0.3)';
    --accent_bg_end: 'rgba(243, 139, 168, 0.1)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #cdd6f4;
    --on_panel_muted: #7f849c;
    --on_base_muted: #81859d;
    --on_preview_muted: #7f849c;
    --on_preview: #f5f5f5;
    --on_list_hover: #f5f5f5;
    --on_hover: #f5f5f5;
    --on_panel_disabled: #a6adc8;
    --on_base_disabled: #a6adc8;
    --on_panel_outline: #636471;
    --on_section_heading: #f38ba8;
    --on_panel_accent: #f38ba8;
    --on_button: #cdd6f4;
    --on_button_disabled: #a6adc8;
    --on_input: #cdd6f4;
    --on_input_hover: #cdd6f4;
    --on_input_focus: #cdd6f4;
    --on_nav_hover: #f5f5f5;
    --on_mixer_muted: #f38ba8;
    --on_mixer_warning: #fab387;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-f38ba8.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-fab387.svg)';
    /* colorway:state-tokens:end */

}
