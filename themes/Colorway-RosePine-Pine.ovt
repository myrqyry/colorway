@OBSThemeMeta {
    name: 'Rosé Pine — Pine';
    id: 'com.myrqyry.Colorway.RosePine.Pine';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Rosé Pine — Pine
       Hex colors:
       --bg_window: #191724;
       --bg_base: #191724;
       --bg_preview: #26233a;
       --bg_dock: #1f1d2e;
       --bg_hover: #26233a;
       --text: #e0def4;
       --text_light: #e0def4;
       --text_muted: #908caa;
       --text_inactive: #6e6a86;
       --text_inverse: #FFFFFF;
       --text_disabled: #6e6a86;
       --primary: #31748f;
       --primary_light: #9ccfd8;
       --primary_lighter: #e0def4;
       --primary_dark: #ebbcba;
       --primary_darker: #524f67;
       --input_bg: #26233a;
       --input_bg_hover: #403d52;
       --input_bg_focus: #332f4a;
       --input_border: #403d52;
       --input_border_hover: #524f67;
       --button_bg: #1f1d2e;
       --button_bg_hover: #26233a;
       --button_bg_disabled: #191724;
       --list_item_bg_hover: #332f4a;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #403d52;
       --ico: #e0def4;
       --ico_selected: #c6d0f5;
       --warning: #f6c177;
       --danger: #eb6f92;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(49, 116, 143, 0.3);
       --accent_bg_end: rgba(49, 116, 143, 0.1);
    */

    --bg_window: #191724;
    --bg_base: #191724;
    --bg_preview: #26233a;
    --primary: #31748f;
    --primary_light: #9ccfd8;
    --primary_lighter: #e0def4;
    --primary_dark: #ebbcba;
    --primary_darker: #524f67;
    --warning: #f6c177;
    --danger: #eb6f92;
    --text: #e0def4;
    --text_light: #e0def4;
    --text_muted: #908caa;
    --text_disabled: #6e6a86;
    --text_inactive: #6e6a86;
    --border_color: #403d52;
    --input_bg: #26233a;
    --input_bg_hover: #403d52;
    --input_bg_focus: #332f4a;
    --list_item_bg_hover: #332f4a;
    --input_border: #403d52;
    --input_border_hover: #524f67;
    --button_bg: #1f1d2e;
    --button_bg_hover: #26233a;
    --button_bg_disabled: #191724;
    --bg_dock: #1f1d2e;
    --bg_hover: #26233a;
    --ico: var(--text);
    --ico_selected: #c6d0f5;
    --text_inverse: #FFFFFF;

    
    --accent_bg_start: 'rgba(49, 116, 143, 0.3)';
    --accent_bg_end: 'rgba(49, 116, 143, 0.1)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_preview: #e0def4;
    --on_list_hover: #e0def4;
    --on_hover: #e0def4;
    --on_section_heading: #4f889f;
    --on_panel_accent: #568da3;
    --on_nav_hover: #e0def4;
    --cw_icon_arrow_down_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-down.svg)';
    --cw_icon_arrow_up_primary: 'url(theme:icons/colorway/mingcute/normal/arrow-up.svg)';
    --cw_icon_audio_primary: 'url(theme:icons/colorway/mingcute/normal/audio.svg)';
