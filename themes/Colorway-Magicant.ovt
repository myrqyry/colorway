@OBSThemeMeta {
    name: 'EarthBound — Magicant';
    id: 'com.myrqyry.Colorway.Magicant';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference (source values; live accessibility overrides below may differ): Magicant
       Hex colors:
       --bg_window: #F9F8B9;
       --bg_base: #F9F8B9;
       --bg_preview: #f0f0a0;
       --bg_dock: #fffde0;
       --bg_hover: #fff8c0;
       --text: #220088;
       --text_light: #1a0060;
       --text_muted: #90694c;
       --text_inactive: #c0b890;
       --text_inverse: #000000;
       --text_disabled: #c0b890;
       --primary: #9D02F2;
       --primary_light: #7100b1;
       --primary_lighter: #9b30d0;
       --primary_dark: #604633;
       --primary_darker: #3d2a20;
       --input_bg: #fffde0;
       --input_bg_hover: #fff8c0;
       --input_bg_focus: #fff8c0;
       --input_border: #e0d890;
       --input_border_hover: #9D02F2;
       --button_bg: #6D01A9;
       --button_bg_hover: #b040ff;
       --button_bg_disabled: #F9F8B9;
       --list_item_bg_hover: #fff8c0;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #e0d890;
       --ico: #220088;
       --ico_selected: #F9F8B9;
       --warning: #f6d56a;
       --danger: #87000d;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(157, 2, 242, 0.3);
       --accent_bg_end: rgba(157, 2, 242, 0.1);
    */

    --accent_bg_start: 'rgba(157, 2, 242, 0.3)';
    --accent_bg_end: 'rgba(157, 2, 242, 0.1)';

    --bg_window: #F9F8B9;
    --bg_base: #F9F8B9;
    --bg_preview: #f0f0a0;

    --primary: #9D02F2;
    --primary_light: #7100b1;
    --primary_lighter: #9b30d0;
    --primary_dark: #604633;
    --primary_darker: #3d2a20;

    --warning: #876908;
    --danger: #87000d;
    --success: #3f6b2a;
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/selected/check.svg)';

    --text: #220088;
    --text_light: #1a0060;
    --text_muted: #90694c;

    --text_disabled: #c0b890;
    --text_inactive: #c0b890;

    --border_color: #e0d890;

    --input_bg: #fffde0;
    --input_bg_hover: #fff8c0;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #fff8c0;

    --input_border: #e0d890;
    --input_border_hover: #9D02F2;

    --button_bg: #6D01A9;
    --button_bg_hover: #b040ff;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #F9F8B9;

    
    --text_inverse: #000000;

    --bg_dock: #fffde0;
    --bg_hover: #fff8c0;

    
    --ico: var(--text);
    --ico_selected: #F9F8B9;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_primary: var(--bg_base);
