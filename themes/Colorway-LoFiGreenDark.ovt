@OBSThemeMeta {
    name: 'Lo-Fi Green Dark';
    id: 'com.myrqyry.Colorway.LoFiGreenDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Lo-Fi Green Dark
       Hex colors:
       --bg_window: #0d0f0c;
       --bg_base: #0d0f0c;
       --bg_preview: #060806;
       --bg_dock: #121512;
       --bg_hover: #1e261e;
       --text: #f5f2c4;
       --text_light: #ffffff;
       --text_muted: #4a8a4a;
       --text_inactive: #222a22;
       --text_inverse: #FFFFFF;
       --text_disabled: #222a22;
       --primary: #66b366;
       --primary_light: #a7ffc1;
       --primary_lighter: #d0ffd8;
       --primary_dark: #3c553c;
       --primary_darker: #2a3a2a;
       --input_bg: #162016;
       --input_bg_hover: #1e261e;
       --input_bg_focus: #1e261e;
       --input_border: #222a22;
       --input_border_hover: #4a8a4a;
       --button_bg: #162016;
       --button_bg_hover: #1e261e;
       --button_bg_disabled: #0d0f0c;
       --list_item_bg_hover: #1e261e;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #222a22;
       --ico: #f5f2c4;
       --ico_selected: #0d0f0c;
       --warning: #ffda55;
       --danger: #f38357;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(102, 179, 102, 0.3);
       --accent_bg_end: rgba(102, 179, 102, 0.1);
    */

    --accent_bg_start: 'rgba(102, 179, 102, 0.3)';
    --accent_bg_end: 'rgba(102, 179, 102, 0.1)';

    --bg_window: #0d0f0c;
    --bg_base: #0d0f0c;
    --bg_preview: #060806;

    --primary: #66b366;
    --primary_light: #a7ffc1;
    --primary_lighter: #d0ffd8;
    --primary_dark: #3c553c;
    --primary_darker: #2a3a2a;

    --warning: #ffda55;
    --danger: #f38357;

    --text: #f5f2c4;
    --text_light: #ffffff;
    --text_muted: #4a8a4a;

    --text_disabled: #222a22;
    --text_inactive: #222a22;
    --text_inverse: #FFFFFF;

    --border_color: #222a22;

    --input_bg: #162016;
    --input_bg_hover: #1e261e;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #1e261e;

    --input_border: #222a22;
    --input_border_hover: #4a8a4a;

    --button_bg: #162016;
    --button_bg_hover: #1e261e;
    --button_bg_disabled: #0d0f0c;

    --bg_dock: #121512;
    --bg_hover: #1e261e;

    
    --ico: var(--text);
    --ico_selected: #0d0f0c;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #f5f2c4;
    --on_panel_muted: #4c8c4c;
    --on_base_muted: #4a8a4a;
    --on_preview_muted: #4a8a4a;
    --on_panel_disabled: #5e645e;
    --on_base_disabled: #5b615b;
    --on_panel_outline: #5e645e;
    --on_section_heading: #66b366;
    --on_panel_accent: #66b366;
    --on_button: #f5f2c4;
    --on_button_disabled: #5b615b;
    --on_input: #f5f2c4;
    --on_input_hover: #f5f2c4;
    --on_input_focus: #f5f2c4;
    --on_mixer_muted: #f38357;
    --on_mixer_warning: #ffda55;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-f38357.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ffda55.svg)';
    /* colorway:state-tokens:end */

}
