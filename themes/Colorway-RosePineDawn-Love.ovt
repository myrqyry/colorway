@OBSThemeMeta {
    name: 'Rose Pine Dawn — Love';
    id: 'com.myrqyry.Colorway.RosePineDawn.Love';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference (source values; live accessibility overrides below may differ): Rose Pine Dawn — Love
       Hex colors:
       --bg_window: #faf4ed;
       --bg_base: #faf4ed;
       --bg_preview: #fffaf3;
       --bg_dock: #f2e9e1;
       --bg_hover: #f4ede8;
       --text: #575279;
       --text_light: #ffffff;
       --text_muted: #9893a5;
       --text_inactive: #9893a5;
       --text_inverse: #575279;
       --text_disabled: #9893a5;
       --primary: #b4637a;
       --primary_light: #ea9d34;
       --primary_lighter: #56949f;
       --primary_dark: #907aa9;
       --primary_darker: #d7827e;
       --input_bg: #fffaf3;
       --input_bg_hover: #f4ede8;
       --input_bg_focus: #f2e9e1;
       --input_border: #cecacd;
       --input_border_hover: #dfdad9;
       --button_bg: #f2e9e1;
       --button_bg_hover: #f4ede8;
       --button_bg_disabled: #faf4ed;
       --list_item_bg_hover: #f4ede8;
       --list_item_bg_selected: #faf4ed;
       --border_color: #dfdad9;
       --ico: #575279;
       --ico_selected: #faf4ed;
       --warning: #ea9d34;
       --danger: #b4637a;
       --success: #37d247;
       --meter_bg_nom: #fffaf3;
       --meter_bg_war: #ea9d34;
       --meter_bg_err: #b4637a;
       --meter_fg_nom: #b4637a;
       --meter_fg_war: #ea9d34;
       --meter_fg_err: #b4637a;
       Derived colors:
       --accent_bg_start: rgba(180, 99, 122, 0.3);
       --accent_bg_end: rgba(180, 99, 122, 0.1);
    */

    --bg_window: #faf4ed;
    --bg_base: #faf4ed;
    --bg_preview: #fffaf3;
    --bg_dock: #f2e9e1;
    --bg_hover: #f4ede8;

    --text: #575279;
    --text_light: #ffffff;
    --text_muted: #9893a5;
    --text_inactive: #9893a5;
    --text_inverse: #575279;
    --text_disabled: #9893a5;

    --border_color: #dfdad9;

    --input_bg: #fffaf3;
    --input_bg_hover: #f4ede8;
    --input_bg_focus: #f2e9e1;
    --input_border: #cecacd;
    --input_border_hover: #dfdad9;

    --button_bg: #f2e9e1;
    --button_bg_hover: #f4ede8;
    --button_bg_disabled: #faf4ed;

    --list_item_bg_hover: #f4ede8;
    --list_item_bg_selected: #faf4ed;

    --warning: #955c0f;
    --danger: #b4637a;
    --success: #286983;
    --checkbox_check_icon: url(theme:icons/colorway/mingcute/selected/check.svg);

    --meter_bg_nom: #fffaf3;
    --meter_bg_war: #ea9d34;
    --meter_bg_err: #b4637a;
    --meter_fg_nom: #b4637a;
    --meter_fg_war: #ea9d34;
    --meter_fg_err: #b4637a;

    
    --accent_bg_start: rgba(180, 99, 122, 0.3);
    --accent_bg_end: rgba(180, 99, 122, 0.1);

    --primary: #b4637a;
    --primary_light: #ea9d34;
    --primary_lighter: #56949f;
    --primary_dark: #907aa9;
    --primary_darker: #d7827e;

    
    --ico: #575279;
    --ico_selected: #faf4ed;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_primary: #000000;
    --on_primary_hover: #000000;
    --on_primary_dark: #000000;
    --cw_icon_arrow_down_base: url(theme:icons/colorway/mingcute/selected/arrow-down.svg);
    --cw_icon_arrow_up_base: url(theme:icons/colorway/mingcute/selected/arrow-up.svg);
    --cw_icon_audio_base: url(theme:icons/colorway/mingcute/selected/audio.svg);
