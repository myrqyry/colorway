@OBSThemeMeta {
    name: 'Catppuccin Sibling — Terracotta';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Terracotta';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: baked clay / earthen red-brown.
 */
@OBSThemeVars {
    /* Official palette reference: Catppuccin Sibling — Terracotta
       Hex colors:
       --bg_window: #251512;
       --bg_base: #2e1a16;
       --bg_preview: #1b0f0c;
       --bg_dock: #251512;
       --bg_hover: #402f2c;
       --text: #ecd0ca;
       --text_light: #f3e1db;
       --text_muted: #96807b;
       --text_inactive: #c1a8a2;
       --text_inverse: #1b0f0c;
       --text_disabled: #c1a8a2;
       --primary: #d7a4e3;
       --primary_light: #bebcf4;
       --primary_lighter: #f6c4da;
       --primary_dark: #7ebaec;
       --primary_darker: #6b5854;
       --input_bg: #402f2c;
       --input_bg_hover: #554441;
       --input_bg_focus: #554441;
       --input_border: #554441;
       --input_border_hover: #d7a4e3;
       --button_bg: #251512;
       --button_bg_hover: #402f2c;
       --button_bg_disabled: #2e1a16;
       --list_item_bg_hover: #402f2c;
       --list_item_bg_selected: #d7a4e3;
       --border_color: #402f2c;
       --ico: #ecd0ca;
       --ico_selected: #1b0f0c;
       --warning: #fedfb9;
       --danger: #ee9292;
       --success: #c2dc98;
       --meter_bg_nom: #402f2c;
       --meter_bg_war: #402f2c;
       --meter_bg_err: #402f2c;
       --meter_fg_nom: #c2dc98;
       --meter_fg_war: #fedfb9;
       --meter_fg_err: #ee9292;
       Derived colors:
       --accent_bg_start: rgba(215, 164, 227, 0.3);
       --accent_bg_end: rgba(215, 164, 227, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling_text: #ecd0ca;
    --sibling_subtext1: #d7bcb7;
    --sibling_subtext0: #c1a8a2;
    --sibling_overlay2: #ab9590;
    --sibling_overlay1: #96807b;
    --sibling_overlay0: #806c68;
    --sibling_surface2: #6b5854;
    --sibling_surface1: #554441;
    --sibling_surface0: #402f2c;
    --sibling_base: #2e1a16;
    --sibling_mantle: #251512;
    --sibling_crust: #1b0f0c;

    --sibling_rosewater: #f3e1db;
    --sibling_flamingo: #efcfce;
    --sibling_pink: #f6c4da;
    --sibling_mauve: #d7a4e3;
    --sibling_red: #ee9292;
    --sibling_maroon: #e5a4a9;
    --sibling_peach: #f6b498;
    --sibling_yellow: #fedfb9;
    --sibling_green: #c2dc98;
    --sibling_teal: #a4dfca;
    --sibling_sky: #94dcde;
    --sibling_sapphire: #7dc7e1;
    --sibling_blue: #7ebaec;
    --sibling_lavender: #bebcf4;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling_mantle);
    --bg_base: var(--sibling_base);
    --bg_preview: var(--sibling_crust);
    --bg_dock: var(--sibling_mantle);
    --bg_hover: var(--sibling_surface0);
    --text: var(--sibling_text);
    --text_light: var(--sibling_rosewater);
    --text_muted: var(--sibling_overlay1);
    --text_inactive: var(--sibling_subtext0);
    --text_inverse: var(--sibling_crust);
    --text_disabled: var(--sibling_subtext0);
    --primary: var(--sibling_mauve);
    --primary_light: var(--sibling_lavender);
    --primary_lighter: var(--sibling_pink);
    --primary_dark: var(--sibling_blue);
    --primary_darker: var(--sibling_surface2);
    --input_bg: var(--sibling_surface0);
    --input_bg_hover: var(--sibling_surface1);
    --input_bg_focus: var(--sibling_surface1);
    --input_border: var(--sibling_surface1);
    --input_border_hover: var(--sibling_mauve);
    --button_bg: var(--sibling_mantle);
    --button_bg_hover: var(--sibling_surface0);
    --button_hover_text: var(--sibling_text);
    --button_bg_disabled: var(--sibling_base);
    --list_item_bg_hover: var(--sibling_surface0);
    --list_item_bg_selected: var(--sibling_mauve);
    --border_color: var(--sibling_surface0);
    --warning: var(--sibling_yellow);
    --danger: var(--sibling_red);
    --success: var(--sibling_green);
    --meter_bg_nom: var(--sibling_surface0);
    --meter_bg_war: var(--sibling_surface0);
    --meter_bg_err: var(--sibling_surface0);
    --meter_fg_nom: var(--sibling_green);
    --meter_fg_war: var(--sibling_yellow);
    --meter_fg_err: var(--sibling_red);
    --ico: var(--text);
    --ico_selected: var(--sibling_crust);
    --accent_bg_start: rgba(215, 164, 227, 0.3);
    --accent_bg_end: rgba(215, 164, 227, 0.1);

}
