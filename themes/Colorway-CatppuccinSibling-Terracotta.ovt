@OBSThemeMeta {
    name: 'Catppuccin Sibling — Terracotta';
    id: 'com.myrqyry.Colorway.CatppuccinSibling.Terracotta';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

/*
 * Colorway-original Catppuccin-inspired sibling palette.
 * Not an official Catppuccin flavor.
 * Family: baked clay / earthen red-brown.
 */
@OBSThemeVars {
    /* Official palette reference (Colorway-generated sibling; not an official Catppuccin flavor): Catppuccin Sibling — Terracotta
       Hex colors:
       --bg_window: #251512;
       --bg_base: #2e1a16;
       --bg_preview: #1b0f0c;
       --bg_dock: #251512;
       --bg_hover: #402f2c;
       --text: #ecd0ca;
       --text_light: #f3e1db;
       --text_muted: #96807b;
       --text_inactive: #c1a8a2;
       --text_inverse: #1b0f0c;
       --text_disabled: #c1a8a2;
       --primary: #d7a4e3;
       --primary_light: #bebcf4;
       --primary_lighter: #f6c4da;
       --primary_dark: #7ebaec;
       --primary_darker: #6b5854;
       --input_bg: #402f2c;
       --input_bg_hover: #554441;
       --input_bg_focus: #554441;
       --input_border: #554441;
       --input_border_hover: #d7a4e3;
       --button_bg: #251512;
       --button_bg_hover: #402f2c;
       --button_hover_text: #ecd0ca;
       --button_bg_disabled: #2e1a16;
       --list_item_bg_hover: #402f2c;
       --list_item_bg_selected: #d7a4e3;
       --border_color: #402f2c;
       --warning: #fedfb9;
       --danger: #ee9292;
       --success: #c2dc98;
       --meter_bg_nom: #402f2c;
       --meter_bg_war: #402f2c;
       --meter_bg_err: #402f2c;
       --meter_fg_nom: #c2dc98;
       --meter_fg_war: #fedfb9;
       --meter_fg_err: #ee9292;
       --ico: #ecd0ca;
       --ico_selected: #1b0f0c;
       Derived colors:
       --accent_bg_start: rgba(215, 164, 227, 0.3);
       --accent_bg_end: rgba(215, 164, 227, 0.1);
    */

    /* Full V2 sibling palette seed. */
    --sibling-text: #ecd0ca;
    --sibling-subtext1: #d7bcb7;
    --sibling-subtext0: #c1a8a2;
    --sibling-overlay2: #ab9590;
    --sibling-overlay1: #96807b;
    --sibling-overlay0: #806c68;
    --sibling-surface2: #6b5854;
    --sibling-surface1: #554441;
    --sibling-surface0: #402f2c;
    --sibling-base: #2e1a16;
    --sibling-mantle: #251512;
    --sibling-crust: #1b0f0c;

    --sibling-rosewater: #f3e1db;
    --sibling-flamingo: #efcfce;
    --sibling-pink: #f6c4da;
    --sibling-mauve: #d7a4e3;
    --sibling-red: #ee9292;
    --sibling-maroon: #e5a4a9;
    --sibling-peach: #f6b498;
    --sibling-yellow: #fedfb9;
    --sibling-green: #c2dc98;
    --sibling-teal: #a4dfca;
    --sibling-sky: #94dcde;
    --sibling-sapphire: #7dc7e1;
    --sibling-blue: #7ebaec;
    --sibling-lavender: #bebcf4;

    /* Colorway semantic roles. */
    --bg_window: var(--sibling-mantle);
    --bg_base: var(--sibling-base);
    --bg_preview: var(--sibling-crust);
    --bg_dock: var(--sibling-mantle);
    --bg_hover: var(--sibling-surface0);
    --text: var(--sibling-text);
    --text_light: var(--sibling-rosewater);
    --text_muted: var(--sibling-overlay1);
    --text_inactive: var(--sibling-subtext0);
    --text_inverse: var(--sibling-crust);
    --text_disabled: var(--sibling-subtext0);
    --primary: var(--sibling-mauve);
    --primary_light: var(--sibling-lavender);
    --primary_lighter: var(--sibling-pink);
    --primary_dark: var(--sibling-blue);
    --primary_darker: var(--sibling-surface2);
    --input_bg: var(--sibling-surface0);
    --input_bg_hover: var(--sibling-surface1);
    --input_bg_focus: var(--sibling-surface1);
    --input_border: var(--sibling-surface1);
    --input_border_hover: var(--sibling-mauve);
    --button_bg: var(--sibling-mantle);
    --button_bg_hover: var(--sibling-surface0);
    --button_hover_text: var(--sibling-text);
    --button_bg_disabled: var(--sibling-base);
    --list_item_bg_hover: var(--sibling-surface0);
    --list_item_bg_selected: var(--sibling-mauve);
    --border_color: var(--sibling-surface0);
    --warning: var(--sibling-yellow);
    --danger: var(--sibling-red);
    --success: var(--sibling-green);
    --meter_bg_nom: var(--sibling-surface0);
    --meter_bg_war: var(--sibling-surface0);
    --meter_bg_err: var(--sibling-surface0);
    --meter_fg_nom: var(--sibling-green);
    --meter_fg_war: var(--sibling-yellow);
    --meter_fg_err: var(--sibling-red);
    --ico: var(--text);
    --ico_selected: var(--sibling-crust);
    --accent_bg_start: rgba(215, 164, 227, 0.3);
    --accent_bg_end: rgba(215, 164, 227, 0.1);
}
