    --cw_icon_trash_primary_hover: 'url(theme:icons/colorway/mingcute/normal/trash.svg)';
    --cw_icon_unlock_primary_hover: 'url(theme:icons/colorway/mingcute/normal/unlock.svg)';
    --cw_icon_video_primary_hover: 'url(theme:icons/colorway/mingcute/normal/video.svg)';
