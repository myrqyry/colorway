    --cw_icon_pin_primary_hover: 'url(theme:icons/colorway/mingcute/normal/pin.svg)';
    --cw_icon_plus_primary_hover: 'url(theme:icons/colorway/mingcute/normal/plus.svg)';
    --cw_icon_popout_primary_hover: 'url(theme:icons/colorway/mingcute/normal/popout.svg)';
    --cw_icon_refresh_primary_hover: 'url(theme:icons/colorway/mingcute/normal/refresh.svg)';
