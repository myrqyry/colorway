    --cw_icon_image_primary_hover: 'url(theme:icons/colorway/mingcute/normal/image.svg)';
    --cw_icon_interact_primary_hover: 'url(theme:icons/colorway/mingcute/normal/interact.svg)';
    --cw_icon_layout_horizontal_primary_hover: 'url(theme:icons/colorway/mingcute/normal/layout-horizontal.svg)';
    --cw_icon_layout_vertical_primary_hover: 'url(theme:icons/colorway/mingcute/normal/layout-vertical.svg)';
    --cw_icon_lock_primary_hover: 'url(theme:icons/colorway/mingcute/normal/lock.svg)';
    --cw_icon_media_play_primary_hover: 'url(theme:icons/colorway/mingcute/normal/media-play.svg)';
    --cw_icon_media_stop_primary_hover: 'url(theme:icons/colorway/mingcute/normal/media-stop.svg)';
    --cw_icon_microphone_primary_hover: 'url(theme:icons/colorway/mingcute/normal/microphone.svg)';
    --cw_icon_minus_primary_hover: 'url(theme:icons/colorway/mingcute/normal/minus.svg)';
    --cw_icon_output_primary_hover: 'url(theme:icons/colorway/mingcute/normal/output.svg)';
