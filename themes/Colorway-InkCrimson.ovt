    --cw_icon_slideshow_primary_hover: 'url(theme:icons/colorway/mingcute/normal/slideshow.svg)';
    --cw_icon_skip_forward_primary_hover: 'url(theme:icons/colorway/mingcute/normal/skip_forward.svg)';
    --cw_icon_skip_previous_primary_hover: 'url(theme:icons/colorway/mingcute/normal/skip_previous.svg)';
