    --cw_icon_volume_mute_primary_hover: 'url(theme:icons/colorway/mingcute/normal/volume-mute.svg)';
    --cw_icon_window_primary_hover: 'url(theme:icons/colorway/mingcute/normal/window.svg)';
    --cw_icon_download_primary_hover: 'url(theme:icons/colorway/mingcute/normal/download.svg)';
