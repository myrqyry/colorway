    --cw_icon_dots_vert_primary_hover: 'url(theme:icons/colorway/mingcute/normal/dots-vert.svg)';
    --cw_icon_eye_off_primary_hover: 'url(theme:icons/colorway/mingcute/normal/eye-off.svg)';
