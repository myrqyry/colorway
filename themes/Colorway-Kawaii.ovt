@OBSThemeMeta {
    name: 'Kawaii';
    id: 'com.myrqyry.Colorway.Kawaii';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Kawaii
       Hex colors:
       --bg_window: #353042;
       --bg_base: #353042;
       --bg_preview: #2C2638;
       --bg_dock: #2C2638;
       --bg_hover: #353042;
       --text: #FFF0F5;
       --text_light: #FFF0F5;
       --text_muted: #998996;
       --text_inactive: #9498a1;
       --text_inverse: #000000;
       --text_disabled: #9498a1;
       --primary: #ff5c8d;
       --primary_light: #FFE175;
       --primary_lighter: #FFF0F5;
       --primary_dark: #ea7599;
       --primary_darker: #2C2638;
       --input_bg: #2C2638;
       --input_bg_hover: #353042;
       --input_bg_focus: #353042;
       --input_border: #9498a1;
       --input_border_hover: #FFE175;
       --button_bg: #B24062;
       --button_bg_hover: #ff8cb4;
       --button_bg_disabled: #353042;
       --list_item_bg_hover: #ff5c8d;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #9498a1;
       --ico: #FFF0F5;
       --ico_selected: #353042;
       --warning: #FFE175;
       --danger: #ff62a5;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(255, 92, 141, 0.3);
       --accent_bg_end: rgba(255, 92, 141, 0.1);
    */

    --accent_bg_start: 'rgba(255, 92, 141, 0.3)';
    --accent_bg_end: 'rgba(255, 92, 141, 0.1)';

    --bg_window: #353042;
    --bg_base: #353042;
    --bg_preview: #2C2638;

    --primary: #ff5c8d;
    --primary_light: #FFE175;
    --primary_lighter: #FFF0F5;
    --primary_dark: #ea7599;
    --primary_darker: #2C2638;

    --warning: #FFE175;
    --danger: #ff62a5;

    --text: #FFF0F5;
    --text_light: #FFF0F5;
    --text_muted: #998996;

    --text_disabled: #9498a1;
    --text_inactive: #9498a1;
    --text_inverse: #000000;

    --border_color: #9498a1;

    --input_bg: #2C2638;
    --input_bg_hover: #353042;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #ff5c8d;

    --input_border: #9498a1;
    --input_border_hover: #FFE175;

    --button_bg: #B24062;
    --button_bg_hover: #ff8cb4;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #353042;

    --bg_dock: #2C2638;
    --bg_hover: #353042;

    
    --ico: var(--text);
    --ico_selected: #353042;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #FFF0F5;
    --on_panel_muted: #9a8b97;
    --on_base_muted: #a496a1;
    --on_preview_muted: #9a8b97;
    --on_preview: #FFF0F5;
    --on_list_hover: #322f30;
    --on_hover: #FFF0F5;
    --on_panel_disabled: #9498a1;
    --on_base_disabled: #9498a1;
    --on_panel_outline: #9498a1;
    --on_section_heading: #ff6392;
    --on_panel_accent: #ff5c8d;
    --on_button: #FFF0F5;
    --on_button_disabled: #9498a1;
    --on_input: #FFF0F5;
    --on_input_hover: #FFF0F5;
    --on_input_focus: #FFF0F5;
    --on_nav_hover: #FFF0F5;
    --on_mixer_muted: #ff62a5;
    --on_mixer_warning: #FFE175;
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-ff62a5.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-ffe175.svg)';
    /* colorway:state-tokens:end */

}
