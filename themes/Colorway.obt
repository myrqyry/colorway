@OBSThemeMeta {
    name: 'Colorway';
    id: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {

    /* OBS Color Palette */
    --blue1: #718CDC;
    --blue2: #476BD7;
    --blue3: #284CB8;
    --blue4: #213E97;
    --blue5: #1A3278;
    --blue6: #162A64;

    --red1: #E85E75;
    --red2: #E33B57;
    --red3: #C01C37;
    --red4: #A1172E;
    --red5: #7D1224;
    --red6: #590D1A;

    --pink1: #E5619A;
    --pink2: #E03E84;
    --pink3: #C11F65;
    --pink4: #9E1A53;
    --pink5: #7B1441;
    --pink6: #580E2E;

    --teal1: #3DBEF5;
    --teal2: #16B1F3;
    --teal3: #0981B4;
    --teal4: #086F9B;
    --teal5: #065374;
    --teal6: #04374E;

    --purple1: #997FDC;
    --purple2: #805FD3;
    --purple3: #5B34BF;
    --purple4: #4D2CA0;
    --purple5: #3D2380;
    --purple6: #2E1A60;

    --green1: #59D966;
    --green2: #37D247;
    --green3: #25A231;
    --green4: #1E8528;
    --green5: #17641E;
    --green6: #0F4313;

    --yellow1: #EABC48;
    --yellow2: #E5AF24;
    --yellow3: #B88A16;
    --yellow4: #926E11;
    --yellow5: #6E520D;
    --yellow6: #493709;

    --grey1: #5B6273;
    --grey2: #4E5566;
    --grey3: #464B59;
    --grey4: #3C404D;
    --grey5: #323540;
    --grey6: #272A33;
    --grey7: #1D1F26;
    --grey8: #13141A;

    --white1: #FFFFFF;
    --white2: #E1E1E1;
    --white3: #D2D2D2;
    --white4: #B4B4B4;
    --white5: #969696;

    --black1: #0A0A0A;
    --black2: #1F1F1F;
    --black3: #414141;
    --black4: #646464;
    --black5: #828282;

    /* Base Theme Colors */
    --bg_window: #191724;
    --bg_base: #191724;
    --bg_preview: #26233a;

    --primary: #c4a7e7;
    --primary_light: #e0def4;
    --primary_lighter: #f0ebff;
    --primary_dark: #907aa9;
    --primary_darker: #524f67;

    --warning: #f6c177;
    --danger: #eb6f92;
    --success: #37d247;

    --text: #e0def4;
    --text_light: #ffffff;
    --text_muted: #908caa;

    --text_disabled: #6e6a86;
    --text_inactive: #6e6a86;

    --border_color: #403d52;

    /* Layout & Accessibility Scaling */
    --font_base_value: var(--obsFontScale);
    --padding_base_value: var(--obsPadding);
    --spacing_base_value: calc(2 + calc(var(--obsPadding) / 2));

    --highlight_width: 1px;
    --highlight_color: var(--primary_lighter);

    --border_highlight: transparent;

    /* OS Fixes */
    --os_mac_font_base_value: calc(1.2 * var(--obsFontScale));

    --font_base: calc(1pt * var(--font_base_value));
    --font_small: max(7pt, calc(0.8pt * var(--font_base_value)));
    --font_xsmall: max(6.75pt, calc(0.65pt * var(--font_base_value)));
    --font_large: calc(1.1pt * var(--font_base_value));
    --font_xlarge: calc(1.5pt * var(--font_base_value));

    --font_heading: calc(2.5pt * var(--font_base_value));

    --icon_base: calc(calc(max(2, var(--obsPadding)) * 1px) + 12px);
    --icon_small: calc(4px + var(--font_base_value));

    --spacing_base: min(max(1px, calc(0.4 * var(--spacing_base_value))), 2px);
    --spacing_large: min(max(2px, calc(1px * var(--spacing_base_value))), 4px);
    --spacing_small: max(1px, calc(0.25px * var(--spacing_base_value)));
    --spacing_title: 4px;

    --padding_base: calc(0.5px * var(--padding_base_value));
    --padding_large: min(max(1px, calc(1px * var(--padding_base_value))), 5px);
    --padding_xlarge: min(max(2px, calc(1.75px * var(--padding_base_value))), 10px);
    --padding_small: max(0px, calc(0.25px * var(--padding_base_value)));

    --padding_container: max(4px, var(--padding_base));
    --padding_wide: min(calc(12px + max(var(--padding_base_value), 4)), 24px);
    --padding_menu: calc(4px + calc(2 * var(--padding_base_value)));
    --padding_menubar: max(6px, calc(2px + calc(1.25 * var(--padding_base_value))));

    --padding_base_border: calc(var(--padding_base) + 1px);

    /* Precomputed widget geometry.
       OBS evaluates calc/min/max only while parsing @OBSThemeVars. */
    --button_min_height: calc(1.8pt * var(--font_base_value));
    --compact_control_min_height: calc(1.6pt * var(--font_base_value));
    --input_min_height: calc(2.0pt * var(--font_base_value));
    --spinbox_min_height: calc(2.6pt * var(--font_base_value));

    --spinbox_min_width: calc(var(--input_height) * 2.5);
    --spinbox_button_height: calc(var(--input_height_half) - 1px);

    --volume_slider: calc(calc(4px + var(--font_base_value)) / 4);
    --volume_slider_box: calc(var(--volume_slider) * 4);
    --volume_slider_label: calc(var(--volume_slider_box) * 2);

    --scrollbar_size: 10px;
    --scrollbar_handle_radius: calc(var(--scrollbar_size) / 2);
    --settings_scrollbar_size: calc(var(--scrollbar_size) + 9px);
    --scrollbar_handle: var(--border_color);

    --scrollbar_bg: var(--bg_base);
    --scrollbar_hover: var(--primary);
    --scrollbar_down: var(--primary_dark);

    --scrollbar_border: var(--border_color);

    /* Semantic Feedback Active States
       Keep these as aliases so every variant drives the actual OBS controls. */
    --live: var(--primary);
    --recording: var(--danger);
    --lavender_accent: var(--primary);

    /* Semantic Feedback Backgrounds
       Accent tints are variant-overridable; recording uses neutral theme surfaces
       so we do not bake one red palette into every Colorway variant. */
    --accent_bg_start: 'rgba(196, 167, 231, 0.3)';
    --accent_bg_end: 'rgba(196, 167, 231, 0.1)';
    --live_bg_start: var(--accent_bg_start);
    --live_bg_end: var(--accent_bg_end);
    --recording_bg_start: var(--bg_hover);
    --recording_bg_end: var(--bg_base);

    /* Indicator Tint Overlays */
    --tint_amber: 'rgba(251, 191, 36, 0.1)';
    --tint_green: 'rgba(74, 222, 128, 0.1)';
    --tint_red: 'rgba(244, 63, 94, 0.1)';

    /* Material Rounded Corners */
    --border_radius: 9px;
    --border_radius_small: 5px;
    --border_radius_large: 12px;

    /* Accessibility Sizing for Sliders (Enlarged and aligned to track height) */
    --slider_groove_thickness: 14px;
    --slider_groove_radius: 7px;
    --slider_handle_size: 14px;       /* Set equal to track thickness to stop vertical clipping */
    --slider_handle_radius: 7px;     /* Half of 14px for a perfect circle */
    --slider_handle_margin: 0px;      /* Set to 0px since no vertical centering offset is needed */
    --properties_slider_min_height: calc(var(--slider_handle_size) + calc(var(--slider_handle_radius) * 2));
    --group_title_margin: calc(2.2px * var(--font_base_value));

    /* Inputs & Layout Controls */
    --input_font_scale: calc(var(--font_base_value) * 2.2);
    --input_font_padding: calc(var(--padding_base_value) * 2);

    --input_height_base: max(calc(var(--input_font_scale) + var(--input_font_padding)), 24);
    --input_padding: calc(2px + var(--padding_base));
    --input_text_padding: max(calc(6px + var(--padding_base)), 8px);
    --input_height: calc(var(--input_height_base) - calc(var(--input_padding) * 2));
    --input_height_half: calc(var(--input_height_base) / 2);

    --input_bg: #26233a;
    --input_bg_hover: #403d52;
    --input_bg_focus: #2d2a42;

    --list_item_bg_selected: var(--primary);
    --list_item_bg_hover: #332f4a;

    --input_border: #403d52;
    --input_border_width: 1px;
    --input_border_hover: #524f67;
    --input_border_focus: var(--primary);

    --spacing_input: var(--spacing_base);

    --button_bg: #1f1d2e;
    --button_bg_hover: #26233a;
    --button_bg_down: var(--primary);
    --button_bg_disabled: #21202e;

    --button_border_width: var(--input_border_width);
    --button_border: var(--button_bg);
    --button_border_hover: var(--border_color);
    --button_border_focus: var(--primary);

    --tab_bg: var(--button_bg_disabled);
    --tab_bg_hover: var(--button_bg_hover);
    --tab_bg_down: var(--primary);
    --tab_bg_disabled: var(--button_bg_disabled);

    --tab_border: var(--border_color);
    --tab_border_hover: var(--button_border_hover);
    --tab_border_focus: var(--primary_lighter);
    --tab_border_selected: var(--primary);

    --tab_padding_base: calc(5px + var(--padding_base));
    --tab_padding_large: calc(9px + var(--padding_base));

    --preview_scale_width: calc(calc(var(--input_text_padding) * 3.5) * calc(var(--font_base_value) / 10));

    --separator_hover: var(--text_light);

    --action_row_base: calc(var(--input_height_base) * 0.75);
    --action_row_height: calc(var(--action_row_base) + calc(var(--action_row_padding) * 2px));
    --action_row_border: 3px;
    --action_row_input_width: calc(var(--action_row_base) * 4);
    --action_row_collapse: calc(var(--action_row_base) + var(--padding_large));
    --action_row_collapse_radius: calc(var(--action_row_collapse) / 2);
    --action_row_padding: calc(var(--padding_large) * 1.5);
    --action_row_padding_x: calc(var(--action_row_padding) * 2);
    --action_row_padding_nested: calc(var(--action_row_padding_x) * 1.5);

    --toggle_border: 1;
    --toggle_margin: 3;
    --toggle_width: calc(var(--action_row_base) * 1.8);
    --toggle_height: calc(var(--action_row_base) * 0.9);
    --toggle_handle: calc(calc(calc(var(--toggle_height) * 0.9) - calc(var(--toggle_border) * 2)) - var(--toggle_margin));
    --toggle_radius: calc(var(--toggle_height) / 2);

    /* Qt Palette variables can be set with the "palette_" prefix */
    --palette_window: var(--bg_window);
    --palette_windowText: var(--text);
    --palette_base: var(--bg_base);

    --palette_light: var(--input_bg_hover);
    --palette_mid: var(--bg_preview);
    --palette_dark: var(--bg_dock);

    --palette_highlight: var(--primary);
    --palette_highlightedText: var(--on_primary);

    --palette_text: var(--text);
    --palette_link: var(--primary_light);
    --palette_linkVisited: var(--primary);

    --palette_button: var(--button_bg);
    --palette_buttonText: var(--text);

    --palette_text_active: var(--text);
    --palette_text_disabled: var(--text_disabled);
    --palette_text_inactive: var(--text_inactive);

    /* Theme Aliases */
    --bg_dock: #1f1d2e;
    --bg_hover: #26233a;
    --bg_input: var(--input_bg);
    --border_base: var(--border_color);
    --border_focus: var(--primary);
    --text_base: var(--text);
    --text_bright: var(--text_light);
    --text_inverse: var(--bg_base);
    --button_hover_text: var(--text);
    --primary_hover: var(--primary_light);
    --primary_dark_alias: var(--primary_dark);

    --meter_bg_nom: var(--bg_hover);
    --meter_bg_war: var(--warning);
    --meter_bg_err: var(--danger);
    --meter_fg_nom: var(--primary);
    --meter_fg_war: var(--warning);
    --meter_fg_err: var(--danger);

    /* Icon Paths */

    --icon_add: var(--cw_icon_plus_base);
    --icon_remove: var(--cw_icon_minus_base);
    --icon_settings: var(--cw_icon_settings_base);
    --icon_refresh: var(--cw_icon_refresh_base);
    --icon_up: var(--cw_icon_arrow_up_base);
    --icon_down: var(--cw_icon_arrow_down_base);
    --icon_eye: var(--cw_icon_eye_base);
    --icon_eye_off: var(--cw_icon_eye_off_base);
    --icon_lock: var(--cw_icon_lock_base);
    --icon_unlock: var(--cw_icon_unlock_base);
    --icon_vol_high: var(--cw_icon_volume_high_base);
    --icon_vol_mute: var(--cw_icon_volume_mute_base);
    --icon_tree_closed: var(--cw_icon_chevron_right_base);
    --icon_tree_open: var(--cw_icon_chevron_down_base);
    --icon_dock_close: var(--cw_icon_close_base);
    --icon_dock_popout: var(--cw_icon_popout_base);
    --icon_check: var(--cw_icon_check_base);
    --checkbox_check_icon: var(--cw_icon_check_base);
    --pattern_eyes: 'url(theme:patterns/pattern.svg)';

    /* Elevation & Depth Simulation */
    --elevation_1: 'rgba(0, 0, 0, 0.15)';
    --elevation_2: 'rgba(0, 0, 0, 0.25)';

    /* Focus Glow */
    --focus_glow: 'rgba(196, 167, 231, 0.15)';

    /* M3 Expressive - Surface Tone Hierarchy (auto-adapts to variants) */
    --surface0: var(--bg_base);
    --surface1: var(--bg_dock);
    --surface2: var(--bg_preview);
    --surface3: var(--input_bg_focus);
    --surface4: var(--input_bg_hover);
    --surface_dim: var(--button_bg_disabled);

    /* M3 Expressive - Container Colors */
    --primary_container: var(--surface3);
    --on_primary_container: var(--text);
    --secondary_container: var(--surface2);
    --on_secondary_container: var(--text);

    /* M3 Expressive - Expanded Shape Scale */
    --shape_xs: 3px;
    --shape_sm: 5px;
    --shape_md: 9px;
    --shape_lg: 16px;
    --shape_xl: 24px;
    --shape_full: 999px;

    /* M3 Expressive - Typography Role Aliases */
    --font_label_size: var(--font_small);
    --font_label_weight: 500;
    --font_body_size: var(--font_base);
    --font_body_weight: 400;
    --font_title_size: var(--font_xlarge);
    --font_title_weight: 600;
    --font_headline_size: var(--font_heading);
    --font_headline_weight: 700;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #e0def4;
    --on_panel_muted: #908caa;
    --on_base_muted: #908caa;
    --on_preview_muted: #908caa;
    --on_preview: #ffffff;
    --on_list_hover: #ffffff;
    --on_hover: #ffffff;
    --on_panel_disabled: #6e6a86;
    --on_base_disabled: #6e6a86;
    --on_panel_outline: #6a6778;
    --on_section_heading: #c4a7e7;
    --on_panel_accent: #c4a7e7;
    --on_button: #e0def4;
    --on_button_disabled: #6e6a86;
    --on_input: #e0def4;
    --on_input_hover: #e0def4;
    --on_input_focus: #e0def4;
    --on_nav_hover: #ffffff;
    --on_primary: var(--text_inverse);
    --cw_icon_arrow_down_primary: 'url(theme:icons/colorway/mingcute/selected/arrow-down.svg)';
    --cw_icon_arrow_up_primary: 'url(theme:icons/colorway/mingcute/selected/arrow-up.svg)';
    --cw_icon_audio_primary: 'url(theme:icons/colorway/mingcute/selected/audio.svg)';
    --cw_icon_brush_primary: 'url(theme:icons/colorway/mingcute/selected/brush.svg)';
    --cw_icon_check_primary: 'url(theme:icons/colorway/mingcute/selected/check.svg)';
    --cw_icon_checkbox_fill_primary: 'url(theme:icons/colorway/mingcute/selected/checkbox_fill.svg)';
    --cw_icon_checkbox_line_primary: 'url(theme:icons/colorway/mingcute/selected/checkbox_line.svg)';
    --cw_icon_chevron_down_primary: 'url(theme:icons/colorway/mingcute/selected/chevron-down.svg)';
    --cw_icon_chevron_right_primary: 'url(theme:icons/colorway/mingcute/selected/chevron-right.svg)';
    --cw_icon_chevron_up_primary: 'url(theme:icons/colorway/mingcute/selected/chevron-up.svg)';
    --cw_icon_close_primary: 'url(theme:icons/colorway/mingcute/selected/close.svg)';
    --cw_icon_cogs_primary: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_default_primary: 'url(theme:icons/colorway/mingcute/selected/default.svg)';
    --cw_icon_display_primary: 'url(theme:icons/colorway/mingcute/selected/display.svg)';
    --cw_icon_dots_vert_primary: 'url(theme:icons/colorway/mingcute/selected/dots-vert.svg)';
    --cw_icon_eye_off_primary: 'url(theme:icons/colorway/mingcute/selected/eye-off.svg)';
    --cw_icon_eye_primary: 'url(theme:icons/colorway/mingcute/selected/eye.svg)';
    --cw_icon_filter_primary: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_icon_gamepad_primary: 'url(theme:icons/colorway/mingcute/selected/gamepad.svg)';
    --cw_icon_globe_primary: 'url(theme:icons/colorway/mingcute/selected/globe.svg)';
    --cw_icon_group_primary: 'url(theme:icons/colorway/mingcute/selected/group.svg)';
    --cw_icon_image_primary: 'url(theme:icons/colorway/mingcute/selected/image.svg)';
    --cw_icon_interact_primary: 'url(theme:icons/colorway/mingcute/selected/interact.svg)';
    --cw_icon_layout_horizontal_primary: 'url(theme:icons/colorway/mingcute/selected/layout-horizontal.svg)';
    --cw_icon_layout_vertical_primary: 'url(theme:icons/colorway/mingcute/selected/layout-vertical.svg)';
    --cw_icon_lock_primary: 'url(theme:icons/colorway/mingcute/selected/lock.svg)';
    --cw_icon_media_play_primary: 'url(theme:icons/colorway/mingcute/selected/media-play.svg)';
    --cw_icon_media_stop_primary: 'url(theme:icons/colorway/mingcute/selected/media-stop.svg)';
    --cw_icon_microphone_primary: 'url(theme:icons/colorway/mingcute/selected/microphone.svg)';
    --cw_icon_minus_primary: 'url(theme:icons/colorway/mingcute/selected/minus.svg)';
    --cw_icon_output_primary: 'url(theme:icons/colorway/mingcute/selected/output.svg)';
    --cw_icon_pause_primary: 'url(theme:icons/colorway/mingcute/selected/pause.svg)';
    --cw_icon_pin_primary: 'url(theme:icons/colorway/mingcute/selected/pin.svg)';
    --cw_icon_plus_primary: 'url(theme:icons/colorway/mingcute/selected/plus.svg)';
    --cw_icon_popout_primary: 'url(theme:icons/colorway/mingcute/selected/popout.svg)';
    --cw_icon_refresh_primary: 'url(theme:icons/colorway/mingcute/selected/refresh.svg)';
    --cw_icon_revert_primary: 'url(theme:icons/colorway/mingcute/selected/revert.svg)';
    --cw_icon_save_primary: 'url(theme:icons/colorway/mingcute/selected/save.svg)';
    --cw_icon_scene_primary: 'url(theme:icons/colorway/mingcute/selected/scene.svg)';
    --cw_icon_settings_primary: 'url(theme:icons/colorway/mingcute/selected/settings.svg)';
    --cw_icon_slideshow_primary: 'url(theme:icons/colorway/mingcute/selected/slideshow.svg)';
    --cw_icon_skip_forward_primary: 'url(theme:icons/colorway/mingcute/selected/skip_forward.svg)';
    --cw_icon_skip_previous_primary: 'url(theme:icons/colorway/mingcute/selected/skip_previous.svg)';
    --cw_icon_text_primary: 'url(theme:icons/colorway/mingcute/selected/text.svg)';
    --cw_icon_trash_primary: 'url(theme:icons/colorway/mingcute/selected/trash.svg)';
    --cw_icon_unlock_primary: 'url(theme:icons/colorway/mingcute/selected/unlock.svg)';
    --cw_icon_video_primary: 'url(theme:icons/colorway/mingcute/selected/video.svg)';
    --cw_icon_volume_high_primary: 'url(theme:icons/colorway/mingcute/selected/volume-high.svg)';
    --cw_icon_volume_mute_primary: 'url(theme:icons/colorway/mingcute/selected/volume-mute.svg)';
    --cw_icon_window_primary: 'url(theme:icons/colorway/mingcute/selected/window.svg)';
    --cw_icon_download_primary: 'url(theme:icons/colorway/mingcute/selected/download.svg)';
    --on_primary_hover: var(--text_inverse);
    --cw_icon_arrow_down_primary_hover: 'url(theme:icons/colorway/mingcute/selected/arrow-down.svg)';
    --cw_icon_arrow_up_primary_hover: 'url(theme:icons/colorway/mingcute/selected/arrow-up.svg)';
    --cw_icon_audio_primary_hover: 'url(theme:icons/colorway/mingcute/selected/audio.svg)';
    --cw_icon_brush_primary_hover: 'url(theme:icons/colorway/mingcute/selected/brush.svg)';
    --cw_icon_check_primary_hover: 'url(theme:icons/colorway/mingcute/selected/check.svg)';
    --cw_icon_checkbox_fill_primary_hover: 'url(theme:icons/colorway/mingcute/selected/checkbox_fill.svg)';
    --cw_icon_checkbox_line_primary_hover: 'url(theme:icons/colorway/mingcute/selected/checkbox_line.svg)';
    --cw_icon_chevron_down_primary_hover: 'url(theme:icons/colorway/mingcute/selected/chevron-down.svg)';
    --cw_icon_chevron_right_primary_hover: 'url(theme:icons/colorway/mingcute/selected/chevron-right.svg)';
    --cw_icon_chevron_up_primary_hover: 'url(theme:icons/colorway/mingcute/selected/chevron-up.svg)';
    --cw_icon_close_primary_hover: 'url(theme:icons/colorway/mingcute/selected/close.svg)';
    --cw_icon_cogs_primary_hover: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_default_primary_hover: 'url(theme:icons/colorway/mingcute/selected/default.svg)';
    --cw_icon_display_primary_hover: 'url(theme:icons/colorway/mingcute/selected/display.svg)';
    --cw_icon_dots_vert_primary_hover: 'url(theme:icons/colorway/mingcute/selected/dots-vert.svg)';
    --cw_icon_eye_off_primary_hover: 'url(theme:icons/colorway/mingcute/selected/eye-off.svg)';
    --cw_icon_eye_primary_hover: 'url(theme:icons/colorway/mingcute/selected/eye.svg)';
    --cw_icon_filter_primary_hover: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_icon_gamepad_primary_hover: 'url(theme:icons/colorway/mingcute/selected/gamepad.svg)';
