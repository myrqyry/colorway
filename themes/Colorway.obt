    --cw_icon_pin_primary_hover: 'url(theme:icons/colorway/mingcute/selected/pin.svg)';
    --cw_icon_plus_primary_hover: 'url(theme:icons/colorway/mingcute/selected/plus.svg)';
    --cw_icon_popout_primary_hover: 'url(theme:icons/colorway/mingcute/selected/popout.svg)';
    --cw_icon_refresh_primary_hover: 'url(theme:icons/colorway/mingcute/selected/refresh.svg)';
    --cw_icon_revert_primary_hover: 'url(theme:icons/colorway/mingcute/selected/revert.svg)';
    --cw_icon_save_primary_hover: 'url(theme:icons/colorway/mingcute/selected/save.svg)';
    --cw_icon_scene_primary_hover: 'url(theme:icons/colorway/mingcute/selected/scene.svg)';
    --cw_icon_settings_primary_hover: 'url(theme:icons/colorway/mingcute/selected/settings.svg)';
    --cw_icon_slideshow_primary_hover: 'url(theme:icons/colorway/mingcute/selected/slideshow.svg)';
    --cw_icon_skip_forward_primary_hover: 'url(theme:icons/colorway/mingcute/selected/skip_forward.svg)';
    --cw_icon_skip_previous_primary_hover: 'url(theme:icons/colorway/mingcute/selected/skip_previous.svg)';
    --cw_icon_text_primary_hover: 'url(theme:icons/colorway/mingcute/selected/text.svg)';
    --cw_icon_trash_primary_hover: 'url(theme:icons/colorway/mingcute/selected/trash.svg)';
    --cw_icon_unlock_primary_hover: 'url(theme:icons/colorway/mingcute/selected/unlock.svg)';
    --cw_icon_video_primary_hover: 'url(theme:icons/colorway/mingcute/selected/video.svg)';
    --cw_icon_volume_high_primary_hover: 'url(theme:icons/colorway/mingcute/selected/volume-high.svg)';
    --cw_icon_volume_mute_primary_hover: 'url(theme:icons/colorway/mingcute/selected/volume-mute.svg)';
    --cw_icon_window_primary_hover: 'url(theme:icons/colorway/mingcute/selected/window.svg)';
    --cw_icon_download_primary_hover: 'url(theme:icons/colorway/mingcute/selected/download.svg)';
    --on_primary_dark: var(--text_inverse);
    --on_base: var(--text);
    --cw_icon_arrow_down_base: 'url(theme:icons/colorway/mingcute/normal/arrow-down.svg)';
    --cw_icon_arrow_up_base: 'url(theme:icons/colorway/mingcute/normal/arrow-up.svg)';
    --cw_icon_audio_base: 'url(theme:icons/colorway/mingcute/normal/audio.svg)';
    --cw_icon_brush_base: 'url(theme:icons/colorway/mingcute/normal/brush.svg)';
    --cw_icon_check_base: 'url(theme:icons/colorway/mingcute/normal/check.svg)';
    --cw_icon_checkbox_fill_base: 'url(theme:icons/colorway/mingcute/normal/checkbox_fill.svg)';
    --cw_icon_checkbox_line_base: 'url(theme:icons/colorway/mingcute/normal/checkbox_line.svg)';
    --cw_icon_chevron_down_base: 'url(theme:icons/colorway/mingcute/normal/chevron-down.svg)';
    --cw_icon_chevron_right_base: 'url(theme:icons/colorway/mingcute/normal/chevron-right.svg)';
    --cw_icon_chevron_up_base: 'url(theme:icons/colorway/mingcute/normal/chevron-up.svg)';
    --cw_icon_close_base: 'url(theme:icons/colorway/mingcute/normal/close.svg)';
    --cw_icon_cogs_base: 'url(theme:icons/colorway/mingcute/normal/cogs.svg)';
    --cw_icon_default_base: 'url(theme:icons/colorway/mingcute/normal/default.svg)';
    --cw_icon_display_base: 'url(theme:icons/colorway/mingcute/normal/display.svg)';
    --cw_icon_dots_vert_base: 'url(theme:icons/colorway/mingcute/normal/dots-vert.svg)';
    --cw_icon_eye_off_base: 'url(theme:icons/colorway/mingcute/normal/eye-off.svg)';
    --cw_icon_eye_base: 'url(theme:icons/colorway/mingcute/normal/eye.svg)';
    --cw_icon_filter_base: 'url(theme:icons/colorway/mingcute/normal/filter.svg)';
    --cw_icon_gamepad_base: 'url(theme:icons/colorway/mingcute/normal/gamepad.svg)';
    --cw_icon_globe_base: 'url(theme:icons/colorway/mingcute/normal/globe.svg)';
    --cw_icon_group_base: 'url(theme:icons/colorway/mingcute/normal/group.svg)';
    --cw_icon_image_base: 'url(theme:icons/colorway/mingcute/normal/image.svg)';
    --cw_icon_interact_base: 'url(theme:icons/colorway/mingcute/normal/interact.svg)';
    --cw_icon_layout_horizontal_base: 'url(theme:icons/colorway/mingcute/normal/layout-horizontal.svg)';
    --cw_icon_layout_vertical_base: 'url(theme:icons/colorway/mingcute/normal/layout-vertical.svg)';
    --cw_icon_lock_base: 'url(theme:icons/colorway/mingcute/normal/lock.svg)';
    --cw_icon_media_play_base: 'url(theme:icons/colorway/mingcute/normal/media-play.svg)';
    --cw_icon_media_stop_base: 'url(theme:icons/colorway/mingcute/normal/media-stop.svg)';
    --cw_icon_microphone_base: 'url(theme:icons/colorway/mingcute/normal/microphone.svg)';
    --cw_icon_minus_base: 'url(theme:icons/colorway/mingcute/normal/minus.svg)';
    --cw_icon_output_base: 'url(theme:icons/colorway/mingcute/normal/output.svg)';
    --cw_icon_pause_base: 'url(theme:icons/colorway/mingcute/normal/pause.svg)';
    --cw_icon_pin_base: 'url(theme:icons/colorway/mingcute/normal/pin.svg)';
    --cw_icon_plus_base: 'url(theme:icons/colorway/mingcute/normal/plus.svg)';
    --cw_icon_popout_base: 'url(theme:icons/colorway/mingcute/normal/popout.svg)';
    --cw_icon_refresh_base: 'url(theme:icons/colorway/mingcute/normal/refresh.svg)';
    --cw_icon_revert_base: 'url(theme:icons/colorway/mingcute/normal/revert.svg)';
    --cw_icon_save_base: 'url(theme:icons/colorway/mingcute/normal/save.svg)';
    --cw_icon_scene_base: 'url(theme:icons/colorway/mingcute/normal/scene.svg)';
    --cw_icon_settings_base: 'url(theme:icons/colorway/mingcute/normal/settings.svg)';
    --cw_icon_slideshow_base: 'url(theme:icons/colorway/mingcute/normal/slideshow.svg)';
    --cw_icon_skip_forward_base: 'url(theme:icons/colorway/mingcute/normal/skip_forward.svg)';
    --cw_icon_skip_previous_base: 'url(theme:icons/colorway/mingcute/normal/skip_previous.svg)';
    --cw_icon_text_base: 'url(theme:icons/colorway/mingcute/normal/text.svg)';
    --cw_icon_trash_base: 'url(theme:icons/colorway/mingcute/normal/trash.svg)';
    --cw_icon_unlock_base: 'url(theme:icons/colorway/mingcute/normal/unlock.svg)';
    --cw_icon_video_base: 'url(theme:icons/colorway/mingcute/normal/video.svg)';
    --cw_icon_volume_high_base: 'url(theme:icons/colorway/mingcute/normal/volume-high.svg)';
    --cw_icon_volume_mute_base: 'url(theme:icons/colorway/mingcute/normal/volume-mute.svg)';
    --cw_icon_window_base: 'url(theme:icons/colorway/mingcute/normal/window.svg)';
    --cw_icon_download_base: 'url(theme:icons/colorway/mingcute/normal/download.svg)';
    /* colorway:state-tokens:end */

}

/* --------------------- */
/* General Styling Hints */

.bg_window {
    background-color: var(--bg_window);
}

.bg-base {
    background-color: var(--bg_base);
}

.text-title {
    font-size: var(--font_large);
    font-weight: bold;
}

.text-small {
    font-size: var(--font_small);
}

.text-tiny {
    font-size: var(--font_xsmall);
}

.text-heading {
    font-size: var(--font_heading);
    font-weight: bold;
}

.text-large {
    font-size: var(--font_large);
}

.text-bold {
    font-weight: bold;
}

.text-italic {
    font-style: italic;
}

.text-bright {
    color: var(--primary_light);
}

.text-muted {
    color: var(--text_muted);
}

.text-warning {
    color: var(--warning);
}

.text-danger {
    color: var(--danger);
}

.text-success {
    color: var(--success);
}

.frame-notice {
    background: var(--surface1);
    border: 1px solid var(--border_color);
    border-radius: var(--border_radius);
    padding: var(--padding_xlarge) var(--padding_large);
}

.frame-notice QLabel {
    padding: var(--padding_large) 0px;
}

.dialog-container {
    padding: var(--padding_large) var(--padding_xlarge);
}

.dialog-frame {
    background-color: var(--surface1);
    border-radius: var(--shape_md);
    border: 1px solid var(--border_color);
    margin: var(--spacing_base);
}

.dialog-frame > QWidget {
    margin: var(--spacing_base) 0;
}

.subtitle {
    font-size: var(--font_small);
    font-weight: bold;
    color: var(--text_muted);
}

.button-primary {
    background-color: var(--primary_dark);
    color: var(--on_primary_dark);
    border-color: var(--primary);
    outline: none;
}

.button-primary:hover,
.button-primary:focus {
    background-color: var(--primary);
    color: var(--on_primary);
    border-color: var(--primary_lighter);
}

.button-primary:hover {
    border-color: var(--primary_light);
}

.toolbar-button {
    background: transparent;
    font-weight: bold;
    padding: 0 var(--padding_xlarge);
    margin: var(--spacing_small) var(--spacing_small) 0px;
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

.margin {
    margin: var(--spacing_base);
}

.margin-x {
    margin-left: var(--spacing_base);
    margin-right: var(--spacing_base);
}

.margin-left {
    margin-left: var(--spacing_base);
}

.margin-right {
    margin-right: var(--spacing_base);
}

.margin-y {
    margin-top: var(--spacing_base);
    margin-bottom: var(--spacing_base);
}

.margin-top {
    margin-top: var(--spacing_base);
}

.margin-bottom {
    margin-bottom: var(--spacing_base);
}

/* Icon Overrides */

.icon-plus { qproperty-icon: var(--cw_icon_plus_base); }

.icon-minus { qproperty-icon: var(--cw_icon_minus_base); }

.icon-trash { qproperty-icon: var(--cw_icon_trash_base); }

.icon-clear { qproperty-icon: var(--cw_icon_close_base); }

.icon-gear { qproperty-icon: var(--cw_icon_settings_base); }

.icon-dots-vert { qproperty-icon: var(--cw_icon_dots_vert_base); }

.icon-refresh { qproperty-icon: var(--cw_icon_refresh_base); }

.icon-cogs { qproperty-icon: var(--cw_icon_cogs_base); }

.icon-touch { qproperty-icon: var(--cw_icon_interact_base); }

.icon-up { qproperty-icon: var(--cw_icon_chevron_up_base); }

.icon-down { qproperty-icon: var(--cw_icon_chevron_down_base); }

.icon-pause { qproperty-icon: var(--cw_icon_pause_base); }

.icon-filter { qproperty-icon: var(--cw_icon_filter_base); }

.icon-revert { qproperty-icon: var(--cw_icon_revert_base); }

.icon-save { qproperty-icon: var(--cw_icon_save_base); }

.icon-close { qproperty-icon: var(--cw_icon_close_base); }

.icon-pin { qproperty-icon: var(--cw_icon_pin_base); }

.icon-layout-vertical { qproperty-icon: var(--cw_icon_layout_vertical_base); }

.icon-layout-horizontal { qproperty-icon: var(--cw_icon_layout_horizontal_base); }

/* Media icons */

.icon-media-play { qproperty-icon: var(--cw_icon_media_play_base); }

.icon-media-pause { qproperty-icon: var(--cw_icon_pause_base); }

.icon-media-restart { qproperty-icon: var(--cw_icon_refresh_base); }

.icon-media-stop { qproperty-icon: var(--cw_icon_media_stop_base); }

.icon-media-next { qproperty-icon: var(--cw_icon_skip_forward_base); }

.icon-media-prev { qproperty-icon: var(--cw_icon_skip_previous_base); }

/* Bricolage Grotesque must be installed as an OS font; QSS cannot load fonts.
   See the package INSTALL.md. The root family list supplies Qt fallbacks. */

#controlsFrame QPushButton {
    margin: var(--spacing_base) var(--spacing_small);
}

#streamButton,
#recordButton,
#replayBufferButton,
#broadcastButton {
    padding: var(--padding_large);
}

#pauseRecordButton,
#saveReplayButton,
#virtualCamConfigButton {
    padding: var(--padding_large) var(--padding_large);
    width: var(--input_height);
    max-width: var(--input_height);
}

/* Primary Control Button Active States */
#streamButton.state-active, #broadcastButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--live_bg_start), stop:1 var(--live_bg_end));
    border-color: var(--live);
    color: var(--live);
    font-weight: bold;
}

#recordButton.state-active, #pauseRecordButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--recording_bg_start), stop:1 var(--recording_bg_end));
    border-color: var(--recording);
    color: var(--recording);
    font-weight: bold;
}

#replayBufferButton.state-active, #virtualCamButton.state-active {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 var(--accent_bg_start), stop:1 var(--accent_bg_end));
    border-color: var(--lavender_accent);
    color: var(--lavender_accent);
}

/* Primary Control Button Active Hover States */
#streamButton:hover:!pressed.state-active,
#broadcastButton:hover:!pressed.state-active {
    background: var(--button_bg_hover);
    border-color: var(--live);
    color: var(--button_hover_text);
}

#recordButton:hover:!pressed.state-active,
#pauseRecordButton:hover:!pressed.state-active {
    background: var(--button_bg_hover);
    border-color: var(--recording);
    color: var(--button_hover_text);
}

#replayBufferButton:hover:!pressed.state-active,
#virtualCamButton:hover:!pressed.state-active {
    background: var(--button_bg_hover);
    border-color: var(--lavender_accent);
    color: var(--button_hover_text);
}

/* Studio Mode active state.
   Current OBS toggles .state-active; :checked stays as a legacy fallback. */
#modeSwitch:!hover:!pressed.state-active,
#modeSwitch:!hover:!pressed:checked {
    background: var(--bg_base);
    border: 2px solid var(--primary);
    color: var(--text);
    font-weight: bold;
}

#modeSwitch:hover:!pressed.state-active,
#modeSwitch:hover:!pressed:checked {
    background: var(--button_bg_hover);
    border: 2px solid var(--primary);
    color: var(--button_hover_text);
    font-weight: bold;
}

#modeSwitch:pressed.state-active,
#modeSwitch:pressed:checked {
    background: var(--bg_base);
    border: 2px inset var(--primary_dark);
    color: var(--text);
    font-weight: bold;
}

QPushButton:focus {
    background: qradialgradient(
        cx:0.5, cy:0.5, radius: 0.9, fx:0.5, fy:0.5,
        stop:0    var(--button_bg),
        stop:0.5  var(--button_bg),
        stop:1    var(--primary)
    );
}

/* Sliders */

#stackedMixerArea {
    border: none;
    padding: 0px;
}

.mixer-category {
    color: var(--text_muted);
    margin: 0;
    padding: 0;
    text-align: center;
}

/* Volume Control Buttons */

.btn-mute,
.btn-monitor {
    width: var(--icon_small);
    height: var(--icon_small);
    background-color: transparent;
    padding: var(--padding_base_border) var(--padding_base_border);
    margin: 0px var(--spacing_small);
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
    icon-size: var(--icon_small);
}

.btn-mute:checked,
.btn-monitor:checked {
    background-color: transparent;
    border-color: transparent;
}

.btn-mute:hover,
.btn-monitor:hover {
    background-color: var(--button_bg_hover);
    border-color: transparent;
}

.btn-mute:pressed,
.btn-monitor:pressed {
    background-color: var(--button_bg_down);
}

/* Mute Button */

.btn-mute {
    color: var(--text);
}

.btn-mute.checked {
    color: var(--danger);
    background: transparent;
}

.btn-mute.checked.hover {
    color: var(--danger);
    background: var(--bg_hover);
    border-color: var(--danger);
}

.btn-mute.checked:focus {
    border-color: var(--danger);
}

/* OBS renamed mute-unassigned to mute-warning for Monitor Only warnings.
   Keep both selectors so Colorway remains usable across OBS versions. */
.btn-mute.mute-warning,
.btn-mute.mute-unassigned {
    color: var(--warning);
    background: var(--bg_hover);
}

.btn-mute.mute-warning.hover,
.btn-mute.mute-warning:focus,
.btn-mute.mute-unassigned.hover,
.btn-mute.mute-unassigned:focus {
    border-color: var(--warning);
}

/* Monitor Button */

.btn-monitor {
    background: transparent;
}

.btn-monitor:focus {
    border-color: var(--success);
}

.btn-monitor.checked {
    background: var(--bg_hover);
    color: var(--success);
    border-color: var(--success);
}

.btn-monitor.checked:focus,
.btn-monitor:checked:focus,
.btn-monitor.checked:hover {
    background: var(--bg_hover);
    color: var(--success);
    border-color: var(--success);
}

/* Toggle hidden button */

.toggle-hidden:checked {
    background: var(--primary_dark);
    border-color: var(--primary);
}

.toggle-hidden:disabled {
    background: transparent;
    border-color: transparent;
}

VolumeControl,
VolumeMeter {
    background: var(--bg_base);
}

VolumeName {
    background: transparent;
    padding: var(--padding_base) 0;
    border: 1px solid transparent;
}

VolumeName QLabel {
    font-size: var(--font_small);
}

VolumeName:focus {
    border: 1px solid var(--button_border_hover);
}

VolumeName:hover {
    background: var(--button_bg_hover);
    border: 1px solid var(--button_border_hover);
}

VolumeControl #volLabel {
    min-width: 48px;
    padding: var(--padding_base) 0px var(--padding_base);
    text-align: center;
    font-size: var(--font_small);
    color: var(--text_muted);
}

/* Horizontal Mixer */
#hVolumeWidgets VolumeControl {
    padding: 0px 0px;
    border-bottom: 1px solid var(--border_color);
    margin-bottom: 0px;
}

#hVolumeWidgets .mixer-category {
    margin: var(--spacing_base);
    padding: 0px var(--padding_xlarge);
    border-radius: var(--border_radius);
}

#hVolumeWidgets VolumeName {
    padding-right: var(--padding_large);
}

#hVolumeWidgets VolumeName QLabel {
    margin: 0 var(--padding_large);
}

#hVolumeWidgets #volLabel {
    margin: 0 var(--spacing_base);
    border-radius: var(--border_radius);
}

#hVolumeWidgets #volMeterFrame {
    margin-bottom: var(--padding_large);
}

#hVolumeWidgets VolumeControl QSlider {
    margin: var(--padding_large) 0px;
    min-height: var(--slider_handle_size);
}

#hVolumeWidgets VolumeControl QSlider::groove:horizontal {
    background: var(--bg_window);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

#hVolumeWidgets VolumeControl QPushButton {
    margin-left: var(--padding_large);
}

#hVolumeWidgets VolumeControl #volMeterFrame {
    padding: 0 var(--padding_xlarge);
}

/* Vertical Mixer */
#vVolumeWidgets VolumeControl {
    padding: 0px 0px var(--padding_container);
    border-right: 1px solid var(--border_color);
}

#vVolumeWidgets .mixer-category {
    border-bottom: 1px solid var(--border_color);
}

#vMixerScrollArea VolumeControl QSlider {
    width: var(--slider_handle_size);
    margin: 0px var(--padding_xlarge);
}

#vVolumeWidgets VolumeControl #volLabel {
    padding: var(--padding_base) 0px var(--padding_base);
    min-width: var(--volume_slider_label);
    margin-left: var(--padding_xlarge);
    text-align: center;
}

#vVolumeWidgets VolumeControl QSlider::groove:vertical {
    background: var(--bg_window);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

#vVolumeWidgets VolumeControl #volMeterFrame {
    padding: var(--padding_large) var(--padding_xlarge) var(--padding_large) 0px;
}

#vVolumeWidgets VolumeControl QLabel {
    padding: 0px var(--padding_large);
}

VolumeControl.volume-inactive,
VolumeControl.volume-inactive VolumeMeter {
    background: var(--button_bg_disabled);
}

VolumeControl.volume-hidden .mixer-name,
VolumeControl.volume-inactive .mixer-name {
    color: var(--text_muted);
}

VolumeControl .mixer-category {
    font-weight: bold;
    background: var(--bg_base);
    color: var(--text);
}

VolumeControl.volume-pinned .mixer-category {
    background: var(--button_bg_hover);
    color: var(--button_hover_text);
}

VolumeControl.volume-hidden .mixer-category {
    background: var(--bg_base);
    color: var(--primary_dark);
}

VolumeControl.volume-unassigned .mixer-category {
    background: var(--bg_hover);
    color: var(--warning);
}

VolumeControl.volume-inactive .mixer-category {
    background: var(--bg_base);
    color: var(--on_base_muted);
}

VolumeControl.volume-preview .mixer-category {
    background: var(--bg_hover);
    color: var(--success);
}

#stackedMixerArea VolumeControl.volume-hidden QSlider::groove,
#stackedMixerArea VolumeControl.volume-inactive QSlider::groove {
    background: var(--button_bg_disabled);
}

/* Table View */

QTableView::item {
    margin: 0px;
    padding: 0px;
}

QTableView QLineEdit {
    background: var(--input_bg_focus);
    padding: 0;
    margin: 0;
}

QTableView QPushButton,
QTableView QToolButton {
    padding: 0px;
    margin: -1px;
    border-radius: var(--shape_xs);
}

QTableView::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
}

QTableView::indicator:unchecked {
    image: none;
    background: var(--bg_base);
    border: 2px solid var(--text);
    border-radius: var(--shape_xs);
}

QTableView::indicator:checked {
    image: var(--checkbox_check_icon);
    background: var(--bg_base);
    border: 2px solid var(--text);
    border-radius: var(--shape_xs);
}

QTableView::indicator:unchecked:hover,
QTableView::indicator:checked:hover,
QTableView::indicator:unchecked:focus,
QTableView::indicator:checked:focus {
    border: 3px solid var(--primary);
}

/* Canvas / Preview background color */

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--bg_preview);
}

/* Filters Window */

OBSBasicFilters #widget,
OBSBasicFilters #widget_2 {
    margin: 0px;
    padding: 0px;
    padding-bottom: var(--padding_base);
}

OBSBasicFilters #widget QPushButton,
OBSBasicFilters #widget_2 QPushButton {
    min-width: 16px;
    padding: var(--padding_base) var(--padding_large);
    margin-top: 0px;
    border-radius: var(--border_radius_small);
}

/* Preview/Program labels */

.label-preview-title {
    font-size: var(--font_xlarge);
    font-weight: bold;
    color: var(--text_light);
    margin-bottom: 4px;
}

/* Checkboxes */

/* Icon Checkboxes */
.checkbox-icon {
    outline: none;
    background: transparent;
    max-width: var(--icon_base);
    max-height: var(--icon_base);
    padding: var(--padding_base);
    margin-right: var(--spacing_large);
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

.checkbox-icon::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
    background: var(--bg_base);
    border-radius: var(--border_radius_small);
}

.checkbox-icon:hover,
.checkbox-icon:focus {
    border-color: var(--primary_lighter);
}

/* Locked CheckBox */

.indicator-lock::indicator:checked,
.indicator-lock::indicator:checked:hover {
    image: var(--cw_icon_lock_base);
    background: var(--bg_base);
    border-radius: var(--border_radius_small);
}

.indicator-lock::indicator:unchecked,
.indicator-lock::indicator:unchecked:hover {
    image: var(--cw_icon_unlock_base);
}

/* Visibility CheckBox */

.indicator-visibility::indicator:checked,
.indicator-visibility::indicator:checked:hover {
    image: var(--cw_icon_eye_base);
    background: var(--bg_base);
    border-radius: var(--border_radius_small);
}

.indicator-visibility::indicator:unchecked,
.indicator-visibility::indicator:unchecked:hover {
    image: var(--cw_icon_eye_off_base);
    background: var(--bg_base);
    border-radius: var(--border_radius_small);
}

#hotkeyFilterReset {
    margin-top: 0px;
}

OBSHotkeyWidget {
    padding: 8px 0px;
    margin: 2px 0px;
}

OBSHotkeyLabel {
    padding: 4px 0px;
}

OBSHotkeyWidget QPushButton {
    min-width: 16px;
    padding: var(--padding_base);
    margin-top: 0px;
    margin-left: var(--spacing_base);
    border-radius: var(--border_radius_small);
}

/* Sources List Group Collapse Checkbox */

.indicator-expand::indicator:checked,
.indicator-expand::indicator:checked:hover {
    image: var(--cw_icon_chevron_down_base);
}

.indicator-expand::indicator:unchecked,
.indicator-expand::indicator:unchecked:hover {
    image: var(--cw_icon_chevron_right_base);
}

/* Source Icons */

.source-icon {
    margin-right: var(--spacing_large);
}

OBSBasic {
    qproperty-imageIcon: var(--cw_icon_image_base);
    qproperty-colorIcon: var(--cw_icon_brush_base);
    qproperty-slideshowIcon: var(--cw_icon_slideshow_base);
    qproperty-audioInputIcon: var(--cw_icon_microphone_base);
    qproperty-audioOutputIcon: var(--cw_icon_audio_base);
    qproperty-desktopCapIcon: var(--cw_icon_display_base);
    qproperty-windowCapIcon: var(--cw_icon_window_base);
    qproperty-gameCapIcon: var(--cw_icon_gamepad_base);
    qproperty-cameraIcon: var(--cw_icon_video_base);
    qproperty-textIcon: var(--cw_icon_text_base);
    qproperty-mediaIcon: var(--cw_icon_media_play_base);
    qproperty-browserIcon: var(--cw_icon_globe_base);
    qproperty-groupIcon: var(--cw_icon_group_base);
    qproperty-sceneIcon: var(--cw_icon_scene_base);
    qproperty-defaultIcon: var(--cw_icon_default_base);
    qproperty-audioProcessOutputIcon: var(--cw_icon_audio_base);
}

/* Scene Tree Grid Mode */

SceneTree,
SourceTree {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
}

SceneTree {
    qproperty-gridItemWidth: 154;
    qproperty-gridItemHeight: var(--input_height_base);
}

.list-grid SceneTree::item {
    color: var(--text);
    background-color: var(--button_bg);
    border-radius: var(--border_radius);
    margin: var(--spacing_base);
}

.list-grid SceneTree::item:selected {
    background-color: var(--primary);
    color: var(--on_primary);
}

.list-grid SceneTree::item:checked {
    background-color: var(--primary);
    color: var(--on_primary);
}

.list-grid SceneTree::item:hover {
    background-color: var(--list_item_bg_hover);
}

.list-grid SceneTree::item:selected:hover {
    background-color: var(--primary_light);
    color: var(--on_primary_hover);
}

/* Studio Mode T-Bar */

.slider-tbar {
    height: var(--slider_handle_size);
}

.slider-tbar::groove:horizontal {
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

.slider-tbar::sub-page:horizontal {
    background: var(--primary);
    border-radius: var(--slider_groove_radius);
}

.slider-tbar::handle:horizontal {
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    border-radius: var(--slider_handle_radius);
    margin: var(--slider_handle_margin) 0px;
}

/* YouTube Integration */
OBSYoutubeActions {
    qproperty-thumbPlaceholder: var(--cw_icon_image_base);
}

#ytEventList QLabel {
    color: var(--text);
    background-color: var(--button_bg);
    border: none;
    border-radius: var(--border_radius);
    padding: 4px 20px;
}

#ytEventList QLabel:hover {
    background-color: var(--button_bg_hover);
}

#ytEventList .row-selected {
    background-color: var(--primary);
    color: var(--on_primary);
    border: none;
}

#ytEventList .row-selected:hover {
    background-color: var(--primary_light);
    color: var(--on_primary_hover);
}

/* Calendar Widget */
QDateTimeEdit::down-arrow {
    image: var(--cw_icon_chevron_down_base);
    width: 100%;
}

QDateTimeEdit:on {
    background-color: var(--input_bg_focus);
}

/* Calendar Top Bar */
QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: var(--bg_base);
    padding: var(--padding_base) var(--padding_large);
}

/* Calendar Top Bar Buttons */
QCalendarWidget QToolButton {
    background-color: var(--button_bg);
    padding: 2px 16px;
    border-radius: var(--border_radius);
    margin: var(--spacing_base);
}

#qt_calendar_monthbutton::menu-indicator {
    image: var(--cw_icon_chevron_down_base);
    subcontrol-position: right;
    padding-top: var(--padding_small);
    padding-right: var(--padding_base);
    height: 10px;
    width: 10px;
}

QCalendarWidget #qt_calendar_prevmonth {
    padding: var(--padding_small);
    icon-size: var(--icon_base);
}

QCalendarWidget #qt_calendar_nextmonth {
    padding: var(--padding_small);
    icon-size: var(--icon_base);
}

QCalendarWidget QToolButton:hover {
    background-color: var(--button_bg_hover);
    border-radius: var(--border_radius);
}

QCalendarWidget QToolButton:pressed {
    background-color: var(--button_bg_down);
}

/* Month Dropdown Menu */
/* Year spinbox */
QCalendarWidget QSpinBox {
    background-color: var(--input_bg);
    border: none;
    border-radius: var(--border_radius);
    margin: 0px var(--spacing_base) 0px 0px;
    padding: var(--padding_base) 16px;
}

QCalendarWidget QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
}

QCalendarWidget QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
}

QCalendarWidget QSpinBox::up-arrow {
    width: 10px;
    height: 10px;
}

QCalendarWidget QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* Days of the Week Bar */
QCalendarWidget QWidget {
    alternate-background-color: var(--bg_hover);
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: var(--bg_base);
    color: var(--text);
}

QCalendarWidget QAbstractItemView:disabled {
    color: var(--on_base_disabled);
}

/* VirtualCam Plugin Fixes */

#VirtualProperties QWidget {
    margin-top: 0;
    margin-bottom: 0;
}

/* Disable icons on QDialogButtonBox */
QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}

/* Advanced audio dialog */
OBSBasicAdvAudio #scrollAreaWidgetContents {
    background: var(--bg_base);
}

#previewScalePercent,
#previewScalingMode {
    background: transparent;
    color: var(--on_preview_muted);
    font-size: var(--font_xsmall);
    height: 14px;
    max-height: 14px;
    padding: 0px;
    margin: 0;
}

#previewXContainer {
    border: 1px solid var(--border_color);
}

#previewScalePercent {
    padding: 0px var(--input_text_padding);
    min-width: var(--preview_scale_width);
}

#previewScalingMode {
    padding: 0px var(--input_text_padding);
    border: 1px solid var(--border_color);
}

#previewScalingMode:hover,
#previewScalingMode:focus {
    border-color: var(--input_border_hover);
}

#previewScalingMode:on {
    background-color: var(--input_bg_focus);
    border-color: var(--input_border_focus);
}

#previewXScrollBar,
#previewYScrollBar {
    background: transparent;
    border: 1px solid var(--border_color);
    border-radius: var(--border_radius_small);
}

#previewXScrollBar {
    border-left: none;
    height: 16px;
}

#previewXScrollBar::handle,
#previewYScrollBar::handle {
    margin: 3px;
}

#previewYScrollBar {
    width: 16px;
}

#previewZoomInButton {
    border: none;
    border-radius: var(--border_radius_small);
    outline: none;
}

#previewZoomOutButton {
    border: none;
    border-radius: var(--border_radius_small);
    outline: none;
}

#previewZoomInButton:!hover,
#previewZoomOutButton:!hover {
    background-color: transparent;
}

#previewZoomInButton:pressed,
#previewZoomOutButton:pressed {
    background-color: var(--button_bg);
}

#previewZoomInButton:focus,
#previewZoomOutButton:focus {
    border: 1px solid var(--input_border_hover);
}

/* Add Source Dialog */
.btn-create-new {
    background: transparent;
    padding: var(--padding_wide) var(--padding_large);
    border-radius: var(--shape_lg);
    border: 2px dashed var(--border_color);
    outline: none;
    qproperty-icon: var(--cw_icon_plus_base);
    margin-bottom: var(--spacing_large);
}

.btn-create-new:hover,
.btn-create-new:focus {
    background: var(--button_bg_hover);
    border-color: var(--primary);
}

SourceSelectButton {
    background: var(--bg_base);
    padding: var(--padding_base) var(--padding_large);
    margin: var(--spacing_base);
    border-radius: var(--shape_lg);
    border: 2px solid var(--border_color);
    outline: none;
}

SourceSelectButton QLabel {
    padding: var(--padding_large) 0;
    text-align: center;
    color: var(--text);
}

SourceSelectButton #thumbnail {
    background: var(--bg_preview);
    border-radius: var(--border_radius);
    padding: 0;
    margin-top: var(--spacing_base);
}

SourceSelectButton:hover {
    background-color: var(--bg_base);
    border-color: var(--input_border_hover);
}

SourceSelectButton:checked {
    background-color: var(--bg_base);
    border-color: var(--primary);
    color: var(--text);
}

SourceSelectButton:focus,
SourceSelectButton:checked:focus {
    border-color: var(--text_light);
}

SourceSelectButton:pressed,
SourceSelectButton:pressed:hover {
    background-color: var(--bg_base);
    border-color: var(--primary_dark);
    color: var(--text);
}

/* Idian Widgets */
idian--Group {
    background: var(--surface1);
    border-radius: var(--shape_md);
    padding: var(--padding_base);
    font-weight: bold;
    margin: 0 0 var(--spacing_base);
    min-width: 300px;
    max-width: 600px;
}

idian--Group .header .title {
    font-weight: bold;
    padding: var(--padding_large);
    color: var(--on_primary_container);
}

idian--Group .header .description {
    color: var(--on_panel_muted);
    padding: var(--spacing_small) var(--padding_small);
}

idian--PropertiesList {
    border-width: 0;
    padding: 0;
    margin: var(--spacing_base) 0;
}

idian--Row {
    background: var(--surface2);
    margin: 0;
    padding: var(--action_row_padding) var(--action_row_padding_x);
}

idian--Row.keyFocus {
    background: var(--surface3);
    border: var(--highlight_width) solid var(--highlight_color);
}

idian--Row.cursor-pointer.hover {
    background: var(--surface3);
    border: var(--highlight_width) solid var(--input_border_hover);
}

idian--Row.first {
    border-top-left-radius: var(--border_radius);
    border-top-right-radius: var(--border_radius);
}

idian--Row.last {
    border-bottom-left-radius: var(--border_radius);
    border-bottom-right-radius: var(--border_radius);
}

idian--Row > QLabel.description {
    font-size: var(--font_small);
    color: var(--on_preview_muted);
}

idian--ToggleSwitch {
    qproperty-background: var(--bg_base);
    qproperty-background_hover: var(--bg_base);
    qproperty-background_checked: var(--bg_base);
    qproperty-background_checked_hover: var(--bg_base);

    min-width: var(--toggle_width);
    min-height: var(--toggle_height);

    border-radius: var(--toggle_radius);

    qproperty-handleColor: var(--text);
    qproperty-handleSize: var(--toggle_handle);

    border: var(--highlight_width) solid transparent;
}

idian--ToggleSwitch.hover {
    border-color: var(--input_border_hover);
}

idian--ToggleSwitch.checked {
    border-color: var(--primary);
}

idian--ToggleSwitch.checked.hover {
    border-color: var(--primary_lighter);
}

idian--ToggleSwitch.keyFocus {
    border-color: var(--highlight_color);
}

idian--Row idian--ToggleSwitch.hover,
idian--Row.hover > idian--ToggleSwitch.row-buddy {
    border-color: var(--input_border_hover);
}

idian--Row idian--ToggleSwitch.hover.checked,
idian--Row.hover > idian--ToggleSwitch.checked.row-buddy {
    border-color: var(--primary_lighter);
}

idian--Row QComboBox {
    background-color: transparent;
    min-height: var(--action_row_base);
    max-height: var(--action_row_base);
    min-width: var(--action_row_input_width);
    border: var(--highlight_width) solid transparent;
    padding: 0;
    padding-left: var(--padding_xlarge);
    margin: 0;
}

idian--Row QComboBox:focus {
    border-color: transparent;
}

idian--Row QComboBox.hover {
    border-color: var(--input_border_hover);
}

idian--Row QComboBox.keyFocus {
    border-color: var(--highlight_color);
}

idian--Row QComboBox::drop-down {
    border: none;
}

idian--Row QComboBox::down-arrow {
    image: var(--cw_icon_chevron_down_base);
}

idian--Row QComboBox QAbstractItemView {
    outline: none;
}

idian--Row QComboBox QAbstractItemView::item {
    background-color: var(--bg_base);
    padding: var(--padding_base) var(--padding_large);
}

idian--Row QComboBox QAbstractItemView.hover::item,
idian--Row QComboBox QAbstractItemView::item:selected {
    background-color: var(--list_item_bg_selected);
    padding: var(--padding_base) var(--padding_large);
}

idian--Row QPushButton,
idian--Row QSpinBox,
idian--Row QDoubleSpinBox {
    margin: 0;
    padding: var(--padding_base) var(--action_row_padding_x);
}

idian--PropertiesListSpacer {
    max-height: var(--spacing_small);
    min-height: var(--spacing_small);
    background-color: var(--bg_window);
}

idian--Row idian--CheckBox {
    outline: none;
}

idian--CheckBox::indicator {
    border: var(--highlight_width) solid transparent;
    border-radius: var(--border_radius);
}

idian--CheckBox.keyFocus::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator {
    image: var(--cw_icon_checkbox_line_base);
}

idian--CheckBox.keyFocus.checked::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    image: var(--cw_icon_checkbox_fill_base);
}

idian--CheckBox.hover::indicator,
idian--CheckBox.checked.hover::indicator,
idian--Row.hover > idian--CheckBox.row-buddy::indicator,
idian--Row.hover > idian--CheckBox.row-buddy.checked::indicator {
    border-color: var(--input_border_hover);
}

idian--CheckBox.keyFocus::indicator,
idian--CheckBox.keyFocus.checked::indicator {
    border-color: var(--highlight_color);
}

idian--CollapsibleRow {
    margin: 0;
    padding: 0;
    border: none;
}

idian--CollapsibleRow.keyFocus {
    border: var(--highlight_width) solid var(--highlight_color);
}

idian--CollapsibleRow idian--PropertiesList {
    border-radius: 0;
    border-left: 1px solid var(--border_color);
    border-right: 1px solid var(--border_color);
    border-bottom: 1px solid var(--border_color);
    margin: var(--spacing_small) 0px 0px;
}

idian--CollapsibleRow idian--PropertiesList idian--Row {
    background-color: var(--surface1);
    padding-left: var(--action_row_padding_nested);
}

idian--CollapsibleRow idian--Row.first {
    border-top-left-radius: var(--border_radius);
    border-top-right-radius: var(--border_radius);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

idian--CollapsibleRow idian--Row.last {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: var(--border_radius);
    border-bottom-right-radius: var(--border_radius);
}

idian--CollapsibleRow idian--PropertiesList idian--ToggleSwitch {
    qproperty-background: var(--surface2);
    qproperty-background_hover: var(--surface3);
}

idian--ExpandButton {
    background: transparent;
    min-width: var(--action_row_collapse);
    max-width: var(--action_row_collapse);
    min-height: var(--action_row_collapse);
    max-height: var(--action_row_collapse);
    border: none;
}

/* Legacy Idian CollapsibleRow renders its chevron through ::indicator. */
idian--CollapsibleRow idian--ExpandButton::indicator {
    background: var(--surface2);
    border-radius: var(--action_row_collapse_radius);
    padding: var(--padding_large);
    image: var(--cw_icon_chevron_down_base);
    border: var(--highlight_width) solid var(--border_color);
}

idian--CollapsibleRow idian--ExpandButton::indicator:checked {
    image: var(--cw_icon_chevron_up_base);
}

idian--ExpandButton.keyFocus,
idian--CollapsibleRow idian--ExpandButton.keyFocus::indicator {
    border-color: var(--highlight_color);
}

idian--RowFrame .btn-frame {
    background: var(--surface2);
    padding: var(--action_row_padding) var(--action_row_padding_x);
}

idian--RowFrame.hover .btn-frame {
    background: var(--surface3);
}

idian--RowFrame.hover idian--Row {
    background: var(--surface3);
    border: var(--highlight_width) solid var(--input_border_hover);
    border-right: none;
}

idian--RowFrame.hover .row-buddy {
    background: var(--surface3);
    border: var(--highlight_width) solid var(--input_border_hover);
    border-left: none;
}

idian--RowFrame.hover idian--ExpandButton::indicator {
    border-color: var(--input_border_hover);
}

/* Current Idian widget names (OBS 32+).
   Legacy Idian selectors above stay in place for older OBS releases. */
idian--ListHeader {
    border-radius: var(--shape_md);
    font-weight: bold;
    margin: 0 0 var(--spacing_base);
    padding: 0 var(--padding_base);
    min-width: 300px;
}

idian--ListHeader .title {
    font-weight: bold;
    padding: var(--padding_large) 0;
    color: var(--text);
}

idian--ListHeader .description,
idian--RowInfo QLabel.description {
    color: var(--text_muted);
}

idian--RowList {
    border-width: 0;
    padding: 0;
    margin: var(--spacing_base) 0;
}


idian--RowList idian--Row {
    border-radius: 0;
}

idian--RowList idian--Row.first {
    border-top-left-radius: var(--shape_md);
    border-top-right-radius: var(--shape_md);
}

idian--RowList idian--Row.last {
    border-bottom-left-radius: var(--shape_md);
    border-bottom-right-radius: var(--shape_md);
}

idian--RowListSpacer {
    max-height: var(--spacing_small);
    min-height: var(--spacing_small);
    background-color: var(--bg_window);
}

idian--CollapsibleGroup {
    margin: 0;
    padding: 0;
    border: none;
}

idian--CollapsibleGroup.expanded > idian--Row {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

idian--CollapsibleGroup idian--Row.keyFocus {
    border: var(--highlight_width) solid var(--highlight_color);
}

idian--CollapsibleGroup idian--RowList {
    border-radius: 0;
    border-left: 1px solid var(--border_color);
    border-right: 1px solid var(--border_color);
    border-bottom: 1px solid var(--border_color);
    margin: var(--spacing_small) 0 0;
}

idian--CollapsibleGroup idian--RowList idian--Row {
    background-color: var(--surface1);
    padding-left: var(--action_row_padding_nested);
}

idian--CollapsibleGroup idian--RowList idian--Row.first {
    border-radius: 0;
}

idian--CollapsibleGroup idian--RowList idian--Row.last {
    border-bottom-left-radius: var(--shape_md);
    border-bottom-right-radius: var(--shape_md);
}

idian--RowList idian--CollapsibleGroup idian--Row.last {
    border-radius: 0;
}

idian--RowList idian--CollapsibleGroup.last idian--Row.last {
    border-bottom-left-radius: var(--shape_md);
    border-bottom-right-radius: var(--shape_md);
}

idian--CollapsibleGroup idian--RowList idian--ToggleSwitch {
    qproperty-background: var(--surface2);
    qproperty-background_hover: var(--surface3);
}

idian--InlineButton,
idian--Row idian--InlineButton {
    background: transparent;
    min-width: var(--input_height);
    min-height: var(--input_height);
    border-radius: var(--shape_sm);
    padding: var(--padding_large);
    margin: 0 var(--spacing_base);
    border: var(--highlight_width) solid transparent;
}

idian--InlineButton:hover,
idian--Row.hover idian--InlineButton.row-buddy {
    background-color: var(--button_bg_hover);
    border-color: var(--input_border_hover);
}

idian--InlineButton:pressed {
    background-color: var(--button_bg_down);
}

idian--InlineButton:focus,
idian--InlineButton.keyFocus,
idian--Row.keyFocus idian--InlineButton,
idian--Row.keyFocus idian--InlineButton.checked {
    border-color: var(--highlight_color);
}

/* OBS 32+ Idian exposes the chevron through qproperty-icon.
   Geometry stays in the shared ExpandButton rule above; legacy CollapsibleRow
   keeps its scoped ::indicator fallback for older OBS releases. */
idian--ExpandButton {
    qproperty-icon: var(--cw_icon_chevron_down_base);
}

idian--ExpandButton.checked {
    qproperty-icon: var(--cw_icon_chevron_up_base);
    background: transparent;
    border-color: transparent;
}

AlignmentSelector {
    border: 1px solid var(--input_border);
    margin: 0px;
    border-radius: var(--shape_xs);
}

AlignmentSelector:focus,
AlignmentSelector:hover {
    border: 1px solid var(--primary_lighter);
}

AlignmentSelector:checked:hover {
    border: 1px solid var(--primary_lighter);
}

AlignmentSelector::indicator {
    margin: 0px;
    background: transparent;
}

AlignmentSelector::indicator:checked {
    background: var(--primary);
}

AlignmentSelector::indicator:checked:focus {
    background: var(--primary_light);
}

AlignmentSelector:disabled {
    border: 1px solid var(--border_color);
}

AlignmentSelector::indicator:disabled {
    background: var(--button_bg_disabled);
}

AlignmentSelector::indicator:checked:disabled {
    background: var(--border_color);
}

 QPushButton {
     background-color: var(--button_bg);
     color: var(--on_button);
     border: 2px solid var(--button_bg);
     border-radius: var(--border_radius); /* Propagates 9px rounding globally */
     min-height: var(--button_min_height);
     padding: var(--padding_small) var(--padding_wide);
     margin: var(--spacing_small);
     font-weight: 500;
 }

 QPushButton:flat {
     background: transparent;
     border-color: transparent;
 }

 QPushButton:hover {
     color: var(--button_hover_text);
     border-color: var(--primary);
     background: qradialgradient(
         cx:0.5, cy:0.5, radius: 0.9, fx:0.5, fy:0.5,
         stop:0    var(--button_bg),
         stop:0.5  var(--button_bg),
         stop:1    var(--primary)
     );
 }

 QPushButton:checked {
     background: var(--primary);
     border-color: var(--primary_light);
     color: var(--on_primary);
 }

 QPushButton:checked:hover {
     background: var(--primary_light);
     border-color: var(--primary_lighter);
     color: var(--on_primary_hover);
 }

 QPushButton:pressed {
     background: var(--primary);
     border-color: var(--primary);
     color: var(--on_primary);
 }

 QPushButton:disabled {
     background-color: var(--button_bg_disabled);
     border-color: var(--button_bg_disabled);
     color: var(--on_button_disabled);
 }

 QToolButton,
.btn-tool {
    background-color: var(--button_bg);
    padding: var(--padding_base);
    margin: 0;
    border: 1px solid var(--button_border);
    border-radius: var(--border_radius);
    icon-size: var(--icon_base);
    color: var(--on_button);
}

QToolButton:hover,
QToolButton:focus,
.btn-tool:hover,
.btn-tool:focus {
    background-color: var(--button_bg_hover);
    border-color: var(--button_border_hover);
}

QToolButton:checked,
.btn-tool:checked {
    background-color: var(--button_bg_hover);
    border-color: var(--primary);
    color: var(--button_hover_text);
    font-weight: bold;
}

QToolButton:checked:hover,
QToolButton:checked:focus,
.btn-tool:checked:hover,
.btn-tool:checked:focus {
    border-color: var(--primary_lighter);
}

QToolButton:pressed,
QToolButton:pressed:hover,
.btn-tool:pressed,
.btn-tool:pressed:hover {
    background-color: var(--bg_base);
    border-color: var(--primary);
    color: var(--text);
}

QToolButton:disabled,
.btn-tool:disabled {
    background-color: var(--button_bg_disabled);
    border-color: transparent;
    color: var(--on_button_disabled);
}

QPushButton::menu-indicator {
     image: var(--cw_icon_chevron_down_base);
     subcontrol-position: right center;
     subcontrol-origin: content;
     padding-left: var(--spacing_large);
     padding-right: var(--spacing_large);
 }

/* Small Property Icon Buttons override */
QPushButton[themeID="settingsIconSmall"],
QPushButton[themeID="menuIconSmall"],
QPushButton[themeID="replayIconSmall"] {
    min-height: var(--compact_control_min_height);
    padding: var(--padding_small) var(--padding_large);
    font-size: var(--font_small);
}

QComboBox, QDateTimeEdit, QSpinBox, QDoubleSpinBox, QLineEdit, QPlainTextEdit, QTextEdit {
    min-height: var(--input_min_height);
    padding: var(--padding_small) var(--padding_large);
    border: 2px solid var(--border_base);
    background: var(--bg_input);
    border-radius: var(--border_radius_small);
    margin: var(--spacing_small);
    color: var(--on_input);
    selection-background-color: var(--primary);
    selection-color: var(--on_primary);
}

QSpinBox, QDoubleSpinBox {
    min-height: var(--spinbox_min_height);
    min-width: var(--spinbox_min_width);
}

QComboBox:focus, QDateTimeEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus {
    border: 2px solid var(--border_focus);
    background-color: var(--input_bg_focus);
    color: var(--on_input_focus);
}

QPlainTextEdit:focus, QTextEdit:focus,
QTreeView:focus, QListWidget:focus, QTableView:focus {
    border: 2px solid var(--border_focus);
}

QPlainTextEdit:focus, QTextEdit:focus {
    color: var(--on_input_focus);
}

 QComboBox:hover, QDateTimeEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover {
     background: var(--input_bg_hover);
     border-color: var(--input_border_hover);
     color: var(--on_input_hover);
 }

 QPlainTextEdit:hover,
 QTextEdit:hover {
     background: var(--input_bg_hover);
     border-color: var(--input_border_hover);
     color: var(--on_input_hover);
 }

 QLineEdit:read-only, QDateTimeEdit:read-only, QTextEdit:read-only, QPlainTextEdit:read-only {
     background: var(--bg_base);
     border-color: var(--border_base);
     color: var(--on_base_disabled);
 }

 QTextEdit:!editable, QPlainTextEdit:!editable {
     background: var(--bg_base);
     border-color: var(--border_base);
     color: var(--on_base_disabled);
 }

 QLineEdit:read-only:hover,
 QLineEdit:read-only:focus,
 QTextEdit:!editable:hover,
 QTextEdit:!editable:focus,
 QPlainTextEdit:!editable:hover,
 QPlainTextEdit:!editable:focus {
     background: var(--bg_base);
     border-color: var(--input_border_hover);
 }

/* Dropdown Arrow Area */
QComboBox::drop-down {
    border: none;
    width: var(--input_height);
    background: transparent;
}

QComboBox::down-arrow {
    image: var(--cw_icon_chevron_down_base);
    width: var(--icon_small);
    height: var(--icon_small);
}

/* Spinbox Buttons */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: var(--icon_small);
    height: var(--spinbox_button_height);
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: var(--icon_small);
    height: var(--spinbox_button_height);
    border: none;
    background: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background: var(--button_bg_hover);
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background: var(--button_bg_down);
}

QSpinBox::up-button:disabled,
QSpinBox::up-button:off,
QSpinBox::down-button:disabled,
QSpinBox::down-button:off,
QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:off,
QDoubleSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:off {
    background: var(--button_bg_disabled);
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: var(--cw_icon_arrow_up_base);
    width: 100%;
    margin: 2px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: var(--cw_icon_arrow_down_base);
    width: 100%;
    padding: 2px;
}

QSlider {
    background: transparent;
    /* Allocates room at the edges so the handle does not get clipped at 0% or 100% */
    padding-left: var(--slider_handle_radius);
    padding-right: var(--slider_handle_radius);
}

QSlider:vertical {
    padding-top: var(--slider_handle_radius);
    padding-bottom: var(--slider_handle_radius);
}

QSlider::groove:horizontal {
    background: var(--button_bg);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:horizontal {
    background: var(--primary);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:horizontal {
    background: var(--button_bg);
    height: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:horizontal {
    background: var(--text_bright);
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    margin: var(--slider_handle_margin) 0px;
    border-radius: var(--slider_handle_radius);
}

QSlider::handle:horizontal:hover,
QSlider::handle:vertical:hover {
    background: var(--primary_hover);
}

QSlider::handle:horizontal:pressed,
QSlider::handle:vertical:pressed {
    background: var(--primary);
}

QSlider::sub-page:horizontal:disabled {
    background-color: var(--border_color);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:horizontal:disabled {
    background-color: var(--button_bg_disabled);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:vertical:disabled {
    background-color: var(--border_color);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:vertical:disabled {
    background-color: var(--button_bg_disabled);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:disabled {
    background-color: var(--text_disabled);
}

/* Vertical sliders */
QSlider::groove:vertical {
    background: var(--button_bg);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::add-page:vertical {
    background: var(--primary);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::sub-page:vertical {
    background: var(--primary);
    width: var(--slider_groove_thickness);
    border-radius: var(--slider_groove_radius);
}

QSlider::handle:vertical {
    background: var(--text_bright);
    width: var(--slider_handle_size);
    height: var(--slider_handle_size);
    margin: 0px var(--slider_handle_margin);
    border-radius: var(--slider_handle_radius);
}

QCheckBox, QRadioButton {
    spacing: var(--spacing_large);
    padding: var(--padding_small);
    color: var(--text_base);
}

QCheckBox::indicator, QRadioButton::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
    border: 1px solid var(--border_base);
    border-radius: var(--shape_sm);
    background: var(--bg_base);
}

QRadioButton::indicator {
    border-radius: var(--shape_full);
}

 QCheckBox::indicator:hover, QRadioButton::indicator:hover {
     border-color: var(--primary);
     background: var(--bg_hover);
 }

 QCheckBox::indicator:unchecked:hover, QRadioButton::indicator:unchecked:hover {
     border-color: var(--primary);
     background: var(--bg_hover);
 }

 QCheckBox::indicator:unchecked {
     image: none;
 }

 QCheckBox::indicator:unchecked:disabled, QRadioButton::indicator:unchecked:disabled {
     border-color: var(--button_bg_disabled);
     background: var(--button_bg_disabled);
 }

 QCheckBox::indicator:checked {
     background: var(--bg_base);
     border-color: var(--primary);
     image: var(--checkbox_check_icon);
 }

 QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
     background: var(--bg_base);
     border-color: var(--primary_light);
 }

 QRadioButton::indicator:checked:hover {
     background: var(--primary_light);
 }

 QRadioButton::indicator:checked {
     background: var(--primary);
     border: 3px solid var(--bg_base);
 }

 QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
     border-color: var(--button_bg_disabled);
     background: var(--button_bg_disabled);
 }

 QCheckBox::indicator:checked:disabled, QRadioButton::indicator:checked:disabled {
     background: var(--button_bg_disabled);
     border-color: var(--button_bg_disabled);
     color: var(--text_disabled);
 }

/* Icon-based checkboxes mapping */
QCheckBox[themeID="visibilityCheckBox"]::indicator:unchecked {
    image: var(--icon_eye);
    border: none;
    background: transparent;
}
QCheckBox[themeID="visibilityCheckBox"]::indicator:checked {
    image: var(--icon_eye_off);
    border: none;
    background: transparent;
}
QCheckBox[themeID="lockCheckBox"]::indicator:unchecked {
    image: var(--icon_unlock);
    border: none;
    background: transparent;
}
QCheckBox[themeID="lockCheckBox"]::indicator:checked {
    image: var(--icon_lock);
    border: none;
    background: transparent;
}
QCheckBox[themeID="muteCheckBox"]::indicator:unchecked {
    image: var(--icon_vol_high);
    border: none;
    background: transparent;
}
QCheckBox[themeID="muteCheckBox"]::indicator:checked {
    image: var(--icon_vol_mute);
    border: none;
    background: transparent;
}

OBSBasicStats, OBSBasicFilters, OBSBasicSettings {
    background-color: var(--bg_base);
    color: var(--text_base);
}

OBSBasicStats QLabel {
    background: transparent;
    color: var(--text);
    font-weight: 600;
}

QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget {
    background: transparent;
}

/* Settings scroll contents have autoFillBackground enabled by Qt. Leaving
   their stylesheet background transparent paints black instead of showing
   the dialog's theme surface, especially on light variants. Paint the
   actual page contents; leave unrelated OBS scroll areas untouched. */
OBSBasicSettings QScrollArea > QWidget > QWidget {
    background-color: var(--bg_window);
    background-image: var(--pattern_eyes);
}

QMenu,
QMenu > QMenu {
    background-color: var(--bg_dock);
    border: 1px solid var(--border_base);
    border-bottom: 2px solid var(--elevation_2);
    padding: var(--spacing_base);
}

QMenu::item {
    border: 1px solid transparent;
    padding: var(--padding_large) var(--padding_menu);
    margin: var(--spacing_small);
    border-radius: var(--shape_sm);
    color: var(--text_base);
}

QMenu::item:selected {
    background-color: var(--primary);
    color: var(--on_primary);
}

QMenu::item:disabled {
    color: var(--on_panel_disabled);
}

QMenu::separator {
    height: 1px;
    background: var(--border_base);
    margin: var(--spacing_base) var(--spacing_large);
}

QMenu::icon {
    padding-left: var(--padding_large);
}

QDockWidget {
    titlebar-close-icon: var(--icon_dock_close);
    titlebar-normal-icon: var(--icon_dock_popout);
}

QDockWidget::title {
    padding: var(--padding_base) var(--padding_large);
    font-size: var(--font_small);
    font-weight: bold;
    background: var(--surface1);
    color: var(--primary);
    border-bottom: 2px solid var(--border_base);
}

QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    border-radius: var(--border_radius_small);
    background: transparent;
    padding: var(--padding_small);
    icon-size: var(--icon_small);
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: var(--bg_base);
}

QListWidget, QTreeView, QTableView {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
    border: 1px solid var(--border_base);
    color: var(--text_base);
    border-radius: var(--border_radius_small);
    outline: none;
    selection-background-color: var(--primary);
    selection-color: var(--on_primary);
    show-decoration-selected: 1;
    gridline-color: var(--border_color);
}

QListWidget::item, QTreeView::item {
    border: 1px solid transparent;
    padding: var(--padding_base) var(--padding_large);
    min-height: var(--compact_control_min_height);
    margin: 0px;
    border-radius: var(--border_radius_small);
    background-color: transparent;
}

QListWidget::item:alternate, QTreeView::item:alternate {
    background-color: var(--bg_hover);
}

QListWidget::item:selected, QTreeView::item:selected {
    background: var(--primary);
    color: var(--on_primary);
}

QListWidget::item:hover:!selected, QTreeView::item:hover:!selected {
    background: var(--list_item_bg_hover);
    color: var(--on_list_hover);
}

/* Tree View Branches */
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    image: var(--icon_tree_closed);
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
    image: var(--icon_tree_open);
}

/* Table Headers */
QHeaderView::section {
    background-color: var(--bg_dock);
    color: var(--on_panel_muted);
    border: none;
    border-bottom: 1px solid var(--border_base);
    border-right: 1px solid var(--border_base);
    padding: var(--padding_base) var(--padding_large);
    font-weight: bold;
    font-size: var(--font_small);
}

QHeaderView::section:hover {
    background: var(--bg_hover);
    color: var(--on_hover);
}

QScrollBar:vertical {
    background: var(--bg_base);
    width: var(--scrollbar_size);
    margin: 0px;
    border-radius: var(--border_radius);
}

QScrollBar::handle:vertical {
    background: var(--scrollbar_handle);
    min-height: 20px;
    border-radius: var(--scrollbar_handle_radius);
    margin: 1px;
}

 QScrollBar::handle:vertical:hover {
     background: var(--scrollbar_hover);
 }

 QScrollBar::handle:vertical:pressed {
     background: var(--scrollbar_down);
 }

QScrollBar::handle:vertical:disabled {
    background: transparent;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: var(--bg_base);
    height: var(--scrollbar_size);
    margin: 0px;
    border-radius: var(--border_radius);
}

QScrollBar::handle:horizontal {
    background: var(--scrollbar_handle);
    min-width: 20px;
    border-radius: var(--scrollbar_handle_radius);
    margin: 1px;
}

 QScrollBar::handle:horizontal:hover {
     background: var(--scrollbar_hover);
 }

 QScrollBar::handle:horizontal:pressed {
     background: var(--scrollbar_down);
 }

QScrollBar::handle:horizontal:disabled {
    background: transparent;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

QTabBar {
    outline: none;
    font-size: var(--font_small);
}

QTabBar::tab:top {
    border-top-left-radius: var(--shape_sm);
    border-top-right-radius: var(--shape_sm);
}

QTabBar::tab:bottom {
    border-bottom-left-radius: var(--shape_sm);
    border-bottom-right-radius: var(--shape_sm);
}

QTabWidget::pane {
    border: 1px solid var(--border_base);
    background: var(--surface1);
    top: -1px;
}

QTabBar::tab {
    background: var(--bg_base);
    color: var(--on_base_muted);
    padding: var(--padding_base) var(--padding_large);
    min-width: 50px;
    border-top-left-radius: var(--shape_sm);
    border-top-right-radius: var(--shape_sm);
    margin-right: 2px;
    font-size: var(--font_small);
}

QTabBar::tab:selected {
    background: var(--surface1);
    color: var(--on_panel_accent);
    border-bottom: 2px solid var(--primary);
    font-weight: bold;
}

QTabBar::tab:bottom {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: var(--shape_sm);
    border-bottom-right-radius: var(--shape_sm);
}

QTabBar::tab:bottom:selected {
    border-bottom: 1px solid var(--tab_bg);
    border-top: 2px solid var(--primary);
}

QTabBar::tab:hover:!selected {
    background: var(--surface2);
    color: var(--on_nav_hover);
    border-bottom: 2px solid var(--border_base);
}

QTabBar::tab:bottom:hover:!selected {
    border-bottom: 1px solid var(--tab_bg);
    border-top: 2px solid var(--border_base);
}

QTabBar::tab:pressed {
    background: var(--tab_bg_down);
}

QTabBar::tab:focus {
    border-color: var(--tab_border_focus);
}

QTabBar QToolButton {
    background: var(--button_bg);
    border: none;
    border-radius: var(--border_radius_small);
    min-width: 16px;
    padding: 0px;
}

QGroupBox {
    background: var(--surface1);
    border: 1px solid var(--border_base);
    border-radius: var(--shape_md);
    margin-top: var(--group_title_margin);
    padding: var(--padding_large);
    font-size: var(--font_base);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: var(--spacing_title);
    padding: 0 var(--padding_large);
    color: var(--on_section_heading);
    font-weight: bold;
    font-size: var(--font_small);
}

QGroupBox::indicator {
    width: var(--icon_base);
    height: var(--icon_base);
    margin-right: var(--spacing_large);
    background: var(--bg_base);
}

QGroupBox::indicator:unchecked {
    image: var(--cw_icon_checkbox_line_base);
}

QGroupBox::indicator:unchecked:hover {
    image: var(--cw_icon_checkbox_line_base);
    border: 1px solid var(--primary);
}

QGroupBox::indicator:checked {
    image: var(--cw_icon_checkbox_fill_base);
}

QGroupBox::indicator:checked:hover {
    image: var(--cw_icon_checkbox_fill_base);
    background: var(--bg_base);
}

QGroupBox::indicator:unchecked:disabled {
    image: var(--cw_icon_checkbox_line_base);
    border: 1px solid var(--button_bg_disabled);
}

QGroupBox::indicator:checked:disabled {
    image: var(--cw_icon_checkbox_fill_base);
    background: var(--button_bg_disabled);
    border: 1px solid var(--button_bg_disabled);
}

QToolTip {
    background-color: var(--surface2);
    color: var(--on_preview);
    border: 1px solid var(--primary);
    border-radius: var(--shape_sm);
    padding: var(--padding_base) var(--padding_large);
    font-size: var(--font_small);
}

QStatusBar {
    background: var(--bg_dock);
    border-top: 1px solid var(--border_base);
    color: var(--on_panel_muted);
    font-size: var(--font_small);
}

QStatusBar::item {
    border: none;
}

QMainWindow::separator {
    background: var(--border_base);
    width: 3px;
    height: 3px;
}

QMainWindow::separator:hover {
    background: var(--primary);
}

QSplitter::handle {
    background: var(--border_base);
}

QSplitter::handle:hover {
    background: var(--primary);
}

QToolBar {
    border: none;
    spacing: var(--spacing_small);
    padding: var(--padding_base);
    background: var(--bg_dock);
}

QToolBar QToolButton {
    background: transparent;
    border: none;
    padding: var(--padding_small);
    margin: 1px;
    border-radius: var(--border_radius_small);
}

QToolBar QToolButton:hover {
    background: var(--bg_hover);
}

QToolBar QToolButton:pressed {
    background: var(--primary);
}

OBSPropertiesView {
    min-height: var(--input_min_height);
}

OBSPropertiesView QLabel {
    margin-bottom: 0px;
    padding: 1px 0px;
    font-size: var(--font_base);
}

OBSPropertiesView QWidget {
    margin-bottom: var(--spacing_small);
}

OBSPropertiesView QPushButton,
OBSPropertiesView QComboBox,
OBSPropertiesView QSpinBox,
OBSPropertiesView QLineEdit {
    margin: var(--spacing_base) 0px;
}

OBSPropertiesView IconLabel {
    margin-left: var(--spacing_large);
}

OBSPropertiesView QSlider:horizontal {
    min-height: var(--properties_slider_min_height);
    padding-left: var(--slider_handle_radius);
    padding-right: var(--slider_handle_radius);
    padding-top: var(--slider_handle_radius);
    padding-bottom: var(--slider_handle_radius);
}

OBSBasicSettings QListWidget {
    background-color: var(--bg_dock);
    background-image: var(--pattern_eyes);
    border: none;
    border-right: 1px solid var(--border_base);
    outline: none;
    padding: var(--padding_container) 0px;
    font-weight: bold;
    min-width: 140px;
}

OBSBasicSettings {
    qproperty-generalIcon: var(--cw_icon_settings_base);
    qproperty-appearanceIcon: var(--cw_icon_brush_base);
    qproperty-streamIcon: var(--cw_icon_output_base);
    qproperty-outputIcon: var(--cw_icon_media_play_base);
    qproperty-audioIcon: var(--cw_icon_audio_base);
    qproperty-videoIcon: var(--cw_icon_display_base);
    qproperty-hotkeysIcon: var(--cw_icon_gamepad_base);
    qproperty-accessibilityIcon: var(--cw_icon_eye_base);
    qproperty-advancedIcon: var(--cw_icon_cogs_base);
}

OBSBasicSettings QListWidget::item {
    padding: var(--padding_large) var(--padding_xlarge);
    margin: 0px var(--spacing_small) var(--spacing_small) var(--spacing_small);
    color: var(--on_panel_muted);
    border-radius: var(--shape_md);
}

OBSBasicSettings QListWidget::item:hover {
    background-color: var(--surface2);
    color: var(--on_nav_hover);
}

OBSBasicSettings QListWidget::item:selected {
    background-color: var(--primary);
    color: var(--on_primary);
}

OBSBasicSettings QLabel {
    color: var(--text_base);
}

OBSBasicSettings QGroupBox::title {
    color: var(--on_section_heading);
}

/* Settings group panels use --bg_dock, not --bg_base. With some curated
   palettes the original muted/disabled ink was effectively invisible there. */
OBSBasicSettings QGroupBox QLabel,
OBSBasicSettings QGroupBox QCheckBox,
OBSBasicSettings QGroupBox QRadioButton {
    color: var(--on_panel);
}

OBSBasicSettings QGroupBox QLabel:disabled,
OBSBasicSettings QGroupBox QCheckBox:disabled,
OBSBasicSettings QGroupBox QRadioButton:disabled {
    color: var(--on_panel_disabled);
}

/* Preserve unmistakable checkbox and radio shapes when panel and base
   backgrounds are very similar, without changing their semantic state. */
OBSBasicSettings QGroupBox QCheckBox::indicator:unchecked,
OBSBasicSettings QGroupBox QRadioButton::indicator:unchecked {
    border: 2px solid var(--on_panel_outline);
}
OBSBasicSettings QGroupBox QCheckBox::indicator:unchecked:disabled,
OBSBasicSettings QGroupBox QRadioButton::indicator:unchecked:disabled {
    border: 2px solid var(--on_panel_outline);
}
OBSBasicSettings QGroupBox QCheckBox::indicator:checked,
OBSBasicSettings QGroupBox QRadioButton::indicator:checked {
    border: 2px solid var(--on_panel_accent);
}
OBSBasicSettings QGroupBox QCheckBox::indicator:checked:disabled,
OBSBasicSettings QGroupBox QRadioButton::indicator:checked:disabled {
    border: 2px solid var(--on_panel_outline);
}

/* Link Colors */
QLabel[openExternalLinks="true"] {
    color: var(--palette_link);
}

OBSBasicFilters QListWidget {
    background-color: var(--bg_dock);
    background-image: var(--pattern_eyes);
    border: 1px solid var(--border_base);
    color: var(--text_base);
    border-radius: var(--border_radius_small);
}

OBSBasicFilters QListWidget::item {
    padding: var(--padding_base) var(--padding_large);
    margin: 1px;
}

OBSBasicFilters QListWidget::item:selected {
    background: var(--primary);
    color: var(--on_primary);
}

OBSLogViewer {
    background: var(--bg_base);
}

OBSLogViewer QTextEdit, OBSLogViewer QPlainTextEdit {
    background-color: var(--bg_preview);
    color: var(--text);
    border: 1px solid var(--border_base);
    border-radius: var(--border_radius_small);
    font-family: 'Consolas', 'Courier New', 'Monaco', monospace;
    font-size: var(--font_small);
    padding: var(--padding_large);
    margin: var(--padding_xlarge);
}

VolumeMeter {
    qproperty-backgroundNominalColor: var(--meter_bg_nom);
    qproperty-backgroundWarningColor: var(--meter_bg_war);
    qproperty-backgroundErrorColor: var(--meter_bg_err);
    qproperty-foregroundNominalColor: var(--meter_fg_nom);
    qproperty-foregroundWarningColor: var(--meter_fg_war);
    qproperty-foregroundErrorColor: var(--meter_fg_err);
    qproperty-magnitudeColor: var(--text_bright);
    qproperty-majorTickColor: var(--text_bright);
    qproperty-minorTickColor: var(--text_disabled);
}

QProgressBar {
    border: 1px solid var(--border_base);
    border-radius: var(--shape_full);
    text-align: center;
    background: var(--bg_base);
    color: var(--text_base);
    height: 18px;
}

QProgressBar::chunk {
    background: var(--primary);
    border-radius: var(--shape_full);
}

*[themeID="propertiesIconSmall"], *[themeID="configIconSmall"] { qproperty-icon: var(--cw_icon_cogs_base); }

QTextBrowser {
    background-color: var(--bg_dock);
    color: var(--text_base);
    border: 1px solid var(--border_base);
    border-radius: var(--border_radius_small);
    padding: var(--padding_large);
}

QTextBrowser a {
    color: var(--palette_link);
}

QWidget {
    alternate-background-color: var(--bg_base);
    color: var(--text);
    selection-background-color: var(--primary);
    selection-color: var(--on_primary);
    font-size: var(--font_base);
    font-weight: normal;
    font-family: 'Bricolage Grotesque', '.AppleSystemUIFont', 'Segoe UI', 'DejaVu Sans', Helvetica, Arial, sans-serif;
}

QWidget:disabled {
    color: var(--on_base_disabled);
}

/* Container windows */

QDialog,
QMainWindow,
QMessageBox,
QStatusBar,
QMenuBar,

OBSBasic,
QDialog {
    background-color: var(--bg_window);
    background-image: var(--pattern_eyes);
}

/* Central widget of the main window */
OBSBasic > QWidget {
    background: transparent;
    background-image: var(--pattern_eyes);
}

/* General Widgets */

QLabel,

QListView QWidget,
QListWidget QWidget {
    margin-top: 0;
    margin-bottom: 0;
}

* [frameShape="1"],
* [frameShape="2"],
* [frameShape="3"],
* [frameShape="4"],
* [frameShape="5"],
* [frameShape="6"] {
    border: 1px solid var(--bg_base);
}

/* Misc: item views only. Checkbox, group box and menu bar backgrounds
   are governed by their own selectors, not by the item-view pattern. */
QAbstractItemView {
    background-color: var(--bg_base);
    background-image: var(--pattern_eyes);
}

/* Context Menu */
QMenu::indicator {
    left: var(--padding_large);
}

QMenu::right-arrow {
    image: var(--cw_icon_chevron_right_base);
}

QMenu::right-arrow:selected {
    image: var(--cw_icon_chevron_right_primary);
}

QMenu::right-arrow:selected:hover {
    image: var(--cw_icon_chevron_right_primary_hover);
}

/* Top Menu Bar Items */
QMenuBar::item {
    background-color: transparent;
    padding: var(--padding_large) var(--padding_menubar);
}

QMenuBar::item:selected {
    background: var(--primary);
    color: var(--on_primary);
}

/* Toolbars */

QToolBar::separator {
    background: var(--border_color);
    width: 1px;
    margin: 0px var(--spacing_base) 0px;
}

QListWidget::item,
SourceTreeItem {
    border: 1px solid transparent;
    padding: var(--padding_large) var(--padding_large);
}

SourceTreeItem {
    border-radius: var(--border_radius);
    color: var(--text);
}

/* Temporary fix for plugins affected by fix in #11555 */
QListView::item,
QListWidget::item,
SourceTreeItem {
    min-height: var(--padding_menu);
    border: 1px solid transparent;
}

SourceTreeItem .checkbox-icon {
    margin-right: 0;
    margin-left: var(--spacing_large);
}

SourceTree .indicator-expand {
    margin-right: var(--spacing_large);
    margin-left: 0;
}

QMenu::item:selected,
QMenu > QWidget:selected,
QListView::item:selected,
QListWidget::item:selected,
SourceTreeItem:selected {
    background-color: var(--primary);
    border-color: var(--primary_light);
    color: var(--on_primary);
}

QMenu::item:hover,
QListView::item:hover,
QListWidget::item:hover,
SourceTreeItem:hover {
    background: var(--list_item_bg_hover);
    border: 1px solid var(--border_base);
}

QMenu::item:focus,
QListView::item:focus,
QListWidget::item:focus,
SourceTreeItem:focus,
QMenu::item:selected:focus,
QListView::item:selected:focus,
QListWidget::item:selected:focus {
    border: 1px solid var(--primary_lighter);
}

QMenu::item:selected:hover,
QListView::item:selected:hover,
QListWidget::item:selected:hover,
QTreeView::item:selected:hover,
SourceTreeItem:selected:hover {
    background: var(--primary_light);
    border: 1px solid var(--primary_lighter);
    color: var(--on_primary_hover);
}

QListView::item:disabled,
QListView::item:disabled:hover,
QListWidget::item:disabled,
QListWidget::item:disabled:hover {
    background: transparent;
    color: var(--on_base_disabled);
}

QListView QLineEdit,
QListWidget QLineEdit {
    padding: 0;
    padding-bottom: 1px;
    margin: 0;
    border: var(--input_border_width) solid var(--input_border);
    border-radius: var(--border_radius);
}

QListView QLineEdit:focus,
QListWidget QLineEdit:focus {
    border: 1px solid var(--input_border_focus);
}

/* Settings QList */

OBSBasicSettings QScrollBar:vertical {
    width: var(--settings_scrollbar_size);
    margin-left: 9px;
}

OBSBasicSettings QScrollBar:horizontal {
    height: var(--settings_scrollbar_size);
}

/* Settings properties view */
OBSBasicSettings #PropertiesContainer {
    background-color: var(--bg_base);
}

/* Dock Widget */
OBSDock > QWidget {
    background: var(--surface1);
    background-image: var(--pattern_eyes);
    border-bottom-left-radius: var(--shape_lg);
    border-bottom-right-radius: var(--shape_lg);
    border: 1px solid var(--border_color);
    border-top: none;
}

OBSDock QToolBar {
    padding: 1px;
    margin: 0px;
    height: 32px;
    max-height: 32px;
    border-top: 1px solid var(--border_color);
    spacing: 0;
}

OBSDock QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--border_radius_small);
    margin: 1px;
    margin-top: 2px;
    padding: var(--padding_large);
    max-width: var(--icon_small);
    max-height: var(--icon_small);
}

OBSDock QToolBar QToolButton:hover {
    border-color: var(--input_border_hover);
}

OBSDock QToolBar QToolButton:disabled {
    background: var(--button_bg_disabled);
}

#transitionsFrame {
    padding: var(--padding_container);
}

OBSDock QLabel {
    background: transparent;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background: var(--button_bg_down);
    padding: 1px -1px -1px 1px;
}

QAbstractScrollArea {
    border-radius: var(--border_radius);
}

/* Status Bar Widget Formatting */
OBSBasicStatusBar {
    margin-top: var(--spacing_large);
    border-top: 1px solid var(--border_color);
    background: var(--bg_base);
}

StatusBarWidget > QFrame {
    border: 0px solid var(--border_color);
    border-left-width: 1px;
    padding: 0px var(--padding_xlarge) var(--padding_small);
}

/* ScrollBars */

::corner {
    background-color: var(--bg_window);
    border: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,

QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
    background: transparent;
}

QScrollBar::handle:pressed {
    background-color: var(--scrollbar_down);
    border-color: var(--scrollbar_down);
}

QScrollBar::handle:disabled {
    background: transparent;
    border-color: transparent;
}

OBSDock QScrollBar {
    border-radius: var(--border_radius_small);
}

OBSDock QListWidget::corner {
    background: transparent;
    border-top: 1px solid var(--border_color);
    border-left: 1px solid var(--border_color);
}

OBSDock QScrollBar:horizontal {
    border-top: 1px solid var(--border_color);
}

OBSDock QScrollBar:vertical {
    border-left: 1px solid var(--border_color);
}

/* Source Context Bar */

#contextContainer {
    background-color: var(--surface1);
    margin-top: 4px;
    border-radius: var(--shape_md);
}

#contextContainer QPushButton {
    padding-left: 12px;
    padding-right: 12px;
}

QPushButton#sourcePropertiesButton {
    icon-size: var(--icon_base);
}

QPushButton#sourceFiltersButton {
    icon-size: var(--icon_base);
}

QToolBarExtension {
    background: var(--button_bg);
    min-width: 12px;
    max-width: 12px;
    padding: 4px 0px;
    margin-left: 0px;

}

/* Tab Widget */

QTabBar {
    outline: none;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab:top {
    margin-bottom: 0px;
}

QTabBar::tab:bottom {
    margin-top: 0px;
}

/* ComboBox */

QComboBox QAbstractItemView {
    padding: var(--spacing_base) var(--spacing_large);
    border: 1px solid var(--border_color);
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: var(--padding_large) var(--padding_xlarge);
    border-radius: var(--shape_sm);
}

QComboBox QAbstractItemView::item:selected {
    background-color: var(--primary);
    color: var(--on_primary);
}

QComboBox QAbstractItemView::item:hover {
    background-color: var(--primary_light);
    color: var(--on_primary_hover);
}

QComboBox:hover,
QDateTimeEdit:hover,
QDateTimeEdit:selected {
    background-color: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

QComboBox:focus,
QDateTimeEdit:focus {
    background-color: var(--input_bg_focus);
    border-color: var(--border_focus);
}

QComboBox:on {
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    border: none;
    border-left: 1px solid var(--border_color);
    width: var(--input_height);
}

QComboBox::down-arrow{
    image: var(--cw_icon_chevron_down_base);
}

QComboBox:editable:hover {
    background-color: var(--input_bg_hover);
    border-color: var(--input_border_hover);
}

QComboBox:on,
QDateTimeEdit:on,
QComboBox:editable:focus {
    background-color: var(--input_bg_focus);
    border-color: var(--input_border_focus);
}

QComboBox::drop-down:editable,
QDateTimeEdit::drop-down:editable {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow:editable,
QDateTimeEdit::down-arrow:editable {
    image: var(--cw_icon_chevron_down_base);
    width: 100%;
}

/* Controls Dock */
#controlsFrame {
    padding: var(--padding_container);
}

/* colorway:button-icons:start — generated render-time QPushButton icons */
QPushButton.icon-plus, QPushButton.icon-plus:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_plus_base); }
QPushButton.icon-plus:checked, QPushButton.icon-plus:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_plus_primary); }
QPushButton.icon-plus:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_plus_primary_hover); }
QPushButton.icon-plus:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-plus, QToolButton.icon-plus:hover, QToolButton.icon-plus:checked, QToolButton.icon-plus:pressed { background: var(--bg_base); color: var(--text); }
QToolButton.icon-plus:checked, QToolButton.icon-plus:pressed { border-color: var(--primary); }
QPushButton.icon-minus, QPushButton.icon-minus:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_minus_base); }
QPushButton.icon-minus:checked, QPushButton.icon-minus:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_minus_primary); }
QPushButton.icon-minus:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_minus_primary_hover); }
QPushButton.icon-minus:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-minus, QToolButton.icon-minus:hover, QToolButton.icon-minus:checked, QToolButton.icon-minus:pressed { background: var(--bg_base); color: var(--text); }
QToolButton.icon-minus:checked, QToolButton.icon-minus:pressed { border-color: var(--primary); }
QPushButton.icon-trash, QPushButton.icon-trash:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_trash_base); }
QPushButton.icon-trash:checked, QPushButton.icon-trash:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_trash_primary); }
QPushButton.icon-trash:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_trash_primary_hover); }
QPushButton.icon-trash:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-trash, QToolButton.icon-trash:hover, QToolButton.icon-trash:checked, QToolButton.icon-trash:pressed { background: var(--bg_base); color: var(--text); }
QToolButton.icon-trash:checked, QToolButton.icon-trash:pressed { border-color: var(--primary); }
QPushButton.icon-clear, QPushButton.icon-clear:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_close_base); }
QPushButton.icon-clear:checked, QPushButton.icon-clear:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_close_primary); }
QPushButton.icon-clear:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_close_primary_hover); }
QPushButton.icon-clear:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-clear, QToolButton.icon-clear:hover, QToolButton.icon-clear:checked, QToolButton.icon-clear:pressed { background: var(--bg_base); color: var(--text); }
QToolButton.icon-clear:checked, QToolButton.icon-clear:pressed { border-color: var(--primary); }
QPushButton.icon-gear, QPushButton.icon-gear:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_settings_base); }
QPushButton.icon-gear:checked, QPushButton.icon-gear:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_settings_primary); }
QPushButton.icon-gear:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_settings_primary_hover); }
QPushButton.icon-gear:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-gear, QToolButton.icon-gear:hover, QToolButton.icon-gear:checked, QToolButton.icon-gear:pressed { background: var(--bg_base); color: var(--text); }
QToolButton.icon-gear:checked, QToolButton.icon-gear:pressed { border-color: var(--primary); }
QPushButton.icon-dots-vert, QPushButton.icon-dots-vert:hover { background: var(--bg_base); color: var(--text); icon: var(--cw_icon_dots_vert_base); }
QPushButton.icon-dots-vert:checked, QPushButton.icon-dots-vert:pressed { background: var(--primary); color: var(--on_primary); icon: var(--cw_icon_dots_vert_primary); }
QPushButton.icon-dots-vert:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_dots_vert_primary_hover); }
QPushButton.icon-dots-vert:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton.icon-dots-vert, QToolButton.icon-dots-vert:hover, QToolButton.icon-dots-vert:checked, QToolButton.icon-dots-vert:pressed { background: var(--bg_base); color: var(--text); }
