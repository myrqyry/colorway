QPushButton[themeID="refreshIconSmall"]:checked:hover:!pressed { background: var(--primary_light); color: var(--on_primary_hover); icon: var(--cw_icon_refresh_primary_hover); }
QPushButton[themeID="refreshIconSmall"]:disabled { background: var(--button_bg_disabled); color: var(--on_button_disabled); }
QToolButton[themeID="refreshIconSmall"], QToolButton[themeID="refreshIconSmall"]:hover, QToolButton[themeID="refreshIconSmall"]:checked, QToolButton[themeID="refreshIconSmall"]:pressed { background: var(--bg_base); color: var(--text); }
QToolButton[themeID="refreshIconSmall"]:checked, QToolButton[themeID="refreshIconSmall"]:pressed { border-color: var(--primary); }
/* colorway:button-icons:end */
