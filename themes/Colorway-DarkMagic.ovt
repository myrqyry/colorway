@OBSThemeMeta {
    name: 'Dark Magic';
    id: 'com.myrqyry.Colorway.DarkMagic';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Dark Magic
       Hex colors:
       --bg_window: #0f0f17;
       --bg_base: #0f0f17;
       --bg_preview: #17171f;
       --bg_dock: #17171f;
       --bg_hover: #2f2f40;
       --text: #e7eeec;
       --text_light: #fafffe;
       --text_muted: #828b9c;
       --text_inactive: #5B606C;
       --text_inverse: #FFFFFF;
       --text_disabled: #5B606C;
       --primary: #66eeaa;
       --primary_light: #b4f09e;
       --primary_lighter: #bfffa8;
       --primary_dark: #2f2f40;
       --primary_darker: #17171f;
       --input_bg: #17171f;
       --input_bg_hover: #2f2f40;
       --input_bg_focus: #272733;
       --input_border: #2f2f40;
       --input_border_hover: #5a66ee;
       --button_bg: #17171f;
       --button_bg_hover: #2f2f40;
       --button_bg_disabled: #0f0f17;
       --list_item_bg_hover: #2f2f40;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #2f2f40;
       --ico: #e7eeec;
       --ico_selected: #0f0f17;
       --warning: #c7c56c;
       --danger: #db6797;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(102, 238, 170, 0.3);
       --accent_bg_end: rgba(102, 238, 170, 0.1);
    */

    --bg_window: #0f0f17;
    --bg_base: #0f0f17;
    --bg_preview: #17171f;

    
    --primary: #66eeaa;        
    --primary_light: #b4f09e;  
    --primary_lighter: #bfffa8;
    --primary_dark: #2f2f40;   
    --primary_darker: #17171f; 

    --warning: #c7c56c; 
    --danger: #db6797;  

    
    --text: #e7eeec;        
    --text_light: #fafffe;
    --text_muted: #828b9c;  

    --text_disabled: #5B606C; 
    --text_inactive: #5B606C;
    --text_inverse: #FFFFFF;

    --border_color: #2f2f40;

    
    --input_bg: #17171f;
    --input_bg_hover: #2f2f40;
    --input_bg_focus: #272733;

    --list_item_bg_hover: #2f2f40;

    --input_border: #2f2f40;
    --input_border_hover: #5a66ee;

    --button_bg: #17171f;
    --button_bg_hover: #2f2f40;
    --button_bg_disabled: #0f0f17;

    
    
    --accent_bg_start: 'rgba(102, 238, 170, 0.3)';
    --accent_bg_end: 'rgba(102, 238, 170, 0.1)';

    --bg_dock: #17171f;
    --bg_hover: #2f2f40;

    
    --ico: var(--text);
    --ico_selected: #0f0f17;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #e7eeec;
    --on_panel_muted: #828b9c;
    --on_base_muted: #828b9c;
    --on_preview_muted: #828b9c;
    --on_preview: #fafffe;
    --on_list_hover: #fafffe;
    --on_hover: #fafffe;
    --on_panel_disabled: #5f646f;
    --on_base_disabled: #5B606C;
    --on_panel_outline: #63636f;
    --on_section_heading: #66eeaa;
    --on_panel_accent: #66eeaa;
    --on_button: #e7eeec;
    --on_button_disabled: #5B606C;
    --on_input: #e7eeec;
    --on_input_hover: #e7eeec;
    --on_input_focus: #e7eeec;
    --on_nav_hover: #fafffe;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    /* colorway:state-tokens:end */

}