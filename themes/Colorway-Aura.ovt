@OBSThemeMeta {
    name: 'Aura';
    id: 'com.myrqyry.Colorway.Aura';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Aura
       Hex colors:
       --bg_window: #15141b;
       --bg_base: #15141b;
       --bg_preview: #2c2c32;
       --bg_dock: #14131a;
       --bg_hover: #37373c;
       --text: #edecee;
       --text_light: #ffffff;
       --text_muted: #6d6a7e;
       --text_inactive: #5d5a6b;
       --text_inverse: #FFFFFF;
       --text_disabled: #5d5a6b;
       --primary: #a277ff;
       --primary_light: #82e2ff;
       --primary_lighter: #ff6767;
       --primary_dark: #61ffca;
       --primary_darker: #6d6a7e;
       --input_bg: #2c2c32;
       --input_bg_hover: #37373c;
       --input_bg_focus: #37373c;
       --input_border: #28272d;
       --input_border_hover: #a277ff;
       --button_bg: #14131a;
       --button_bg_hover: #37373c;
       --button_bg_disabled: #15141b;
       --list_item_bg_hover: #37373c;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #28272d;
       --ico: #edecee;
       --ico_selected: #15141b;
       --warning: #ffca85;
       --danger: #ff6767;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(162, 119, 255, 0.3);
       --accent_bg_end: rgba(162, 119, 255, 0.1);
    */

    --accent_bg_start: rgba(162, 119, 255, 0.3);
    --accent_bg_end: rgba(162, 119, 255, 0.1);

    
    --bg_window: #15141b;
    --bg_base: #15141b;
    --bg_preview: #2c2c32;

    --primary: #a277ff;
    --primary_light: #82e2ff;
    --primary_lighter: #ff6767;
    --primary_dark: #61ffca;
    --primary_darker: #6d6a7e;

    --warning: #ffca85;
    --danger: #ff6767;

    --text: #edecee;
    --text_light: #ffffff;
    --text_muted: #6d6a7e;

    --text_disabled: #5d5a6b;
    --text_inactive: #5d5a6b;
    --text_inverse: #FFFFFF;

    --border_color: #28272d;

    
    --input_bg: #2c2c32;
    --input_bg_hover: #37373c;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #37373c;

    --input_border: #28272d;
    --input_border_hover: #a277ff;

    --button_bg: #14131a;
    --button_bg_hover: #37373c;
    --button_bg_disabled: #15141b;

    
    --bg_dock: #14131a;
    --bg_hover: #37373c;

    
    --ico: var(--text);
    --ico_selected: #15141b;

}
