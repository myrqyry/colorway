@OBSThemeMeta {
    name: 'Lucent Orng';
    id: 'com.myrqyry.Colorway.Lucent-orng';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Lucent Orng
       Hex colors:
       --bg_window: #2a1a15;
       --bg_base: #2a1a15;
       --bg_preview: #3f312c;
       --bg_dock: #281914;
       --bg_hover: #493b37;
       --text: #eeeeee;
       --text_light: #ffffff;
       --text_muted: #808080;
       --text_inactive: #6d6d6d;
       --text_inverse: #FFFFFF;
       --text_disabled: #6d6d6d;
       --primary: #EC5B2B;
       --primary_light: #56b6c2;
       --primary_lighter: #FFF7F1;
       --primary_dark: #6ba1e6;
       --primary_darker: #808080;
       --input_bg: #3f312c;
       --input_bg_hover: #493b37;
       --input_bg_focus: #493b37;
       --input_border: #3b2c28;
       --input_border_hover: #EC5B2B;
       --button_bg: #281914;
       --button_bg_hover: #493b37;
       --button_bg_disabled: #2a1a15;
       --list_item_bg_hover: #493b37;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #3b2c28;
       --ico: #eeeeee;
       --ico_selected: #2a1a15;
       --warning: #EC5B2B;
       --danger: #e06c75;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(236, 91, 43, 0.3);
       --accent_bg_end: rgba(236, 91, 43, 0.1);
    */

    --accent_bg_start: rgba(236, 91, 43, 0.3);
    --accent_bg_end: rgba(236, 91, 43, 0.1);

    
    --bg_window: #2a1a15;
    --bg_base: #2a1a15;
    --bg_preview: #3f312c;

    --primary: #EC5B2B;
    --primary_light: #56b6c2;
    --primary_lighter: #FFF7F1;
    --primary_dark: #6ba1e6;
    --primary_darker: #808080;

    --warning: #EC5B2B;
    --danger: #e06c75;

    --text: #eeeeee;
    --text_light: #ffffff;
    --text_muted: #808080;

    --text_disabled: #6d6d6d;
    --text_inactive: #6d6d6d;
    --text_inverse: #FFFFFF;

    --border_color: #3b2c28;

    
    --input_bg: #3f312c;
    --input_bg_hover: #493b37;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #493b37;

    --input_border: #3b2c28;
    --input_border_hover: #EC5B2B;

    --button_bg: #281914;
    --button_bg_hover: #493b37;
    --button_bg_disabled: #2a1a15;

    
    --bg_dock: #281914;
    --bg_hover: #493b37;

    
    --ico: var(--text);
    --ico_selected: #2a1a15;

}
