@OBSThemeMeta {
    name: 'Mercury';
    id: 'com.myrqyry.Colorway.Mercury';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Mercury
       Hex colors:
       --bg_window: #171721;
       --bg_base: #171721;
       --bg_preview: #2e2e37;
       --bg_dock: #16161f;
       --bg_hover: #383841;
       --text: #dddde5;
       --text_light: #ffffff;
       --text_muted: #9d9da8;
       --text_inactive: #85858f;
       --text_inverse: #FFFFFF;
       --text_disabled: #85858f;
       --primary: #8da4f5;
       --primary_light: #77becf;
       --primary_lighter: #8da4f5;
       --primary_dark: #77c599;
       --primary_darker: #9d9da8;
       --input_bg: #2e2e37;
       --input_bg_hover: #383841;
       --input_bg_focus: #383841;
       --input_border: #2a2a33;
       --input_border_hover: #8da4f5;
       --button_bg: #16161f;
       --button_bg_hover: #383841;
       --button_bg_disabled: #171721;
       --list_item_bg_hover: #383841;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #2a2a33;
       --ico: #dddde5;
       --ico_selected: #171721;
       --warning: #fc9b6f;
       --danger: #fc92b4;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(141, 164, 245, 0.3);
       --accent_bg_end: rgba(141, 164, 245, 0.1);
    */

    --accent_bg_start: 'rgba(141, 164, 245, 0.3)';
    --accent_bg_end: 'rgba(141, 164, 245, 0.1)';

    
    --bg_window: #171721;
    --bg_base: #171721;
    --bg_preview: #2e2e37;

    --primary: #8da4f5;
    --primary_light: #77becf;
    --primary_lighter: #8da4f5;
    --primary_dark: #77c599;
    --primary_darker: #9d9da8;

    --warning: #fc9b6f;
    --danger: #fc92b4;

    --text: #dddde5;
    --text_light: #ffffff;
    --text_muted: #9d9da8;

    --text_disabled: #85858f;
    --text_inactive: #85858f;
    --text_inverse: #FFFFFF;

    --border_color: #2a2a33;

    
    --input_bg: #2e2e37;
    --input_bg_hover: #383841;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #383841;

    --input_border: #2a2a33;
    --input_border_hover: #8da4f5;

    --button_bg: #16161f;
    --button_bg_hover: #383841;
    --button_bg_disabled: #171721;

    
    --bg_dock: #16161f;
    --bg_hover: #383841;

    
    --ico: var(--text);
    --ico_selected: #171721;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #dddde5;
    --on_panel_muted: #9d9da8;
    --on_base_muted: #9d9da8;
    --on_preview_muted: #9d9da8;
    --on_panel_disabled: #85858f;
    --on_base_disabled: #85858f;
    --on_panel_outline: #636369;
    --on_section_heading: #8da4f5;
    --on_panel_accent: #8da4f5;
    --on_button: #dddde5;
    --on_button_disabled: #85858f;
    --on_input: #dddde5;
    --on_input_hover: #dddde5;
    --on_input_focus: #dddde5;
    --on_mixer_muted: #fc92b4;
    --on_mixer_warning: #fc9b6f;
    --on_primary: var(--bg_base);
    --on_primary_hover: var(--bg_base);
    --on_primary_dark: var(--bg_base);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-fc92b4.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-fc9b6f.svg)';
    /* colorway:state-tokens:end */

}
