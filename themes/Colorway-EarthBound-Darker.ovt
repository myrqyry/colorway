@OBSThemeMeta {
    name: 'EarthBound — Darker';
    id: 'com.myrqyry.Colorway.EarthBound.Darker';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: EarthBound — Darker
       Hex colors:
       --bg_window: #080808;
       --bg_base: #080808;
       --bg_preview: #050505;
       --bg_dock: #0a0a0a;
       --bg_hover: #1a1a1a;
       --text: #ffffff;
       --text_light: #ffffff;
       --text_muted: #ffff79;
       --text_inactive: #333333;
       --text_inverse: #000000;
       --text_disabled: #333333;
       --primary: #25ff81;
       --primary_light: #70caff;
       --primary_lighter: #a0ddff;
       --primary_dark: #fafd51;
       --primary_darker: #c4b800;
       --input_bg: #111111;
       --input_bg_hover: #1a1a1a;
       --input_bg_focus: #1a1a1a;
       --input_border: #1a1a1a;
       --input_border_hover: #25ff81;
       --button_bg: #19B25A;
       --button_bg_hover: #4fff99;
       --button_bg_disabled: #080808;
       --list_item_bg_hover: #1a1a1a;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1a1a1a;
       --ico: #ffffff;
       --ico_selected: #080808;
       --warning: #fafd51;
       --danger: #fb967f;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(37, 255, 129, 0.3);
       --accent_bg_end: rgba(37, 255, 129, 0.1);
    */

    --accent_bg_start: 'rgba(37, 255, 129, 0.3)';
    --accent_bg_end: 'rgba(37, 255, 129, 0.1)';

    --bg_window: #080808;
    --bg_base: #080808;
    --bg_preview: #050505;

    --primary: #25ff81;
    --primary_light: #70caff;
    --primary_lighter: #a0ddff;
    --primary_dark: #fafd51;
    --primary_darker: #c4b800;

    --warning: #fafd51;
    --danger: #fb967f;

    --text: #ffffff;
    --text_light: #ffffff;
    --text_muted: #ffff79;

    --text_disabled: #333333;
    --text_inactive: #333333;
    --text_inverse: #000000;

    --border_color: #1a1a1a;

    --input_bg: #111111;
    --input_bg_hover: #1a1a1a;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #1a1a1a;

    --input_border: #1a1a1a;
    --input_border_hover: #25ff81;

    --button_bg: #19B25A;
    --button_bg_hover: #4fff99;
    --button_hover_text: var(--text_inverse);
    --button_bg_disabled: #080808;

    --bg_dock: #0a0a0a;
    --bg_hover: #1a1a1a;

    
    --ico: var(--text);
    --ico_selected: #080808;

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #ffffff;
    --on_panel_muted: #ffff79;
    --on_base_muted: #ffff79;
    --on_preview_muted: #ffff79;
    --on_panel_disabled: #5d5d5d;
    --on_base_disabled: #5d5d5d;
    --on_panel_outline: #5d5d5d;
    --on_section_heading: #25ff81;
    --on_panel_accent: #25ff81;
    --on_button: #333333;
    --on_button_disabled: #5d5d5d;
    --on_input: #ffffff;
    --on_input_hover: #ffffff;
    --on_input_focus: #ffffff;
    --on_mixer_muted: #fb967f;
    --on_mixer_warning: #fafd51;
    --cw_icon_cogs_button: 'url(theme:icons/colorway/mingcute/selected/cogs.svg)';
    --cw_icon_filter_button: 'url(theme:icons/colorway/mingcute/selected/filter.svg)';
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-fb967f.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-fafd51.svg)';
    /* colorway:state-tokens:end */

}
