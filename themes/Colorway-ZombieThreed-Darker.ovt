@OBSThemeMeta {
    name: 'Zombie Threed Darker';
    id: 'com.myrqyry.Colorway.ZombieThreed.Darker';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Zombie Threed Darker
       Hex colors:
       --bg_window: #080808;
       --bg_base: #080808;
       --bg_preview: #040404;
       --bg_dock: #0c0c0c;
       --bg_hover: #1a1a1a;
       --text: #F0FAFF;
       --text_light: #F0FAFF;
       --text_muted: #46ffcd;
       --text_inactive: #333333;
       --text_inverse: #000000;
       --text_disabled: #333333;
       --primary: #F89070;
       --primary_light: #ffcf32;
       --primary_lighter: #ffe070;
       --primary_dark: #2fff89;
       --primary_darker: #20c066;
       --input_bg: #111111;
       --input_bg_hover: #1a1a1a;
       --input_bg_focus: #1a1a1a;
       --input_border: #1a1a1a;
       --input_border_hover: #F89070;
       --button_bg: #AD644E;
       --button_bg_hover: #ffa888;
       --button_bg_disabled: #080808;
       --list_item_bg_hover: #1a1a1a;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1a1a1a;
       --ico: #F0FAFF;
       --ico_selected: #080808;
       --warning: #ffcf32;
       --danger: #ff4a6a;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(248, 144, 112, 0.3);
       --accent_bg_end: rgba(248, 144, 112, 0.1);
    */

    --accent_bg_start: rgba(248, 144, 112, 0.3);
    --accent_bg_end: rgba(248, 144, 112, 0.1);

    --bg_window: #080808;
    --bg_base: #080808;
    --bg_preview: #040404;

    --primary: #F89070;
    --primary_light: #ffcf32;
    --primary_lighter: #ffe070;
    --primary_dark: #2fff89;
    --primary_darker: #20c066;

    --warning: #ffcf32;
    --danger: #ff4a6a;

    --text: #F0FAFF;
    --text_light: #F0FAFF;
    --text_muted: #46ffcd;

    --text_disabled: #333333;
    --text_inactive: #333333;
    --text_inverse: #000000;

    --border_color: #1a1a1a;

    --input_bg: #111111;
    --input_bg_hover: #1a1a1a;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #1a1a1a;

    --input_border: #1a1a1a;
    --input_border_hover: #F89070;

    --button_bg: #AD644E;
    --button_bg_hover: #ffa888;
    --button_bg_disabled: #080808;

    --bg_dock: #0c0c0c;
    --bg_hover: #1a1a1a;

    
    --ico: var(--text);
    --ico_selected: #080808;

}
