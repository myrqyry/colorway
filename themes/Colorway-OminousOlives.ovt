@OBSThemeMeta {
    name: 'Ominous Olives';
    id: 'com.myrqyry.Colorway.OminousOlives';
    extends: 'com.myrqyry.Colorway';
    author: 'StellarBee / myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Ominous Olives
       Hex colors:
       --bg_window: #0c1013;
       --bg_base: #0c1013;
       --bg_preview: #212433;
       --bg_dock: #1f1b18;
       --bg_hover: #333945;
       --text: #e6d472;
       --text_light: #e6d472;
       --text_muted: #6f7897;
       --text_inactive: #6f7897;
       --text_inverse: #0c1013;
       --text_disabled: #4d3028;
       --primary: #8a7a22;
       --primary_light: #e6d472;
       --primary_lighter: #e6d472;
       --primary_dark: #322610;
       --primary_darker: #1f1b18;
       --input_bg: #212433;
       --input_bg_hover: #333945;
       --input_bg_focus: #333945;
       --input_border: #333945;
       --input_border_hover: #8a7a22;
       --button_bg: #333945;
       --button_bg_hover: #e6d472;
       --button_bg_disabled: #212433;
       --list_item_bg_hover: #212433;
       --list_item_bg_selected: #4d3028;
       --border_color: #333945;
       --ico: #e6d472;
       --ico_selected: #0c1013;
       --warning: #e6d472;
       --danger: #bf736a;
       --success: #8a7a22;
       --meter_bg_nom: #212433;
       --meter_bg_war: #623925;
       --meter_bg_err: #360e0f;
       --meter_fg_nom: #8a7a22;
       --meter_fg_war: #e6d472;
       --meter_fg_err: #bf736a;
       Derived colors:
       --accent_bg_start: rgba(138, 122, 34, 0.3);
       --accent_bg_end: rgba(138, 122, 34, 0.1);
    */

    /* Lospec palette: Ominous Olives — StellarBee
       Source: https://lospec.com/palette-list/ominous-olives
       Curated OBS semantic mapping; alert legibility may use derived colors.
       All other solid swatches preserve the source palette. */

    --bg_window: #0c1013;
    --bg_base: #0c1013;
    --bg_preview: #212433;
    --bg_dock: #1f1b18;
    --bg_hover: #333945;
    --text: #e6d472;
    --text_light: #e6d472;
    --text_muted: #6f7897;
    --text_inactive: #6f7897;
    --text_disabled: #4d3028;
    --text_inverse: #0c1013;
    --primary: #8a7a22;
    --primary_light: #e6d472;
    --primary_lighter: #e6d472;
    --primary_dark: #322610;
    --primary_darker: #1f1b18;
    --input_bg: #212433;
    --input_bg_hover: #333945;
    --input_bg_focus: #333945;
    --input_border: #333945;
    --input_border_hover: #8a7a22;
    --button_bg: #333945;
    --button_bg_hover: #e6d472;
    --button_hover_text: #0c1013;
    --button_bg_disabled: #212433;
    --list_item_bg_hover: #212433;
    --list_item_bg_selected: #4d3028;
    --border_color: #333945;
    --warning: #e6d472;
    --danger: #bf736a;
    --success: #8a7a22;
    --meter_bg_nom: #212433;
    --meter_bg_war: #623925;
    --meter_bg_err: #360e0f;
    --meter_fg_nom: #8a7a22;
    --meter_fg_war: #e6d472;
    --meter_fg_err: #bf736a;
    --accent_bg_start: 'rgba(138, 122, 34, 0.3)';
    --accent_bg_end: 'rgba(138, 122, 34, 0.1)';
    --ico: var(--text);
    --ico_selected: var(--text_inverse);
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/normal/check.svg)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
    --on_panel: #e6d472;
    --on_panel_muted: #7a839f;
    --on_base_muted: #727a99;
    --on_preview_muted: #838aa5;
    --on_preview: #e6d472;
    --on_list_hover: #e6d472;
    --on_hover: #e6d472;
    --on_panel_disabled: #78625b;
    --on_base_disabled: #725a54;
    --on_panel_outline: #626770;
    --on_section_heading: #8b7b23;
    --on_panel_accent: #928432;
    --on_button: #e6d472;
    --on_button_disabled: #7e6a64;
    --on_input: #e6d472;
    --on_input_hover: #e6d472;
    --on_input_focus: #e6d472;
    --on_nav_hover: #e6d472;
    --on_mixer_muted: #bf736a;
    --on_mixer_monitor: #8a7a22;
    --on_mixer_warning: #e6d472;
    --on_primary: #000000;
    --on_primary_dark: var(--text);
    --cw_mixer_muted: 'url(theme:icons/colorway/mingcute/mixer/volume-mute-bf736a.svg)';
    --cw_mixer_monitor: 'url(theme:icons/colorway/mingcute/mixer/headphone-8a7a22.svg)';
    --cw_mixer_warning: 'url(theme:icons/colorway/mingcute/mixer/warning-e6d472.svg)';
    /* colorway:state-tokens:end */

}
