@OBSThemeMeta {
    name: 'Twitch Dark';
    id: 'com.myrqyry.Colorway.TwitchDark';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Twitch Dark
       Hex colors:
       --bg_window: #0e0e10;
       --bg_base: #0e0e10;
       --bg_preview: #1f1f23;
       --bg_dock: #18181b;
       --bg_hover: #26233a;
       --text: #efeff1;
       --text_light: #ffffff;
       --text_muted: #adadb8;
       --text_inactive: #53535f;
       --text_inverse: #FFFFFF;
       --text_disabled: #53535f;
       --primary: #9146ff;
       --primary_light: #af7eff;
       --primary_lighter: #e3d1ff;
       --primary_dark: #772ce8;
       --primary_darker: #5c16c5;
       --input_bg: #1f1f23;
       --input_bg_hover: #1f1f23;
       --input_bg_focus: #2d2d34;
       --input_border: #1f1f23;
       --input_border_hover: #9146ff;
       --button_bg: #1f1f23;
       --button_bg_hover: #9146ff;
       --button_bg_disabled: #0e0e10;
       --list_item_bg_hover: #0e0e10;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #1f1f23;
       --warning: #ffb000;
       --danger: #eb6f92;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(145, 70, 255, 0.3);
       --accent_bg_end: rgba(145, 70, 255, 0.1);
    */

    --bg_window: #0e0e10;
    --bg_base: #0e0e10;
    --bg_preview: #1f1f23;
    --bg_dock: #18181b;

    
    --primary: #9146ff;
    --primary_light: #af7eff;
    --primary_lighter: #e3d1ff;
    --primary_dark: #772ce8;
    --primary_darker: #5c16c5;

    --warning: #ffb000;
    --danger: #eb6f92;

    
    --text: #efeff1;
    --text_light: #ffffff;
    --text_muted: #adadb8;
    --text_disabled: #53535f;
    --text_inactive: #53535f;

    
    --border_color: #1f1f23;

    
    --input_bg: #1f1f23;
    --input_bg_hover: #1f1f23;
    --input_bg_focus: #2d2d34;
    --list_item_bg_hover: #0e0e10;
    --input_border: #1f1f23;
    --input_border_hover: #9146ff;

    --button_bg: #1f1f23;
    --button_bg_hover: #9146ff;
    --button_bg_disabled: #0e0e10;

    
    --accent_bg_start: rgba(145, 70, 255, 0.3);
    --accent_bg_end: rgba(145, 70, 255, 0.1);

    
    --text_inverse: #FFFFFF;

}