@OBSThemeMeta {
    name: 'Catppuccin Latte — Red';
    id: 'com.myrqyry.Colorway.CatppuccinLatte.Red';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'false';
}

@OBSThemeVars {
    /* Official palette reference (source values; live accessibility overrides below may differ): Catppuccin Latte — Red
       Hex colors:
       --bg_window: #eff1f5;
       --bg_base: #e6e9ef;
       --bg_preview: #dce0e8;
       --bg_dock: #eff1f5;
       --bg_hover: #ccd0da;
       --text: #4c4f69;
       --text_light: #eff1f5;
       --text_muted: #9ca0b0;
       --text_inactive: #bcc0cc;
       --text_inverse: #000000;
       --text_disabled: #bcc0cc;
       --primary: #d20f39;
       --primary_light: #e64553;
       --primary_lighter: #fe640b;
       --primary_dark: #e64553;
       --primary_darker: #acb0be;
       --input_bg: #ccd0da;
       --input_bg_hover: #bcc0cc;
       --input_bg_focus: #e6e9ef;
       --input_border: #EDEEF1;
       --input_border_hover: #acb0be;
       --button_bg: #eff1f5;
       --button_bg_hover: #ccd0da;
       --button_bg_disabled: #e6e9ef;
       --list_item_bg_hover: #ccd0da;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #ccd0da;
       --ico: #4c4f69;
       --ico_selected: #eff1f5;
       --warning: #df8e1d;
       --danger: #d20f39;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(210, 15, 57, 0.3);
       --accent_bg_end: rgba(210, 15, 57, 0.1);
    */

    --bg_window: #eff1f5;
    --bg_base: #e6e9ef;
    --bg_preview: #dce0e8;

    --primary: #d20f39;
    --primary_light: #e64553;
    --primary_lighter: #fe640b;
    --primary_dark: #e64553;
    --primary_darker: #acb0be;

    --warning: #784c10;
    --danger: #d20f39;
    --success: #28611f;
    --checkbox_check_icon: 'url(theme:icons/colorway/mingcute/selected/check.svg)';

    --text: #4c4f69;
    --text_light: #eff1f5;
    --text_muted: #9ca0b0;
    --text_disabled: #bcc0cc;
    --text_inactive: #bcc0cc;
    --text_inverse: #000000;

    --border_color: #ccd0da;

    --input_bg: #ccd0da;
    --input_bg_hover: #bcc0cc;
    --input_bg_focus: #e6e9ef;

    --list_item_bg_hover: #ccd0da;

    --input_border: #EDEEF1;
    --input_border_hover: #acb0be;

    --button_bg: #eff1f5;
    --button_bg_hover: #ccd0da;
    --button_bg_disabled: #e6e9ef;

    --bg_dock: #eff1f5;
    --bg_hover: #ccd0da;

    --ico: var(--text);
    --ico_selected: #eff1f5;

    --accent_bg_start: 'rgba(210, 15, 57, 0.3)';
    --accent_bg_end: 'rgba(210, 15, 57, 0.1)';

    /* colorway:state-tokens:start — generated by pnpm sync:themes */
