@OBSThemeMeta {
    name: 'Dracula';
    id: 'com.myrqyry.Colorway.Dracula';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(189, 147, 249, 0.3);
    --accent_bg_end: rgba(189, 147, 249, 0.1);

    /* Base Theme Colors */
    --bg_window: #282A36;
    --bg_base: #282A36;
    --bg_preview: #44475A;

    --primary: #BD93F9;
    --primary_light: #F8F8F2;
    --primary_lighter: #FF79C6;
    --primary_dark: #50FA7B;
    --primary_darker: #6272A4;

    --warning: #FFB86C;
    --danger: #FF5555;

    --text: #F8F8F2;
    --text_light: #FFFFFF;
    --text_muted: #6272A4;

    --text_disabled: #44475A;
    --text_inactive: #44475A;

    --border_color: #44475A;

    /* Inputs and Buttons */
    --input_bg: #44475A;
    --input_bg_hover: #6272A4;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #393a4d;

    --input_border: #44475A;
    --input_border_hover: #6272A4;

    --button_bg: #191A21;
    --button_bg_hover: #44475A;
    --button_bg_disabled: #282A36;

    /* Theme Aliases */
    --bg_dock: #191A21;
    --bg_hover: #44475A;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #282A36;
}
