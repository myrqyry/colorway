@OBSThemeMeta {
    name: 'Ethereal Y2K Aero';
    id: 'com.myrqyry.Colorway.EtherealY2KAero';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Official palette reference: Ethereal Y2K Aero
       Hex colors:
       --bg_window: #0b1720;
       --bg_base: #0b1720;
       --bg_preview: #050c12;
       --bg_dock: #101e2a;
       --bg_hover: #182a38;
       --text: #d0f4ff;
       --text_light: #d0f4ff;
       --text_muted: #4d8aa0;
       --text_inactive: #182a38;
       --text_inverse: #FFFFFF;
       --text_disabled: #182a38;
       --primary: #00f0ff;
       --primary_light: #00d2ff;
       --primary_lighter: #b3f8ff;
       --primary_dark: #00b8cc;
       --primary_darker: #008899;
       --input_bg: #101e2a;
       --input_bg_hover: #182a38;
       --input_bg_focus: #182a38;
       --input_border: #122636;
       --input_border_hover: #4d8aa0;
       --button_bg: #101e2a;
       --button_bg_hover: #182a38;
       --button_bg_disabled: #0b1720;
       --list_item_bg_hover: #182a38;
       --list_item_bg_selected: #c4a7e7;
       --border_color: #122636;
       --ico: #d0f4ff;
       --ico_selected: #0b1720;
       --warning: #ffd166;
       --danger: #ff6b6b;
       --success: #37d247;
       --meter_bg_nom: #26233a;
       --meter_bg_war: #f6c177;
       --meter_bg_err: #eb6f92;
       --meter_fg_nom: #c4a7e7;
       --meter_fg_war: #f6c177;
       --meter_fg_err: #eb6f92;
       Derived colors:
       --accent_bg_start: rgba(0, 240, 255, 0.3);
       --accent_bg_end: rgba(0, 240, 255, 0.1);
    */

    --accent_bg_start: rgba(0, 240, 255, 0.3);
    --accent_bg_end: rgba(0, 240, 255, 0.1);

    --bg_window: #0b1720;
    --bg_base: #0b1720;
    --bg_preview: #050c12;

    --primary: #00f0ff;
    --primary_light: #00d2ff;
    --primary_lighter: #b3f8ff;
    --primary_dark: #00b8cc;
    --primary_darker: #008899;

    --warning: #ffd166;
    --danger: #ff6b6b;

    --text: #d0f4ff;
    --text_light: #d0f4ff;
    --text_muted: #4d8aa0;

    --text_disabled: #182a38;
    --text_inactive: #182a38;
    --text_inverse: #FFFFFF;

    --border_color: #122636;

    --input_bg: #101e2a;
    --input_bg_hover: #182a38;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #182a38;

    --input_border: #122636;
    --input_border_hover: #4d8aa0;

    --button_bg: #101e2a;
    --button_bg_hover: #182a38;
    --button_bg_disabled: #0b1720;

    --bg_dock: #101e2a;
    --bg_hover: #182a38;

    
    --ico: var(--text);
    --ico_selected: #0b1720;

}
