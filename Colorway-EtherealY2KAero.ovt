@OBSThemeMeta {
    name: 'Ethereal Y2K Aero';
    id: 'com.myrqyry.Colorway.EtherealY2KAero';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    /* Replay/VirtualCam active state accent (derived from --primary) */
    --accent_bg_start: rgba(0, 240, 255, 0.3);
    --accent_bg_end: rgba(0, 240, 255, 0.1);

    --bg_window: #0b1720;
    --bg_base: #0b1720;
    --bg_preview: #050c12;

    --primary: #00f0ff;
    --primary_light: #00d2ff;
    --primary_lighter: #b3f8ff;
    --primary_dark: #00b8cc;
    --primary_darker: #008899;

    --warning: #ffd166;
    --danger: #ff6b6b;

    --text: #d0f4ff;
    --text_light: #d0f4ff;
    --text_muted: #4d8aa0;

    --text_disabled: #182a38;
    --text_inactive: #182a38;

    --border_color: #122636;

    --input_bg: #101e2a;
    --input_bg_hover: #182a38;
    --input_bg_focus: var(--input_bg_hover);

    --list_item_bg_hover: #182a38;

    --input_border: #122636;
    --input_border_hover: #4d8aa0;

    --button_bg: #101e2a;
    --button_bg_hover: #182a38;
    --button_bg_disabled: #0b1720;

    --bg_dock: #101e2a;
    --bg_hover: #182a38;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #0b1720;
}
