@OBSThemeMeta {
    name: 'Spirited Away';
    id: 'com.myrqyry.Colorway.SpiritedAway';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #1a1d1c;
    --bg_base: #1a1d1c;
    --bg_preview: #121615;

    --primary: #F3B1B3;
    --primary_light: #B0D9DE;
    --primary_lighter: #D4EDF0;
    --primary_dark: #6B5D7E;
    --primary_darker: #4E6D66;

    --warning: #C0A878;
    --danger: #8D635B;

    --text: #E6E6E6;
    --text_light: #FFFFFF;
    --text_muted: #7A9A9E;

    --text_disabled: #506E68;
    --text_inactive: #506E68;

    --border_color: #2E3A38;

    --input_bg: #222726;
    --input_bg_hover: #2E3A38;
    --input_bg_focus: #222726;

    --list_item_bg_hover: #2E3A38;

    --input_border: #2E3A38;
    --input_border_hover: #5EB1BF;

    --button_bg: #222726;
    --button_bg_hover: #2E3A38;
    --button_bg_disabled: #1a1d1c;

    --bg_dock: #1f2322;
    --bg_hover: #2E3A38;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #1a1d1c;
}
