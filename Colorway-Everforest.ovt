@OBSThemeMeta {
    name: 'Everforest';
    id: 'com.myrqyry.Colorway.Everforest';
    extends: 'com.myrqyry.Colorway';
    author: 'Mat + AI';
    dark: 'true';
}

@OBSThemeVars {
    /* Base Theme Colors (Warm Forest Greens/Browns) */
    --bg_window: #2b3339;
    --bg_base: #2b3339;
    --bg_preview: #232a2f; /* Slightly darker than base for canvas */

    /* Everforest Accents */
    --primary: #a7c080;        /* Everforest Green */
    --primary_light: #d3c6aa;  /* Cream for high contrast highlights */
    --primary_lighter: #e6e2cc;
    --primary_dark: #8da468;
    --primary_darker: #4a5b48;

    --warning: #dbbc7f; /* Everforest Yellow */
    --danger: #e67e80;  /* Everforest Red */

    /* Typography (Warm Cream) */
    --text: #d3c6aa;
    --text_light: #ffffff;
    --text_muted: #9da9a0;

    --text_disabled: #7a8478;
    --text_inactive: #7a8478;

    --border_color: #434f55;

    /* Inputs and Buttons */
    --input_bg: #323c41;
    --input_bg_hover: #3a454a;
    --input_bg_focus: #323c41;

    --list_item_bg_hover: #3a454a;

    --input_border: #434f55;
    --input_border_hover: #5c6a72;

    --button_bg: #323c41;
    --button_bg_hover: #3a454a;
    --button_bg_disabled: #2b3339;

    /* Theme Aliases */
    --bg_dock: #323c41;
    --bg_hover: #3a454a;
}