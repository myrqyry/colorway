@OBSThemeMeta {
    name: 'Everforest Dark';
    id: 'com.myrqyry.Colorway.Everforest';
    extends: 'com.myrqyry.Colorway';
    author: 'myrqyry';
    dark: 'true';
}

@OBSThemeVars {
    --bg_window: #2D353B;
    --bg_base: #2D353B;
    --bg_preview: #232A2E;

    --primary: #A7C080;
    --primary_light: #D3C6AA;
    --primary_lighter: #E6E2CC;
    --primary_dark: #8DA468;
    --primary_darker: #4A5B48;

    --warning: #DBBC7F;
    --danger: #E67E80;

    --text: #D3C6AA;
    --text_light: #FFFFFF;
    --text_muted: #9DA9A0;

    --text_disabled: #7A8478;
    --text_inactive: #7A8478;

    --border_color: #475258;

    --input_bg: #343F44;
    --input_bg_hover: #3D484D;
    --input_bg_focus: #404b51;

    --list_item_bg_hover: #3D484D;

    --input_border: #475258;
    --input_border_hover: #859289;

    --button_bg: #343F44;
    --button_bg_hover: #3D484D;
    --button_bg_disabled: #2D353B;

    --bg_dock: #343F44;
    --bg_hover: #3D484D;

    /* Icon colors (currentColor SVGs, controlled via CSS color) */
    --ico: var(--text);
    --ico_selected: #2D353B;
}
